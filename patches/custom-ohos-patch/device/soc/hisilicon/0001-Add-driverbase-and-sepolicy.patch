+int32_t AudioEffectHal::CheckAefParamsSum(const AefBufferType &buf)
+{
+    const int16_t *header = buf.addr;
+    if ((header == nullptr) || (buf.bufLen < AEF_BUFFER_HEAD_LEN)) {
+        LOGE("header is nullptr or len is invalid");
+        return RETURN_FAILURE;
+    }
+    int32_t i = 0;
+    const int16_t *bufPos = buf.addr + AEF_BUFFER_HEAD_LEN;
+    m_checkSumList = std::vector<int64_t>(AEF_CHECK_SUM_LIST_LEN, 0);
+    while (bufPos != nullptr && i < header[AEF_BUFFER_PRE_FLAG]) {
+        m_checkSumList[AEF_PRE_CHECK_SUM_POS] += *bufPos;
+        bufPos++;
+        i++;
+    }
+    i = 0;
+    while (bufPos != nullptr && i < header[AEF_BUFFER_CFG_FLAG]) {
+        m_checkSumList[AEF_CFG_CHECK_SUM_POS] += *bufPos;
+        bufPos++;
+        i++;
+    }
+    i = 0;
+    while (bufPos != nullptr && i < header[AEF_BUFFER_TWS_FLAG]) {
+        m_checkSumList[AEF_TWS_CHECK_SUM_POS] += *bufPos;
+        bufPos++;
+        i++;
+    }
+    i = 0;
+    while (bufPos != nullptr && i < header[AEF_BUFFER_NTM_FLAG]) {
+        m_checkSumList[AEF_NTM_CHECK_SUM_POS] += *bufPos;
+        bufPos++;
+        i++;
+    }
+    i = 0;
+    while (bufPos != nullptr && i < header[AEF_BUFFER_RAP_FLAG]) {
+        m_checkSumList[AEF_RAP_CHECK_SUM_POS] += *bufPos;
+        bufPos++;
+        i++;
+    }
+    i = 0;
+    while (bufPos != nullptr && i < header[AEF_BUFFER_CUS_FLAG]) {
+        m_checkSumList[AEF_CUS_CHECK_SUM_POS] += *bufPos;
+        bufPos++;
+        i++;
+    }
+    m_checkSumList[AEF_VOL_CHECK_SUM_POS] = header[AEF_BUFFER_VOL_FLAG];
+    return RETURN_SUCCESS;
+}
