+    ret = uapi_avplay_create(&avPlayAttr, &m_handle);
+    if(ret != TD_SUCCESS) {
+        LOGE("uapi_avplay_create failed, ret:0x%x", ret);
+        return RETURN_FAILURE;
+    } 
+    return RETURN_SUCCESS;
+}
