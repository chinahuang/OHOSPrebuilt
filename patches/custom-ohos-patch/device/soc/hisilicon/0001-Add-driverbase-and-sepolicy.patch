+        return RETURN_FAILURE;
+    }
+
+    if(m_handle == TD_INVALID_HANDLE)
+    {
+        LOGE("m_handle is invalid");
+        return RETURN_FAILURE;
+    }
+    uapi_audio_format dataFormat = UAPI_AUDIO_FORMAT_CXT;
+    int32_t ret = uapi_ai_get_stream_type(m_handle, &dataFormat);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_ai_get_stream_type failed, ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+
+    switch(dataFormat)
+    {
+        case UAPI_AUDIO_FORMAT_PCM:
+            streamType = DRIVERBASE_AOUT_HDMI_DATA_PCM;
+            break;
+        case UAPI_AUDIO_FORMAT_AC3:
+            streamType = DRIVERBASE_AOUT_HDMI_DATA_DD;
+            break;
+        case UAPI_AUDIO_FORMAT_DTS:
+            streamType = DRIVERBASE_AOUT_HDMI_DATA_DTS;
+            break;
+        case UAPI_AUDIO_FORMAT_EAC3:
+            streamType = DRIVERBASE_AOUT_HDMI_DATA_DDP;
+            break;
+        case UAPI_AUDIO_FORMAT_DTS_HD:
+            streamType = DRIVERBASE_AOUT_HDMI_DATA_DTSHD;
+            break;
+        case UAPI_AUDIO_FORMAT_MAT:
+            streamType = DRIVERBASE_AOUT_HDMI_DATA_MAT;
+            break;
+        default:
+            streamType = DRIVERBASE_AOUT_HDMI_DATA_BUTT;
+            break;
+    }
+
+    return RETURN_SUCCESS;
+}
