+{
+    
+}
+
+int32_t HdmiAudioControllerHal::Create(AoutAudioInputType source)
+{
+    LOGI("Create.");
+    m_track = AudioHal::GetInstance().CreateAudioTrack();
+    if(m_track == nullptr) {
+        LOGE("CreateAudioTrack failed.");
+        return RETURN_FAILURE;
+    }
+    m_input = AudioHal::GetInstance().CreateAudioInput();
+    if(m_input == nullptr) {
+        LOGE("CreateAudioInput failed.");
+        m_track.reset();
+        m_track = nullptr;
+        return RETURN_FAILURE;
+    }
+    m_decoder = AudioHal::GetInstance().CreateAudioDecoder();
+    if(m_decoder == nullptr) {
+        LOGE("CreateAudioDecoder failed.");
+        m_track.reset();
+        m_track = nullptr;
+        m_input.reset();
+        m_input = nullptr;
+        return RETURN_FAILURE;
+    }
+    int32_t ret = m_decoder->HdmiInit();
+    if(ret != RETURN_SUCCESS) {
+        LOGW("HdmiInit failed. ret = %d", ret);
+    }
+    if(!m_isRegisterCodecLib) {
+        ret = m_decoder->RegisterAllCodecLib(m_LoadAudioCodecLib, AUDIO_CODEC_LIB_BUTT);
+        if(ret != RETURN_SUCCESS) {
+            LOGW("RegisterCodecLib failed. ret = %d", ret);
+        }
+        m_isRegisterCodecLib = true;
+    }
+    m_source = source;
+    m_bPassThrough = false;
+    return RETURN_SUCCESS;
+}
+
+int32_t HdmiAudioControllerHal::Destroy()
+{
+    LOGI("Destroy.");
+    if(m_input != nullptr) {
+        m_input.reset();
+        m_input = nullptr;
+    }
+    if(m_track != nullptr) {
+        m_track.reset();
+        m_track = nullptr;
+    }
+    if(m_decoder != nullptr) {
+        m_decoder.reset();
+        m_decoder = nullptr;
+    }
+    m_source = DRIVERBASE_AOUT_SRC_BUTT;
+    return RETURN_SUCCESS;
+}
+
+int32_t HdmiAudioControllerHal::Start(AudioTrackType m_trackType) // AudioTrackType m_trackType
+{
+    
+    if(m_track == nullptr) {
+        LOGE("hdmi audio track is null.");
+        return RETURN_FAILURE;
+    }
+    if(m_input == nullptr) {
+        LOGE("hdmi audio input is null.");
+        return RETURN_FAILURE;
+    }
+    int32_t ret = m_track->Create(m_source, m_trackType);
+    if(ret != RETURN_SUCCESS) {
+        LOGE("track create failed. ret:0x%x", ret);
+        return ret;
+    }
+    //  ������ callback 
+    // TrackStatusInfo trackInfoChange = {m_usrId, TRACK_STATUS_END};
+    // NotifyTrackInfo(trackInfoChange);
+
+    UpdateHdmiAiAttr(m_aiAttr);
+    ret = m_input->Create(m_source, m_aiAttr);
+    if(ret != RETURN_SUCCESS) {
+        LOGE("input create failed. ret:0x%x", ret);
+        static_cast<void>(m_input->Destroy());
+    }
+    ret = m_input->SetEnable(true);
+    if(ret != RETURN_SUCCESS) {
+        LOGW("SetEnable ret = 0x%x", ret);
+    }
+    ThreadHandler::SetName(HDMI_THREAD_NAME);
+    ThreadHandler::Run(ThreadHandler::REPEAT);
+    return ret;
+}
+
