+int32_t PqHal::SetMemcLevel(CommonLevel level)
+{
+    LOGI("level=%d", level);
+    if (!m_isDispInit && InitDisp() != RETURN_SUCCESS) {
+        LOGE("disp not init, can not set memc");
+        return RETURN_FAILURE;
+    }
+    const td_bool memcEnable = (level == COMMON_LEVEL_OFF) ? TD_FALSE : TD_TRUE;
+    int32_t ret = uapi_disp_set_memc_enable(UAPI_DISPLAY0, memcEnable);
+    if (ret != TD_SUCCESS) {
+        LOGE("Failed to %s MEMC (ret=0x%x)", 
+             memcEnable ? "enable" : "disable", ret);
+        return RETURN_FAILURE;
+    }
+    const td_bool judderFreeEnable = (level == COMMON_LEVEL_OFF) ? TD_TRUE : TD_FALSE;
+    ret = uapi_disp_set_judder_free(UAPI_DISPLAY0, judderFreeEnable);
+    if (ret != TD_SUCCESS) {
+        LOGW("Failed to %s judder free (ret=0x%x), continuing...",
+            judderFreeEnable ? "enable" : "disable", ret);
+    }
+    ret = uapi_disp_set_memc_level(UAPI_DISPLAY0, level);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_disp_set_memc_level call failed! ret=0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
+
+CommonLevel PqHal::GetMemcLevel()
+{
+    if (!m_isDispInit && InitDisp() != RETURN_SUCCESS) {
+        LOGE("disp not init, can not set memc");
+        return COMMON_LEVEL_OFF;
+    }
+    td_bool memcEnable = TD_FALSE;
+    int32_t ret = uapi_disp_get_memc_enable(UAPI_DISPLAY0, &memcEnable);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_disp_get_memc_enable call failed! ret=0x%x", ret);
+        return COMMON_LEVEL_OFF;
+    }
+    if (memcEnable == TD_FALSE) {
+        LOGD("MEMC is disabled on display %d", UAPI_DISPLAY0);
+        return COMMON_LEVEL_OFF;
+    }
+    uint32_t uapiMemcLevel = 0;
+    ret = uapi_disp_get_memc_level(UAPI_DISPLAY0, &uapiMemcLevel);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_disp_get_memc_level call failed! ret=0x%x", ret);
+        return COMMON_LEVEL_OFF;
+    }
+    if (uapiMemcLevel >= static_cast<uint32_t>(COMMON_LEVEL_BUTT)) {
+        LOGW("Invalid MEMC level %u received, returning OFF", uapiMemcLevel);
+        return COMMON_LEVEL_OFF;
+    }
+    return static_cast<CommonLevel>(uapiMemcLevel);
+}
