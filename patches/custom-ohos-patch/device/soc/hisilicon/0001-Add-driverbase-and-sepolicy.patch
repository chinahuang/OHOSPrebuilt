+int32_t AudioOutDeviceHal::SetSndMute(SndOutPort port, bool isMute)
+{
+    if (Check() != RETURN_SUCCESS) {
+        LOGE("check failed");
+        return RETURN_FAILURE;
+    }
+    td_bool tmpMute = TD_FALSE;
+    td_bool targetMute = static_cast<td_bool>(isMute);
+    auto targetPort = m_sndOutPortMap.find(port);
+    if( targetPort == m_sndOutPortMap.end() ) {
+        LOGE("[AudioHal] : port:%d is not match",port);
+        return RETURN_FAILURE;
+    }
+    int32_t ret = uapi_snd_get_mute(UAPI_SND_0,targetPort->second,&tmpMute);
+    if (ret != TD_SUCCESS) {
+        LOGE("[AudioHal]:get sound device i2s port mutex statue failed ,ret:%d",ret);
+        return RETURN_FAILURE;
+    }
+    if (tmpMute == targetMute) {
+        LOGI("[AudioHal]:sound device i2s port mute statue is the same as target： %d",targetMute);
+        return RETURN_SUCCESS;
+    }
+    ret = uapi_snd_set_mute(UAPI_SND_0,targetPort->second,targetMute);
+    if (ret != TD_SUCCESS) {
+        LOGE("[AudioHal]:set sound device i2s port mutex statue failed ,ret:%d",ret);
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
