+int32_t AudioTrackHal::Create(AoutAudioInputType type, AudioTrackType trackType)
+{
+    int32_t ret= uapi_snd_init();
+    if(ret != TD_SUCCESS) {
+        LOGE("UAPI_SND_INit failed(0x%x)", ret);
+        return RETURN_FAILURE;
+    }
+    uapi_audio_track_attr trackAttr{};
+    ret = uapi_snd_get_default_track_attr(static_cast<uapi_snd_track_type>(trackType), &trackAttr);
+    if(ret != TD_SUCCESS) {
+        LOGE("uapi_snd_get_default_track_attr failed, ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    ret = uapi_snd_create_track(UAPI_SND_0, &trackAttr, &m_handle);
+    if(ret != TD_SUCCESS) {
+        LOGE("uapi_snd_create_track fail, ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    m_trackAttr = trackAttr;
+    m_trackSrc = GetTrackSource(type);
+    ret = uapi_snd_set_track_source(m_handle, m_trackSrc);
+    if(ret != TD_SUCCESS) {
+        LOGE("uapi_snd_set_track_source failed, ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    ret = uapi_snd_set_track_mute(m_handle, TD_TRUE);
+    if(ret != TD_SUCCESS) {
+        LOGE("uapi_snd_set_track_mute fail, ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
