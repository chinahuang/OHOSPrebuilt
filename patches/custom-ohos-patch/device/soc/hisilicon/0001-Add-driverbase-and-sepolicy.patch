+void AudioEffectHal::SetMaxInfo() const
+{
+    LOGI("start setmaxinfo");
+    int16_t mixInfo[MIX_INFO_LEN] = {0};
+    std::vector<int32_t> channelSequence = ConfigFactory::Get().ParseIntVector("soundchannel:channelSequence");
+    std::vector<int32_t> mixRatio = ConfigFactory::Get().ParseIntVector("soundchannel:mixRatio");
+    if ((channelSequence.size() != MAX_CHANNEL_NUM) || (mixRatio.size() != MAX_CHANNEL_NUM)) {
+        LOGE("Invalid mix info, please check ODM configuration");
+    } else {
+        for (uint16_t i = 0; i < MIX_INFO_LEN; i++) {
+            if (i < MAX_CHANNEL_NUM) {
+                mixInfo[i] = static_cast<int16_t>(channelSequence[i]);
+            } else {
+                mixInfo[i] = static_cast<int16_t>(mixRatio[i - MAX_CHANNEL_NUM]);
+            }
+            LOGI("MixInfo[%hu]: %d", i, mixInfo[i]);
+        }
+        int32_t ret = uapi_snd_set_aef_config(m_aefHandle, AEF_CONFIG_TYPE_CHN_ARRGT,
+            reinterpret_cast<const void *>(mixInfo), BUFFER_LENGTH);
+        LOGI("uapi_snd_set_aef_config:0x%{public}x", ret);
+        if (ret != RETURN_SUCCESS) {
+            LOGI("SetMaxInfo failed");
+        }
+        LOGI("SetMaxInfo success");
+    }
+}
