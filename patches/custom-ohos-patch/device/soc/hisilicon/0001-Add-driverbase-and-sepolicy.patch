+    ret = uapi_sif_stop(UAPI_SIF_ID_0);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_sif_stop fail, ret=%d", ret);
+        return RETURN_FAILURE;
+    }
+
+    m_isInit = false;
+    return RETURN_SUCCESS;
