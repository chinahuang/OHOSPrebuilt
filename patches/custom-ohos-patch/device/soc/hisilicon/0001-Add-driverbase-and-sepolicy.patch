+    uapi_snd_preci_gain preciGainAttr{};
+    int32_t ret = uapi_snd_get_precision_volume(UAPI_SND_0, port, &preciGainAttr);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_snd_get_precision_volume fail port:0x%x failed, retL0x%x", port, ret);
+        return RETURN_FAILURE;
