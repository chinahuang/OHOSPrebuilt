+    if (Check() != RETURN_SUCCESS) {
+        LOGE("check failed");
+        return RETURN_FAILURE;
+    }   
+    uapi_snd_out_port port = ConvertDeviceTypeToPort(type);
+    uapi_snd_preci_gain preciGainAttr{};
+    preciGainAttr.integer = intGain;
+    preciGainAttr.decimal = decGain;
+    int32_t ret = uapi_snd_set_precision_volume(UAPI_SND_0, port, &preciGainAttr);
+    if (ret != TD_SUCCESS) {
+        LOGD("set port:0x%x precision volume, IntegerGain:%d, DecimalGain:%d!",
+        port, preciGainAttr.integer, preciGainAttr.decimal);
+    } else {
+        LOGE("uapi_snd_set_precision_volume port:0x%x failed, retL0x%x", port, ret);
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
