+int32_t AudioInputHal::ReleaseFrame(AoFrameInfo &frame)
+{
+    if(Check() != RETURN_SUCCESS)
+    {
+        LOGE("check failed");
+        return RETURN_FAILURE;
+    }
+
+    if(m_handle == TD_INVALID_HANDLE)
+    {
+        LOGE("m_handle is invalid");
+        return RETURN_FAILURE;
+    }
+
+    uapi_audio_frame audioFrame{};
+    audioFrame.bit_depth = frame.bitPerSample;
+    audioFrame.interleaved = frame.interleaved ? TD_TRUE : TD_FALSE;
+    audioFrame.sample_rate = frame.sampleRate;
+    audioFrame.channels = frame.channels;
+    audioFrame.pts = frame.ptsUs;
+    audioFrame.pcm_buffer = reinterpret_cast<td_s32 *>(frame.pcmBuffer);
+    audioFrame.bits_buffer = reinterpret_cast<td_s32 *>(frame.bitsBuffer);
+    audioFrame.pcm_samples = frame.pcmSamplesPerFrame;
+    audioFrame.bits_bytes = frame.bitsBytesPerFrame;
+    audioFrame.frame_index = frame.frameIndex;
+    audioFrame.iec_data_type = frame.dataType;
+
+    int32_t ret = uapi_ai_release_frame(m_handle, &audioFrame);
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("uapi_ai_release_frame failed, ret:0x%x", ret);
+        return ret;
+    }
+
+    return RETURN_SUCCESS;
+}
+
+int32_t AudioInputHal::GetDelay(uint32_t &aiDelay)
+{
+    if(Check() != RETURN_SUCCESS)
+    {
+        LOGE("check failed");
+        return RETURN_FAILURE;
+    }
+
+    if(m_handle == TD_INVALID_HANDLE)
+    {
+        LOGE("m_handle is invalid");
+        return RETURN_FAILURE;
+    }
+
+    uapi_ai_delay audioInputDelay{};
+    int32_t ret = uapi_ai_get_delay(m_handle, &audioInputDelay);
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("uapi_ai_get_delay failed, ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+
+    aiDelay = audioInputDelay.delay_ms;
+    return RETURN_SUCCESS;
+};
+
+uapi_hdmirx_port AudioInputHal::ConvertInputToHdmiPort(AoutAudioInputType source) const
+{  
+    switch (source) 
+    {
+        case DRIVERBASE_AOUT_SRC_HDMI1:
+            return static_cast<uapi_hdmirx_port>(ConfigFactory::Get().ParseInt("videoinputmap:HDMI1Port"));
+        case DRIVERBASE_AOUT_SRC_HDMI2:
+            return static_cast<uapi_hdmirx_port>(ConfigFactory::Get().ParseInt("videoinputmap:HDMI2Port"));
+        case DRIVERBASE_AOUT_SRC_HDMI3:
+            return static_cast<uapi_hdmirx_port>(ConfigFactory::Get().ParseInt("videoinputmap:HDMI3Port"));
+        case DRIVERBASE_AOUT_SRC_HDMI4:
+            return static_cast<uapi_hdmirx_port>(ConfigFactory::Get().ParseInt("videoinputmap:HDMI4Port"));
+        default:
+            LOGE("unknown source=%d", source);
+            break;
+    }
+    return UAPI_HDMIRX_PORT_MAX;
+}
+
+int32_t AudioInputHal::GetHdmiAudioInfo(HdmiAudioAttr &hdmiAudioInfo, AoutAudioInputType source)
+{
+    uapi_hdmirx_audio_attr audioInfo{};
+    int32_t ret = uapi_hdmirx_get_audio_info(ConvertInputToHdmiPort(source), &audioInfo);
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("uapi_hdmirx_get_audio_info failed, ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+
+    LOGI("nChannel = %d, bitDepth = %d, SampleRate = %d, audio_data_type = %d, audio_format = %d", audioInfo.channels, audioInfo.bit_depth, audioInfo.sample_rate, audioInfo.audio_data_type, audioInfo.audio_format);
+    
+    hdmiAudioInfo.nChannel = static_cast<I2SChnNum>(audioInfo.channels);
+    hdmiAudioInfo.bitDepth = static_cast<I2SBitDepth>(audioInfo.bit_depth);
+    hdmiAudioInfo.sampleRate = static_cast<SampleRate>(audioInfo.sample_rate);
+
+    if(audioInfo.audio_data_type == UAPI_AUDIO_DATA_TYPE_LPCM)
+    {
+        hdmiAudioInfo.dataFmt = HDMI_AUDIO_FMT_LPCM;
+    }
+    else if(audioInfo.audio_data_type == UAPI_AUDIO_DATA_TYPE_LBR)
+    {
+        hdmiAudioInfo.dataFmt = HDMI_AUDIO_FMT_LBR;
+    }
+    else if(audioInfo.audio_data_type == UAPI_AUDIO_DATA_TYPE_HBR)
+    {
+        hdmiAudioInfo.dataFmt = HDMI_AUDIO_FMT_HBR;
+    }
+
+    switch(audioInfo.audio_format)
+    {
+        case UAPI_AUDIO_FORMAT_PCM:
+            hdmiAudioInfo.dataType = DRIVERBASE_AOUT_HDMI_DATA_PCM;
+            break;
+        case UAPI_AUDIO_FORMAT_AC3:
+            hdmiAudioInfo.dataType = DRIVERBASE_AOUT_HDMI_DATA_DD;
+            break;
+        case UAPI_AUDIO_FORMAT_DTS:
+            hdmiAudioInfo.dataType = DRIVERBASE_AOUT_HDMI_DATA_DTS;
+            break;
+        case UAPI_AUDIO_FORMAT_EAC3:
+            hdmiAudioInfo.dataType = DRIVERBASE_AOUT_HDMI_DATA_DDP;
+            break;
+        case UAPI_AUDIO_FORMAT_DTS_HD:
+            hdmiAudioInfo.dataType = DRIVERBASE_AOUT_HDMI_DATA_DTSHD;
+            break;
+        case UAPI_AUDIO_FORMAT_MAT:
+            hdmiAudioInfo.dataType = DRIVERBASE_AOUT_HDMI_DATA_MAT;
+            break;
+        default:
+            hdmiAudioInfo.dataType = DRIVERBASE_AOUT_HDMI_DATA_BUTT;
+            break;
+    }
+
+    return ret;
+}
