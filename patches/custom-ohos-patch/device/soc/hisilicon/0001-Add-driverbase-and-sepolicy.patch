@@ -0,0 +1,91 @@
+#define LOG_NDEBUG 0
+#define LOG_TAG "CvbsAudioControllerHal"
+
+#include "CvbsAudioControllerHal.h"
+
+CvbsAudioControllerHal &GetCvbsAudioControllerHal()
+{
+    return CvbsAudioControllerHal::GetInstance();
+}
+
+CvbsAudioControllerHal &CvbsAudioControllerHal::GetInstance()
+{
+    static CvbsAudioControllerHal cvbsAudioControllerHal;
+    return cvbsAudioControllerHal;
+}
+
+CvbsAudioControllerHal::CvbsAudioControllerHal()
+{
+    LOGI("AudioController CvbsAudioControllerHal");
+}
+
+CvbsAudioControllerHal::~CvbsAudioControllerHal()
+{
+    LOGI("AudioController ~CvbsAudioControllerHal");
+}
+
+void CvbsAudioControllerHal::SetUserMute(bool userMute)
+{
+    LOGI("AudioController SetUserMute");
+    curUsrMute = userMute;
+}
+
+int32_t CvbsAudioControllerHal::Start(AudioTrackType m_trackType) 
+{
+    LOGI("AudioController start");
+    if(m_input == nullptr || m_track == nullptr) {
+        LOGE("audio start failed.");
+        return RETURN_FAILURE;
+    }
+    AudioInputAttr aiAttr = {};
+    int32_t ret = m_input->Create(m_source, aiAttr);
+    if(ret != RETURN_SUCCESS) {
+        LOGE("Create input failed. ret:%d", ret);
+        return RETURN_FAILURE;
+    }
+    ret = m_track->Create(m_source, m_trackType);
+    if(ret != RETURN_SUCCESS) {
+        LOGE("Create track failed. ret:%d", ret);
+        static_cast<void>(m_input->Destroy());
+        return RETURN_FAILURE;
+    }
+    ret = CvbsStart(*m_input, *m_track);
+    if(ret != RETURN_SUCCESS) {
+        LOGE("CvbsStart failed. ret:%d", ret);
+        static_cast<void>(m_input->Destroy());
+        static_cast<void>(m_track->Destroy());
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
+
+int32_t CvbsAudioControllerHal::CvbsStart(AudioInputHal &input, AudioTrackHal &track) const
+{
+    int32_t ret = track.AttachInput(input.GetHandle());
+    if(ret != RETURN_SUCCESS) {
+        LOGE("AttachInput failed. ret:%d", ret);
+        return RETURN_FAILURE;
+    }
+    ret = input.SetNrAttr(input.GetHandle());
+    if(ret != RETURN_SUCCESS) {
+        LOGE("SetNrAttr failed. ret:%d", ret);
+        static_cast<void>(track.DetachInput());
+        return RETURN_FAILURE;
+    }
+    ret = input.SetEnable(true);
+    if(ret != RETURN_SUCCESS) {
+        LOGE("SetEnable failed. ret:%d", ret);
+        static_cast<void>(track.DetachInput());
+        return RETURN_FAILURE;
+    }
+    
+    bool userMute = true;
+    ret = track.SetMute(track.GetHandle(), userMute);
+    if(ret != RETURN_SUCCESS) {
+        LOGE("SetMute failed. ret:%d", ret);
+        static_cast<void>(input.SetEnable(false));
+        static_cast<void>(track.DetachInput());
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
