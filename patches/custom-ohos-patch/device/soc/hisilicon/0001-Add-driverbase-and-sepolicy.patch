+int32_t AudioOutDeviceHal::SetTrackChannelMode(TrackChannelModeType trackMode)
+{
+    if (Check() != RETURN_SUCCESS) {
+        LOGE("check failed");
+        return RETURN_FAILURE;
+    }
+    uapi_snd_track_info trackInfo{};
+    uapi_audio_track_attr trackAttr{};
+
+    int32_t ret = uapi_snd_get_track_info(UAPI_SND_0, &trackInfo);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_snd_get_track_info fail, ret:0x%x", ret);
+        return RETURN_FAILURE;        /* code */
+    }
+    if( trackInfo.track_num == 0 ){
+        LOGE("No Track!");
+        return RETURN_FAILURE;
+    }
+    td_handle handleTrack = TD_INVALID_HANDLE;
+    uapi_track_mode trackChannelMode = UAPI_TRACK_MODE_MAX;
+    for (uint32_t index = 0; index < trackInfo.track_num; index++) {
+        ret = uapi_snd_get_track_attr(trackInfo.track_status[index].track, &trackAttr);
+        if (ret != TD_SUCCESS) {
+            LOGE("uapi_snd_get_track_attr fail, ret:0x%x", ret);
+            continue;
+        }
+        handleTrack = trackInfo.track_status[index].track;
+        trackChannelMode = static_cast<uapi_track_mode>(trackMode);
+        ret = uapi_snd_set_track_channel_mode(handleTrack, trackChannelMode);
+        if (ret != TD_SUCCESS) {
+            LOGE("uapi_snd_set_track_channel_mode fail, ret:0x%x",ret);
+            return RETURN_FAILURE;
+        }
+    }
+    return RETURN_SUCCESS;
+}
