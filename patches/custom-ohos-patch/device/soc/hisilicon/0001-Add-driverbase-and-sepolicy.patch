+int32_t AudioOutDeviceHal::SetArcCap(const ArcCap &arcCap)
+{
+    if (Check() != RETURN_SUCCESS) {    
+        LOGE("check failed");
+        return RETURN_FAILURE;
+    }
+    uapi_snd_arc_audio_cap unfArcCap{};
+    uint32_t length = sizeof(unfArcCap.audio_fmt_supported) / sizeof(unfArcCap.audio_fmt_supported[0]);
+    for (uint32_t i = 0; (i < length) && (i < EDID_AUDIO_FORMAT_CODE_BUTT); i++) {
+        unfArcCap.audio_fmt_supported[i] = arcCap.isAudioFmtSupported[i] ? TD_TRUE : TD_FALSE;
+    }
+    int32_t ret = uapi_snd_set_arc_cap(UAPI_SND_0, UAPI_SND_OUT_PORT_ARC0, &unfArcCap);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_snd_set_arc_cap failed, retL0x%x", ret);
+        for (int32_t i = 0; i < UAPI_AUDIO_FORMAT_CXT; i++) {
+            LOGE("arcCap.isAudioFmtSupported[%d] = %d", i, unfArcCap.audio_fmt_supported[i]);
+        }
+        return RETURN_FAILURE;
+    }
+    LOGE("uapi_snd_set_arc_cap success");
+    return RETURN_SUCCESS;
+}
