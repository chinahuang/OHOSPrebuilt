+    }
+    if(inputType == INPUT_HDMI)
+    {
+        return &VideoDecoderHdmiHal::GetInstance();
+    } else if(inputType == INPUT_CVBS)
+    {
+        return &VideoDecoderCvbsHal::GetInstance();
+    } else if(inputType == INPUT_AVPLAY)
+    {
+        //return &VideoDecoderAvPlayHal::GetInstance();
+        LOGE("VideoInputHal::GetVideoDecoder, unvalid input type %d", inputType);
+    } else 
+    {
+        LOGE("VideoInputHal::GetVideoDecoder, unknown input type %d", inputType);
+    }
+    return nullptr;
