+int32_t VideoOutputHal::DestroyWindow(WindowType type)
+{
+	if (type != m_windowType) {
+		LOGE("destroy window type %d failed. current window type %d.", type, m_windowType);
+		return RETURN_FAILURE;
+	}
+
+	if (m_windowHandle == TD_INVALID_HANDLE) {
+		LOGW("no window");
+		return RETURN_SUCCESS;
+	}
+
+	if (Check() != RETURN_SUCCESS) {
+		LOGE("check failed");
+		return RETURN_FAILURE;
+	}
+
+	int32_t ret = uapi_win_destroy(m_windowHandle);
+	if (ret != TD_SUCCESS) {
+		LOGE("uapi_win_destroy failed. ret=0x%x", ret);
+		return RETURN_FAILURE;
+	}
+
+	m_windowHandle = TD_INVALID_HANDLE;
+	m_windowType = WINDOW_BUTT;
+	m_source = SOURCE_BUTT;
+	m_quickOutEn = false;
+
+	return RETURN_SUCCESS;
+}
+
+uapi_win_win_priority VideoOutputHal::ConvertWindowType(WindowType type) const
+{
+	static const std::unordered_map <WindowType, uapi_win_win_priority> convertMap{
+		{WINDOW_MAIN, UAPI_WIN_WIN_PRIORITY_MAIN},
+		{WINDOW_SUB, UAPI_WIN_WIN_PRIORITY_SUB},
+		{WINDOW_AUTO, UAPI_WIN_WIN_PRIORITY_AUTO}
+	};
+
+	auto item = convertMap.find(type);
+	if (item == convertMap.end()) {
+		return UAPI_WIN_WIN_PRIORITY_MAIN;
+	}
+
+	return item->second;
+}
