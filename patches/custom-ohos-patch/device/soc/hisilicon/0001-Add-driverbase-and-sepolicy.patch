+int32_t PqHal::SetColorGain(ColorType colorType)
+{
+    if (colorType >= COLOR_TYPE_TYPE_BUTT) {
+        LOGE("Invalid color type: %d", static_cast<int>(colorType));
+        return RETURN_FAILURE;
+    }
+
+    uint32_t totalIndex = 0;
+    int32_t ret =
+        uapi_pq_get_table_num(UAPI_DISPLAY0, UAPI_PQ_IMAGE_GRAPH_ALL, UAPI_PQ_TABLE_MODULE_COLOR, &totalIndex);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_pq_get_table_num call failed! ret=0x%x", ret);
+    }
+    if (colorType >= totalIndex) {
+        LOGW("current curve:%d not support, total:%u set curve : 0", colorType, totalIndex);
+        colorType = COLOR_TYPE_CVBS;
+    }
+    LOGI("colorType = %d", colorType);
+    ret = uapi_pq_set_table(UAPI_DISPLAY0, UAPI_PQ_IMAGE_ALL, UAPI_PQ_TABLE_MODULE_COLOR, colorType);
+    if (ret == TD_SUCCESS) {
+        m_lastColorType = colorType;
+        return RETURN_SUCCESS;
+    }
+    LOGE("uapi_pq_set_table call failed! ret=0x%x", ret);
+    return RETURN_FAILURE;
+}
