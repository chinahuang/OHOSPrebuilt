+int32_t HdmiAudioControllerHal::Stop()
+{
+    if(m_input == nullptr) {
+        LOGE("hdmi audio input is nullptr");
+        return RETURN_FAILURE;
+    }
+    if(m_track == nullptr) {
+        LOGE("hdmi audio track is nullptr");
+        return RETURN_FAILURE;
+    }
+    int32_t ret = m_input->SetEnable(false);
+    if(ret != RETURN_SUCCESS) {
+        LOGW("audio input disable fail!");
+    }
+    ThreadHandler::ExitAndJoin();
+    LOGD("----- passThrough thread exit! -----");
+    if(m_curHdmiStreamType != STREAM_FORMAT_BUTT) {
+        AudioStreamInfo streamInfo{};
+        streamInfo.streamType = AUDIO_STREAM_TYPE_BUTT;
+        //������ callback
+        //NotifyStreamType(streamInfo);
+    }
+
+    if(m_bPassThrough) {
+        static_cast<void>(DeInitCastForNoPcm());
+    } else {
+        static_cast<void>(DeInitCastForPcm());
+    }
+
+    if(m_isTrackAttachAi) {
+        ret = m_track->DetachInput();
+        if(ret != RETURN_SUCCESS) {
+            LOGW("audio track disconnect fail!");
+        }
+        m_isTrackAttachAi = false;
+    }
+    DeleteSource();
+    m_streamType = DRIVERBASE_AOUT_HDMI_DATA_BUTT;
+    m_curStreamType = DRIVERBASE_AOUT_HDMI_DATA_BUTT;
+    m_hasHdmiInfoReport = false;
+    return RETURN_SUCCESS;
+}
