+    return RETURN_SUCCESS;
+}
+
+int32_t AudioTrackHal::GetTrackAttr(TrackAttr &trackAttr)
+{ 
+    if(m_handle == TD_INVALID_HANDLE){
+        LOGE("m_handle is invalid");
+        return RETURN_FAILURE;
+    }
+    uapi_audio_track_attr audioTrackAttr{};
+    int32_t ret = uapi_snd_get_track_attr(m_handle, &audioTrackAttr);
+    if(ret != TD_SUCCESS) {
+        LOGE("uapi_snd_get_track_attr fail, ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    trackAttr.trackType = static_cast<TrackType>(audioTrackAttr.track_type);
+    trackAttr.fadeInMs = audioTrackAttr.fadein_ms;
+    trackAttr.fadeOutMs = audioTrackAttr.fadeout_ms;
+    trackAttr.outputBufSize = audioTrackAttr.output_buf_size;
+    trackAttr.bufLevelMs = audioTrackAttr.buf_level_ms;
+    trackAttr.startThresholdMs = audioTrackAttr.start_threshold_ms;
+    trackAttr.userID = audioTrackAttr.user_id;
+    return RETURN_SUCCESS;
+}
+
+int32_t AudioTrackHal::SetTrackAttr(const TrackAttr &trackAttr)
+{   
+    if(m_handle == TD_INVALID_HANDLE){
+        LOGE("m_handle is invalid");
+        return RETURN_FAILURE;
+    }
+    uapi_audio_track_attr audioTrackAttr{};
+    audioTrackAttr.track_type = static_cast<uapi_snd_track_type>(trackAttr.trackType);
+    audioTrackAttr.fadein_ms = trackAttr.fadeInMs;
+    audioTrackAttr.fadeout_ms = trackAttr.fadeOutMs;
+    audioTrackAttr.output_buf_size = trackAttr.outputBufSize;
+    audioTrackAttr.buf_level_ms = trackAttr.bufLevelMs;
+    audioTrackAttr.start_threshold_ms = trackAttr.startThresholdMs;
+    audioTrackAttr.user_id = trackAttr.userID;
+    int32_t ret = uapi_snd_set_track_attr(m_handle, &audioTrackAttr);
+    if(ret != TD_SUCCESS) {
+        LOGE("uapi_snd_set_track_attr fail, ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
