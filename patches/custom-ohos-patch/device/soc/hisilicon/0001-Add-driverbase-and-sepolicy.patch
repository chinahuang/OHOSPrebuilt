+uapi_snd_out_port AudioOutDeviceHal::ConvertDeviceTypeToPort(AoutDeviceType outputDevice)
+{
+    uapi_snd_out_port outPort = UAPI_SND_OUT_PORT_MAX;
+    switch(outputDevice) {
+        case DRIVERBASE_AOUT_DEVICE_RCA:
+            outPort = UAPI_SND_OUT_PORT_DAC0;
+            break;
+        case DRIVERBASE_AOUT_DEVICE_SPDIF:
+            outPort = UAPI_SND_OUT_PORT_SPDIF0;
+            break;
