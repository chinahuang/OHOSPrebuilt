+int32_t HdmiAudioControllerHal::GetDolbyStreamType(AudioStreamType &audioStreamType, uint32_t &value)
+{
+    if(m_decoder == nullptr) {
+        LOGE("decoder is nullptr!");
+        return RETURN_FAILURE;
+    }
+    AcodecStreamInfo acodecStreamInfo{};
+    m_curHdmiStreamType = STREAM_FORMAT_BUTT;
+    audioStreamType = AUDIO_STREAM_TYPE_BUTT;
+    value = static_cast<uint32_t>(AUDIO_DOLBY_TYPE_BUTT);
+
+    if((m_LoadAudioCodecLib[m_curAudioType]) ||
+        ((m_curAudioType == DRIVERBASE_AOUT_HDMI_DATA_DD) && (m_LoadAudioCodecLib[DRIVERBASE_AOUT_HDMI_DATA_DDP]))) {
+            static_cast<void>(m_decoder->GetStreamInfo(acodecStreamInfo));
+            LOGI("current audio format:%d", acodecStreamInfo.audioFormat);
+            if(HA_FORMAT_AC3 == acodecStreamInfo.audioFormat || HA_FORMAT_EAC3 == acodecStreamInfo.audioFormat ||
+                HA_FORMAT_AC4 == acodecStreamInfo.audioFormat) {
+                    m_curHdmiStreamType = STREAM_FORMAT_DOLBY_AUDIO;
+                    audioStreamType = AUDIO_STREAM_TYPE_DOLBY;
+                    value = static_cast<uint32_t>(AUDIO_DOLBY_TYPE_AUDIO);
+                }
+        }
+        return RETURN_SUCCESS;
+}
+
+int32_t HdmiAudioControllerHal::GetDtsStreamType(AudioStreamType &audioStreamType, uint32_t &value)
+{
+    if(m_decoder == nullptr) {
+        LOGE("hdmi decoder is nullptr!");
+        return RETURN_FAILURE;
+    }
+
+    if((!m_LoadAudioCodecLib[AUDIO_CODEC_LIB_DTSM6]) && (!m_LoadAudioCodecLib[AUDIO_CODEC_LIB_DTSHD])) {
+        LOGI("both AUDIO_CODEC_LIB_DTSM6 and AUDIO_CODEC_LIB_DTSHD are not loaded!");
+        return RETURN_SUCCESS;
+    }
+    if((m_curAudioType == DRIVERBASE_AOUT_HDMI_DATA_DTS) || (m_curAudioType == DRIVERBASE_AOUT_HDMI_DATA_DTSHD)) {
+        m_curHdmiStreamType = STREAM_FORMAT_DTS_AUDIO;
+        audioStreamType = AUDIO_STREAM_TYPE_DTS;
+        if (m_LoadAudioCodecLib[AUDIO_CODEC_LIB_DTSM6]) {
+            DtsStreamType curDtsStreamType = DTS_STREAM_TYPE_BUTT;
+            int32_t ret = m_decoder->GetDtsStreamType(curDtsStreamType);
+            if (ret != RETURN_SUCCESS) {
+                LOGE("GetDtsStreamType fail!");
+                return RETURN_FAILURE;
+            }
+            value = static_cast<uint32_t>(curDtsStreamType);
+        } else{
+            audioStreamType = AUDIO_STREAM_TYPE_DTS;
+            value = static_cast<uint32_t>(DTS_STREAM_TYPE_DTS);
+        }
+    }
+    return RETURN_SUCCESS;
+}
