+
+#include <sys/prctl.h>
+
+ThreadHandler::ThreadHandler(ThreadHandlerFunc func, const void *arg, IThreadHandlerEvt *evt)
+    : m_threadFunc(func), m_arg(arg), m_curEvt(evt), m_curId(0)
+{
+    LOGI("constuct");
+    int32_t ret = pthread_mutex_init(&m_lock, nullptr);
+    if (ret != RETURN_SUCCESS) {
+        LOGE("pthread_mutex_init fail, ret: 0x%x", ret);
+    }
+
+    ret = pthread_cond_init(&m_cond, nullptr);
+    if (ret != RETURN_SUCCESS) {
+        LOGE("pthread_cond_init fail, ret: 0x%x", ret);
+    }
+}
+
+ThreadHandler::~ThreadHandler()
+{
+    int32_t ret = pthread_mutex_lock(&m_lock);
+    if (ret != RETURN_SUCCESS) {
+        LOGE("pthread_mutex_lock fail, ret: 0x%x", ret);
+    }
+
+    if (!m_stat.exit) {
+        ret = pthread_mutex_unlock(&m_lock);
+        if (ret != RETURN_SUCCESS) {
+            LOGE("pthread_mutex_unlock fail, ret: 0x%x", ret);
+        }
+
+        ret = pthread_join(m_curId, nullptr);
+        if (ret != RETURN_SUCCESS) {
+            LOGE("pthread_join fail, ret: 0x%x", ret);
+        }
+    } else {
+        ret = pthread_mutex_unlock(&m_lock);
+        if (ret != RETURN_SUCCESS) {
+            LOGE("pthread_mutex_unlock fail, ret: 0x%x", ret);
+        }
+    }
+
+    ret = pthread_mutex_destroy(&m_lock);
+    if (ret != RETURN_SUCCESS) {
+        LOGE("pthread_mutex_destroy fail, ret: 0x%x", ret);
+    }
+
+    ret = pthread_cond_destroy(&m_cond);
+    if (ret != RETURN_SUCCESS) {
+        LOGE("pthread_cond_destroy fail, ret: 0x%x", ret);
+    }
+}
+
+void ThreadHandler::Exit()
+{
+    int32_t ret = pthread_mutex_lock(&m_lock);
+    if (ret != RETURN_SUCCESS) {
+        LOGE("pthread_mutex_lock fail, ret: 0x%x", ret);
+    }
+
+    if (!m_stat.exit) {
+        m_stat.exit = true;
+        m_stat.wait = false;
+        ret = pthread_cond_signal(&m_cond);
+        if (ret != RETURN_SUCCESS) {
+            LOGE("pthread_cond_signal fail, ret: 0x%x", ret);
+        }
+    }
+    ret = pthread_mutex_unlock(&m_lock);
+    if (ret != RETURN_SUCCESS) {
+        LOGE("pthread_mutex_unlock fail, ret: 0x%x", ret);
+    }
+}
+
+void ThreadHandler::ExitAndJoin()
+{
+    int32_t ret = pthread_mutex_lock(&m_lock);
+    if (ret != RETURN_SUCCESS) {
+        LOGE("pthread_mutex_lock fail, ret: 0x%x", ret);
+    }
+
+    if (!m_stat.exit) {
+        m_stat.exit = true;
+        m_stat.wait = false;
+
+        ret = pthread_cond_signal(&m_cond);
+        if (ret != RETURN_SUCCESS) {
+            LOGE("pthread_cond_signal fail, ret: 0x%x", ret);
+        }
+
+        ret = pthread_mutex_unlock(&m_lock);
+        if (ret != RETURN_SUCCESS) {
+            LOGE("pthread_mutex_unlock fail, ret: 0x%x", ret);
+        }
+
+        ret = pthread_join(m_curId, nullptr);
+        if (ret != RETURN_SUCCESS) {
+            LOGE("pthread_join fail, ret: 0x%x", ret);
+        }
+        return;
+    }
+
+    ret = pthread_mutex_unlock(&m_lock);
+    if (ret != RETURN_SUCCESS) {
+        LOGE("pthread_mutex_unlock fail, ret: 0x%x", ret);
+    }
+    
+    LOGI("Thread not Run");
+}
+
+void ThreadHandler::Run(uint32_t flag)
+{
+    LOGI("TEST Thread Run");
+    int32_t ret = pthread_mutex_lock(&m_lock);
+    if (ret != RETURN_SUCCESS) {
+        LOGE("pthread_mutex_lock fail, ret: 0x%x", ret);
+    }
+
+    if (!m_stat.exit) {
+        m_stat.exit = true;
+        m_stat.wait = false;
+
+        ret = pthread_cond_signal(&m_cond);
+        if (ret != RETURN_SUCCESS) {
+            LOGE("pthread_cond_signal fail, ret: 0x%x", ret);
+        }
+
+        ret = pthread_mutex_unlock(&m_lock);
+        if (ret != RETURN_SUCCESS) {
+            LOGE("pthread_mutex_unlock fail, ret: 0x%x", ret);
+        }
+
+        ret = pthread_join(m_curId, nullptr);
+        if (ret != RETURN_SUCCESS) {
+            LOGE("pthread_join fail, ret: 0x%x", ret);
+        }
+
+        ret = pthread_mutex_lock(&m_lock);
+        if (ret != RETURN_SUCCESS) {
+            LOGE("pthread_mutex_lock fail, ret: 0x%x", ret);
+        }
+    }
+    m_stat.exit = false;
+    m_stat.wait = true;
+    m_stat.once = flag & ONCE;
+
+    if (~flag & WAIT) {
+        m_stat.wait = false;
+    }
+    ret = pthread_mutex_unlock(&m_lock);
+    if (ret != RETURN_SUCCESS) {
+        LOGE("pthread_mutex_unlock fail, ret: 0x%x", ret);
+    }
+    ret = pthread_create(&m_curId, nullptr, Loop, this);
+    if (ret != RETURN_SUCCESS) {
+        LOGE("pthread_create fail, ret: 0x%x", ret);
+    }
+}
+
+void ThreadHandler::Suspend()
+{
+    int32_t ret = pthread_mutex_lock(&m_lock);
+    if (ret != RETURN_SUCCESS) {
+        LOGE("pthread_mutex_lock fail, ret: 0x%x", ret);
+    }
+
+    if(!m_stat.exit) {
+        if (m_stat.wait) {
+            ret = pthread_mutex_unlock(&m_lock);
+            if (ret != RETURN_SUCCESS) {
+                LOGE("pthread_mutex_unlock fail, ret: 0x%x", ret);
+            }
+            return;
+        }
+        m_stat.wait = true;
+    }
+    ret = pthread_mutex_unlock(&m_lock);
+    if (ret != RETURN_SUCCESS) {
+        LOGE("pthread_mutex_unlock fail, ret: 0x%x", ret);
+    }
+}
+
+void ThreadHandler::Resume()
+{
+    int32_t ret = pthread_mutex_lock(&m_lock);
+    if (ret != RETURN_SUCCESS) {
+        LOGE("pthread_mutex_lock fail, ret: 0x%x", ret);
+    }
+
+    if(!m_stat.exit) {
+        if (m_stat.wait) {
+            ret = pthread_mutex_unlock(&m_lock);
+            if (ret != RETURN_SUCCESS) {
+                LOGE("pthread_mutex_unlock fail, ret: 0x%x", ret);
+            }
+            return;
+        }
+        m_stat.wait = false;
+        ret = pthread_cond_signal(&m_cond);
+        if (ret != RETURN_SUCCESS) {
+            LOGE("pthread_cond_signal fail, ret: 0x%x", ret);
+        }
+    }
+    ret = pthread_mutex_unlock(&m_lock);
+    if (ret != RETURN_SUCCESS) {
+        LOGE("pthread_mutex_unlock fail, ret: 0x%x", ret);
+    }
+}
+
+void *ThreadHandler::Loop(void *arg)
+{
+    auto *ptr = reinterpret_cast<ThreadHandler *>(arg);
+
+    prctl(PR_SET_NAME, ptr->m_threadName.c_str());
+
+    while (!ptr->m_stat.exit) {
+        ptr->Task();
+    }
+
+    if (ptr->m_curEvt != nullptr) {
+        ptr->m_curEvt->OnThreadHandlerExit(ptr);
+    }
+    return nullptr;
+}
+
+void ThreadHandler::Task()
+{
+    int32_t ret = pthread_mutex_lock(&m_lock);
+    if (ret != RETURN_SUCCESS) {
+        LOGE("pthread_mutex_lock fail, ret: 0x%x", ret);
+    }
+
+    while (m_stat.wait) {
+        ret = pthread_cond_wait(&m_cond, &m_lock);
+        if (ret != RETURN_SUCCESS) {
+            LOGE("pthread_cond_wait fail, ret: 0x%x", ret);
+        }
+    }
+
+    if (m_stat.exit) {
+        ret = pthread_mutex_unlock(&m_lock);
+        if (ret != RETURN_SUCCESS) {
+            LOGE("pthread_mutex_unlock fail, ret: 0x%x", ret);
+        }
+        return;
+    }
+
+    m_stat.wait = m_stat.once;
+    ret = pthread_mutex_unlock(&m_lock);
+    if (ret != RETURN_SUCCESS) {
+        LOGE("pthread_mutex_unlock fail, ret: 0x%x", ret);
+    }
+
+    if (m_threadFunc == nullptr) {
+        return Run(m_arg);
+    }
+    return m_threadFunc(m_arg);
+}
+
+void ThreadHandler::SetName(std::string threadName)
+{
+    m_threadName = std::move(threadName);
+}
