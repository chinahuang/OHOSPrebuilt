+int32_t AudioHal::SetAVCThreshold(const int32_t avcThreshold)
+{
+    if ((!m_isInit) && (Init() != RETURN_SUCCESS)) {
+        LOGE("Snd has not initialized.");
+        return RETURN_FAILURE;
+    }
+
+    uapi_snd_avc_attr avcAttr;
+    errno_t rc = memset_s(&avcAttr, sizeof(avcAttr), 0, sizeof(avcAttr));
+    if (rc != EOK) {
+        LOGE("memset_s_func failed, rc = %d", rc);
+        return RETURN_FAILURE;
+    }
+
+    int32_t ret = uapi_snd_get_avc_attr(UAPI_SND_0, &avcAttr);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_snd_get_avc_attr fail, ret=%d", ret);
+        return RETURN_FAILURE;
+    }
+    avcAttr.threshold_level = avcThreshold;
+
+    ret = uapi_snd_set_avc_attr(UAPI_SND_0, &avcAttr);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_snd_set_avc_attr fail, ret=%d, avcAttr.threshold_level=%d", ret, avcAttr.threshold_level);
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
