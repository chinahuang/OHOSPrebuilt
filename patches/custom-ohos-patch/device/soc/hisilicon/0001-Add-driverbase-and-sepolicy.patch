+int32_t AudioDecoderHal::RegisterAllCodecLib(bool loadLibState[], uint32_t length)
+{
+    if(Check() != RETURN_SUCCESS) {
+        LOGE("check failed");
+        return RETURN_FAILURE;
+    }
+    if(length > AUDIO_CODEC_LIB_BUTT || loadLibState == nullptr) {
+        LOGE("the array length is too large or loadLibState is null");
+        return RETURN_FAILURE;
+    }
+    for(uint32_t i=0; i < length; i++) {
+        int32_t ret = RegisterAcodecLib(m_audioCodecLibNames[i]);
+        loadLibState[i] = (ret == RETURN_SUCCESS);
+        if(!loadLibState[i]) {
+            LOGI("some audio decode lib[%u] NOT found. you may NOT able to decode some audio type!!!", i);
+        }
+    }
+    return RETURN_SUCCESS;
+}
