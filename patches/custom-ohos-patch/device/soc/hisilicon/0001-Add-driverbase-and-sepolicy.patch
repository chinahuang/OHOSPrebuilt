+    uapiPicColor.color_gamut.primary_g.cie_y = colorManageParam.colorGamutParam.primaryG.y;
+    uapiPicColor.color_gamut.primary_b.cie_x = colorManageParam.colorGamutParam.primaryB.x;
+    uapiPicColor.color_gamut.primary_b.cie_y = colorManageParam.colorGamutParam.primaryB.y;
+    uapiPicColor.white_point.enable = colorManageParam.whitePointParam.isEnable ? TD_TRUE : TD_FALSE;
+    uapiPicColor.color_gamut.primary_r.cie_x = colorManageParam.colorGamutParam.primaryR.x;
+    uapiPicColor.color_gamut.primary_r.cie_y = colorManageParam.colorGamutParam.primaryR.y;
