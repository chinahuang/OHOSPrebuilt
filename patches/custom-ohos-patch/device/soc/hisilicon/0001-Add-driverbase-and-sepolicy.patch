+{
+	if (Check() != RETURN_SUCCESS) {
+		LOGE("Check failed");
+		return HDR_TYPE_SDR;
+	}
+
+	uapi_hdr_type uapiHdrType = UAPI_HDR_TYPE_MAX;
+	uapi_win_handle_info winInfo{};
+
+	int32_t ret = uapi_win_get_handle_info(GetDispID(), &winInfo);
+	if (ret != TD_SUCCESS) {
+		LOGE("get play window failed");
+		return HDR_TYPE_SDR;
+	}
+
+	if (winInfo.main_handle == TD_INVALID_HANDLE) {
+		LOGE("window is invalid");
+		return HDR_TYPE_SDR;
+	}
+
+	ret = uapi_win_get_hdr_type(winInfo.main_handle, &uapiHdrType);
+	if (ret != TD_SUCCESS) {
+		LOGE("get hdr type faild");
+		return HDR_TYPE_SDR;
+	}
+
+	auto it = HDR_MAP.find(uapiHdrType);
+	if (it == HDR_MAP.end()) {
+		LOGE("can not match hdr type");
+		return HDR_TYPE_SDR;
+	}
+
+	return it->second;
+}
+
+int32_t VideoOutputHal::SetVrrEnable(bool Vrr_isEnable)
+{
+	if (Check() != RETURN_SUCCESS) {
+		LOGE("Check failed");
+		return RETURN_FAILURE;
+	}
+
+	td_bool enable = Vrr_isEnable ? TD_TRUE : TD_FALSE;
+/*
+        uapi_disp_vrr vrr_attr;
+        vrr_attr.enable = Vrr_isEnable ? TD_TRUE : TD_FALSE;
+	td_s32 ret = DisplayHal::GetDisplayHal(GetDispID())->GetDisplayCapabilities(vrr_attr.vrr_min, vrr_attr.vrr_max);
+	if (ret != TD_SUCCESS) {
+		LOGE("GetDisplayCapabilities failed");
+		return RETURN_FAILURE;
+	}
+*/
+	td_s32 ret = uapi_disp_set_vrr_enable(DISP_PORT, enable);
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("set vrr failed");
+        return RETURN_FAILURE;
+    }
+	return RETURN_SUCCESS;
+}
+
+int32_t VideoOutputHal::SetAllmEnable(bool Allm_isEnable)
+{
+	if (Check() != RETURN_SUCCESS) {
+		LOGE("Check failed");
+		return RETURN_FAILURE;
+	}
+/*
+    td_s32 ret = uapi_disp_set_allm(DISP_PORT, Allm_isEnable ? TD_TRUE : TD_FALSE);
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("set allm status failed");
+        return RETURN_FAILURE;
+    }
+*/
+	return RETURN_SUCCESS;
+}
+
+uapi_disp_color_space VideoOutputHal::ConvertDispColorSpaceType(DispColorSpaceType dispColorSpaceType)
+{
+	switch (dispColorSpaceType) {
+		case DISP_COLOR_SPACE_BT601:
+			return UAPI_DISP_COLOR_SPACE_BT601;
+		case DISP_COLOR_SPACE_BT709:
+			return UAPI_DISP_COLOR_SPACE_BT709;
+		case DISP_COLOR_SPACE_BT2020:
+			return UAPI_DISP_COLOR_SPACE_BT2020;
+		default:
+			return UAPI_DISP_COLOR_SPACE_MAX;
+	}
+}
+
+
+int32_t VideoOutputHal::SetDispColorSpace(DispColorSpaceType dispColorSpaceType)
+{
+	DisplayHal *displayHal = DisplayHal::GetDisplayHal(GetDispID());
+	if (displayHal == nullptr) {
+		return RETURN_FAILURE;
+	}
+
+	return displayHal->SetDispColorSpace(ConvertDispColorSpaceType(dispColorSpaceType));
+}
+
+uapi_disp VideoOutputHal::GetDispID()
+{
+	std::string surportHDMI = OHOS::system::GetParameter("hdi.hdmi.enabled", "false");
+    LOGI("GetDispID=%s", surportHDMI.c_str());
+    if (surportHDMI == "true") {
+        return UAPI_DISPLAY1;
+    } else {
+        return UAPI_DISPLAY0;
+    }
+}
