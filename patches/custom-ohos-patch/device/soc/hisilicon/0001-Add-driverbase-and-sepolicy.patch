+int32_t AmpHal::AmpInit()
+{
+    std::lock_guard<std::mutex> lg(m_mutex);
+    if(m_ampFd < 0){
+
+        m_ampFd = open(AMP_DEVICE_NAME.c_str(), O_RDWR, 0);
+        if(m_ampFd < 0) {
+            LOGE("open %s error. m_ampFd:0x%x", AMP_DEVICE_NAME.c_str(), m_ampFd);
+            return RETURN_FAILURE;
+        }
+    }
+
+    if(!m_isAmpInit){
+        int32_t ret = ioctl(m_ampFd, CMD_AMP_INIT);
+        if(ret != 0){
+            LOGE("AmpHal init amp failed. ret:0x%x", ret);
+            return RETURN_FAILURE;
+        }
+
+        m_isAmpInit = true;
+    }
+
+    return RETURN_SUCCESS;
+}
+
+void AmpHal::AmpDeInit()
+{
+    std::lock_guard<std::mutex> lg(m_mutex);
+    if (m_ampFd >= 0) {
+
+        if(close(m_ampFd) < 0){
+
+            LOGE("AmpDeInit close fd: %d error: %d", m_ampFd, errno);
+        } else {
+
+            m_ampFd = AMP_INVALID_HANDLE;
+        }
+    }
+}
+
+int32_t AmpHal::GetAmpFd()
+{
+    if(m_isAmpInit && m_ampFd >= 0) {
+
+        return m_ampFd;
+    }
+
+    if(AmpInit() != RETURN_SUCCESS) {
+
+        LOGE("amp hal interfaces initialized failed.");
+        return AMP_INVALID_HANDLE;
+    }
+
+    return m_ampFd;
+}
+
+int32_t AmpHal::SetMute(bool isMute)
+{
+    int32_t fd = GetAmpFd();
+    if (fd == AMP_INVALID_HANDLE) {
+        return RETURN_FAILURE;
+    }
+    int32_t ret = ioctl(fd, CMD_AMP_SETMUTE, &isMute);
+    if (ret != 0) {
+        LOGE("AmpHal ioctl set %s failed. ret:0x%x", isMute ? "mute" : "unmute", ret);
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
+
