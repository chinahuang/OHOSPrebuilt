+RxCecCtrlHal::RxCecCtrlHal()
+{
+    LOGI("construct");
+}
+
+RxCecCtrlHal::~RxCecCtrlHal()
+{
+    LOGI("deconstruct");
+    static_cast<void>(DeInit());
+    static_cast<void>(PmocDeInit());
+}
+
+int32_t RxCecCtrlHal::Init()
+{
+    LOGI("RxCecCtrlHal Init.");
+    lock_guard<mutex> lock(m_lock);
+    if(m_isInited)
+    {
+        return RETURN_SUCCESS;
+    }
+
+    int32_t ret = uapi_hdmirx_init();
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("uapi_hdmirx_init failed! ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    m_isInited = true;
+
+    return RETURN_SUCCESS;
+}
+
+int32_t RxCecCtrlHal::DeInit()
+{
+    LOGI("RxCecCtrlHal DeInit.");
+    lock_guard<mutex> lock(m_lock);
+    if(!m_isInited)
+    {
+        return RETURN_SUCCESS;
+    }
+
+    int32_t ret = uapi_hdmirx_deinit();
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("uapi_hdmirx_deinit failed! ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+
+    m_isInited = false;
+    return RETURN_SUCCESS;
+}
+
+int32_t RxCecCtrlHal::PmocInit()
+{
+    LOGI("PmocInit");
+    lock_guard<mutex> lock(m_pmocLock);
+    if(m_pmocInit)
+    {
+        return RETURN_SUCCESS;
+    }
+
+    int32_t ret = uapi_pmoc_init();
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("uapi_pmoc_init failed! ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+
+    m_pmocInit = true;
+    return RETURN_SUCCESS;
+}
+
+int32_t RxCecCtrlHal::PmocDeInit()
+{
+    LOGI("PmocDeInit");
+    lock_guard<mutex> lock(m_pmocLock);
+    if(!m_pmocInit)
+    {
+        return RETURN_SUCCESS;
+    }
+    m_pmocInit = false;
+
+    return RETURN_SUCCESS;
+}
+
+int32_t RxCecCtrlHal::Enable(bool enable)
+{
+    if((!m_isInited) && (Init() != RETURN_SUCCESS))
+    {
+        LOGI("hdmirx is not init");
+        return RETURN_FAILURE;
+    }
+
+    LOGE("set cec enable:%d", enable);
+    td_bool isEnable = enable ? TD_TRUE : TD_FALSE;
+    int32_t ret = uapi_hdmirx_cec_enable(isEnable);
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("cec enable:%d failed, ret:0x%x", enable, ret);
+        return RETURN_FAILURE;
+    }
+    m_sendCmdEnable = enable;
+
+    return RETURN_SUCCESS;
+}
+
+void RxCecCtrlHal::PrintCecMsg(const CecCmd &cecCmd, uint32_t count) const
+{
+    std::stringstream ss;
+    ss << GetCecLogAddrName(cecCmd.srcAddr) << "->" << GetCecLogAddrName(cecCmd.dstAddr);
+    ss << ",op:[0x" << std::hex << cecCmd.opcode << "] " << GetCecOpCodeName(cecCmd.opcode);
+    if(cecCmd.operand.argCount != 0)
+    {
+        ss << "arg:" << std::dec << cecCmd.operand.argCount << ",";
+        for(uint32_t i = 0; i < cecCmd.operand.argCount; i++)
+        {
+            ss << " 0x" << std::hex << cecCmd.operand.args[i];
+        }
+    }
+
+    if(count != 0)
+    {
+        ss << ",getCnt" << std::dec << count;
+    }
+
+    if(cecCmd.opcode == CEC_OPCODE_SEND_PING || cecCmd.opcode == CEC_OPCODE_GIVE_AUDIO_STATUS)
+    {
+        LOGI("%s", ss.str().c_str());
+    }
+    else
+    {
+        LOGI("%s", ss.str().c_str());
+    }
+}
+
+int32_t RxCecCtrlHal::SetCommand(CecCmd &cecCmd)
+{
+    if((!m_isInited) && (Init() != RETURN_SUCCESS))
+    {
+        LOGE("hdmirx is not init");
+        return RETURN_FAILURE;
+    }
+
+    lock_guard<mutex> lg(m_setCommandMtx);
+    cecCmd.srcAddr = CEC_LOGADDR_TV;
+
+    if(!m_sendCmdEnable)
+    {
+        LOGE("cec enable status:%d, can not send cec command[%s -> %s, OpCode:[0x%x] %s], need enable hdmi cec",m_sendCmdEnable, GetCecLogAddrName(cecCmd.srcAddr).c_str(), GetCecLogAddrName(cecCmd.dstAddr).c_str(), cecCmd.opcode, GetCecOpCodeName(cecCmd.opcode).c_str());
+        if(Enable(true) != RETURN_SUCCESS)
+        {
+            return RETURN_FAILURE;
+        }
+    }
+
+    uapi_cec_msg cecMsg{};
+    cecMsg.src_addr = cecCmd.srcAddr;
+    cecMsg.dst_addr = cecCmd.dstAddr;
+    cecMsg.opcode = static_cast<uapi_cec_opcode>(cecCmd.opcode);
+    cecMsg.operand.len = cecCmd.operand.argCount;
+
+    for(int32_t i = 0; i < UAPI_CEC_MAX_OPERAND_SIZE; ++i)
+    {
+        cecMsg.operand.data[i] = cecCmd.operand.args[i];
+    }
+
+    int32_t ret = uapi_hdmirx_cec_send_msg(&cecMsg);
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("CEC SetCommand failure. ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+
+    uint32_t count = 0;
+    for(; count < CEC_CMD_STATE_CNT; count++)
+    {
+        ret = uapi_hdmirx_cec_get_cur_msg_state(reinterpret_cast<uapi_hdmirx_cec_status *>(&m_cmdTxState));
+        if(ret != TD_SUCCESS)
+        {
+            usleep(GET_MSG_INTERVAL_TIME);
+        }
+        else
+        {
+            break;
+        }
+    }
+    if(count >= CEC_LINE_BUSY_CNT)
+    {
+        LOGW("Big count = %u indicate the CEC line is not idle!", count);
+    }
+
+    PrintCecMsg(cecCmd, count);
+
+    return RETURN_SUCCESS;
+}
+
+int32_t RxCecCtrlHal::GetCommand(CecCmd &cecCmd)
+{
+    if((!m_isInited) && (Init() != RETURN_SUCCESS))
+    {
+        LOGE("hdmirx is not init");
+        return RETURN_FAILURE;
+    }
+
+    uapi_cec_msg cecMsg{};
+    int32_t ret = uapi_hdmirx_cec_receive_msg(&cecMsg);
+    if(ret != TD_SUCCESS)
+    {
+        return RETURN_FAILURE;
+    }
+
+    cecCmd.srcAddr = static_cast<CecLogicalAddr>(cecMsg.src_addr);
+    cecCmd.dstAddr = static_cast<CecLogicalAddr>(cecMsg.dst_addr);
+    cecCmd.opcode = static_cast<CecOpcode>(cecMsg.opcode);
+    cecCmd.operand.argCount = cecMsg.operand.len;
+    for(int32_t i = 0; i < UAPI_CEC_MAX_OPERAND_SIZE; ++i)
+    {
+        cecCmd.operand.args[i] = cecMsg.operand.data[i];
+    }
+
+    PrintCecMsg(cecCmd, 0);
+
+    return RETURN_SUCCESS;
+}
+
+int32_t RxCecCtrlHal::GetCurCmdState(HdmiRxCecCmdState &cmdTxState)
+{
+    cmdTxState = m_cmdTxState;
+    return RETURN_SUCCESS;
+}
