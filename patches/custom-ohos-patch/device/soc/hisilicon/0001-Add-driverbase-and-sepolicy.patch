+    }
+
+    int32_t ret = ioctl(fd, CMD_AMP_GETMUTE, &isMute);
+    if(ret != 0) {
+
+        LOGE("AmpHal ioctl GetMute failed. ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
