diff --git a/common/driverbase/hal/HdcpEdidHal.cpp b/common/driverbase/hal/HdcpEdidHal.cpp
new file mode 100644
index 0000000..c99c9bf
--- /dev/null
+++ b/common/driverbase/hal/HdcpEdidHal.cpp
@@ -0,0 +1,312 @@
+#define LOG_NDEBUG 0
+#define LOG_TAG "HdcpEdidHal"
+
+#include "HdcpEdidHal.h"
+#include <unordered_map>
+// #include <oeminfo.h>
+#include "CommonDef.h"
+#include "ConfigFactory.h"
+
+struct HdcpStoreV2 {
+    uint32_t magicV2;
+    uint32_t hdcpV14KeyLen;
+    uint32_t hdcpV22KeyLen;
+    uint8_t hdcpV14KeyData[HdcpEdidHal::HDCP_14_MAX_LENGTH_V2];
+    uint8_t hdcpV22KeyData[HdcpEdidHal::HDCP_22_MAX_LENGTH_V2];
+} __attribute__((packed));
+
+HdcpEdidHal &GetHdcpEdidHal()
+{
+    return HdcpEdidHal::GetInstance();
+}
+
+HdcpEdidHal &HdcpEdidHal::GetInstance()
+{
+    static HdcpEdidHal hdcpEdidHal;
+    return hdcpEdidHal;
+}
+
+HdcpEdidHal::HdcpEdidHal()
+{
+    LOGI("construct");
+}
+
+HdcpEdidHal::~HdcpEdidHal()
+{
+    LOGI("deconstruct");
+    DeInit();
+}
+int32_t HdcpEdidHal::UpdateHdcp(HdmiRxHdcpType hdcpType)
+{
+    if (CheckInit() != RETURN_SUCCESS) {
+        LOGE("check init failed");
+        return RETURN_FAILURE;
+    }
+    HdcpStoreV2 hdcpStoreV2{};
+   //  int32_t ret = rmt_oeminfo_read(OEMINFO_CASTHDCP, sizeof(HdcpStoreV2), reinterpret_cast<uint8_t *>(&hdcpStoreV2));
+    /* if (ret != 0) {
+        LOGE("rmt_oeminfo_read error! ret=0x%x", ret);
+        return RETURN_FAILURE;
+    } */
+    if (hdcpStoreV2.magicV2 != HDCP_MAGIC_V2) {
+        LOGE("Read hdcpStoreV2 magicV2 error!");
+        return RETURN_FAILURE;
+    }
+    uapi_hdmirx_hdcp hdcp{};
+    if (hdcpType == HDMIRX_HDCP_TYPE_14) {
+        hdcp.hdcp_length = hdcpStoreV2.hdcpV14KeyLen;
+        hdcp.hdcp_data = hdcpStoreV2.hdcpV14KeyData;
+        LOGI("hdcpV14KeyLen = %u, hdcpV14KeyData[0] = %u, hdcpV14KeyData[len - 1] = %u", hdcp.hdcp_length,
+        hdcp.hdcp_data[0], hdcp.hdcp_data[hdcp.hdcp_length - 1]);
+    } else if (hdcpType == HDMIRX_HDCP_TYPE_22) {
+        hdcp.hdcp_length = hdcpStoreV2.hdcpV22KeyLen;
+        hdcp.hdcp_data = hdcpStoreV2.hdcpV22KeyData;
+        LOGI("hdcpV22KeyLen = %u, hdcpV22KeyData[0] = %u, hdcpV22KeyData[len - 1] = %u", hdcp.hdcp_length,
+            hdcp.hdcp_data[0], hdcp.hdcp_data[hdcp.hdcp_length - 1]);
+    }
+    for (uint32_t i = UAPI_HDMIRX_PORT0; i < UAPI_HDMIRX_PORT_MAX; i++) {
+        int32_t ret = uapi_hdmirx_load_hdcp(static_cast<uapi_hdmirx_port>(i), ConvertHdmiRxHdcpType(hdcpType), &hdcp);
+        if (ret != TD_SUCCESS) {
+            LOGE("uapi_hdmirx_load_hdcp fail, port[%u], hdcpType[%d], ret:0x%x", i , hdcpType, ret);
+             return RETURN_FAILURE;
+        }
+    }
+    return RETURN_SUCCESS;
+}
+
+int32_t HdcpEdidHal::InitEdid(HdmiRxEdidData &hdmiRxEdidData)
+{
+    if (CheckInit() != RETURN_SUCCESS) {
+        LOGE("check init failed");
+        return RETURN_FAILURE;
+    }
+    HdmiRxEdidCap edidCap = HDMIRX_EDID_CAP_BUTT;
+    int32_t ret = GetEdidCap(hdmiRxEdidData.edid14.port, edidCap);
+    if (ret != RETURN_SUCCESS) {
+        LOGE("getEdidCap fail, port:%d, ret:0x%x", hdmiRxEdidData.edid14.port, ret);
+        return RETURN_FAILURE;
+    }
+    
+    uint8_t edid[UAPI_HDMIRX_VER_MAX][HDMIRX_EDID_LENGTH] = {};
+    for (uint32_t j = 0; j < HDMIRX_EDID_LENGTH; j++) {
+        edid[HDMIRX_EDID_CAP_14][j] = hdmiRxEdidData.edid14.edidValue[j] & 0xff;
+        edid[HDMIRX_EDID_CAP_20][j] = hdmiRxEdidData.edid20.edidValue[j] & 0xff;
+        edid[HDMIRX_EDID_CAP_21][j] = hdmiRxEdidData.edid21.edidValue[j] & 0xff;
+    }
+
+    bool isEdid21Support = ConfigFactory::Get().ParseBoolean("databasedef:HDMIRXEdid_21_Support");
+    if (edidCap < HDMIRX_EDID_CAP_21 || !isEdid21Support) {
+        return InitEdidCap20(edid, hdmiRxEdidData);
+    } else {
+        return InitEdidCap21(edid, hdmiRxEdidData);
+    }
+}
+
+int32_t HdcpEdidHal::ResumeHdcp()
+{
+    if (CheckInit() != RETURN_SUCCESS) {
+        LOGE("check init failed");
+        return RETURN_FAILURE;
+    }
+    int32_t update14Ret = UpdateHdcp(HDMIRX_HDCP_TYPE_14);
+    if (update14Ret != RETURN_SUCCESS) {
+        LOGE("hdcp 1.4 update failed");
+    }
+    int32_t update22Ret = UpdateHdcp(HDMIRX_HDCP_TYPE_22);
+    if (update22Ret != RETURN_SUCCESS) {
+        LOGE("hdcp 2.2 update failed");
+    }
+    if (update14Ret != RETURN_SUCCESS || update22Ret != RETURN_SUCCESS) {
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
+
+int32_t HdcpEdidHal::UpdateEdid([[maybe_unused]]HdmiRxEdid &edid)
+{
+    LOGI("no need to update edid.");
+    return RETURN_SUCCESS;
+}
+
+int32_t HdcpEdidHal::SetEdidMode(HdmiRxPort port, HdmiRxEdidType mode)
+{
+    if (CheckInit() != RETURN_SUCCESS) {
+        LOGE("check hdmirx init failed");
+        return RETURN_FAILURE;
+    }
+    uapi_hdmirx_port unfPort = ConvertHdmiRxPort(port);
+    HdmiRxEdidType edidType = (HdmiRxEdidType)(0);
+    uapi_hdmirx_edid_mode edidMode = ConvertHdmiRxEdidMode(edidType);
+    td_s32 ret = uapi_hdmirx_set_edid_mode(unfPort, edidMode);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_hdmirx_set_edid_mode failed! unfPort:%d, unfEdidMode:%d, ret:0x%x", unfPort, edidMode, ret);
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
+
+int32_t HdcpEdidHal::CheckInit()
+{
+    if (m_init) {
+        return RETURN_SUCCESS;
+    }
+    return Init();
+}
+
+int32_t HdcpEdidHal::Init()
+{
+    std::lock_guard<std::mutex> lock(m_lock);
+    if (m_init) {
+        return RETURN_SUCCESS;
+    }
+    td_s32 ret = uapi_hdmirx_init();
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_hdmirx_init failed! Ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    m_init = true;
+    return RETURN_SUCCESS;
+}
+
+int32_t HdcpEdidHal::DeInit()
+{
+    std::lock_guard<std::mutex> lock(m_lock);
+    if (!m_init) {
+        return RETURN_SUCCESS;
+    }
+    td_s32 ret = uapi_hdmirx_deinit();
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_hdmirx_init failed! Ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    m_init = false;
+    return RETURN_SUCCESS;
+}
+
+int32_t HdcpEdidHal::GetEdidCap(HdmiRxPort port, HdmiRxEdidCap &capability)
+{
+    if (CheckInit() != RETURN_SUCCESS) {
+        LOGE("check init failed");
+        return RETURN_FAILURE;
+    }
+    uapi_hdmirx_capability capInfo = {};
+    td_s32 ret = uapi_hdmirx_get_capability(&capInfo);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_hdmirx_get_capability failed! Ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    capability = HdmiRxVersionToEdidCap(capInfo.caps[port].ver);
+    if (capability == HDMIRX_EDID_CAP_BUTT) {
+        LOGE("convert version to edidCap failed, version[%d]", capInfo.caps[port].ver);
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
+
+int32_t HdcpEdidHal::InitEdidCap20(uint8_t (&edid)[UAPI_HDMIRX_VER_MAX][HDMIRX_EDID_LENGTH],
+    HdmiRxEdidData &hdmiRxEdidData) const
+{
+    uapi_hdmirx_edid edidInfo[UAPI_HDMIRX_VER_21] = {};
+    edidInfo[HDMIRX_EDID_CAP_14].edid_length = hdmiRxEdidData.edid14.edidLength;
+    edidInfo[HDMIRX_EDID_CAP_20].edid_length = hdmiRxEdidData.edid20.edidLength;
+
+    edidInfo[HDMIRX_EDID_CAP_14].edid = edid[HDMIRX_EDID_CAP_14];
+    edidInfo[HDMIRX_EDID_CAP_20].edid = edid[HDMIRX_EDID_CAP_20];
+
+    edidInfo[HDMIRX_EDID_CAP_14].cec_addr = hdmiRxEdidData.edid14.cecAddr;
+    edidInfo[HDMIRX_EDID_CAP_20].cec_addr = hdmiRxEdidData.edid20.cecAddr;
+
+    int32_t ret = uapi_hdmirx_init_edid(ConvertHdmiRxPort(hdmiRxEdidData.edid14.port), edidInfo, UAPI_HDMIRX_VER_21);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_hdmirx_init_edid fail, cnt:%d, ret:0x%x", UAPI_HDMIRX_VER_21, ret);
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
+
+int32_t HdcpEdidHal::InitEdidCap21(uint8_t (&edid)[UAPI_HDMIRX_VER_MAX][HDMIRX_EDID_LENGTH],
+HdmiRxEdidData &hdmiRxEdidData) const
+{
+    uapi_hdmirx_edid edidInfo[UAPI_HDMIRX_VER_MAX] = {};
+    edidInfo[HDMIRX_EDID_CAP_14].edid_length = hdmiRxEdidData.edid14.edidLength;
+    edidInfo[HDMIRX_EDID_CAP_20].edid_length = hdmiRxEdidData.edid20.edidLength;
+    edidInfo[HDMIRX_EDID_CAP_21].edid_length = hdmiRxEdidData.edid21.edidLength;
+
+    edidInfo[HDMIRX_EDID_CAP_14].edid = edid[HDMIRX_EDID_CAP_14];
+    edidInfo[HDMIRX_EDID_CAP_20].edid = edid[HDMIRX_EDID_CAP_20];
+    edidInfo[HDMIRX_EDID_CAP_21].edid = edid[HDMIRX_EDID_CAP_21];
+
+    edidInfo[HDMIRX_EDID_CAP_14].cec_addr = hdmiRxEdidData.edid14.cecAddr;
+    edidInfo[HDMIRX_EDID_CAP_20].cec_addr = hdmiRxEdidData.edid20.cecAddr;
+    edidInfo[HDMIRX_EDID_CAP_21].cec_addr =  hdmiRxEdidData.edid21.cecAddr;
+
+    int32_t ret = uapi_hdmirx_init_edid(ConvertHdmiRxPort(hdmiRxEdidData.edid14.port), edidInfo, UAPI_HDMIRX_VER_MAX);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_hdmirx_init_edid fail, Cnt:%d, ret:0x%x", UAPI_HDMIRX_VER_MAX, ret);
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
+
+HdmiRxEdidCap HdcpEdidHal::HdmiRxVersionToEdidCap(uapi_hdmirx_ver version)
+{
+    static const std::unordered_map<uapi_hdmirx_ver, HdmiRxEdidCap> convertMap {
+        {UAPI_HDMIRX_VER_14, HDMIRX_EDID_CAP_14},
+        {UAPI_HDMIRX_VER_20, HDMIRX_EDID_CAP_20},
+        {UAPI_HDMIRX_VER_21, HDMIRX_EDID_CAP_21}
+    };
+    auto item = convertMap.find(version); 
+    if (item == convertMap.end()) {
+        LOGE("invalid param version[%d]", version);
+        return HDMIRX_EDID_CAP_BUTT;
+    }
+    return item->second;
+}
+
+uapi_hdmirx_port HdcpEdidHal::ConvertHdmiRxPort(HdmiRxPort port) const
+{
+    static const std::unordered_map<HdmiRxPort, uapi_hdmirx_port> convertMap {
+        {HDMIRX_PORT0, UAPI_HDMIRX_PORT0},
+        {HDMIRX_PORT1, UAPI_HDMIRX_PORT1},
+        {HDMIRX_PORT2, UAPI_HDMIRX_PORT2},
+        {HDMIRX_PORT3, UAPI_HDMIRX_PORT3}
+    };
+    auto item = convertMap.find(port);
+    if (item == convertMap.end()) {
+        LOGE("invalid hdmirx param port[%d]", port);
+        return UAPI_HDMIRX_PORT_MAX;
+    }
+    return item->second;
+}
+
+uapi_hdmirx_hdcp_ver HdcpEdidHal::ConvertHdmiRxHdcpType(HdmiRxHdcpType hdcpType) const
+{
+    switch (hdcpType) {
+        case HDMIRX_HDCP_TYPE_14:
+            return UAPI_HDMIRX_HDCP_VER_1X;
+        case HDMIRX_HDCP_TYPE_22:
+            return UAPI_HDMIRX_HDCP_VER_2X;
+        default:
+            LOGE("invalid hdmirx hdcp type[%d]", hdcpType);
+    }
+    return UAPI_HDMIRX_HDCP_VER_MAX;
+}
+
+
+uapi_hdmirx_edid_mode HdcpEdidHal::ConvertHdmiRxEdidMode(HdmiRxEdidType edidType) const
+{
+    static const std::unordered_map<HdmiRxEdidType, uapi_hdmirx_edid_mode> convertMap{
+        {HDMIRX_EDID_TYPE_AUTO, UAPI_HDMIRX_EDID_MODE_AUTO},
+        {HDMIRX_EDID_TYPE_14, UAPI_HDMIRX_EDID_MODE_14},
+        {HDMIRX_EDID_TYPE_20, UAPI_HDMIRX_EDID_MODE_20},
+        {HDMIRX_EDID_TYPE_21, UAPI_HDMIRX_EDID_MODE_21},
+        {HDMIRX_EDID_TYPE_21_VRR_FSY, UAPI_HDMIRX_EDID_MODE_21},
+    };
+
+    auto item = convertMap.find(edidType);
+    if (item == convertMap.end()) {
+        return UAPI_HDMIRX_EDID_MODE_MAX;
+    }
+    return item->second;
+}
+
diff --git a/common/driverbase/hal/HdmiAudioControllerHal.cpp b/common/driverbase/hal/HdmiAudioControllerHal.cpp
