+int32_t PanelHal::GetBinVersionInfo(std::string &version)
+{
+    if ((!m_isInit) && (Init() != RETURN_SUCCESS)) {
+        LOGE("Panel has not initialized.");
+        return RETURN_FAILURE;
+    }
+
+    uapi_panel_name name = {};
+    uapi_pdm_disp_param disp_param_data = {};
+
+    int32_t ret = uapi_pdm_get_disp_param(UAPI_DISPLAY0, &disp_param_data);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_pdm_get_disp_param call failed! ret=0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    
+    if (disp_param_data.intf[UAPI_DISP_INTF_TYPE_PANEL].intf_type != UAPI_DISP_INTF_TYPE_PANEL) {
+        LOGE("panel not bind, please check");
+        return RETURN_FAILURE;
+    }
+    uapi_panel_id panel_id = (uapi_panel_id)disp_param_data.intf[UAPI_DISP_INTF_TYPE_PANEL].intf.panel;
+    
+    ret = uapi_panel_get_panel_name(panel_id, &name);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_panel_get_panel_name, ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    
+    if (name.name_size + 1 > PANEL_NAME_MAX_LEN) {
+        LOGE("string too large, str length:%d, buf length:%d", name.name_size, PANEL_NAME_MAX_LEN);
+        return RETURN_FAILURE;
+    }
+    name.panel_name[name.name_size] = '\0';
+    version = name.panel_name;
+
+    return RETURN_SUCCESS;
+}
