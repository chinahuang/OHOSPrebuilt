+void AudioInputHal::UpdateAttr(const AudioInputAttr &aiAttr)
+{
+    if (Check() != RETURN_SUCCESS)
+    {
+        LOGE("check failed");
+        return;
+    }
+
+    if(!aiAttr.isHdmiPlayer)
+    {
+        LOGI("not hdmi player");
+        return;
+    }
+
+    LOGD("m_attr changed");
+    m_attr.sample_rate = static_cast<uapi_audio_sample_rate>(aiAttr.sampleRate);
+    m_attr.attr.hdmi_attr.bit_depth = static_cast<uapi_audio_bit_depth>(aiAttr.bitDepth);
+    if(aiAttr.nChannel == I2S_CHNNUM_8 && aiAttr.dataFmt == HDMI_AUDIO_FMT_LPCM)
+    {
+        m_attr.attr.hdmi_attr.channels = UAPI_AUDIO_CHANNEL_2;
+    }
+    else
+    {
+        m_attr.attr.hdmi_attr.channels = static_cast<uapi_audio_channel>(aiAttr.nChannel);
+    }
+
+    if(!aiAttr.isPassThrough)
+    {
+        LOGI("[2.4.2] HDMI audio is not PassThough. The audio data format is LPCM");
+        m_attr.attr.hdmi_attr.data_format = UAPI_AUDIO_FORMAT_PCM;
+        m_attr.attr.hdmi_attr.data_type = UAPI_AUDIO_DATA_TYPE_LPCM;
+    }
+    else
+    {
+        LOGI("[2.4.2] HDMI audio is PassThough. The audio data type is %d", aiAttr.dataType);
+        if(aiAttr.dataFmt == HDMI_AUDIO_FMT_LPCM)
+        {
+            m_attr.attr.hdmi_attr.data_type = UAPI_AUDIO_DATA_TYPE_LPCM;
+        }
+        else if(aiAttr.dataFmt == HDMI_AUDIO_FMT_LBR)
+        {
+            m_attr.attr.hdmi_attr.data_type = UAPI_AUDIO_DATA_TYPE_LBR;
+        }
+        else if(aiAttr.dataFmt == HDMI_AUDIO_FMT_HBR)
+        {
+            m_attr.attr.hdmi_attr.data_type = UAPI_AUDIO_DATA_TYPE_HBR;
+        }
+        GetAudioFormatByType(aiAttr.dataType, m_attr);
+    }
+
+    if((aiAttr.dataFmt == HDMI_AUDIO_FMT_HBR) && (aiAttr.nChannel == I2S_CHNNUM_8))
+    {
+        m_attr.pcm_frame_max_num = (m_attr.pcm_frame_max_num > SND_FRAME_MAX) ? SND_FRAME_MAX : m_attr.pcm_frame_max_num;
+    }
+
+    LOGI("UpdateAttr sample_rate=0x%x, hdmi_attr.sample_rate=0x%x, hdmi_attr.channels=0x%x, hdmi_attr.data_format=0x%x, hdmi_attr.data_type=0x%x, u32PcmFrameMax=0x%x",
+        m_attr.sample_rate, m_attr.attr.hdmi_attr.sample_rate, m_attr.attr.hdmi_attr.channels, m_attr.attr.hdmi_attr.data_format, m_attr.attr.hdmi_attr.data_type, m_attr.pcm_frame_max_num);
+}
