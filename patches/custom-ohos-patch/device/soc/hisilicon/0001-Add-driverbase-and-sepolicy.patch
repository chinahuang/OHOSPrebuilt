+int32_t VideoOutputHal::GetWinAspectMode(WinAspectMode &aspectMode)
+{
+	std::vector <uint32_t> windows = GetCurWindowInfo();
+	if (windows.size() != 1) {
+		LOGE("not one window, not supported");
+		return RETURN_FAILURE;
+	}
+
+	if (Check() != RETURN_SUCCESS) {
+		LOGE("Check failed");
+		return RETURN_FAILURE;
+	}
+
+	uapi_win_aspect_mode winMode{};
+	uapi_win_aspect_attr winAttr{};
+	td_s32 ret = uapi_win_get_aspect_attr(windows.at(0), &winMode, &winAttr);
+	if (ret != TD_SUCCESS) {
+		LOGE("uapi_win_get_aspect_attr failed. window=0x%x ret=0x%x", windows.at(0), ret);
+		return RETURN_FAILURE;
+	}
+
+	LOGI("window=0x%x aspect mode=%d", windows.at(0), winMode);
+	aspectMode = ConvertWinAspectMode(winMode);
+
+	return RETURN_SUCCESS;
+}
