+int32_t PanelHal::SetBoostLevel(BoostType boostType, CommonLevel level)
+{
+    if (boostType == BOOST_TYPE_PWM || boostType == BOOST_TYPE_HYBRID) {
+        if ((m_customFd < 0) && (Init() != RETURN_SUCCESS)) {
+            LOGE("Custom has not initialized.");
+            return RETURN_FAILURE;
+        }
+        int32_t ret;
+        bool dynamicBlStatus = IsDynamicBlEnable();
+        if ((dynamicBlStatus) && (level == COMMON_LEVEL_OFF)) {
+            ret = SetDynamicBlEnable(!dynamicBlStatus);
+            if (ret != RETURN_SUCCESS) {
+                LOGE("SetDynamicBlEnable failed, ret: 0x%x.", ret);
+                return RETURN_FAILURE;
+            }
+        }
+        if ((!dynamicBlStatus) && (level > COMMON_LEVEL_OFF)) {
+            ret = SetDynamicBlEnable(!dynamicBlStatus);
+            if (ret != RETURN_SUCCESS) {
+                LOGE("SetDynamicBlEnable failed, ret: 0x%x.", ret);
+                return RETURN_FAILURE;
+            }
+        }
+        ret = ioctl(m_customFd, CUSTOM_CMD_SET_PWMBOOST_INDEX, &level);
+        if (ret != TD_SUCCESS) {
+            LOGE("SetBoostLevel failed, ret: 0x%x.", ret);
+            return RETURN_FAILURE;
+        }
+        LOGI("SetBoostLevel: %d success.", level);
+        return RETURN_SUCCESS;
+    }
+    return RETURN_FAILURE;
+}
