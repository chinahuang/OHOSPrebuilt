+
+std::mutex VideoDecoderCvbsHal::m_lock;
+
+VideoDecoderCvbsHal &VideoDecoderCvbsHal::GetInstance()
+{ 
+    static VideoDecoderCvbsHal videoDecoderCvbsHal;
+    return videoDecoderCvbsHal;
+}
+
+VideoDecoderCvbsHal::VideoDecoderCvbsHal()
+{
+    LOGI("construct");
+}
+
+VideoDecoderCvbsHal::~VideoDecoderCvbsHal()
+{
+    LOGI("destruct");
+    static_cast<void>(DeInit());
+}
+
+int32_t VideoDecoderCvbsHal::Init()
+{
+    std::lock_guard<std::mutex> lock(m_lock);
+    if(m_isInited)
+    {
+        return RETURN_SUCCESS;
+    }
+
+    int32_t ret = uapi_tvd_init();
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("uapi_tvd_init failed");
+        return RETURN_FAILURE;
+    }
+    m_isInited = true;
+    return RETURN_SUCCESS;
+}
+
+int32_t VideoDecoderCvbsHal::DeInit()
+{
+    std::lock_guard<std::mutex> lock(m_lock);
+    if(!m_isInited)
+    {
+        return RETURN_SUCCESS;
+    }
+
+    int32_t ret = uapi_tvd_deinit();
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("uapi_tvd_deinit failed");
+        return RETURN_FAILURE;
+    }
+    m_isInited = false;
+    return RETURN_SUCCESS;
+}
+
+int32_t VideoDecoderCvbsHal::Check()
+{
+    if(m_isInited)
+    {
+        return RETURN_SUCCESS;
+    }
+    return Init();
+}
+
+SignalStatus VideoDecoderCvbsHal::GetSignalStatus()
+{ 
+    if(Check() != RETURN_SUCCESS){
+        LOGE("Check failed");
+        return SIGNAL_BUTT;
+    }
+    uapi_sig_status status = UAPI_SIG_STATUS_MAX;
+    int32_t ret = uapi_tvd_get_signal_status(&status);
+    if(ret != TD_SUCCESS){
+        LOGE("uapi_get_sig_status failed.ret=0x%x", ret);
+        return SIGNAL_BUTT;
+    }
+    SignalStatus signalStatus = ConvertSignalStatus(status);
+    LOGI("signalStatus=[%d]",signalStatus);
+    return signalStatus;
+}
+
+int32_t VideoDecoderCvbsHal::Connect(SourceType source)
+{
+    if(Check() != RETURN_SUCCESS){
+        LOGE("Check failed");
+        return RETURN_FAILURE;
+    }
+
+    uapi_tvd_src_attr srcAttr{};
+    srcAttr.type = UAPI_VIDEO_SOURCE_CVBS;
+
+    int32_t port = 1;
+    if(VideoInputPortOrder::GetInstance().Get(source, port) == RETURN_SUCCESS){
+        LOGI("not set port map. source %d",source);
+    }
+    LOGI("cvbs source %d, port %d",source,port);
+    srcAttr.index = static_cast<uint32_t>(port);
+    int32_t ret = uapi_tvd_connect(&srcAttr);
+    if (ret != TD_SUCCESS){
+        LOGE("uapi_tvd_connect failed, ret=0x%x",ret);
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
+
+int32_t VideoDecoderCvbsHal::DisConnect()
+{
+    if(Check() != RETURN_SUCCESS){
+        LOGE("Check failed");
+        return RETURN_FAILURE;
+    }
+    int32_t ret = uapi_tvd_disconnect();
+    if(ret != TD_SUCCESS){
+        LOGE("uapi_tvd_disconnect failed, ret=0x%x",ret);
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
+
+int32_t VideoDecoderCvbsHal::AssembleViAttr(uapi_vi_attr &viAttr)
+{
+    uapi_tvd_timing_info timingInfo{};
+    int32_t ret = uapi_tvd_get_timing_info(&timingInfo);
+    if(ret != TD_SUCCESS){
+        LOGE("uapi_tvd_get_timing_info failed");
+        return RETURN_FAILURE;
+    }
+
+    uapi_color_sys colorSys = UAPI_COLOR_SYS_MAX;
+    ret = uapi_tvd_get_color_system(&colorSys);
+    if(ret != TD_SUCCESS){
+        LOGE("uapi_tvd_get_color_system failed");
+        return RETURN_FAILURE;
+    }
+
+    int32_t width = timingInfo.width;
+    int32_t height = timingInfo.height;
+    if (timingInfo.interlace && timingInfo.height == 480) {
+        viAttr.vi_config.display_field = UAPI_VI_DISPLAY_FIELD_TOP;
+        LOGI("timingInfo.display_field=UAPI_VI_DISPLAY_FIELD_TOP");
+    } else {
+        viAttr.vi_config.display_field = UAPI_VI_DISPLAY_FIELD_ALL;
+    }
+    viAttr.access_type = UAPI_VI_ACCESS_TVD;
+    viAttr.source_type = UAPI_VIDEO_SOURCE_CVBS;
+    viAttr.vi_type = UAPI_VI_MAIN;
+    viAttr.intf_mode = UAPI_VI_INTF_FVHDE;
+    viAttr.vi_config.input_rect.x = 0;
+    viAttr.vi_config.input_rect.y = 0;
+    viAttr.vi_config.input_rect.width = width;
+    viAttr.vi_config.input_rect.height = height;
+    viAttr.vi_config.width = width;
+    viAttr.vi_config.height = height;
+    viAttr.vi_config.color_sys = colorSys;
+    viAttr.vi_config.frame_rate = timingInfo.frame_rate;
+    viAttr.vi_config.interlace = timingInfo.interlace;
+    viAttr.vi_config.color_sys = UAPI_COLOR_SYS_AUTO;
+    viAttr.over_sample = timingInfo.oversample;
+    viAttr.pixel_format = timingInfo.pixel_fmt;
+    viAttr.secure = TD_FALSE;
+
+    return RETURN_SUCCESS;
+}
+
+int32_t VideoDecoderCvbsHal::GetVideoInfo(VideoInfo &videoInfo, [[maybe_unused]]bool isCast)
+{
+    if(Check() != RETURN_SUCCESS)
+    {
+        LOGE("check failed");
+        return SIGNAL_BUTT;
+    }
+
+    uapi_tvd_timing_info timingInfo{};
+    int32_t ret = uapi_tvd_get_timing_info(&timingInfo);
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("uapi_tvd_get_timing_info failed");
+        return RETURN_FAILURE;
+    }
+
+    uapi_color_sys colorSys = UAPI_COLOR_SYS_MAX;
+    ret = uapi_tvd_get_color_system(&colorSys);
+    if(ret != TD_SUCCESS){
+        LOGE("uapi_tvd_get_color_system failed, ret=0x%x",ret);
+        return COLOR_SYS_BUTT;
+    }
+
+    if(memset_s(&videoInfo,sizeof(VideoInfo),0,sizeof(videoInfo)) != EOK){
+        LOGE("memset_s failed");
+    }
+
+    videoInfo.colorSys= ConvertColorSys(colorSys);
+    videoInfo.isInterlace = (timingInfo.interlace == TD_TRUE);
+    videoInfo.height = timingInfo.height;
+    videoInfo.width = timingInfo.width;
+    videoInfo.frameRate = CheckFrameRate(timingInfo.frame_rate);
+    videoInfo.colorSpace = COLOR_SPACE_BT601_YUV_LIMITED ;
+    videoInfo.pixelFormat = ConvertPixelFormat(timingInfo.pixel_fmt);
+    videoInfo.frame3D = ConvertFrame3D(UAPI_FRAME_PACKING_TYPE_2D);
+    videoInfo.bitWidth = ConvertBitWidth(timingInfo.bit_depth);
+    videoInfo.overSample = ConvertOverSample(timingInfo.oversample);
+    
+    return RETURN_SUCCESS;
+}
+
+uint32_t VideoDecoderCvbsHal::CheckFrameRate(uint32_t frameRate) const
+{
+    static const std::unordered_map<uint32_t, uint32_t> convertMap{
+        {99, 100},
+        {101, 100},
+        {119, 120},
+        {121, 120}
+    };
+
+    auto item = convertMap.find(frameRate);
+    if(item != convertMap.end()){
+        return item->second;
+    }
+
+    return frameRate;
+}
+
+ColorSysType VideoDecoderCvbsHal::ConvertColorSys(const uapi_color_sys &colorSys) const
+{
+    static const std::unordered_map<uapi_color_sys,ColorSysType> colorSysMap{
+        {UAPI_COLOR_SYS_AUTO,COLOR_SYS_AUTO},
+        {UAPI_COLOR_SYS_PAL,COLOR_SYS_PAL},
+        {UAPI_COLOR_SYS_NTSC,COLOR_SYS_NTSC},
+        {UAPI_COLOR_SYS_SECAM,COLOR_SYS_SECAM},
+        {UAPI_COLOR_SYS_PAL_M,COLOR_SYS_PALM},
+        {UAPI_COLOR_SYS_PAL_N,COLOR_SYS_PALN},
+        {UAPI_COLOR_SYS_PAL_N,COLOR_SYS_PAL60},
+        {UAPI_COLOR_SYS_NTSC443,COLOR_SYS_NTSC443},
+        {UAPI_COLOR_SYS_NTSC_50,COLOR_SYS_NTSC50}
+    };
+    
+    auto item = colorSysMap.find(colorSys);
+    if(item == colorSysMap.end()){
+        LOGE("unf colorSys invalid status=%d",colorSys);
+        return COLOR_SYS_BUTT;
+    }
+    return item->second;
+}
+
+InputConnectStatus VideoDecoderCvbsHal::GetOfflineSignalStatus(SourceType source)
+{
+    if(source != SOURCE_CVBS1){
+        LOGE("invalid source type %d",source);
+        return INPUT_CONNECT_BUTT;
+    }
+    if(Check() !=RETURN_SUCCESS){
+        LOGE("Check failed");
+        return INPUT_CONNECT_BUTT;
+    }
+    uapi_tvd_src_attr srcAttr{};
+    srcAttr.type = UAPI_VIDEO_SOURCE_CVBS;
+    
+    int32_t port = 1;
+    if(VideoInputPortOrder::GetInstance().Get(source,port) == RETURN_SUCCESS){
+        LOGI("not set port map.source %d,source",port);
+    }
+    LOGI("cvbs source %d,port %d",source,port);
+    srcAttr.index = static_cast<uint32_t>(port);
+    td_bool status = TD_FALSE;
+    int32_t ret = uapi_tvd_get_offline_status(&srcAttr,&status);
+    if(ret != RETURN_SUCCESS){
+        return INPUT_CONNECT_BUTT;
+    }
+    return(status == TD_TRUE) ? INPUT_CONNECTED:INPUT_NOT_CONNECTED;
+}
+
+int32_t VideoDecoderCvbsHal::GetNonStdInfo(uapi_video_nonstd_info &nonStdInfo)
+{
+    if(Check() != RETURN_SUCCESS)
+    {
+        LOGE("check failed");
+        return SIGNAL_BUTT;
+    }
+    td_s32 ret = uapi_tvd_get_nonstd_info(&nonStdInfo);
+    if(ret != RETURN_SUCCESS){
+        LOGE("tvd get nonstd info failed ");
+        return RETURN_FAILURE;
+    }
+	return  RETURN_SUCCESS;
+}
