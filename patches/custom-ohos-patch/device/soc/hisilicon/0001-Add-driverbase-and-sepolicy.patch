+            outPort = UAPI_SND_OUT_PORT_HDMITX0;
+            break;
+        case DRIVERBASE_AOUT_DEVICE_SPEAKER:
+            outPort = UAPI_SND_OUT_PORT_HDMITX1;
+            break;
+        case DRIVERBASE_AOUT_DEVICE_ARC:
+            outPort = UAPI_SND_OUT_PORT_ARC0;
+            break;
+        default:
+            LOGE("invalid deviceTypeL0x%x", outputDevice);
+            break;
+    }
+
+    return outPort;
