+        return RETURN_FAILURE;
+    }
+    int32_t ret = TD_SUCCESS;
+    uapi_audio_decode_attr adecAttr{};
+    uapi_avplay_get_attr(m_handle, UAPI_AVPLAY_ATTR_ID_ADEC, &adecAttr);
+    adecAttr.id = static_cast<uapi_acodec_id>(audioDecType);
+    if(m_funcUnorderedMap.count(adecAttr.id) > 0) {
+        ret = (this->m_funcUnorderedMap[adecAttr.id])(adecAttr, mode);
+        if (ret != TD_SUCCESS) {
+            LOGE("Set Audio decode Attr failed 0x%x", ret);
+            return RETURN_FAILURE;
+        }
+    } else {
+        static_cast<void>(OtherFormatOpenParam(adecAttr, mode));
+    }
+
+    ret = uapi_avplay_set_attr(m_handle, UAPI_AVPLAY_ATTR_ID_ADEC, &adecAttr);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_avplay_set_attr failed 0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
+
+std::string AudioDecoderHal::GetHdmiDataTypeName(AoutHdmiDataType dataType)
+{
+    if (dataType > DRIVERBASE_AOUT_HDMI_DATA_BUTT || dataType < DRIVERBASE_AOUT_HDMI_DATA_PCM) {
+        return "No this type";
+    }
+    const std::string hdmiDataType[DRIVERBASE_AOUT_HDMI_DATA_BUTT + 1] = {
+        "PCM", "DD", "DDP", "DTS", "DTSHD", "TRUEHD", "UNKNOWN", "MAT", "BUTT"
+    };
+    return hdmiDataType[dataType];
+}
+
+int32_t AudioDecoderHal::FindAudioDecoderByFormat(AoutHdmiDataType audioDataType)
+{
+    uint32_t codecId = 0;
+    int32_t adecType = AudioCommon::USER_SET_DECODER_TYPE_DEFAULT;
+    int32_t ret;
+    if (audioDataType == DRIVERBASE_AOUT_HDMI_DATA_DD || audioDataType == DRIVERBASE_AOUT_HDMI_DATA_DDP){
+        ret = uapi_avplay_find_aud_decoder(UAPI_ACODEC_FORMAT_AC3, &codecId);
+    } else if (audioDataType ==DRIVERBASE_AOUT_HDMI_DATA_DTS || audioDataType == DRIVERBASE_AOUT_HDMI_DATA_DTSHD){
+        ret = uapi_avplay_find_aud_decoder(UAPI_ACODEC_FORMAT_DTS, &codecId);
+        if ((codecId != HA_CODEC_ID_DTSHD) && (codecId != HA_CODEC_ID_DTSM6)){
+            codecId = 0;
+        }
+    }else {
+        LOGE("Invaild audio data type :%s", GetHdmiDataTypeName(audioDataType).c_str());
+        return adecType;
+    }
+    if (ret == TD_SUCCESS){
+        adecType = static_cast<int32_t>(codecId);
+    }
+    LOGI("Get audio data type:%s, adec id:0x%x", GetHdmiDataTypeName(audioDataType).c_str(), adecType);
+    return adecType;
+}
+
+int32_t AudioDecoderHal::GetAdecType(AoutHdmiDataType audioDataType)
+{
+    if(Check() != RETURN_SUCCESS){
+        LOGE("check failed");
+        return RETURN_FAILURE;
+    }
+    int32_t adecType = 0;
+    switch (audioDataType){
+        case DRIVERBASE_AOUT_HDMI_DATA_DD:
+        case DRIVERBASE_AOUT_HDMI_DATA_DDP:
+            adecType = FindAudioDecoderByFormat(DRIVERBASE_AOUT_HDMI_DATA_DD);
+            break;
+        case DRIVERBASE_AOUT_HDMI_DATA_DTS:
+        case DRIVERBASE_AOUT_HDMI_DATA_DTSHD:
+            adecType = FindAudioDecoderByFormat(DRIVERBASE_AOUT_HDMI_DATA_DTS);
+            break;
+        case DRIVERBASE_AOUT_HDMI_DATA_TRUEHD:
+            adecType = UAPI_ACODEC_ID_TRUEHD;
+            LOGI("Get Audio Dec Type :TRUEHD");
+            break;
+        case DRIVERBASE_AOUT_HDMI_DATA_MAT:
+            adecType = UAPI_ACODEC_ID_MS12_MAT;
+            break;
+        default:
+            LOGI("unknown ai hdmi data type, can't Get Audio Dec Type");
+            break;
+    }
+    return adecType;
+}
+
+int32_t AudioDecoderHal::HdmiInit()
+{
+    if(Check() != RETURN_SUCCESS){
+        LOGE("check failed");
+        return RETURN_FAILURE;
+    }
+    int32_t ret = uapi_hdmirx_init();
+    if(ret != TD_SUCCESS){
+        LOGE("HDMIRX Init fail, ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
+
+uapi_hdmirx_port AudioDecoderHal::ConvertInputToHdmiPort(AoutAudioInputType source) const
+{
+    switch(source){
+        case DRIVERBASE_AOUT_SRC_HDMI1:
+            return static_cast<uapi_hdmirx_port>(ConfigFactory::Get().ParseInt("videoinputmap:HDMI1Port"));
+        case DRIVERBASE_AOUT_SRC_HDMI2:
+            return static_cast<uapi_hdmirx_port>(ConfigFactory::Get().ParseInt("videoinputmap:HDMI2Port"));
+        case DRIVERBASE_AOUT_SRC_HDMI3:
+            return static_cast<uapi_hdmirx_port>(ConfigFactory::Get().ParseInt("videoinputmap:HDMI3Port"));
+        case DRIVERBASE_AOUT_SRC_HDMI4:
+            return static_cast<uapi_hdmirx_port>(ConfigFactory::Get().ParseInt("videoinputmap:HDMI4Port"));
+        default:
+            LOGE("unknown source=%d",source);
+        break;
+    }
+    return UAPI_HDMIRX_PORT_MAX;
+}
+
+int32_t AudioDecoderHal::GetHdmiAudioInfo(HdmiAudioAttr &hdmiAudioInfo, AoutAudioInputType source)
+{
+    uapi_hdmirx_audio_attr audioInfo{};
+    int32_t ret = uapi_hdmirx_get_audio_info(ConvertInputToHdmiPort(source), &audioInfo);
+    if (ret != TD_SUCCESS){
+        LOGE("uapi_hdmirx_get_audio_info fail, ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+
+    LOGI("nChannel = %d, bitDepth = %d, SampleRate = %d, audio_data_type = %d, audio_format = %d",audioInfo.channels,
+        audioInfo.bit_depth, audioInfo.sample_rate, audioInfo.audio_data_type , audioInfo.audio_format);
+
+        hdmiAudioInfo.nChannel = static_cast<I2SChnNum>(audioInfo.channels);
+        hdmiAudioInfo.bitDepth = static_cast<I2SBitDepth>(audioInfo.bit_depth);
+        hdmiAudioInfo.sampleRate = static_cast<SampleRate>(audioInfo.sample_rate);
+
+        if (audioInfo.audio_data_type == UAPI_AUDIO_DATA_TYPE_LPCM) {
+            hdmiAudioInfo.dataFmt = HDMI_AUDIO_FMT_LPCM;
+        }else if (audioInfo.audio_data_type == UAPI_AUDIO_DATA_TYPE_LBR) {
+            hdmiAudioInfo.dataFmt = HDMI_AUDIO_FMT_LBR;
+        }else if (audioInfo.audio_data_type == UAPI_AUDIO_DATA_TYPE_HBR) {
+            hdmiAudioInfo.dataFmt = HDMI_AUDIO_FMT_HBR;
+    }
+    switch (audioInfo.audio_format) {
+        case UAPI_AUDIO_FORMAT_PCM:
+            hdmiAudioInfo.dataType = DRIVERBASE_AOUT_HDMI_DATA_PCM;
+            break;
+        case UAPI_AUDIO_FORMAT_AC3:
+            hdmiAudioInfo.dataType = DRIVERBASE_AOUT_HDMI_DATA_DD;
+            break;
+        case UAPI_AUDIO_FORMAT_DTS:
+            hdmiAudioInfo.dataType = DRIVERBASE_AOUT_HDMI_DATA_DTS;
+            break;
+        case UAPI_AUDIO_FORMAT_EAC3:
+            hdmiAudioInfo.dataType = DRIVERBASE_AOUT_HDMI_DATA_DDP;
+            break;
+        case UAPI_AUDIO_FORMAT_DTS_HD:
+            hdmiAudioInfo.dataType = DRIVERBASE_AOUT_HDMI_DATA_DTSHD;
+            break;
+        case UAPI_AUDIO_FORMAT_MAT:
+            hdmiAudioInfo.dataType = DRIVERBASE_AOUT_HDMI_DATA_MAT;
+            break;               
+        default:
+            hdmiAudioInfo.dataType = DRIVERBASE_AOUT_HDMI_DATA_BUTT;
+            break;
+    }
+
+    return ret;
+}
+
+int32_t AudioDecoderHal::GetHdmiAudioStatus(SignalStatus &signalState, AoutAudioInputType source)
+{
+    uapi_sig_status *state = reinterpret_cast<uapi_sig_status *>(&signalState);
+
+    int32_t ret = uapi_hdmirx_get_audio_status(ConvertInputToHdmiPort(source),state);
+    if (ret != TD_SUCCESS){
+        LOGE("uapi_hdmirx_get_audio_status fail, ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
+
+int32_t AudioDecoderHal::GetChipDecoderCap(ChipDecoderCap &chipCap)
+{
+    int32_t ret = uapi_sys_init();
+    if (ret != TD_SUCCESS){
+        LOGE("uapi_sys_init fail. ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    uapi_sys_chip_cap cap{};
+    ret = uapi_sys_get_chip_cap(&cap);
+    if (ret != TD_SUCCESS){
+        LOGE("uapi_sys_get_chip_cap failed, ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    chipCap.ddSupport = cap.dd_support;
+    chipCap.ddpSupport = cap.ddp_support;
+    chipCap.dtsSupport = cap.dts_support;
+    LOGI("get chip decoder capability, support dd[%d], ddp[%d], dts[%d]",chipCap.ddSupport, chipCap.ddpSupport,
+        chipCap.dtsSupport);
+    return RETURN_SUCCESS;
+}
+
+int32_t AudioDecoderHal::IsOnlySupportPassthrough(int32_t adecType, bool &onlySupportPassthrough)
+{
+    if (adecType == UAPI_ACODEC_ID_DTSPASSTHROUGH || adecType == UAPI_ACODEC_ID_AC3PASSTHROUGH) {
+        onlySupportPassthrough = true;
+    }else{
+        onlySupportPassthrough = false;
+    }
+    return RETURN_SUCCESS;
+}
