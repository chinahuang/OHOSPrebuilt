+    }
+    if(m_viHandle == TD_INVALID_HANDLE)
+    {
+        LOGE("m_viHandle is TD_INVALID_HANDLE");
+        return RETURN_FAILURE;
+    }
+    static std::unordered_map<HdmiRange,uapi_vi_quantization_range> cscMap {
+        {HDMI_RANGE_AUTO,UAPI_VI_QUANTIZATION_RANGE_AUTO},
+        {HDMI_RANGE_FULL,UAPI_VI_QUANTIZATION_RANGE_FULL},
+        {HDMI_RANGE_LIMIT,UAPI_VI_QUANTIZATION_RANGE_LIMIT}
+    };
+    auto item = cscMap.find(hdmiRange);
+    if(item == cscMap.end())
+    {
+        LOGE("csccMap not find");
+        return RETURN_FAILURE;
+    }
+    int32_t ret = uapi_vi_set_src_quantization_range(m_viHandle,item->second);
+    if(ret != TD_SUCCESS)
