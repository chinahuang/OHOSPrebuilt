@@ -0,0 +1,208 @@
+
+
+
+
+
+#define LOG_NDEBUG 0
+#define LOG_TAG "IniParser"
+
+#include "IniParser.h"
+
+#include <cstdlib>
+#include <fstream>
+
+#include "CommonDef.h"
+
+using namespace std;
+
+int32_t IniParser::Load(const std::string &fileName)
+{
+    char *resolvePath = realpath(fileName.c_str(), nullptr);
+    if (resolvePath == nullptr) {
+        LOGE("file path:%s error!", fileName.c_str());
+        return RETURN_FAILURE;
+    }
+
+    std::ifstream file(resolvePath, std::ios::in);
+
+    free(resolvePath);
+    resolvePath = nullptr;
+
+    if (file.fail()) {
+        LOGE("file open failed. fileName=%s", fileName.c_str());
+        return RETURN_FAILURE;
+    }
+
+    // read each line of the INI file and process it
+    std::string section;
+    std::string key;
+    std::string value;
+    std::string line;
+    int32_t ret = RETURN_SUCCESS;
+    while (GetLine(file, line)) {
+        TrimLine(line);
+        if (ProcessLine(line, section, key, value) != 0) {
+            LOGE("ProcessLine failed");
+            ret = RETURN_FAILURE;
+        }
+    }
+    return ret;
+}
+
+int32_t IniParser::ProcessLine(const std::string &line, std::string &section, std::string &key, std::string &value)
+{
+    if (ParseComment(line)) {
+        return RETURN_SUCCESS;
+    }
+    if (ParseSection(line,section)) {
+        m_sections.push_back(section);
+        return RETURN_SUCCESS;
+    }
+    if (ParseValue(line, key, value)) {
+        m_dictionary.insert({std::string().append(section).append(":").append(key),value});
+        return RETURN_SUCCESS;
+    }
+    
+    LOGE("line format error: %s", line.c_str());
+    return RETURN_FAILURE;
+}
+
+bool IniParser::ParseSection(const std::string &line, std::string &section) const
+{
+    if (line.size() < 3) {
+        return false;
+    }
+    if ((line.at(0) == '[') && (line.at(line.size() - 1) == ']')) {
+        section = line.substr(1, line.size() - 2); // 2: remove the []
+        TrimLine(section);
+        return true;
+    }
+    return false;
+}
+
+bool IniParser::ParseComment(const std::string &line) const
+{
+    if (line.empty()) {
+        return true;
+    }
+    if ((line.at(0) == '#') || (line.at(0) == ';')) {
+        return true;
+    }
+    return false;
+}
+
+bool IniParser::ParseValue(const std::string &line,std::string &key, std::string &value) const
+{
+    std::string data = line.substr(0, line.find_first_of('#')).substr(0, line.find_first_of(';'));
+    std::string::size_type eqIndex = data.find_first_of('=');
+    if (eqIndex == std::string::npos) {
+        return false;
+    }
+    std::string rawKey;
+    if (!SplitKey(data, eqIndex, rawKey)) {
+        return false;
+    }
+    std::string rawValue;
+    if (!SplitValue(data, eqIndex, rawValue)) {
+        return false;
+    }
+    key = rawKey;
+    value = rawValue;
+    return true;
+}
+
+bool IniParser::SplitKey(const std::string &line, std::string::size_type splitIndex, std::string &key)
+{
+    std::string rawKey = line.substr(0, splitIndex);
+    TrimLine(rawKey);
+    if (rawKey.empty()) {
+        LOGE("key is empty");
+        return false;
+    }
+    key = rawKey;
+    return true;
+}
+
+bool IniParser::SplitValue(const std::string &line, std::string::size_type splitIndex, std::string &value)
+{
+    if (splitIndex >= (line.size() - 1)) {
+        value = "";
+        return true;
+    }
+    std::string rawValue = line.substr(splitIndex + 1, line.size() - splitIndex -1);
+    TrimLine(rawValue);
+
+    if (rawValue.empty()) {
+        value = "";
+        return true;
+    }
+
+    if (rawValue[0] == '\'' ) {
+        if (!SplitValueQuotes(rawValue, '\'')) {
+            return false;
+        }
+    } else if (rawValue[0] == '\"') {
+        if (!SplitValueQuotes(rawValue,'\"')){
+            return false;
+        }
+    }
+    value = rawValue;
+    return true;
+}
+
+bool IniParser::SplitValueQuotes(std::string &str, char symbol)
+{
+    if (str.size() < 2) {
+        LOGE("size error");
+        return false;
+    }
+    if (str[0] == symbol && str[str.size() - 1] == symbol) {
+        str = str.substr(1, str.size() - 2); //2: remove "" or ''
+        return true;
+    }
+
+    LOGE("quotes error");
+    return false;
+}
+
+bool IniParser::GetLine(std::ifstream &file, std::string &line) const
+{
+    line.clear();
+    std::string temp;
+    while (getline(file, temp)) {
+        std::string::size_type index = temp.find_last_not_of(BLANK_SYMBOLS);
+        if (index == std::string::npos) {
+            continue;
+        }
+        if (temp[index] == '\\') {
+            line.append(temp,0,index);
+            continue;
+        } else {
+            line.append(temp,0,index + 1);
+            return true;
+        }
+    }
+    return !line.empty();
+}
+
+void IniParser::TrimLine(string &line)
+{
+    if (line.empty()) {
+        return;
+    }
+    line.erase(0,line.find_first_not_of(BLANK_SYMBOLS));
+    line.erase(line.find_last_not_of(BLANK_SYMBOLS) + 1);
+}
+
+std::string IniParser::GetValue(const std::string &key, const std::string &def) const
+{
+    if (m_dictionary.count(key) == 0) {
+        return def;
+    }
+    return m_dictionary.at(key);
+}
+
+const unordered_map<string,string> &IniParser::GetCacheMap() const
+{
+    return m_dictionary;
+}
