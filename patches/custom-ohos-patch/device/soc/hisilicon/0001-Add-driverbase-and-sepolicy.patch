new file mode 100644
index 0000000..079a8c0
--- /dev/null
+++ b/common/driverbase/hal/ini/ConfigHandler.h
@@ -0,0 +1,75 @@
+
+
+
+
+
+#ifndef DRIVERBASE_CONFIGHANDLER_H
+#define DRIVERBASE_CONFIGHANDLER_H
+
+#include <sstream>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include <securec.h>
+
+#include "CommonDef.h"
+#include "IniParser.h"
+
+class ConfigHandler {
+public:
+    explicit ConfigHandler(const std::string &iniFile);
+    ~ConfigHandler() = default;
+    bool GetCfgExceptionStatus() const;
+    std::string ParseString(const std::string &field);
+    std::unordered_map<std::string, std::string> GetCacheMap();
+
+    template<typename T>
+    static std::vector<T> StringToDigitalVector(const std::string &str)
+    {
+        if (str.empty()) {
+            return {};
+        }
+        static_assert(std::is_same<T, int16_t>::value || std::is_same<T, uint16_t>::value ||
+            std::is_same<T, int32_t>::value || std::is_same<T, uint32_t>::value ||
+            std::is_same<T, double>::value, "T is invalid!");
+
+        std::vector<T> ret;
+        std::string dataStr;
+        std::stringstream ss(str);
+        while (std::getline(ss, dataStr, ',')) {
+            Trim(dataStr);
+            if (dataStr.empty()) {
+                LOGE("dataStr is empty");
+                break;
+            }
+            char *end = nullptr;
+            int32_t base = 10; // base is 10
+            if (strncasecmp(dataStr.c_str(),"0x",2) == 0) {
+                base = 16;
+            }
+            T value;
+            if (std::is_same<T, int32_t>::value || std::is_same<T, uint32_t>::value || 
+                std::is_same<T, int16_t>::value || std::is_same<T, uint16_t>::value) {
+                value = static_cast<T>(strtol(dataStr.c_str(), &end, base));
+            } else if (std::is_same<T,double>::value) {
+                value = strtod(dataStr.c_str(), &end);
+            } else {
+                LOGE("Don't support");
+                return ret;
+            }
+            ret.push_back(value);
+        }
+        return ret;
+    }
+
+    static std::vector<bool> StringToBooleanVector(const char *str);
+    static std::vector<std::string> StringToStringVector(const char *str);
+
+private:
+    bool m_cfgHandlerException{false};
+    static void Trim(std::string &str);
+    IniParser m_iniParser;
+};
+
+#endif
