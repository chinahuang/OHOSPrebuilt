+int32_t RxCecCtrlHal::SetOneTouchPlayEnable(bool oneTouchPlay)
+{
+    if((!m_pmocInit) && (PmocInit() != RETURN_SUCCESS))
+    {
+        LOGE("uapi_pmoc_init fail.");
+        return RETURN_FAILURE;
+    }
+
+    td_bool isEnable = oneTouchPlay ? TD_TRUE : TD_FALSE;
+    int32_t ret = uapi_pmoc_set_suspend_param(UAPI_PMOC_WAKEUP_HDMIRX_CEC, isEnable, nullptr);
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("set oneTouchPlay enable:%d fail, ret:0x%x", oneTouchPlay, ret);
+        return RETURN_FAILURE;
+    }
+
+    return RETURN_SUCCESS;
+}
