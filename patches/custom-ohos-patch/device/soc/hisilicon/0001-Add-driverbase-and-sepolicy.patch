+int32_t AudioOutDeviceHal::InitTrackConfig(const std::vector<int32_t> &prescaler)
+{ 
+    if( prescaler.size() < UAPI_SND_SOURCE_MAX ) {
+        LOGE("invalid vector size");
+        return RETURN_FAILURE;
+    }
+    uapi_snd_track_config trackConfig{};
+    for( int32_t i = 0; i < UAPI_SND_SOURCE_MAX; i++) {
+        // devide by 1000 to calculate the integer part of the gain
+        trackConfig.track_prescale[i].integer = prescaler[i] / 1000;
+        // calculating the decimal part of the gain with the module of 1000;
+        trackConfig.track_prescale[i].decimal = prescaler[i] % 1000;
+        LOGI("prescaler:sourceID(%d) integerGain(%d),decimalGain(%d)",i,trackConfig.track_prescale[i].integer, trackConfig.track_prescale[i].decimal);
+    }
+    int32_t ret = uapi_snd_track_config_init(UAPI_SND_0,&trackConfig);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_snd_track_config_init fail,ret:%d",ret);
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
