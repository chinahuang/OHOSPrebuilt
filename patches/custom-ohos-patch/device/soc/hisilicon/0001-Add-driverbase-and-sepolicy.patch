+void HdmiAudioControllerHal::ReportHdmiInfo()
+{
+    if(!(m_loopCnt % REPORT_HDMI_INFO_CNT) && !m_hasHdmiInfoReport) {
+        AoutHdmiDataType dataType = DRIVERBASE_AOUT_HDMI_DATA_BUTT;
+        static_cast<void>(m_input->GetStreamType(dataType));
+        LOGD("dataType=%d", dataType);
+        if(CheckHdmiInfo(dataType)) {
+            static_cast<void>(m_input->GetHdmiAudioInfo(m_hdmiAudioInfo, m_source));
+            if(m_hdmiAudioInfo.sampleRate == SAMPLE_RATE_UNKNOWN) {
+                m_hdmiAudioInfo.sampleRate = SAMPLE_RATE_48K;
+            }
+            m_hdmiAudioInfo.dataType = dataType;
+            LOGI("Hdmi info: nChannel=%d, bitDepth=%d, sampleRate=%d, dataFmt=%d, dataType=%d",
+                m_hdmiAudioInfo.nChannel, m_hdmiAudioInfo.bitDepth, m_hdmiAudioInfo.sampleRate, m_hdmiAudioInfo.dataFmt, 
+                m_hdmiAudioInfo.dataType);
+            // DataDot::ReportHdmiAudio(m_hdmiAudioInfo);
+            m_hasHdmiInfoReport = true;
+        }
+    }
+}
