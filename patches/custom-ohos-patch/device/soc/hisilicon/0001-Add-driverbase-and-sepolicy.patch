+int32_t VideoOutputHal::SetAutoLowLatencyMode(DispAllmMode allmMode)
+{
+	DisplayHal *displayHal = DisplayHal::GetDisplayHal(GetDispID());
+	if (displayHal == nullptr) {
+		return RETURN_FAILURE;
+	}
+
+	uapi_svr_disp_allm_attr svrDispAllmAttr{};
+
+	switch (allmMode) {
+		case DISP_ALLM_MODE_AUTO:
+			svrDispAllmAttr.mode = UAPI_SVR_DISP_ALLM_MODE_AUTO;
+			break;
+		case DISP_ALLM_MODE_ON:
+			svrDispAllmAttr.mode = UAPI_SVR_DISP_ALLM_MODE_ON;
+			break;
+		case DISP_ALLM_MODE_OFF:
+			svrDispAllmAttr.mode = UAPI_SVR_DISP_ALLM_MODE_OFF;
+			break;
+		default:
+			svrDispAllmAttr.mode = UAPI_SVR_DISP_ALLM_MODE_MAX;
+	}
+
+	return displayHal->SetDisplayAllmAttr(svrDispAllmAttr);
+}
+
+int32_t VideoOutputHal::SetDisplayVrrEnable(bool isEnable)
+{
+	DisplayHal *displayHal = DisplayHal::GetDisplayHal(GetDispID());
+	if (displayHal == nullptr) {
+		return RETURN_FAILURE;
+	}
+
+	return displayHal->SetDisplayVrr(isEnable);
+}
