+int32_t AudioInputHal::AcquireFrame(AoFrameInfo &frame)
+{
+    if(Check() != RETURN_SUCCESS)
+    {
+        LOGE("check failed");
+        return RETURN_FAILURE;
+    }
+
+    if(m_handle == TD_INVALID_HANDLE)
+    {
+        LOGE("m_handle is invalid");
+        return RETURN_FAILURE;
+    }
+
+    uapi_audio_frame audioFrame{};
+    int32_t ret = uapi_ai_acquire_frame(m_handle, &audioFrame, 0);
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("uapi_ai_acquire_frame failed, ret:0x%x", ret);
+        return ret;
+    }
+
+    frame.bitPerSample = audioFrame.bit_depth;
+    frame.interleaved = audioFrame.interleaved == TD_TRUE;
+    frame.sampleRate = audioFrame.sample_rate;
+    frame.channels = audioFrame.channels;
+    frame.ptsUs = audioFrame.pts;
+    frame.pcmBuffer = reinterpret_cast<int32_t *>(audioFrame.pcm_buffer);
+    frame.bitsBuffer = reinterpret_cast<int32_t *>(audioFrame.bits_buffer);
+    frame.pcmSamplesPerFrame = audioFrame.pcm_samples;
+    frame.bitsBytesPerFrame = audioFrame.bits_bytes;
+    frame.frameIndex = audioFrame.frame_index;
+    frame.dataType = audioFrame.iec_data_type;
+
+    return RETURN_SUCCESS;
+}
