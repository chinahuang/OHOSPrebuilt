+int32_t AudioHal::Init()
+{
+    LOGI("Init");
+    std::lock_guard<std::mutex> lg(m_mutex);
+    if (m_isInit) {
+        return RETURN_SUCCESS;
+    }
+
+    int32_t ret = uapi_snd_init();
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_snd_init failed, retL0x%x", ret);
+        return RETURN_FAILURE;
+    }
+
+    ret = uapi_sif_init();
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_sif_init failed, retL0x%x", ret);
+        return RETURN_FAILURE;
+    }
+
+    ret = uapi_sif_open(UAPI_SIF_ID_0);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_sif_open fail, ret=%d", ret);
+        return RETURN_FAILURE;
+    }
+
+    ret = uapi_sif_start(UAPI_SIF_ID_0);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_sif_start fail, ret=%d", ret);
+        return RETURN_FAILURE;
+    }
+
+    m_isInit = true;
+    return RETURN_SUCCESS;
+}
+
+int32_t AudioHal::DeInit()
+{
+    LOGI("Deinit");
+    std::lock_guard<std::mutex> lg(m_mutex);
+    if (!m_isInit) {
+        return RETURN_SUCCESS;
+    }
+
+    int32_t ret = uapi_snd_deinit();
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_snd_deinit failed, retL0x%x", ret);
+        return RETURN_FAILURE;
+    }
+
+    ret = uapi_sif_de_init();
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_sif_de_init failed, retL0x%x", ret);
+        return RETURN_FAILURE;
+    }
+
+    ret = uapi_sif_close(UAPI_SIF_ID_0);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_sif_close fail, ret=%d", ret);
+        return RETURN_FAILURE;
