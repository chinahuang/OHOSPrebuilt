+int32_t AudioOutDeviceHal::GetHandleByPid(uint32_t &handle, int32_t pid)
+{
+    OutDeviceTrackInfo trackInfo{};
+    int32_t ret = GetTrackInfo(trackInfo);
+    if(ret != RETURN_SUCCESS){
+        LOGE("GetTrackInfo failed");
+        return RETURN_FAILURE;
+    }
+    for(size_t i = 0; i < trackInfo.trackNum && i < AudioCommon::OUT_DEVICE_TRACK_MAX ; i++){
+        if(pid == trackInfo.trackStatus[i].userID ){
+            handle = trackInfo.track[i];
+            break;
+        }
+    }
+    if( handle != AudioCommon::HANDLE_INVALID ) {
+        return RETURN_SUCCESS;
+    }
+    return RETURN_FAILURE;
+}
