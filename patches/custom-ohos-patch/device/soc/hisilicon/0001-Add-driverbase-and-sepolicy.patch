+            deviceType = DRIVERBASE_AOUT_DEVICE_HDMI;
+            break;
+        case UAPI_SND_OUT_PORT_HDMITX1:
+            deviceType = DRIVERBASE_AOUT_DEVICE_SPEAKER;
+            break;
+        case UAPI_SND_OUT_PORT_ARC0:
+            deviceType = DRIVERBASE_AOUT_DEVICE_ARC;
+            break;
+        default:
+            LOGE("invalid portL0x%x", port);
+            break;
