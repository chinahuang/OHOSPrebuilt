+int32_t PanelHal::Init()
+{
+    std::lock_guard<std::mutex> lg(m_mutex);
+    if (m_isInit) {
+        return RETURN_SUCCESS;
+    }
+
+    int32_t ret = uapi_panel_init();
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_panel_init failed, ret = 0x%x.", ret);
+        return RETURN_FAILURE;
+    }
+    uapi_pdm_disp_param paramData{};
+    ret = uapi_pdm_get_disp_param(UAPI_DISPLAY0, &paramData);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_pdm_get_disp_param failed");
+        return RETURN_FAILURE;
+    }
+    if (paramData.intf[UAPI_DISP_INTF_TYPE_PANEL].intf_type != UAPI_DISP_INTF_TYPE_PANEL) {
+        LOGE("panel not bind please check");
+        return RETURN_FAILURE;
+    }
+    m_panelId = static_cast<uapi_panel_id>(paramData.intf[UAPI_DISP_INTF_TYPE_PANEL].intf.panel);
+
+    m_customFd = open("/dev/soc_custom", O_RDWR | O_NONBLOCK, 0);
+    if (m_customFd < 0) {
+        LOGE("open soc_custom failed, m_customFd = 0x%x.", m_customFd);
+        return RETURN_FAILURE;
+    }
+    m_isInit = true;
+    return RETURN_SUCCESS;
+}
+
+int32_t PanelHal::DeInit()
+{
+    std::lock_guard<std::mutex> lg(m_mutex);
+    if (!m_isInit) {
+        return RETURN_SUCCESS;
+    }
+    int32_t ret = uapi_panel_deinit();
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_panel_deinit failed, ret = 0x%x.", ret);
+        return RETURN_FAILURE;
+    }
+    ret = close(m_customFd);
+    if (ret != TD_SUCCESS) {
+        LOGE("close soc_custom failed, ret = 0x%x.", ret);
+        return RETURN_FAILURE;
+    }
+    m_customFd = -1;
+    m_isInit = false;
+    return RETURN_SUCCESS;
+}
