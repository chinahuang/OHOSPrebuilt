+void HdmiAudioControllerHal::UpdateHdmiAiAttr(AudioInputAttr &aiAttr)
+{
+    HdmiAudioAttr curHdmiAudioInfo{};
+    int32_t ret = GetAudioInfo(curHdmiAudioInfo);
+    if(ret != RETURN_SUCCESS) {
+        LOGD("get audioinfo ret = %d", ret);
+        return;
+    }
+    m_bPassThrough = false;
+    if(curHdmiAudioInfo.dataFmt == HDMI_AUDIO_FMT_LBR || curHdmiAudioInfo.dataFmt == HDMI_AUDIO_FMT_HBR) {
+        m_bPassThrough = true;
+    }
+    if(curHdmiAudioInfo.dataType == DRIVERBASE_AOUT_HDMI_DATA_DD || curHdmiAudioInfo.dataType == DRIVERBASE_AOUT_HDMI_DATA_DDP ||
+        curHdmiAudioInfo.dataType == DRIVERBASE_AOUT_HDMI_DATA_DTS || curHdmiAudioInfo.dataType == DRIVERBASE_AOUT_HDMI_DATA_DTSHD ||
+        curHdmiAudioInfo.dataType == DRIVERBASE_AOUT_HDMI_DATA_PCM) {
+            m_curAudioType = curHdmiAudioInfo.dataType;
+    } else {
+        m_curAudioType = DRIVERBASE_AOUT_HDMI_DATA_UNKNOWN;
+    }
+    aiAttr.isPassThrough = m_bPassThrough;
+    aiAttr.nChannel = curHdmiAudioInfo.nChannel;
+    aiAttr.bitDepth = curHdmiAudioInfo.bitDepth;
+    aiAttr.sampleRate = curHdmiAudioInfo.sampleRate;
+    aiAttr.dataFmt = curHdmiAudioInfo.dataFmt;
+    aiAttr.dataType = curHdmiAudioInfo.dataType;
+    aiAttr.isHdmiPlayer = true;
+}
