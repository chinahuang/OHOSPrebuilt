+int32_t AudioInputHal::SetDelay(uint32_t delay)
+{
+    if(Check() != RETURN_SUCCESS)
+    {
+        LOGE("check failed");
+        return RETURN_FAILURE;
+    }
+
+    if(m_handle == TD_INVALID_HANDLE)
+    {
+        LOGE("m_handle is invalid");
+        return RETURN_FAILURE;
+    }
+
+    uapi_ai_delay audioInputDelay = {0, TD_TRUE};
+    audioInputDelay.delay_ms = delay;
+    int32_t ret;
+    if(m_enable)
+    {
+        ret = uapi_ai_set_enable(m_handle, TD_FALSE);
+        if(ret != TD_SUCCESS)
+        {
+            LOGE("uapi_ai_set_enable failed, disable");
+        }
+
+        ret = uapi_ai_set_delay(m_handle, &audioInputDelay);
+        if(ret != TD_SUCCESS)
+        {
+            LOGE("uapi_ai_set_delay failed, delay:0x%x", delay);
+        }
+
+        ret = uapi_ai_set_enable(m_handle, TD_TRUE);
+        if(ret != TD_SUCCESS)
+        {
+            LOGE("uapi_ai_set_enable failed, enable");
+        }
+    }
+    else
+    {
+        ret = uapi_ai_set_delay(m_handle, &audioInputDelay);
+        if(ret != TD_SUCCESS)
+        {
+            LOGE("uapi_ai_set_delay failed, delay:0x%x", delay);
+        }
+    }
+
+    return RETURN_SUCCESS;
