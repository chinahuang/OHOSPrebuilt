+int32_t PanelHal::GetPanelAttr(PanelAttr &panelAttr)
+{
+    LOGI("PanelHal::GetPanelAttr in");
+    if ((!m_isInit) && (Init() != RETURN_SUCCESS)) {
+        LOGE("Panel has not initialized.");
+        return RETURN_FAILURE;
+    }
+
+    uapi_svr_dispmng_interface_group attachInfo = {};
+    uapi_svr_dispmng_display_id dispId = UAPI_SVR_DISPMNG_DISPLAY_ID_0;
+    uapi_video_aspect_info aspectInfo = {};
+
+    td_s32 ret = DisplayHal::GetDisplayHal(DISP_PORT)->GetDispmngDisplayId(UAPI_SVR_DISPMNG_DISPLAY_INDEX_0, &dispId);
+	if (ret != TD_SUCCESS) {
+		LOGE("GetDispmngDisplayId failed");
+		return RETURN_FAILURE;
+	}
+
+    ret = uapi_svr_dispmng_get_attached_interface(dispId, &attachInfo);
+    if (ret != TD_SUCCESS) {
+        LOGE("dispid:%d uapi_svr_dispmng_get_attached_interface failed, ret:0x%x", dispId, ret);
+        return ret;
+    }
+
+    if (attachInfo.intf[0].intf_type == UAPI_SVR_DISPMNG_INTERFACE_HDMITX) {
+        ret = uapi_svr_dispmng_get_hdmitx_property(dispId, UAPI_SVR_DISPMNG_PROPERTY_HDMITX_ASPECT_RATIO, &aspectInfo);
+    } else if (attachInfo.intf[0].intf_type == UAPI_SVR_DISPMNG_INTERFACE_PANEL) {
+        ret = uapi_svr_dispmng_get_panel_property(dispId, UAPI_SVR_DISPMNG_PROPERTY_PANEL_ASPECT_RATIO, &aspectInfo);
+    } else {
+        LOGE("intf_type:%d not support", attachInfo.intf[attachInfo.number].intf_type);
+        return ret;
+    }
+    if (ret != TD_SUCCESS) {
+        LOGE("dispid:%d uapi_svr_dispmng_get_intf_property failed, intftype:%d, ret:0x%x",
+            attachInfo.intf[attachInfo.number].intf_type, dispId, ret);
+        return ret;
+    }
+
+    switch (aspectInfo.ratio) {
+        case UAPI_VIDEO_ASPECT_RATIO_4TO3:
+            panelAttr.aspect = PANEL_ASPECT_4_3;
+        case UAPI_VIDEO_ASPECT_RATIO_16TO9:
+            panelAttr.aspect = PANEL_ASPECT_16_9;
+        default:
+            LOGE("%d not support", aspectInfo.ratio);
+            panelAttr.aspect = PANEL_ASPECT_4_3;
+    }
+
+    panelAttr.width = aspectInfo.width;
+    panelAttr.height = aspectInfo.height;
+    LOGI("PanelHal::GetPanelAttr success");
+    return RETURN_SUCCESS;
+}
