+int32_t AudioDecoderHal::GetDtsStreamType(DtsStreamType &dtsStreamType) 
+{
+    if(Check() != RETURN_SUCCESS) {
+        LOGE("check failed");
+        return RETURN_FAILURE;
+    }
+
+    uint32_t streamType = m_dtsStreamInfo.stream_type;
+    DtsStreamType curDtsStreamType = DTS_STREAM_TYPE_BUTT;
+
+    LOGI("streamType = %x", streamType);
+    if(streamType == STREAM_TYPE_INVALID) {
+        curDtsStreamType = DTS_STREAM_TYPE_BUTT;
+    } else if(streamType == STREAM_TYPE_UNKNOW) {
+        curDtsStreamType = DTS_STREAM_TYPE_UNKNOW;
+    } else if(streamType == STREAM_TYPE_DTS_LBR) {
+        curDtsStreamType = DTS_STREAM_TYPE_DTSEX;
+    } else if(streamType == STREAM_TYPE_DTS_LOSSLESS) {
+        curDtsStreamType = DTS_STREAM_TYPE_DTSHD;
+    } else if((streamType == STREAM_TYPE_DTS_1) || (streamType == STREAM_TYPE_DTS_2) ||
+        (streamType == STREAM_TYPE_DTS_4) || (streamType == STREAM_TYPE_DTS_8) || (streamType == STREAM_TYPE_DTS_16) ||
+        (streamType == STREAM_TYPE_DTS_32) || (streamType == STREAM_TYPE_DTS_64)) {
+        curDtsStreamType = DTS_STREAM_TYPE_DTS;
+    } else {
+        LOGE("get dts stream type failed");
+        return RETURN_FAILURE;
+    }
+    dtsStreamType = curDtsStreamType;
+    return RETURN_SUCCESS;
+}
