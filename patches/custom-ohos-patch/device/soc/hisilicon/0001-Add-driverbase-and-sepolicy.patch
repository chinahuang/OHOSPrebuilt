+	windowAttr.video_format = UAPI_FORMAT_DEFAULT;
+	windowAttr.asp_convert_mode = UAPI_WIN_ASPECT_CONVERT_CUSTOM;
+
+	windowAttr.src_crop_rect.left_offset = 0;
+	windowAttr.src_crop_rect.top_offset = 0;
+	windowAttr.src_crop_rect.right_offset = 0;
+	windowAttr.src_crop_rect.bottom_offset = 0;
+
+	windowAttr.output_rect.x = 0;
+	windowAttr.output_rect.y = 0;
+	uint32_t width = 0;
+	uint32_t height = 0;
+	static_cast<void>(GetDisplayResolution(width, height));
+	windowAttr.output_rect.width = width;
+	windowAttr.output_rect.height = height;
+
+	windowAttr.video_rect = windowAttr.output_rect;
+}
