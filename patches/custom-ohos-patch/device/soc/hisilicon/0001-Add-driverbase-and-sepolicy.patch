+};
+
+struct CastSaveParams {
+    bool hasAudioChannel;
+    CastType castType;
+    CastMode castMode;
+    CastVencChnAttr chnAttr;
+};
+
+struct TdeSurface {
+    uint32_t phyAddr;       // 位图首地址或Y分量地址
+    TdeColorFormat colorFmt;
+    uint32_t height;
+    uint32_t width;
+    uint32_t stride;        // 位图跨度或Y分量跨度
+    uint8_t *clutPhyAddr;   // clut表地址, 用作颜色扩展或颜色校正
+    bool isYCbCrClut;       // clut表是否位于y_cb_cr空间
+    bool isAlphaMax255;     // 位图alpha最大值为255还是128
+    bool isAlphaExt1555;    // 是否使能1555的alpha扩展
+    uint8_t alpha0;         // alpha0、alpha1值, 用作ARGB1555格式
+    uint8_t alpha1;
+    uint32_t cbCrPhyAddr;   // cb_cr分量地址
+    uint32_t cbCrStride;    // cb_cr分量跨度
+};
+
+struct TdeColorKeyComponent {
+    uint8_t comMin;
+    uint8_t comMax;
+    uint8_t isCompOut;
+    uint8_t isCompIgnore;
+    uint8_t comMask;
+    uint8_t reserved;
+    uint8_t reserved1;
+    uint8_t reserved2;
+};
+
+struct TdeColorKey {
+    TdeColorKeyComponent alpha;
+    TdeColorKeyComponent redOrYOrClut;
+    TdeColorKeyComponent greenOrCb;
+    TdeColorKeyComponent blueOrCr;
+};
+
+struct TdeBlendOption {
+    bool isGlobalAlphaEnable;
+    bool isPixelAlphaEnable;
+    bool isSrc1AlphaPremulti;
+    bool isSrc2AlphaPremulti;
+    TdeBlendCmd blendCmd;
+    TdeBlendMode src1BlendMode; // 在 blendCmd = TDE2_BLENDCMD_CONFIG 时有效
+    TdeBlendMode src2BlendMode;
+};
+
+struct TdeCscOption {
+    bool isInputCscUserEnable;
+    bool isInputCscParamReload;
+    bool isOutputCscUserEnable;
+    bool isOutputCscParamReload;
+    uint32_t inputCscParamAddr;
+    uint32_t inputCscParamAddrSize;
+    uint32_t outputCscParamAddr;    // OCSC参数地址, 要求128bit对齐
+    uint32_t outputCscParamAddrSize;
+};
+
+struct TdeRect {
+    int32_t xPos;
+    int32_t yPos;
+    uint32_t width;
+    uint32_t height;
+};
+
+/* blit操作选项定义 */
+struct TdeOption {
+    TdeAlgorithmType aluCmd;        // 逻辑运算方式
+    TdeRopCode colorRopCode;        // 颜色空间ROP类型
+    TdeRopCode alphaRopCode;        // alpha的ROP类型
+    TdeColorKeyMode colorKeyMode;
+    TdeColorKey colorKeyValue;
+    TdeClipMode clipMode;
+    TdeRect clipRect;
+    TdeDeflickerMode deflickerMode; // 抗闪烁模式
+    bool isResize;                  // 是否缩放
+    TdeFilterMode filterMode;       // 缩放时使用的滤波模式
+    TdeMirrorMode mirrorMode;       // 镜像类型
+    bool isClutReload;
+    uint8_t globalAlpha;
+    TdeOutAlpha outAlphaFrom;
+    uint32_t colorize;
+    TdeBlendOption blendOpt;
+    TdeCscOption cscOpt;
+    bool isCompress;
+    bool isDecompress;
+};
+
+struct TdeScale {
+    TdeSurface foreGround;
+    TdeSurface backGround;
+    TdeSurface dst;
+    TdeRect foreGroundRect;
+    TdeRect backGroundRect;
+    TdeRect dstRect;
+    TdeOption stOpt;
+};
+
+struct WaterMarkInfo {
+    uint32_t width;
+    uint32_t height;
+    int32_t xCoordinate;
+    int32_t yCoordinate;
+    int32_t pixelsLength;
+    std::unique_ptr<int32_t []> pixels;
+};
+#endif
