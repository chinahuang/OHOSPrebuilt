+int32_t AudioHal::SetOverModulation(const int32_t overModulation)
+{
+    if ((!m_isInit) && (Init() != RETURN_SUCCESS)) {
+        LOGE("Sif has not initialized.");
+        return RETURN_FAILURE;
+    }
+
+    uapi_sif_over_deviation sifOverDeviation;
+    switch (overModulation) {
+        case OVER_MODULATION_50K:
+            sifOverDeviation = UAPI_SIF_OVER_DEVIATION_50K;
+            break;
+        case OVER_MODULATION_100K:
+            sifOverDeviation = UAPI_SIF_OVER_DEVIATION_100K;
+            break;
+        case OVER_MODULATION_200K:
+            sifOverDeviation = UAPI_SIF_OVER_DEVIATION_200K;
+            break;
+        case OVER_MODULATION_384K:
+            sifOverDeviation = UAPI_SIF_OVER_DEVIATION_384K;
+            break;
+        case OVER_MODULATION_540K:
+            sifOverDeviation = UAPI_SIF_OVER_DEVIATION_540K;
+            break;
+        default:
+            sifOverDeviation = UAPI_SIF_OVER_DEVIATION_50K;
+            break;
+    }
+    int32_t ret = uapi_sif_set_over_deviation(UAPI_SIF_ID_0, sifOverDeviation);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_sif_set_over_deviation fail, ret=%d", ret);
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
+
+int32_t AudioHal::GetOverModulation(int32_t &overModulation)
+{
+    if ((!m_isInit) && (Init() != RETURN_SUCCESS)) {
+        LOGE("Sif has not initialized.");
+        return RETURN_FAILURE;
+    }
+
+    uapi_sif_over_deviation sifOverDeviation;
+    int32_t ret = uapi_sif_get_over_deviation(UAPI_SIF_ID_0, &sifOverDeviation);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_sif_get_over_deviation fail, ret=%d", ret);
+        return RETURN_FAILURE;
+    }
+
+    switch (sifOverDeviation) {
+        case UAPI_SIF_OVER_DEVIATION_50K:
+            overModulation = OVER_MODULATION_50K;
+            break;
+        case UAPI_SIF_OVER_DEVIATION_100K:
+            overModulation = OVER_MODULATION_100K;
+            break;
+        case UAPI_SIF_OVER_DEVIATION_200K:
+            overModulation = OVER_MODULATION_200K;
+            break;
+        case UAPI_SIF_OVER_DEVIATION_384K:
+            overModulation = OVER_MODULATION_384K;
+            break;
+        case UAPI_SIF_OVER_DEVIATION_540K:
+            overModulation = OVER_MODULATION_540K;
+            break;
+        default:
+            overModulation = OVER_MODULATION_50K;
+            break;
+    }
+    return RETURN_SUCCESS;
+}
