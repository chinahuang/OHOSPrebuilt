+#define LOG_NDEBUG 0
+#define LOG_TAG "HdmiAudioControllerHal"
+
+#include "HdmiAudioControllerHal.h"
+
+namespace {
+    constexpr int32_t WAIT_FOR_PUT_BUF_TIMES = 8;
+    constexpr int32_t MAX_LOOP_CNT = 1000;
+    constexpr int32_t REPORT_HDMI_INFO_CNT = 100;
+}
+
+HdmiAudioControllerHal &GetHdmiAudioControllerHal()
+{
+    return HdmiAudioControllerHal::GetInstance();
+}
+
+HdmiAudioControllerHal &HdmiAudioControllerHal::GetInstance()
+{
+    static HdmiAudioControllerHal hdmiAudioControllerHal;
+    return hdmiAudioControllerHal;
+}
+
+HdmiAudioControllerHal::HdmiAudioControllerHal()
+{
+
+}
