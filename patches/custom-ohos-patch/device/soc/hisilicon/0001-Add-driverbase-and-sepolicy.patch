+int32_t VideoOutputHal::SetWinAspectMode(WinAspectMode aspectMode)
+{
+	std::vector <uint32_t> windows = GetCurWindowInfo();
+	if (windows.size() != 1) {
+		LOGE("not one window, not supported");
+		return RETURN_FAILURE;
+	}
+
+	if (Check() != RETURN_SUCCESS) {
+		LOGE("Check failed");
+		return RETURN_FAILURE;
+	}
+
+	uapi_win_aspect_mode winMode{};
+	uapi_win_aspect_attr winAttr{};
+	td_s32 ret = uapi_win_get_aspect_attr(windows.at(0), &winMode, &winAttr);
+	if (ret != TD_SUCCESS) {
+		LOGE("uapi_win_get_aspect_attr failed. ret=0x%x", ret);
+		return RETURN_FAILURE;
+	}
+	LOGI("aspect mode=%d", winMode);
+
+	td_handle winHandle[1]{windows.at(0)};
+	uapi_win_aspect_mode aspectModes[1]{ConvertSetAspectMode(aspectMode)};
+	if (winMode == aspectModes[0]) {
+		LOGE("cur window 0x%x has been aspect %d, not set again.", windows.at(0), winMode);
+		return RETURN_SUCCESS;
+	}
+
+	ret = uapi_win_set_aspect_attr(winHandle, aspectModes, &winAttr, 1);
+	if (ret != TD_SUCCESS) {
+		LOGE("uapi_win_set_aspect_attr failed. ret=0x%x", ret);
+		return RETURN_FAILURE;
+	}
+
+	return RETURN_SUCCESS;
+}
+
+uapi_win_aspect_mode VideoOutputHal::ConvertSetAspectMode(WinAspectMode aspectMode) const
+{
+	const static std::unordered_map <WinAspectMode, uapi_win_aspect_mode> aspectMap {
+		{WIN_ASPECT_FULL, UAPI_WIN_ASPECT_CONVERT_FULL},
+		{WIN_ASPECT_BLACK, UAPI_WIN_ASPECT_CONVERT_LETTERBOX},
+		{WIN_ASPECT_SCAN, UAPI_WIN_ASPECT_CONVERT_PAN_SCAN},
+		{WIN_ASPECT_BLACK_AND_SCAN, UAPI_WIN_ASPECT_CONVERT_COMBINED},
+		{WIN_ASPECT_P2P, UAPI_WIN_ASPECT_CONVERT_P2P},
+		{WIN_ASPECT_NONLINEAR, UAPI_WIN_ASPECT_CONVERT_NONLINEAR},
+		{WIN_ASPECT_CUSTOM, UAPI_WIN_ASPECT_CONVERT_CUSTOM}
+	};
+
+	auto item = aspectMap.find(aspectMode);
+	if (item == aspectMap.end()) {
+		LOGE("not find aspectMode=%d, default full.", aspectMode);
+		return UAPI_WIN_ASPECT_CONVERT_FULL;
+	}
+
+	return item->second;
+}
