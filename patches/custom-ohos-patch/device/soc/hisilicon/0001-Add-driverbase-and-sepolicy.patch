+int32_t VideoInputHal::Create(SourceType source,bool isCast)
+{
+    LOGI("VideoInputHal::Create");
+    VideoDecoderHal *decoder = GetVideoDecoder(source);
+    if(decoder == nullptr)
+    {
+        LOGE("decoder is nullptr");
+        return RETURN_FAILURE;
+    }
+    int32_t ret = decoder->Connect(source);
+    if(ret != RETURN_SUCCESS)
+    {
+        return ret;
+    }
+    if(isCast)
+    {
+        m_castSource = source;
+    } else 
+    {
+        m_source = source;
+        m_nonStdInfo.is_non_std = TD_FALSE;
+        m_nonStdInfo.v_freq = 0;
+        m_nonStdInfo.height = 0;
+    }
+    if(source >= SOURCE_HDMI1 && source <= SOURCE_HDMI4)
+    {
+        m_viCapLatency = std::make_unique<ViCapLatencyHal>();
+    }
+    return ret;
