+struct BaseSignal {
+    SignalStatus signalStatus{SIGNAL_BUTT};
+
+    std::shared_mutex rMutex;
+
+    BaseSignal() = default;
+
+    BaseSignal(const BaseSignal &rhs)
+    {
+        signalStatus = rhs.signalStatus;
+    }
+
+    BaseSignal &operator=(const BaseSignal &rhs)
+    {
+        signalStatus = rhs.signalStatus;
+        return *this;
+    }
+
+    virtual ~BaseSignal() = default;
+
+    virtual std::string ToString() const
+    {
+        std::ostringstream ss;
+        ss << std::endl << "SignalStatus:" << signalStatus <<std::endl;
+        return ss.str();
+    }
+};
+
+struct VideoInfoSignal : public BaseSignal {
+    VideoInfo videoInfo{};
+    AvStreamInfo streamInfo{};
+
+    bool operator==(const VideoInfoSignal &other) const
+    {
+        return (this->signalStatus == other.signalStatus) && 
+            (this->videoInfo.width == other.videoInfo.width) &&
+            (this->videoInfo.height == other.videoInfo.height) &&
+            (this->videoInfo.frameRate == other.videoInfo.frameRate) &&
+            (this->videoInfo.isInterlace == other.videoInfo.isInterlace) &&
+            (this->videoInfo.pixelFormat == other.videoInfo.pixelFormat) &&
+            (this->videoInfo.isHdmiMode == other.videoInfo.isHdmiMode) &&
+            (this->videoInfo.isMhl == other.videoInfo.isMhl);
+    }
+
+    bool operator!=(const VideoInfoSignal &other) const
+    {
+        return !(*this == other);
+    }
+
+    std::string ToString() const override
+    {
+        std::ostringstream ss;
+        ss << BaseSignal::ToString();
+        ss << "VideoInfo:" << std::endl;
+        ss << "----width:" << videoInfo.width << ", height:" << videoInfo.height << std::endl;
+        ss << "----frameRate:" << videoInfo.frameRate << " pixelFormat:" << videoInfo.pixelFormat << std::endl;
+        ss << "----isInterlance:" << videoInfo.isInterlace << std::endl;
+        ss << "----isHdmiMode:" << videoInfo.isHdmiMode << ", isMhl:" << videoInfo.isMhl << std::endl;
+        ss << "StreamInfo:" << std::endl;
+        ss << "----contentCnt:" << streamInfo.contentSize << std::endl;
+        ss << "----hasVideo:" << streamInfo.hasVideo << ", hasAudio:" << streamInfo.hasAudio << std::endl;
+        return ss.str();
+    }
+
+    void Reset()
+    {
+        signalStatus = SIGNAL_BUTT;
+        videoInfo = {};
+        streamInfo = {};
+    }
+};
+
+struct HdmiAudioSignal : public BaseSignal {
+    HdmiFormat hdmiFormat{HDMI_FORMAT_BUTT};
+    HdmiAudioAttr audioInfo{};
+
+    bool operator==(const HdmiAudioSignal &other) const
+    {
+        return (this->hdmiFormat == other.hdmiFormat) && 
+            (this->signalStatus == other.signalStatus) &&
+            (this->audioInfo.nChannel == other.audioInfo.nChannel) &&
+            (this->audioInfo.bitDepth == other.audioInfo.bitDepth) &&
+            (this->audioInfo.sampleRate == other.audioInfo.sampleRate) &&
+            (this->audioInfo.dataFmt == other.audioInfo.dataFmt) &&
+            (this->audioInfo.dataType == other.audioInfo.dataType);
+    }
+
+    bool operator!=(const HdmiAudioSignal &other) const
+    {
+        return !(*this == other);
+    }
+
+    std::string ToString() const override
+    {
+        std::ostringstream ss;
+        ss << BaseSignal::ToString();
+        ss << "HdmiAudioAttr:" << std::endl;
+        ss << "----nChannel:" << audioInfo.nChannel << std::endl;
+        ss << "----bitDepth:" << audioInfo.bitDepth << std::endl;
+        ss << "----sampleRate:" << audioInfo.sampleRate << std::endl;
+        ss << "----dataFmt:" << audioInfo.dataFmt << std::endl;
+        ss << "----dataType:" << audioInfo.dataType << std::endl;
+        return ss.str();
+    }
+
+    void Reset()
+    {
+        signalStatus = SIGNAL_BUTT;
+        hdmiFormat = HDMI_FORMAT_BUTT;
+        audioInfo = {};
+    }
+};
