diff --git a/common/driverbase/hal/DisplayHal.cpp b/common/driverbase/hal/DisplayHal.cpp
new file mode 100644
index 0000000..8c4f507
--- /dev/null
+++ b/common/driverbase/hal/DisplayHal.cpp
@@ -0,0 +1,362 @@
+
+#define LOG_NDEBUG 0
+#define LOG_TAG "DisplayHal"
+
+#include "DisplayHal.h"
+
+#include "CommonDef.h"
+#include "ConfigFactory.h"
+
+DisplayHal *DisplayHal::GetDisplayHal(uapi_disp displayId)
+{
+	switch (displayId) {
+		case UAPI_DISPLAY0:
+			static DisplayHal displayHal0(displayId);
+			return &displayHal0;
+		case UAPI_DISPLAY1:
+			static DisplayHal displayHal1(displayId);
+			return &displayHal1;
+		case UAPI_DISPLAY2:
+			static DisplayHal displayHal2(displayId);
+			return &displayHal2;
+		default:
+			return nullptr;
+	}
+}
+
+int32_t DisplayHal::Connect(uapi_disp srcDisplayId)
+{
+	if (CheckInitDisp() != RETURN_SUCCESS) {
+		LOGE("check init failed");
+		return RETURN_FAILURE;
+	}
+	td_s32 ret = uapi_disp_attach(m_distDisplayId, srcDisplayId);
+	if (ret != TD_SUCCESS) {
+		LOGE("uapi_disp_attach failed, ret[0x%x]", ret);
+		return RETURN_FAILURE;
+	}
+	m_srcDisplayId = srcDisplayId; //记录源display通道，便于释放资源
+	return RETURN_SUCCESS;
+}
+
+int32_t DisplayHal::Disconnect(uapi_disp srcDisplayId)
+{
+	if (CheckInitDisp() != RETURN_SUCCESS) {
+		LOGE("check init failed");
+		return RETURN_FAILURE;
+	}
+	if (srcDisplayId < UAPI_DISPLAY0 || srcDisplayId >= UAPI_DISPLAY_MAX) {
+		return RETURN_FAILURE;
+	}
+	td_s32 ret = uapi_disp_detach(m_distDisplayId, srcDisplayId);
+	if (ret != TD_SUCCESS) {
+		LOGE("uapi_disp_detach failed, ret[0x%x]", ret);
+		return RETURN_FAILURE;
+	}
+	return RETURN_SUCCESS;
+}
+
+int32_t DisplayHal::BindOutIntf(const uapi_disp_intf &displayIntf)
+{
+	if (CheckInitDisp() != RETURN_SUCCESS) {
+		LOGE("check init failed");
+		return RETURN_FAILURE;
+	}
+	if (m_isAttached) {
+		LOGE("deAttach is invoked first");
+		return RETURN_FAILURE;
+	}
+	td_s32 ret = uapi_disp_attach_intf(m_distDisplayId, &displayIntf, DISPLAY_DEFAULT_INTF_NUM);
+	if (ret != TD_SUCCESS) {
+		LOGE("uapi_disp_attach_intf failed, ret[0x%x]", ret);
+		return RETURN_FAILURE;
+	}
+	m_isAttached = true;
+	m_displayIntf = displayIntf;
+	return RETURN_SUCCESS;
+	LOGI(" DisplayHal::BindOutIntf not impl");
+	return RETURN_SUCCESS;
+}
+
+int32_t DisplayHal::UnBindOutIntf(const uapi_disp_intf &displayIntf)
+{
+	if (!m_isAttached) {
+		LOGW("no attach interface");
+		return RETURN_SUCCESS;
+	}
+	td_s32 ret = uapi_disp_detach_intf(m_distDisplayId, &displayIntf, DISPLAY_DEFAULT_INTF_NUM);
+	if (ret != TD_SUCCESS) {
+		LOGE("uapi_disp_detach_intf failed, ret[0x%x]", ret);
+		return RETURN_FAILURE;
+	}
+	m_isAttached = false;
+	return RETURN_SUCCESS;
+}
+
+int32_t DisplayHal::SetFormat(const uapi_disp_format &displayFormat)
+{
+	if (CheckInitDisp() != RETURN_SUCCESS) {
+		LOGE("check init failed");
+		return RETURN_FAILURE;
+	}
+	td_s32 ret = uapi_disp_set_disp_format(&m_distDisplayId, &displayFormat, DISPLAY_DEFAULT_CHANNEL_NUM);
+	if (ret != TD_SUCCESS) {
+		LOGE("uapi_disp_set_disp_format failed, ret[0x%x]", ret);
+		return RETURN_FAILURE;
+	}
+	return RETURN_SUCCESS;
+	LOGI(" DisplayHal::SetFormat not impl");
+	return RETURN_SUCCESS;
+}
+
+int32_t DisplayHal::GetFormat(uapi_disp_format &displayFormat)
+{
+	if (CheckInitDisp() != RETURN_SUCCESS) {
+		LOGE("check init failed");
+		return RETURN_FAILURE;
+	}
+	td_s32 ret = uapi_disp_get_disp_format(m_distDisplayId, &displayFormat);
+	if (ret != TD_SUCCESS) {
+		LOGE("uapi_disp_get_disp_format failed, ret[0x%x]", ret);
+		return RETURN_FAILURE;
+	}
+	return RETURN_SUCCESS;
+}
+
+int32_t DisplayHal::GetDisplayResolution(uint32_t &width, uint32_t &height)
+{
+	if (CheckInitDisp() != RETURN_SUCCESS) {
+		LOGE("check init failed");
+		return RETURN_FAILURE;
+	}
+	td_s32 ret = uapi_disp_get_virtual_screen(m_distDisplayId, &width, &height);
+	if (ret != TD_SUCCESS) {
+		LOGE("uapi_disp_get_virtual_screen failed, ret[0x%x]", ret);
+		return RETURN_FAILURE;
+	}
+	return RETURN_SUCCESS;
+}
+
+int32_t DisplayHal::Open()
+{
+	if (CheckInitDisp() != RETURN_SUCCESS) {
+		LOGE("check init failed");
+		return RETURN_FAILURE;
+	}
+	td_s32 ret = uapi_disp_open(m_distDisplayId);
+	if (ret != TD_SUCCESS) {
+		LOGE("uapi_disp_open failed, m_distDisplayId[%d], ret[0x%x]", m_distDisplayId, ret);
+		return RETURN_FAILURE;
+	}
+	m_dispState = DISPLAY_OPENED;
+	return RETURN_SUCCESS;
+}
+
+int32_t DisplayHal::Close()
+{
+	if (m_dispState < DISPLAY_OPENED) {
+		LOGW("display device is closed");
+		return RETURN_SUCCESS;
+	}
+	if (m_dispState > DISPLAY_OPENED) {
+		LOGE("DisplayHal state is invalid");
+		return RETURN_FAILURE;
+	}
+	td_s32 ret = uapi_disp_close(m_distDisplayId);
+	if (ret != TD_SUCCESS) {
+		LOGE("uapi_disp_close failed, m_distDisplayId[%d], ret[0x%x]", m_distDisplayId, ret);
+		return RETURN_FAILURE;
+	}
+	m_dispState = DISPLAY_INITED;
+	return RETURN_SUCCESS;
+}
+
+int32_t DisplayHal::InitDisp()
+{
+	if (m_dispState > DISPLAY_BEGIN && m_dispState <= DISPLAY_OPENED) {
+		LOGW("disp is inited");
+		return RETURN_SUCCESS;
+	}
+
+	td_s32 ret = uapi_disp_init();
+	if (ret != TD_SUCCESS) {
+		LOGE("uapi_disp_init failed, ret[0x%x]", ret);
+		return RETURN_FAILURE;
+	}
+	m_dispState = DISPLAY_INITED; // 状态切换，其他行为函数也要做类似转换
+	return RETURN_SUCCESS;
+}
+
+int32_t DisplayHal::InitDispMng()
+{
+	if (m_dispMngState > DISPLAY_BEGIN && m_dispMngState <= DISPLAY_OPENED) {
+		LOGW("dispmng is inited");
+		return RETURN_SUCCESS;
+	}
+
+	td_s32 ret = uapi_svr_dispmng_init();
+	if (ret != TD_SUCCESS) {
+		LOGE("uapi_svr_dispmng_init failed, ret[0x%x]", ret);
+		return RETURN_FAILURE;
+	}
+	m_dispMngState = DISPLAY_INITED; // 状态切换，其他行为函数也要做类似转换
+	return RETURN_SUCCESS;
+}
+
+int32_t DisplayHal::DeInit()
+{
+	if (m_dispState != DISPLAY_INITED) {
+		LOGE("display device state is %d, don't deInit", m_dispState);
+	} else {
+		td_s32 ret = uapi_disp_deinit();
+		if (ret != TD_SUCCESS) {
+			LOGE("uapi_disp_deinit failed, ret[0x%x]", ret);
+		}
+		m_dispState = DISPLAY_BEGIN;
+	}
+
+	if (m_dispMngState != DISPLAY_INITED) {
+		LOGE("display mng device state is %d, don't deInit", m_dispMngState);
+		return RETURN_FAILURE;
+	} else {
+		td_s32 ret = uapi_svr_dispmng_deinit();
+		if (ret != TD_SUCCESS) {
+			LOGE("uapi_svr_dispmng_deinit failed, ret[0x%x]", ret);
+			return RETURN_FAILURE;
+		}
+		m_dispMngState = DISPLAY_BEGIN;
+	}
+
+	return RETURN_SUCCESS;
+}
+
+/*
+int32_t DisplayHal::SetTestPattern(bool isEnable, const uapi_disp_color &patternAttr)
+{
+    if(CheckInitDisp() != RETURN_SUCCESS) {
+        LOGE("check init failed");
+        return RETURN_FAILURE;
+    }
+    td_bool unfIsEnable = isEnable ? TD_TRUE : TD_FALSE;
+    td_s32 ret;
+    if(unfIsEnable == TD_FALSE) {
+        ret = uapi_disp_set_bg_color(m_distDisplayId, &patternAttr);
+        if(ret != TD_SUCCESS) {
+            LOGE("HI_UNF_DISP_SetBackgroundColor failed, ret[0x%x]", ret);
+            return RETURN_FAILURE;
+        }  
+    } 
+    ret = uapi_disp_set_test_pattern(m_distDisplayId, unfIsEnable, &patternAttr);
+    if(ret != TD_SUCCESS) {
+        LOGE("HI_UNF_DISP_SetTestPatternExt failed, ret[0x%x]", ret);
+        return RETURN_FAILURE;
+    } 
+    return RETURN_SUCCESS;
+}
+*/
+
+int32_t DisplayHal::CheckInitDisp()
+{
+	if (m_dispState > DISPLAY_BEGIN && m_dispState <= DISPLAY_OPENED) {
+		return RETURN_SUCCESS;
+	}
+	return InitDisp();
+}
+
+int32_t DisplayHal::CheckInitDispMng()
+{
+	if (m_dispMngState > DISPLAY_BEGIN && m_dispMngState <= DISPLAY_OPENED) {
+		return RETURN_SUCCESS;
+	}
+	return InitDispMng();
+}
+
+DisplayHal::DisplayHal(uapi_disp displayId) : m_distDisplayId(displayId)
+{
+	LOGI("construct m_displayId[%d]", m_distDisplayId);
+}
+
+DisplayHal::~DisplayHal()
+{
+	LOGI("deconstruct m_displayId[%d]", m_distDisplayId);
+	static_cast<void>(Disconnect(m_srcDisplayId));
+	static_cast<void>(Close());
+	static_cast<void>(UnBindOutIntf(m_displayIntf));
+	static_cast<void>(DeInit());
+}
+
+int32_t DisplayHal::SetDisplayVrr(bool isEnable)
+{
+	if (CheckInitDispMng() != RETURN_SUCCESS) {
+		LOGE("check init failed");
+		return RETURN_FAILURE;
+	}
+
+	td_s32 ret = uapi_svr_dispmng_set_vrr_enable(UAPI_SVR_DISPMNG_DISPLAY_ID_0, isEnable ? TD_TRUE : TD_FALSE);
+	if (ret != TD_SUCCESS) {
+		LOGE("uapi_svr_dispmng_set_vrr_enable failed. ret=0x%x", ret);
+		return RETURN_FAILURE;
+	}
+	return RETURN_SUCCESS;
+}
+
+int32_t DisplayHal::SetDisplayAllmAttr(uapi_svr_disp_allm_attr &allmAttr)
+{
+	if (CheckInitDispMng() != RETURN_SUCCESS) {
+		LOGE("check init failed");
+		return RETURN_FAILURE;
+	}
+
+	td_s32 ret = uapi_svr_dispmng_set_allm_attr(UAPI_SVR_DISPMNG_DISPLAY_ID_0, &allmAttr);
+	if (ret != TD_SUCCESS) {
