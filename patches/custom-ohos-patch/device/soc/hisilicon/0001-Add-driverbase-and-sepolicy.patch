+string RxCecCtrlHal::GetCecLogAddrName(CecLogicalAddr type) const
+{
+    if(type > CEC_LOGADDR_BUTT || type < CEC_LOGADDR_TV)
+    {
+        return "no this cec logical address type";
+    }
+
+    static const unordered_map<CecLogicalAddr, string> logicalAddrNameMap = 
+    {
+        {CEC_LOGADDR_TV, "[0x0]TV"},
+        {CEC_LOGADDR_RECDEV1, "[0x1]RecDev1"},
+        {CEC_LOGADDR_RECDEV2, "[0x2]RecDev2"},
+        {CEC_LOGADDR_TUNER1, "[0x3]Tuner1"},
+        {CEC_LOGADDR_PLAYBACK1, "[0x4]PlayBack1"},
+        {CEC_LOGADDR_AUDSYS, "[0x5]AudSys"},
+        {CEC_LOGADDR_TUNER2, "[0x6]Tuner2"},
+        {CEC_LOGADDR_TUNER3, "[0x7]Tuner3"},
+        {CEC_LOGADDR_PLAYBACK2, "[0x8]PlayBack2"},
+        {CEC_LOGADDR_RECDEV3, "[0x9]RecDev3"},
+        {CEC_LOGADDR_TUNER4, "[0xA]Tuner4"},
+        {CEC_LOGADDR_PLAYBACK3, "[0xB]PlayBack3"},
+        {CEC_LOGADDR_RES3, "[0xC]Resv3"},
+        {CEC_LOGADDR_RES4, "[0xD]Resv4"},
+        {CEC_LOGADDR_FREEUSE, "[0xE]FreeUse"},
+        {CEC_LOGADDR_UNREGORBC, "[0xF]unRegOrBC"},
+        {CEC_LOGADDR_BUTT, "BUTT"}
+    };
+
+    return logicalAddrNameMap.at(type);
+}
+
+string RxCecCtrlHal::GetCecOpCodeName(CecOpcode code) const
+{
+    if (m_cecOpCodeMap.count(code) == 0)
+    {
+        LOGE("Cec OpCode [0x%x] not found!", code);
+        std::string res("invalid cec opcode!");
+        return res;
+    }
+
+    return m_cecOpCodeMap.at(code);
+}
