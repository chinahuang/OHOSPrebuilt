+
+ #ifndef DRIVERBASE_LOGDEF_H
+ #define DRIVERBASE_LOGDEF_H
+ 
+ #include <sys/time.h>
+ //#include "utils/log.h"
+ #include "hilog/log.h"
+ 
+ #undef DRIVERBASE_LOG_DOMAIN
+ #define DRIVERBASE_LOG_DOMAIN 0xD002B73
+ #ifndef DRIVERBASE_MLOG_TAG
+ #define DRIVERBASE_MLOG_TAG "DriverBase"
+ #endif
+ #undef DRIVERBASE_LOG_TAG
+ #define DRIVERBASE_LOG_TAG "DriverBase"
+ 
+ 
+ static inline OHOS::HiviewDFX::HiLogLabel DriverBaseLogLable()
+ {
+     return { LOG_CORE, DRIVERBASE_LOG_DOMAIN, DRIVERBASE_LOG_TAG };
+ }
+ 
+ #define __FILE_NAME__ (__builtin_strrchr(__FILE__, '/') ? __builtin_strrchr(__FILE__, '/') + 1 : __FILE__)
+ 
+ #define DRIVERBASE_HILOG_DEBUG(op, fmt, args...) \
+     do {                                  \
+         op(DriverBaseLogLable(), DRIVERBASE_MLOG_TAG "[{%{public}s:%{public}s:%{public}d] " fmt, __FILE_NAME__, __FUNCTION__, __LINE__, ##args);  \
+     } while (0)
+ 
+ #define DRIVERBASE_HILOG_ERROR(op, fmt, args...) \
+     do {                                  \
+         op(DriverBaseLogLable(), DRIVERBASE_MLOG_TAG "[{%{public}s:%{public}s:%{public}d] " fmt, __FILE_NAME__, __FUNCTION__, __LINE__, ##args);  \
+     } while (0)
+ 
+ #define DRIVERBASE_HILOG_WARN(op, fmt, args...) \
+     do {                                  \
+         op(DriverBaseLogLable(), DRIVERBASE_MLOG_TAG "[{%{public}s:%{public}s:%{public}d] " fmt, __FILE_NAME__, __FUNCTION__, __LINE__, ##args);  \
+     } while (0)
+ 
+ #define DRIVERBASE_HILOG_INFO(op, fmt, args...) \
+     do {                                  \
+         op(DriverBaseLogLable(), DRIVERBASE_MLOG_TAG "[{%{public}s:%{public}s:%{public}d] " fmt, __FILE_NAME__, __FUNCTION__, __LINE__, ##args);  \
+     } while (0)
+     
+ #define DRIVERBASE_HILOG_FATAL(op, fmt, args...) \
+     do {                                  \
+         op(DriverBaseLogLable(), DRIVERBASE_MLOG_TAG "[{%{public}s:%{public}s:%{public}d] " fmt, __FILE_NAME__, __FUNCTION__, __LINE__, ##args);  \
+     } while (0)
+ 
+ 
+ #ifdef PRINTF_DEBUG
+ 
+ #define PRINT_DEBUG_TIME                                                        \
+     do {                                                                        \
+         struct timespec time = { 0, 0 };                                        \
+         clock_gettime(CLOCK_MONOTONIC, &time);                                  \
+         printf("%ld ms\t", (time.tv_sec * 1000) + (time.tv_nsec / 1000000));    \
+     } while (0)                                                                 \
+ 
+ #if defined(PRINTF_DEBUG_LEVEL) && (PRINTF_DEBUG_LEVEL >= 1)
+ #define LOGE(fmt, ...)                                                                                          \
+     do {                                                                                                        \
+         PRINT_DEBUG_TIME;                                                                                       \
+         printf(DRIVERBASE_MLOG_TAG" %s\t E [%s][%s][%d]: " fmt, LOG_TAG, __FILE_NAME__, __FUNCTION__, __LINE__, ##__VA_ARGS__); \
+     } while (0)
+ #define LOGF(fmt, ...)                                                                                          \
+     do {                                                                                                        \
+         PRINT_DEBUG_TIME;                                                                                       \
+         printf(DRIVERBASE_MLOG_TAG" %s\t F [%s][%s][%d]: " fmt, LOG_TAG, __FILE_NAME__, __FUNCTION__, __LINE__, ##__VA_ARGS__); \
+     } while (0)
+ #else
+ #define LOGE(fmt, ...) (void(0))
+ #define LOGF(fmt, ...) (void(0))
+ #endif
+ 
+ #if defined(PRINTF_DEBUG_LEVEL) && (PRINTF_DEBUG_LEVEL >= 2)
+ #define LOGW(fmt, ...)                                                                                          \
+     do {                                                                                                        \
+         PRINT_DEBUG_TIME;                                                                                       \
+         printf(DRIVERBASE_MLOG_TAG" %s\t W [%s][%s][%d]: " fmt, LOG_TAG, __FILE_NAME__, __FUNCTION__, __LINE__, ##__VA_ARGS__); \
+     } while (0)
+ #else
+ #define LOGW(fmt, ...) (void(0))
+ #endif
+ 
+ #if defined(PRINTF_DEBUG_LEVEL) && (PRINTF_DEBUG_LEVEL >= 3)
+ #define LOGI(fmt, ...)                                                                                          \
+     do {                                                                                                        \
+         PRINT_DEBUG_TIME;                                                                                       \
+         printf(DRIVERBASE_MLOG_TAG" %s\t I [%s][%s][%d]: " fmt, LOG_TAG, __FILE_NAME__, __FUNCTION__, __LINE__, ##__VA_ARGS__); \
+     } while (0)
+ #else
+ #define LOGI(fmt, ...) (void(0))
+ #endif
+ 
+ #if defined(PRINTF_DEBUG_LEVEL) && (PRINTF_DEBUG_LEVEL >= 4)
+ #define LOGD(fmt, ...)                                                                                          \
+     do {                                                                                                        \
+         PRINT_DEBUG_TIME;                                                                                       \
+         printf(DRIVERBASE_MLOG_TAG" %s\t D [%s][%s][%d]: " fmt, LOG_TAG, __FILE_NAME__, __FUNCTION__, __LINE__, ##__VA_ARGS__); \
+     } while (0)
+ #else
+ #define LOGD(fmt, ...) (void(0))
+ #endif
+ 
+ #else
+ #define LOGD(fmt, ...) DRIVERBASE_HILOG_DEBUG(OHOS::HiviewDFX::HiLog::Debug, fmt, ##__VA_ARGS__)
+ #define LOGE(fmt, ...) DRIVERBASE_HILOG_ERROR(OHOS::HiviewDFX::HiLog::Error, fmt, ##__VA_ARGS__)
+ #define LOGW(fmt, ...) DRIVERBASE_HILOG_WARN(OHOS::HiviewDFX::HiLog::Warn, fmt, ##__VA_ARGS__)
+ #define LOGI(fmt, ...) DRIVERBASE_HILOG_INFO(OHOS::HiviewDFX::HiLog::Info, fmt, ##__VA_ARGS__)
+ #define LOGF(fmt, ...) DRIVERBASE_HILOG_FATAL(OHOS::HiviewDFX::HiLog::Fatal, fmt, ##__VA_ARGS__)
+ #endif
+ 
+ #endif
+ 
