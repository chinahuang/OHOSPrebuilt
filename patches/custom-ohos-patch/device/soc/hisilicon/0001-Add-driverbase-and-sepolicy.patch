+int32_t ViCapLatencyHal::AdaptViCapLatency()
+{
+    if(m_cnt % REFRESH_PERIOD != 0){
+        m_cnt = (m_cnt + 1) % REFRESH_PERIOD;
+        return RETURN_SUCCESS;
+    }
+    m_cnt = (m_cnt + 1) % REFRESH_PERIOD;
+
+    td_handle viHandle = VideoInputHal::GetInstance().GetViHandle();
+    if(viHandle == TD_INVALID_HANDLE) {
+        LOGI("vi handle is invalid");
+        return RETURN_FAILURE;
+    }
+
+    uapi_vi_attr attr{};
+    if(uapi_vi_get_attr(viHandle, &attr) != TD_SUCCESS) {
+        LOGE("uapi_vi_get_attr failed.");
+        return RETURN_FAILURE;
+    }
+
+    VideoInfo videoInfo{};
+    if(VideoInputHal::GetInstance().GetVideoInfo(videoInfo) != RETURN_SUCCESS)
+    {
+        LOGE("get video info falied.");
+        return RETURN_FAILURE;
+    }
+
+    uint32_t inFrameRate = videoInfo.frameRate;
+    uint32_t outFrameRate = 0;
+    if(GetVdpOutputBaseFrameRate(outFrameRate) != RETURN_SUCCESS)
+    {
+        LOGE("GetVdpOutputBaseFrameRate failed.");
+        return RETURN_FAILURE;
+    }
+
+    int32_t ret = RETURN_SUCCESS;
+    if(m_pictureMode != attr.picture_mode || m_inFrameRate != inFrameRate || m_outFrameRate != outFrameRate) {
+        LOGI("pictureMode:%d->%d, inFrameRate:%u->%u, outFrameRate:%u->%u",
+             m_pictureMode, attr.picture_mode, m_inFrameRate, inFrameRate, m_outFrameRate, outFrameRate);
+        ret = AdaptOnce(inFrameRate, outFrameRate, attr.picture_mode, viHandle);
+    }
+
+    m_pictureMode = attr.picture_mode;
+    m_inFrameRate = inFrameRate;
+    m_outFrameRate = outFrameRate;
+
+    return ret;
+}
+
+int32_t ViCapLatencyHal::AdaptOnce(uint32_t inFrameRate, uint32_t outFrameRate, 
+    uapi_vi_picture_mode pictureMode, td_handle viHandle)
+{
+    uint32_t latency = LATENCY_LEVEL_2;
+    if(pictureMode != UAPI_VI_PICTURE_MODE_GAME && pictureMode != UAPI_VI_PICTURE_MODE_PC)
+    {
+        LOGI("vi picture mode:%d. reset vi capture latency to %u.", pictureMode, latency);
+        if(SetViCaptureLatency(viHandle, latency) != RETURN_SUCCESS){
+            LOGE("SetViCaptureLatency failed. viHandle:0x%x, latency:%u", viHandle, latency);
+            return RETURN_FAILURE;
+        } else {
+            return RETURN_SUCCESS;
+        }
+    }
+
+    if(CalculateLatency(inFrameRate, outFrameRate, latency) != RETURN_SUCCESS) {
+        LOGE("CalculateLatency failed.");
+        return RETURN_FAILURE;
+    }
+
+    if(SetViCaptureLatency(viHandle, latency) != RETURN_SUCCESS) {
+        LOGE("SetViCaptureLatency failed. viHandle:0x%x, latency:%u", viHandle, latency);
+        return RETURN_FAILURE;
+    }
+
+    LOGI("adapt vi capture latency success. latency:%u", latency);
+    return RETURN_SUCCESS;
+}
+
+int32_t ViCapLatencyHal::GetVdpOutputBaseFrameRate(uint32_t &outBaseFrameRate)
+{
+    uapi_disp_format dispFormat{};
+    if(DisplayHal::GetDisplayHal(UAPI_DISPLAY0)->GetFormat(dispFormat) != RETURN_SUCCESS) {
+        LOGE("get display format failed.");
+        return RETURN_FAILURE;
+    }
+
+    outBaseFrameRate = VideoFormat2FrameRate(dispFormat.video_format);
+    if(outBaseFrameRate == 0){
+        uapi_disp_timing customTiming{};
+        if(uapi_disp_get_custom_timing(UAPI_DISPLAY0, &customTiming) != TD_SUCCESS){
+            LOGE("uapi_disp_get_custom_timing failed.");
+            return RETURN_FAILURE;
+        }
+
+        outBaseFrameRate = customTiming.vert_freq;
+    }
+
+    outBaseFrameRate = static_cast<uint32_t>(round(static_cast<double>(outBaseFrameRate) / FRAME_RATE_MS_TO_S));
+    return RETURN_SUCCESS;
+}
+
+int32_t ViCapLatencyHal::CalculateLatency(uint32_t inFrameRate, uint32_t outFrameRate, uint32_t &latency)
+{
+    LOGI("inFrameRate: %u, outFrameRate: %u", inFrameRate, outFrameRate);
+    if(inFrameRate >= outFrameRate){
+        latency = LATENCY_LEVEL_51;
+    } else if(inFrameRate == outFrameRate / FRAMERATE_HALF) {
+        latency = LATENCY_LEVEL_51;
+    }else if(inFrameRate == FRAME_RATE_24 && outFrameRate == FRAME_RATE_60) {
+        latency = LATENCY_LEVEL_60;
+    } else {
+        latency = LATENCY_LEVEL_100;
+    }
+
+    LOGI("latency: %u", latency);
+    return RETURN_SUCCESS;
+}
+
+int32_t ViCapLatencyHal::SetViCaptureLatency(td_handle viHandle, int32_t captureLatency)
+{
+    td_s32 ret = uapi_vi_set_capture_latency(viHandle, captureLatency);
+    if(ret != TD_SUCCESS) {
+        LOGE("uapi_vi_set_capture_latency: %d failed, viHandle: %d ret:0x%x", captureLatency, viHandle, ret);
+        return RETURN_FAILURE;
+    }
+
+    return RETURN_SUCCESS;
+}
+
+void ViCapLatencyHal::Reset()
+{
+    m_pictureMode = UAPI_VI_PICTURE_MODE_VIDEO;
+    m_inFrameRate = 0;
+    m_outFrameRate = 0;
+}
