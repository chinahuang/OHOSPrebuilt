+int32_t VideoOutputHal::EnableCastWindow(bool isEnable)
+{
+	if (m_castWindow == TD_INVALID_HANDLE) {
+		return RETURN_FAILURE;
+	}
+
+	if (Check() != RETURN_SUCCESS) {
+		LOGE("Check failed");
+		return RETURN_FAILURE;
+	}
+
+	int32_t ret = uapi_win_set_enable(m_castWindow, isEnable ? TD_TRUE : TD_FALSE);
+	if (ret != TD_SUCCESS) {
+		LOGE("uapi_win_set_enable (%d) failed. ret=0x%x", isEnable, ret);
+		return RETURN_FAILURE;
+	}
+
+	return RETURN_SUCCESS;
+}
+
+int32_t VideoOutputHal::SetQuickOutputEnable(bool isEnable)
+{
+	if (m_windowHandle == TD_INVALID_HANDLE) {
+		LOGE("m_windowHandle is invalid");
+		return RETURN_FAILURE;
+	}
+
+	if (Check() != RETURN_SUCCESS) {
+		LOGE("check failed");
+		return RETURN_FAILURE;
+	}
+
+	LOGI("set quickout to %d", isEnable);
+	m_quickOutEn = isEnable;
+	uapi_win_freeze_mode freezeMode = UAPI_WIN_FREEZE_MODE_MAX;
+	td_s32 ret = uapi_win_get_freeze_mode(m_windowHandle, &freezeMode);
+	if (ret != TD_SUCCESS) {
+		LOGE("uapi_win_freeze_mode failed. ret=0x%x", ret);
+	}
+
+	if (freezeMode != UAPI_WIN_FREEZE_MODE_DISABLE) {
+		ret = uapi_win_set_freeze_mode(m_windowHandle, UAPI_WIN_FREEZE_MODE_DISABLE);
+		LOGI("freeze=0");
+		if (ret != TD_SUCCESS) {
+			LOGE("uapi_win_set_freeze_mode failed. ret=0x%x", ret);
+			return RETURN_FAILURE;
+		}
+	}
+
+	uapi_win_quickout_mode quickOutMode = isEnable ? UAPI_WIN_QUICKOUT_SUPER_LOW_DELAY : UAPI_WIN_QUICKOUT_DISABLE;
+	return SetQuickOutputMode(isEnable, quickOutMode);
+}
+
+int32_t VideoOutputHal::SetQuickOutputMode(bool isEnable, uapi_win_quickout_mode targetMode) const
+{
+	uapi_win_quickout_mode curMode = UAPI_WIN_QUICKOUT_MAX;
+	td_s32 ret = uapi_win_get_quickout_mode(m_windowHandle, &curMode);
+	if (ret == TD_SUCCESS && curMode == targetMode) {
+		LOGI("uapi_win_quickout_mode %d is same as current mode, not set again.", targetMode);
+		return RETURN_SUCCESS;
+	}
+
+	if (isEnable) {
+		ret = uapi_win_set_quick_output_enable(m_windowHandle, TD_TRUE);
+		if (ret != TD_SUCCESS) {
+			LOGE("uapi_win_set_quick_output_enable (%d) failed. ret=0x%x", isEnable, ret);
+			return RETURN_FAILURE;
+		}
+
+		ret = uapi_win_set_quickout_mode(m_windowHandle, targetMode);
+		if (ret != TD_SUCCESS) {
+			LOGE("uapi_win_set_quickout_mode (%d) failed. ret=0x%x", targetMode, ret);
+			return RETURN_FAILURE;
+		}
+	} else {
+		ret = uapi_win_set_quickout_mode(m_windowHandle, targetMode);
+		LOGI("uapi_win_set_quickout_mode (%d) ret=0x%x", targetMode, ret);
+		ret = uapi_win_set_quick_output_enable(m_windowHandle, TD_FALSE);
+		if (ret != TD_SUCCESS) {
+			LOGE("uapi_win_set_quick_output_enable (%d) failed. ret=0x%x", isEnable, ret);
+			return RETURN_FAILURE;
+		}
+	}
+
+	return RETURN_SUCCESS;
+}
