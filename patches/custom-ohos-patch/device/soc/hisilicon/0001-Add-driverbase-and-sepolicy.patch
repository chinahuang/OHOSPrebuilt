+int32_t PqHal::GetPqModuleEnable(PqModuleType moduleType, bool &isEnable)
+{
+    int32_t ret = RETURN_FAILURE;
+    td_bool uapiEnable = isEnable ? TD_TRUE : TD_FALSE;
+    auto it = PQ_MODULE_MAP.find(moduleType);
+    if (it != PQ_MODULE_MAP.end()) {
+        ret = uapi_pq_get_module_enable(UAPI_DISPLAY0, UAPI_PQ_IMAGE_GRAPH_ALL, it->second, &uapiEnable);
+        if (ret == TD_SUCCESS) {
+            isEnable = (uapiEnable == TD_TRUE);
+            return RETURN_SUCCESS;
+        }
+        LOGE("uapi_pq_get_module_enable call failed, ret=0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    switch (moduleType) {
+        case PQ_MODULE_NR: {
+            ret = uapi_pq_get_module_enable(UAPI_DISPLAY0, UAPI_PQ_IMAGE_GRAPH_ALL, UAPI_PQ_MODULE_SNR, &uapiEnable);
+            if (ret == TD_SUCCESS) {
+                isEnable = (uapiEnable == TD_TRUE);
+                return RETURN_SUCCESS;
+            }
+            LOGE("uapi_pq_get_module_enable call failed, ret=0x%x", ret);
+            return RETURN_FAILURE;
+        }
+        /* case PQ_MODULE_SR: {
+            uapi_pq_demo_param demoParam{};
+            ret = uapi_pq_get_demo(UAPI_DISPLAY0, UAPI_PQ_IMAGE_GRAPH_ALL, UAPI_PQ_MODULE_SR, &demoParam);
+            if (ret != TD_SUCCESS) {
+                LOGE("uapi_pq_get_demo call failed, ret=0x%x", ret);
+                return RETURN_FAILURE;
+            }
+            isEnable = (demoParam.mode != UAPI_PQ_DEMO_MODE_CLOSE);
+            return RETURN_SUCCESS;
+        } */
+        default:
+            LOGE("not support now");
+            return RETURN_FAILURE;
+    }
+}
