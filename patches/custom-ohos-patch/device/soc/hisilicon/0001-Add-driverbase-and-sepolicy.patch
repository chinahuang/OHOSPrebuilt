+  ]
+}
+
+config("tvhal_dtv_frontend_soc_config") {
+  include_dirs = [
+    "//device/soc/hisilicon/common/driverbase/hal/dtv/frontend/include",
+    "//device/soc/hisilicon/common/driverbase/hal/include/include/",
+    "//device/soc/hisilicon/huanglong/vendor/huanglong/uapi/tvoshal/include/include/",
