+    {
+        m_viCapLatency->Reset();
+    }
+    if(m_viHandle == TD_INVALID_HANDLE)
+    {
+        LOGW("m_viHandle is TD_INVALID_HANDLE");
+        return RETURN_SUCCESS;
+    }
+    int32_t ret = uapi_vi_destroy(m_viHandle);
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("uapi_vi_destroy failed");
+        return RETURN_FAILURE;
+    }
+    m_viHandle = TD_INVALID_HANDLE;
+    return RETURN_SUCCESS;
+}
