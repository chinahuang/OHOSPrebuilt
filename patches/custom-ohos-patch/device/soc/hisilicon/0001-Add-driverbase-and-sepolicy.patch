+#define LOG_NDEBUG 0
+#define LOG_TAG "VideoDecoderHdmiHal"
+
+#include "VideoDecoderHdmiHal.h"
+
+#include "ConfigFactory.h"
+#include "VideoDecoderHal.h"
+#include "VideoInputPortOrder.h"
+
+std::mutex VideoDecoderHdmiHal::m_lock;
+
+VideoDecoderHdmiHal &VideoDecoderHdmiHal::GetInstance()
+{
+    static VideoDecoderHdmiHal videoDecoderHdmiHal;
+    return videoDecoderHdmiHal;
+}
+
+VideoDecoderHdmiHal::VideoDecoderHdmiHal()
+{
+    LOGI("construct");
+}
+
+VideoDecoderHdmiHal::~VideoDecoderHdmiHal()
+{
+    LOGI("deconstruct");
+    static_cast<void>(DeInit());
+}
+
+int32_t VideoDecoderHdmiHal::Init()
+{
+    std::lock_guard<std::mutex> lock(m_lock);
+    if(m_isInited)
+    {
+        return RETURN_SUCCESS;
+    }
+
+    int32_t ret = uapi_hdmirx_init();
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("uapi_hdmirx_init failed");
+        return RETURN_FAILURE;
+    }
+    m_isInited = true;
+    return RETURN_SUCCESS;
+}
+
+int32_t VideoDecoderHdmiHal::DeInit()
+{
+    std::lock_guard<std::mutex> lock(m_lock);
+    if(!m_isInited)
+    {
+        return RETURN_SUCCESS;
+    }
+
+    int32_t ret = uapi_hdmirx_deinit();
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("uapi_hdmirx_deinit failed");
+        return RETURN_FAILURE;
+    }
+    m_isInited = false;
+    return RETURN_SUCCESS;
+
+}
+
+int32_t VideoDecoderHdmiHal::Check()
+{
+    if(m_isInited)
+    {
+        return RETURN_SUCCESS;
+    }
+
+    return Init();
+}
+
+SignalStatus VideoDecoderHdmiHal::GetSignalStatus()
+{
+    if(Check() != RETURN_SUCCESS)
+    {
+        LOGE("check failed");
+        return SIGNAL_BUTT;
+    }
+
+    if(m_connectPort == SOURCE_BUTT)
+    {
+        LOGE("not connect, can`t get signal status");
+        return SIGNAL_BUTT;
+    }
+
+    uapi_sig_status status = UAPI_SIG_STATUS_MAX;
+    int32_t ret = uapi_hdmirx_get_signal_status(ConvertSourceToHdmiPort(m_connectPort), &status);
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("uapi_hdmirx_get_signal_status failed");
+        return SIGNAL_BUTT;
+    }
+
+    SignalStatus signalStatus = ConvertSignalStatus(status);
+    LOGI("signalStatus[%d]", signalStatus);
+
+    return signalStatus;
+}
+
+InputConnectStatus VideoDecoderHdmiHal::GetOfflineSignalStatus(SourceType source)
+{ 
+    if(Check() != RETURN_SUCCESS)
+    {
+        LOGE("check failed");
+        return INPUT_CONNECT_BUTT;
+    }
+
+    uapi_hdmirx_port port = ConvertSourceToHdmiPort(source);
+    uapi_hdmirx_offline_info offlineInfo{};
+    int32_t ret = uapi_hdmirx_get_offline_status(port, &offlineInfo);
+    if(ret != TD_SUCCESS)
+    {
+        return INPUT_CONNECT_BUTT;
+    }
+
+    return (offlineInfo.connected == TD_TRUE) ? INPUT_CONNECTED : INPUT_NOT_CONNECTED;
+}
+
+int32_t VideoDecoderHdmiHal::GetVideoInfo(VideoInfo &videoInfo, [[maybe_unused]]bool isCast)
+{
+    if(Check() != RETURN_SUCCESS)
+    {
+        LOGE("check failed");
+        return SIGNAL_BUTT;
+    }
+
+    uapi_hdmirx_timing_info timingInfo{};
+    int32_t ret = uapi_hdmirx_get_timing_info(ConvertSourceToHdmiPort(m_connectPort), &timingInfo);
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("uapi_hdmirx_get_timing_info failed");
+        return RETURN_FAILURE;
+    }
+
+    videoInfo.isInterlace = (timingInfo.is_interlace == TD_TRUE);
+    videoInfo.height = timingInfo.height;
+    videoInfo.width = timingInfo.width;
+    videoInfo.frameRate = CheckFrameRate(timingInfo.frame_rate);
+    videoInfo.vBlank = timingInfo.v_blank;
+    videoInfo.colorSpace = ConvertColorSpace(timingInfo.color_space);
+    videoInfo.pixelFormat = ConvertPixelFormat(timingInfo.pixel_fmt);
+    videoInfo.frame3D = ConvertFrame3D(timingInfo.fmt);
+    videoInfo.bitWidth = ConvertBitWidth(timingInfo.depth);
+    videoInfo.overSample = ConvertOverSample(timingInfo.oversample);
+    videoInfo.isHdmiMode = (timingInfo.hdmi_mode == TD_TRUE);
+    videoInfo.isMhl = (timingInfo.is_mhl == TD_TRUE);
+    videoInfo.pcMode = (timingInfo.pc_mode == TD_TRUE);
+
+    return RETURN_SUCCESS;
+}
+
+uint32_t VideoDecoderHdmiHal::CheckFrameRate(uint32_t frameRate) const
+{
+    static const std::unordered_map<uint32_t, uint32_t> convertMap
+    {
+        {99, 100},
+        {101, 100},
+        {119, 120},
+        {121, 120}
+    };
+
+    auto item = convertMap.find(frameRate);
+    if(item != convertMap.end())
+    {
+        return item->second;
+    }
+
+    return frameRate;
+}
+
+int32_t VideoDecoderHdmiHal::GetHdmiRxInfo(HdmiRxInfo &hdmiRxInfo)
+{
+    if(Check() != RETURN_SUCCESS)
+    {
+        LOGE("check failed");
+        return RETURN_FAILURE;
+    }
+
+    uapi_hdmirx_video_info videoInfo{};
+    int32_t ret = uapi_hdmirx_get_video_info(ConvertSourceToHdmiPort(m_connectPort), &videoInfo);
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("uapi_hdmirx_get_video_info failed");
+        return RETURN_FAILURE;
+    }
+
+    hdmiRxInfo.allmStatus = ConvertHdmiAllmStatus(videoInfo.allm_status);
+    hdmiRxInfo.vrrMode = ConvertHdmiVrrMode(videoInfo.vrr_mode);
+    hdmiRxInfo.frameRate = videoInfo.cur_frame_rate;
+
+    return RETURN_SUCCESS;
+}
+
+int32_t VideoDecoderHdmiHal::Connect(SourceType source)
+{
+    LOGI("hdmi. port=%d", source);
+    if(Check() != RETURN_SUCCESS)
+    {
+        LOGE("check failed");
+        return RETURN_FAILURE;
+    }
+
+    uapi_hdmirx_port port = ConvertSourceToHdmiPort(source);
+    if(port == UAPI_HDMIRX_PORT_MAX)
+    {
+        LOGE("not support hdmi source=%d", source);
+        return RETURN_FAILURE;
+    }
+
+    int32_t ret = uapi_hdmirx_connect(port);
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("uapi_hdmirx_connect failed. ret=0x%x", ret);
+        return RETURN_FAILURE;
+    }
+
+    m_connectPort = source;
+    return RETURN_SUCCESS;
+}
+
+int32_t VideoDecoderHdmiHal::DisConnect()
+{
+    LOGI("hdmi disconnect");
+    if(Check() != RETURN_SUCCESS)
+    {
+        LOGE("check failed");
+        return RETURN_FAILURE;
+    }
+
+    int32_t ret = uapi_hdmirx_disconnect(ConvertSourceToHdmiPort(m_connectPort));
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("uapi_hdmirx_disconncet failed");
+        return RETURN_FAILURE;
+    }
+
+    m_connectPort = SOURCE_BUTT;
+    return RETURN_SUCCESS;
+}
+
+uapi_hdmirx_port VideoDecoderHdmiHal::ConvertSourceToHdmiPort(const SourceType source) const
+{
+    int32_t port = 0;
+    if(VideoInputPortOrder::GetInstance().Get(source, port) != RETURN_SUCCESS)
+    {
+        LOGI("not set port map. source %d. use default.", source);
+        switch(source)
+        {
+            case SOURCE_HDMI1:
+                return UAPI_HDMIRX_PORT0;
+            case SOURCE_HDMI2:
+                return UAPI_HDMIRX_PORT1;
+            case SOURCE_HDMI3:
+                return UAPI_HDMIRX_PORT2;
+            case SOURCE_HDMI4:
+                return UAPI_HDMIRX_PORT3;
+            default:
+                LOGE("unknown source=%d", source);
+                return UAPI_HDMIRX_PORT_MAX;
+        }
+    }
+
+    return static_cast<uapi_hdmirx_port>(port);
+}
+
+int32_t VideoDecoderHdmiHal::AssembleViAttr(uapi_vi_attr &viAttr)
+{
+    uapi_hdmirx_timing_info timingInfo{};
+    uapi_hdmirx_port hdmiRxPort = ConvertSourceToHdmiPort(m_connectPort);
+    int32_t ret = uapi_hdmirx_get_timing_info(hdmiRxPort, &timingInfo);
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("uapi_hdmirx_get_timing_info failed");
+        return RETURN_FAILURE;
+    }
+
+    viAttr.access_type = ConvertHdmiAccessType(hdmiRxPort);
+    viAttr.source_type = UAPI_VIDEO_SOURCE_HDMI;
+
+    viAttr.vi_type = UAPI_VI_MAIN;
+    viAttr.intf_mode = UAPI_VI_INTF_FVHDE;
+
+    viAttr.vi_config.input_rect.x = 0;
+    viAttr.vi_config.input_rect.y = 0;
+    viAttr.vi_config.input_rect.width = timingInfo.width;
+    viAttr.vi_config.input_rect.height = timingInfo.height;
+    viAttr.vi_config.width = timingInfo.width;
+    viAttr.vi_config.height = timingInfo.height;
+
+    viAttr.vi_config.frame_rate = timingInfo.frame_rate;
+    viAttr.vi_config.display_field = UAPI_VI_DISPLAY_FIELD_ALL;
+    viAttr.vi_config.interlace = timingInfo.is_interlace;
+
+    viAttr.vi_config.color_sys = UAPI_COLOR_SYS_AUTO;
+
+    viAttr.video_3d_type = timingInfo.fmt;
+    viAttr.over_sample = timingInfo.oversample;
+    viAttr.color_description = timingInfo.color_space;
+    viAttr.pixel_format = timingInfo.pixel_fmt;
+    viAttr.bit_depth = timingInfo.depth;
+    viAttr.vblank = timingInfo.v_blank;
+    viAttr.secure = TD_FALSE;
+
+    return RETURN_SUCCESS;
+}
+
+int32_t VideoDecoderHdmiHal::GetHdmirxProductInfo(SourceType source, HdmirxProductInfo &info)
+{
+    LOGI("get hdmirx product description info");
+    if(Check() != RETURN_SUCCESS)
+    {
+        LOGE("check failed");
+        return RETURN_FAILURE;
+    }
+
+    uapi_hdmirx_port port = ConvertSourceToHdmiPort(source);
+    if(port == UAPI_HDMIRX_PORT_MAX)
+    {
+        LOGE("not support hdmi source=%d", source);
+        return RETURN_FAILURE;
+    }
+
+    uapi_hdmirx_source_product_description description{};
+    td_s32 ret = uapi_hdmirx_get_source_product_description(port, &description);
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("uapi_hdmirx_get_source_product_description failed, port:%d, ret:%d", port, ret);
+        return RETURN_FAILURE;
+    }
+
+    for(int32_t i = 0; i < UAPI_HDMIRX_VENDOR_NAME_LEN; ++i)
+    {
+        info.vendorName[i] = description.vendor_name[i];
+    }
+
+    for(int32_t i = 0; i < UAPI_HDMIRX_PRODUCT_DESCRIPTION_LEN; ++i)
+    {
+        info.productDescription[i] = description.product_description[i];
+    }
+
+    return RETURN_SUCCESS;
+}
+
+uapi_vi_access_type VideoDecoderHdmiHal::ConvertHdmiAccessType(uapi_hdmirx_port port) const
+{
+    if(port < UAPI_HDMIRX_PORT0 || port > UAPI_HDMIRX_PORT3)
+    {
+        return UAPI_VI_ACCESS_MAX;
+    }
+
+    static const std::unordered_map<uapi_hdmirx_port, uapi_vi_access_type> convertMap
+    {
+        {UAPI_HDMIRX_PORT0, UAPI_VI_ACCESS_HDMIRX_PORT0},
+        {UAPI_HDMIRX_PORT1, UAPI_VI_ACCESS_HDMIRX_PORT1},
+        {UAPI_HDMIRX_PORT2, UAPI_VI_ACCESS_HDMIRX_PORT2},
+        {UAPI_HDMIRX_PORT3, UAPI_VI_ACCESS_HDMIRX_PORT3}
+    };
+
+    return convertMap.at(port);
+}
+
+AllmStatus VideoDecoderHdmiHal::ConvertHdmiAllmStatus(uapi_hdmirx_allm_status allmStatus) const
+{
+    if(allmStatus < UAPI_HDMIRX_ALLM_STATUS_NONE || allmStatus > UAPI_HDMIRX_ALLM_STATUS_MAX)
+    {
+        return ALLM_STATUS_BUTT;
+    }
+
+    static const std::unordered_map<uapi_hdmirx_allm_status, AllmStatus> allmStatusMap
+    {
+        {UAPI_HDMIRX_ALLM_STATUS_NONE, ALLM_STATUS_NONE},
+        {UAPI_HDMIRX_ALLM_STATUS_ENABLE, ALLM_STATUS_ENABLE},
+        {UAPI_HDMIRX_ALLM_STATUS_DISABLE, ALLM_STATUS_DISABLE},
+        {UAPI_HDMIRX_ALLM_STATUS_MAX, ALLM_STATUS_BUTT}
+    };
+
+    return allmStatusMap.at(allmStatus);
+}
+
+VrrMode VideoDecoderHdmiHal::ConvertHdmiVrrMode(uapi_hdmirx_vrr_mode vrrMode) const
+{
+    if(vrrMode < UAPI_HDMIRX_VRR_MODE_NONE || vrrMode > UAPI_HDMIRX_VRR_MODE_MAX)
+    {
+        return VRR_MODE_BUTT;
+    }
+
+    static const std::unordered_map<uapi_hdmirx_vrr_mode, VrrMode> vrrModeMap
+    {
+        {UAPI_HDMIRX_VRR_MODE_NONE, VRR_MODE_NONE},
+        {UAPI_HDMIRX_VRR_MODE_VRR, VRR_MODE_VRR},
+        {UAPI_HDMIRX_VRR_MODE_QMS, VRR_MODE_QMS},
+        {UAPI_HDMIRX_VRR_MODE_ARR, VRR_MODE_ARR},
+        {UAPI_HDMIRX_VRR_MODE_FRR, VRR_MODE_FRR},
+        {UAPI_HDMIRX_VRR_MODE_MAX, VRR_MODE_BUTT}
+    };
+
+    return vrrModeMap.at(vrrMode);
+}
+
+int32_t VideoDecoderHdmiHal::GetHdmiRxSignalEvent(std::vector<uint32_t> &hdmiRxEvent)
+{
+    if(Check() != RETURN_SUCCESS)
+    {
+        LOGE("check failed");
+        return RETURN_FAILURE;
+    }
+
+    if(m_connectPort == SOURCE_BUTT)
+    {
+        LOGE("not connect, can`t get signal status");
+        return RETURN_FAILURE;
+    }
+
+    uapi_hdmirx_events hiHdmiRxEvent;
+    int32_t ret = uapi_hdmirx_get_events(ConvertSourceToHdmiPort(m_connectPort), &hiHdmiRxEvent);
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("uapi_hdmirx_get_events failed, ret:%d", ret);
+        return RETURN_FAILURE;
+    }
+
+    auto size = static_cast<uint32_t>(HdmiRxEventType::DRV_HDMIRX_EVENT_BUTT);
+    auto hiSize = static_cast<uint32_t>(sizeof(hiHdmiRxEvent.event) / sizeof(uint32_t));
+    if(size < hiSize)
+    {
+        LOGE("size error: HdmiRxEventSize:%u, hiHdmiRxEventSize:%u", size, hiSize);
+        return RETURN_FAILURE;
+    }
+
+    hdmiRxEvent.resize(static_cast<int32_t>(HdmiRxEventType::DRV_HDMIRX_EVENT_BUTT), 0);
+    for(auto index = 0; index < hiSize; ++index)
+    {
+        hdmiRxEvent[index] = hiHdmiRxEvent.event[index];
+    }
+
+    return RETURN_SUCCESS;
+}
diff --git a/common/driverbase/hal/VideoHal.cpp b/common/driverbase/hal/VideoHal.cpp
new file mode 100644
index 0000000..a62a88f
--- /dev/null
+++ b/common/driverbase/hal/VideoHal.cpp
@@ -0,0 +1,200 @@
+#define LOG_NDEBUG 0
+#define LOG_TAG "VideoHal"
+
+#include "VideoHal.h"
+#include <unordered_set>
+
+#include "CommonDef.h"
+#include "VideoInputHal.h"
+#include "VideoOutputHal.h"
+
+std::mutex VideoHal::m_lock;
+
+VideoHal &GetVideoHal()
+{
+    return VideoHal::GetInstance();
+}
+
+VideoHal &VideoHal::GetInstance()
+{
+    static VideoHal videoHal;
+    return videoHal;
+}
+
+VideoHal::VideoHal()
+{
+    LOGI("VideoHal::VideoHal()");
+}
+
+VideoHal::~VideoHal()
+{
+    LOGI("VideoHal::~VideoHal()");
+}
+
+int32_t VideoHal::Create(SourceType source)
+{
+    LOGI("source[%d]", source);
+    std::lock_guard<std::mutex> lock(m_lock);
+    int32_t ret = VideoInputHal::GetInstance().Create(source);
+    if(ret != RETURN_SUCCESS)
+    {
+        LOGE("VideoHal::Create() VideoInputHal::Create() failed");
+        return RETURN_FAILURE;
+    }
+    if(IsControlSource(source))
+    {
+        ret = VideoOutputHal::GetInstance().CreateWindow(source,WINDOW_MAIN);
+        if(ret != RETURN_SUCCESS)
+        {
+            LOGE("VideoHal::Create() VideoOutputHal::Create() failed");
+            VideoInputHal::GetInstance().Destroy(false);
+            return RETURN_FAILURE;
+        }
+    }
+    m_source = source;
+    return RETURN_SUCCESS;
+}
+
+int32_t VideoHal::Destroy()
+{
+    std::lock_guard<std::mutex> lock(m_lock);
+    if(m_source == SOURCE_BUTT)
+    {
+        LOGW("VideoHal::Destroy() no source");
+        return RETURN_SUCCESS;
+    }
+    if(m_isStarted)
+    {
+        static_cast<void>(Stop(m_videoParam));
+    }
+    int32_t ret = VideoInputHal::GetInstance().Destroy(false);
+    if(ret != RETURN_SUCCESS)
+    {
+        LOGE("VideoHal::Destroy() VideoInputHal::Destroy() failed");
+        return RETURN_FAILURE;
+    }
+    if(IsControlSource(m_source))
+    {
+        ret = VideoOutputHal::GetInstance().DestroyWindow(WINDOW_MAIN);
+        if(ret != RETURN_SUCCESS)
+        {
+            LOGE("VideoHal::Destroy() VideoOutputHal::Destroy() failed");
+            return RETURN_FAILURE;
+        }
+    }
+    m_source = SOURCE_BUTT;
+    return RETURN_SUCCESS;
+}
+
+int32_t VideoHal::Start(const VideoParam &videoParam)
+{
+    std::lock_guard<std::mutex> lock(m_lock);
+    if(m_isStarted || m_source == SOURCE_BUTT)
+    {
+        LOGW("VideoHal::Start() already started");
+        return RETURN_FAILURE;
+    }
+    if(!IsControlSource(m_source))
+    {
+        LOGI("VideoHal::Start() not control source");
+        m_isStarted = true;
+        return RETURN_SUCCESS;
+    }
+    int32_t ret = VideoInputHal::GetInstance().PrepareVi(videoParam.graphicMode);
+    if(ret != RETURN_SUCCESS)
+    {
+        LOGE("VideoHal::Start() VideoInputHal::PrepareVi() failed");
+        return RETURN_FAILURE;
+    }
+    uint32_t viHandle = VideoInputHal::GetInstance().GetViHandle();
+    if(viHandle == TD_INVALID_HANDLE)
+    {
+        LOGE("VideoHal::Start() VideoInputHal::GetViHandle() failed");
+        return RETURN_FAILURE;
+    }
+    ret = VideoOutputHal::GetInstance().AttachWindow(viHandle);
+    if(ret != RETURN_SUCCESS)
+    {
+        LOGE("VideoHal::Start() VideoOutputHal::AttachWindows() failed");
+        static_cast<void>(VideoInputHal::GetInstance().ReleaseVi());
+        return RETURN_FAILURE;
+    }
+    ret = VideoOutputHal::GetInstance().EnableWindow(true);
+    if(ret != RETURN_SUCCESS)
+    {
+        LOGE("VideoHal::Start() VideoOutputHal::EnableWindows() failed");
+        static_cast<void>(VideoOutputHal::GetInstance().DetachWindow());
+        static_cast<void>(VideoInputHal::GetInstance().ReleaseVi());
+        return RETURN_FAILURE;
+    }
+    ret = VideoInputHal::GetInstance().EnableVi(true);
+    if (ret != RETURN_SUCCESS) {
+        LOGE("EnableVi failed");
+        static_cast<void>(VideoOutputHal::GetInstance().DetachWindow());
+        static_cast<void>(VideoInputHal::GetInstance().ReleaseVi());
+        return RETURN_FAILURE;
+    }
+    m_isStarted = true;
+    m_videoParam = videoParam;
+    return RETURN_SUCCESS;
+}
+
+int32_t VideoHal::Stop([[maybe_unused]] const VideoParam &videoParam)
+{
+    std::lock_guard<std::mutex> lock(m_lock);
+    if(!m_isStarted || m_source == SOURCE_BUTT)
+    {
+        LOGE("VideoHal::Stop() not started");
+        return RETURN_FAILURE;
+    }
+    if(!IsControlSource(m_source))
+    {
+        LOGI("not hdmi or cvbs, source %d", m_source);
+        m_isStarted = false;
+        return RETURN_SUCCESS;
+    }
+    int32_t ret = VideoInputHal::GetInstance().EnableVi(false);
+    if(ret != RETURN_SUCCESS)
+    {
+        LOGE("VideoHal::Stop() VideoOutputHal::EnableVi() failed");
+        return RETURN_FAILURE;
+    }
+    ret = VideoOutputHal::GetInstance().EnableWindow(false);
+    if(ret != RETURN_SUCCESS)
+    {
+        LOGE("EnableWindows failed");
+        return RETURN_FAILURE;
+    }
+    ret = VideoOutputHal::GetInstance().DetachWindow();
+    if(ret != RETURN_SUCCESS)
+    {
+        LOGE("VideoHal::Stop() VideoInputHal::DetachWindow() failed");
+        return RETURN_FAILURE;
+    }
+    ret = VideoInputHal::GetInstance().ReleaseVi();
+    if(ret != RETURN_SUCCESS)
+    {
+        LOGE("VideoHal::Stop() VideoInputHal::ReleaseVi() failed");
+        return RETURN_FAILURE;
+    }
+    m_isStarted = false;
+    return RETURN_SUCCESS;
+}
+
+SourceType VideoHal::GetSource()
+{
+    std::lock_guard<std::mutex> lock(m_lock);
+    return m_source;
+}
+
+bool VideoHal::IsControlSource(SourceType source) const
+{
+    static const std::unordered_set<SourceType> controlSourceSet = {
+        SOURCE_HDMI1,
+        SOURCE_HDMI2,
+        SOURCE_HDMI3,
+        SOURCE_HDMI4,
+        SOURCE_CVBS1,
+    };
+    return controlSourceSet.find(source) != controlSourceSet.end();
+}
