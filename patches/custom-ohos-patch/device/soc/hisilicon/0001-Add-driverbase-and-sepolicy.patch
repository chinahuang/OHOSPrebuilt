+#ifndef DRIVERBASE_VIDEOINPUTPORTORDER_H
+#define DRIVERBASE_VIDEOINPUTPORTORDER_H
+
+#include <map>
+#include "CommonDef.h"
+#include "SourceDef.h"
+class VideoInputPortOrder{
+
+public:
+    VideoInputPortOrder(const VideoInputPortOrder& ) = delete;
+    VideoInputPortOrder& operator=(const VideoInputPortOrder& ) = delete;
+    VideoInputPortOrder(VideoInputPortOrder&& ) = delete;
+    VideoInputPortOrder& operator=(VideoInputPortOrder&& ) = delete;
+    
+    static VideoInputPortOrder& GetInstance()   
+    {
+        static VideoInputPortOrder videoInputPortOrder;
+        return videoInputPortOrder;
+    }   
+
+    void Save(const std::map<SourceType, int32_t> &portMap) 
+    {
+        m_portMap = portMap;
+    }
+    
+    int32_t Get(SourceType source, int32_t &portIndex)
+    {
+        auto index = m_portMap.find(source);
+        if (index == m_portMap.end()) {
+            return RETURN_FAILURE;
+        }
+        portIndex = index->second;
+        return RETURN_SUCCESS;
+    }
+
+private:
+    VideoInputPortOrder() = default;
+    ~VideoInputPortOrder() = default;
+    std::map<SourceType, int32_t> m_portMap{};
+};
+
+#endif // VIDEOINPUTPORTORDER_H
