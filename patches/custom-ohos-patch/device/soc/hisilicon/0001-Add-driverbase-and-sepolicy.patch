+        return RETURN_FAILURE;
+    }
+    VideoDecoderHal *decoder = GetVideoDecoder(m_source);
+    if(decoder == nullptr)
+    {
+        LOGE("GetVideDecoder failed");
+        return RETURN_FAILURE;
+    }
+    uapi_video_nonstd_info nonStdInfo{};
+    int32_t ret = decoder->GetNonStdInfo(nonStdInfo);
+    if(ret != RETURN_SUCCESS)
+    {
+        LOGE("GetNonStdInfo failed");
+        return RETURN_FAILURE;
+    }
+    if(memcmp(&nonStdInfo,&m_nonStdInfo,sizeof(uapi_video_nonstd_info)) != 0)
+    {
+        ret = uapi_vi_update_nstd_info(m_viHandle,&nonStdInfo);
+        if(ret != TD_SUCCESS)
+        {
