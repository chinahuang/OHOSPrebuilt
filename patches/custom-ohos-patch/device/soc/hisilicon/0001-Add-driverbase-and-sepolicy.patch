+int32_t AudioControllerHal::Create(AoutAudioInputType source)
+{
+    LOGI("AudioController::Create");
+    m_source = source;
+    m_track = AudioHal::GetInstance().CreateAudioTrack();
+    if (m_track == nullptr) {
+        LOGE("AudioController::Create CreateAudioTrack failed");
+        return RETURN_FAILURE;
+    }
+    m_input = AudioHal::GetInstance().CreateAudioInput();
+    if (m_input == nullptr) {
+        LOGE("AudioController::Create CreateAudioInput failed");
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
+
+int32_t AudioControllerHal::Start(AudioTrackType m_trackType)
+{
+    LOGI("AudioController::Start");
+    if(m_input == nullptr) {
+        LOGE("audio input is idle");
+        return RETURN_FAILURE;
+    }
+    if(m_track == nullptr) {
+        LOGE("no track source!");
+        return RETURN_FAILURE;
+    }
+    AudioInputAttr aiAttr{};
+    int32_t ret = m_input->Create(m_source, aiAttr);
+    if(ret != RETURN_SUCCESS) {
+        LOGE("create audio input failed, ret:%d", ret);
+        return RETURN_FAILURE; 
+    }
+    ret = m_track->Create(m_source, m_trackType);
+    if(ret != RETURN_SUCCESS) {
+        LOGE("create track failed, ret:%d", ret);
+        static_cast<void>(m_input->Destroy());
+        return RETURN_FAILURE;
+    }
+    ret = AudioControllerStart(*m_input, *m_track);
+    if(ret != RETURN_SUCCESS) {
+        LOGE("AudioControllerStart failed");
+        static_cast<void>(m_input->Destroy());
+        static_cast<void>(m_track->Destroy());
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
+
+int32_t AudioControllerHal::AudioControllerStart(AudioInputHal &input, AudioTrackHal &track) const
+{
+    int32_t ret = track.AttachInput(input.GetHandle());
+    if (ret != RETURN_SUCCESS) {
+        LOGE("AttachInput failed, ret:%d", ret);
+        return RETURN_FAILURE;
+    }
+    ret = input.SetEnable(true);
+    if(ret != RETURN_SUCCESS) {
+        LOGE("SetEnable failed, ret:%d", ret);
+        static_cast<void>(track.DetachInput());
+        return RETURN_FAILURE;
+    }
+    ret = track.SetMute(track.GetHandle(), false);
+    if (ret != RETURN_SUCCESS) {
+        LOGE("SetMute failed, ret:%d", ret);
+        static_cast<void>(m_input->SetEnable(false));
+        static_cast<void>(m_track->DetachInput());
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
+
+void AudioControllerHal::Run(const void *arg)
+{
+    LOGI("AudioController run is not impl");
+}
+
+int32_t AudioControllerHal::Stop()
+{
+    LOGI("AudioController stop");
+    if (m_input == nullptr) {
+        LOGE("audio input is idle!");
+        return RETURN_FAILURE;
+    }
+    if(m_track == nullptr) {
+        LOGE("no track resource!");
+        return RETURN_FAILURE;
+    }
+
+    int32_t ret = m_input->SetEnable(false);
+    if (ret != RETURN_SUCCESS) {
+        LOGE("set enable false failed!, ret:%d", ret);
+        return RETURN_FAILURE;
+    }
+    ret = m_track->DetachInput();
+    if (ret != RETURN_SUCCESS) {
+        LOGE("detach input failed!, ret:%d", ret);
+        return RETURN_FAILURE;
+    }
+    ret = m_track->Destroy();
+    if (ret != RETURN_SUCCESS) {
+        LOGE("destroy track failed!, ret:%d", ret);
+        return RETURN_FAILURE;
+    }
+    ret = m_input->Destroy();
+    if (ret != RETURN_SUCCESS) {
+        LOGE("destroy input failed!, ret:%d", ret);
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
+
+int32_t AudioControllerHal::Destroy()
