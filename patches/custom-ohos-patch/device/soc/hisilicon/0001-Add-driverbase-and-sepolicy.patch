+int32_t VideoOutputHal::FreezeWindow(bool freeze)
+{
+	td_handle voHandle = QueryWindowHandle();
+	if (voHandle == TD_INVALID_HANDLE || Check() != RETURN_SUCCESS) {
+		LOGE("no valid window");
+		return RETURN_FAILURE;
+	}
+
+	uapi_win_freeze_mode freezeMode = UAPI_WIN_FREEZE_MODE_MAX;
+	td_bool quickoutEn = TD_FALSE;
+	static_cast<void>(uapi_win_get_freeze_mode(voHandle, &freezeMode));
+	static_cast<void>(uapi_win_get_quick_output_status(voHandle, &quickoutEn));
+	LOGI("freeze=%d, curFreezeMode:%d, curQuickoutEn=%d", freeze, freezeMode, quickoutEn);
+	uapi_win_freeze_mode targetFreezeMode = freeze ? UAPI_WIN_FREEZE_MODE_BLACK : UAPI_WIN_FREEZE_MODE_DISABLE;
+	if (freezeMode == targetFreezeMode) {
+		LOGI("freeze mode is equal to target mode, do nothing.");
+		return RETURN_SUCCESS;
+	}
+
+	if (quickoutEn == TD_TRUE) {
+		if (SetQuickOutputMode(false, UAPI_WIN_QUICKOUT_DISABLE) != RETURN_SUCCESS) {
+			LOGE("SetQuickOutputMode failed.");
+			return RETURN_FAILURE;
+		}
+	}
+
+	int32_t ret = uapi_win_set_freeze_mode(voHandle, targetFreezeMode);
+	if (ret != TD_SUCCESS) {
+		LOGE("uapi_win_set_freeze_mode failed, freezeMode:%d, ret:0x%x", targetFreezeMode, ret);
+		return RETURN_FAILURE;
+	}
+
+	if (!freeze && m_quickOutEn) {
+		if (SetQuickOutputMode(true, UAPI_WIN_QUICKOUT_SUPER_LOW_DELAY) != RETURN_SUCCESS) {
+			LOGE("SetQuickOutputMode failed.");
+			return RETURN_FAILURE;
+		}
+	}
+
+	return RETURN_SUCCESS;
+}
+
+td_handle VideoOutputHal::QueryWindowHandle()
+{
+	if (Check() != RETURN_SUCCESS) {
+		LOGE("check failed");
+		return RETURN_FAILURE;
+	}
+
+	if (m_windowHandle != TD_INVALID_HANDLE) {
+		return m_windowHandle;
+	}
+
+	SourceType source = VideoHal::GetInstance().GetSource();
+
+	/*
+	if(!VideoDecoderAvPlayHal::GetInstance().IsAvPlaySource(source))
+	{
+		return TD_INVALID_HANDLE;
+	}
+	*/
+
+	uapi_win_handle_info voHandle{};
+	int32_t ret = uapi_win_get_handle_info(GetDispID(), &voHandle);
+	if (ret != TD_SUCCESS) {
+		LOGE("uapi_win_get_handle_info failed");
+		return TD_INVALID_HANDLE;
+	}
+
+	uapi_video_source curVideoSource = ConvertVideoSource(source);
+	for (const uint32_t &handle: voHandle.win_handle) {
+		uapi_video_source videoSource = UAPI_VIDEO_SOURCE_MAX;
+		ret = uapi_win_get_video_source(handle, &videoSource);
+		if (ret != TD_SUCCESS) {
+			continue;
+		}
+
+		if (videoSource == curVideoSource) {
+			return handle;
+		}
+	}
+
+	return voHandle.main_handle;
+}
+
+int32_t VideoOutputHal::CreateWindow(SourceType source, WindowType type)
+{
+	if (Check() != RETURN_SUCCESS) {
+		LOGE("check failed");
+		return RETURN_FAILURE;
+	}
+
+	if (m_windowHandle != TD_INVALID_HANDLE) {
+		LOGI("m_windowHandle is not invalid. do DestroyWindow");
+		static_cast<void>(DestroyWindow(m_windowType));
+	}
+
+	uapi_win_attr windowAttr{};
+	AssembleWindowAttr(type, windowAttr);
+	td_handle windowHandle = TD_INVALID_HANDLE;
+	int32_t ret = uapi_win_create(&windowAttr, &windowHandle);
+
+	if (ret != TD_SUCCESS) {
+		LOGI("uapi_win_create failed. ret=0x%x", ret);
+		return RETURN_FAILURE;
+	}
+
+	m_windowType = type;
+	m_windowHandle = windowHandle;
+	m_source = source;
+
+	ret = SetWindowSource(source);
+	if (ret != RETURN_SUCCESS) {
+		LOGE("SetWindowSource failed");
+		static_cast<void>(DestroyWindow(type));
+		return RETURN_FAILURE;
+	}
+
+	return RETURN_SUCCESS;
+}
+
+int32_t VideoOutputHal::SetWindowSource(SourceType source)
+{
+	uapi_video_source videoSource = ConvertVideoSource(source);
+	int32_t ret = uapi_win_set_video_source(m_windowHandle, videoSource);
+	if (ret != TD_SUCCESS) {
+		LOGE("uapi_win_set_video_source failed. videoSource=%d", videoSource);
+		return RETURN_FAILURE;
+	}
+
+	return RETURN_SUCCESS;
+}
+
+uapi_video_source VideoOutputHal::ConvertVideoSource(SourceType source) const
+{
+	static const std::unordered_map <SourceType, uapi_video_source> convertMap{
+		{SOURCE_MEDIA, UAPI_VIDEO_SOURCE_MEDIA},
+		{SOURCE_HDMI1, UAPI_VIDEO_SOURCE_HDMI},
+		{SOURCE_HDMI2, UAPI_VIDEO_SOURCE_HDMI},
+		{SOURCE_HDMI3, UAPI_VIDEO_SOURCE_HDMI},
+		{SOURCE_HDMI4, UAPI_VIDEO_SOURCE_HDMI},
+		{SOURCE_CVBS1, UAPI_VIDEO_SOURCE_CVBS},
+		{SOURCE_DTMB, UAPI_VIDEO_SOURCE_DTV},
+		{SOURCE_DVBC, UAPI_VIDEO_SOURCE_DTV},
+		{SOURCE_DVBT, UAPI_VIDEO_SOURCE_DTV},
+		{SOURCE_GRAPHIC, UAPI_VIDEO_SOURCE_GRAPHIC},
+		{SOURCE_NETWORK, UAPI_VIDEO_SOURCE_NETWORK}
+	};
+
+	auto item = convertMap.find(source);
+	if (item == convertMap.end()) {
+		return UAPI_VIDEO_SOURCE_MAX;
+	}
+
+	return item->second;
+}
