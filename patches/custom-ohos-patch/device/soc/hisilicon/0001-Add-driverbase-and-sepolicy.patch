+int32_t GetPlayingTrackDelay(uint32_t &delay)
+{ 
+    uapi_snd_track_info trackInfo;
+    int32_t ret = uapi_snd_get_track_info(UAPI_SND_0, &trackInfo);
+    if(ret != TD_SUCCESS) {
+        LOGE("uapi_snd_get_track_info failed, ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    td_handle handle = TD_INVALID_HANDLE;
+    uint32_t maxDataCnt = 0;
+    uapi_snd_source sndSource = UAPI_SND_SOURCE_MAX;
+    uint32_t startCnt = 0;
+    for (uint32_t index = 0; index < trackInfo.track_num;++index){
+        if(trackInfo.track_status[index].play_status == UAPI_SND_TRACK_PLAY_STATUS_START){
+            ++startCnt;
+            if(trackInfo.track_status[index].receive_data_cnt > maxDataCnt){
+                handle = trackInfo.track_status[index].track;
+                sndSource = trackInfo.track_status[index].source;
+                maxDataCnt =  trackInfo.track_status[index].receive_data_cnt;
+            }
+        }
+        LOGI("startCnt:%u, handle:0x%x, dataCnt:%d",startCnt,
+            trackInfo.track_status[index].track, trackInfo.track_status[index].receive_data_cnt);
+    }
+    if(handle == TD_INVALID_HANDLE || sndSource != UAPI_SND_SOURCE_ALSA){
+        LOGE("get handle failed. handle:0x%x, source:%d", handle, sndSource);
+        return RETURN_FAILURE;  
+    }
+    if(startCnt != 1){
+        LOGE("Start track num:%u, ignore.", startCnt);
+        return RETURN_FAILURE;
+    }
+    ret = uapi_snd_get_track_delay(handle, &delay);
+    if(ret != TD_SUCCESS) {
+        LOGE("uapi_snd_get_track_delay failed, ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
+}
