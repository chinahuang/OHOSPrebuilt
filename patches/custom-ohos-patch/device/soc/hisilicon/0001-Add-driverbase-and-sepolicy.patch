+    if(m_viHandle == TD_INVALID_HANDLE)
+    {
+        LOGE("m_viHandle is TD_INVALID_HANDLE");
+        return RETURN_FAILURE;
+    }
+    if(isEnable)
+    {
+        int32_t ret = uapi_vi_start(m_viHandle);
+        if(ret != TD_SUCCESS)
+        {
+            LOGE("uapi_vi_start failed");
+            return RETURN_FAILURE;
+        }
+    } else {
+        int32_t ret = uapi_vi_stop(m_viHandle);
+        if(ret != TD_SUCCESS)
+        {
+            LOGE("uapi_vi_stop failed");
+            return RETURN_FAILURE;
+        }
+    }
+    return RETURN_SUCCESS;
