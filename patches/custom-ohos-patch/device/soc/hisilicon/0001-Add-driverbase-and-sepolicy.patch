+
+
+
+
+
+#define LOG_NDEBUG 0
+#define LOG_TAG "ConfigHandler"
+
+#include "ConfigHandler.h"
+
+using namespace std;
+
+ConfigHandler::ConfigHandler(const string &iniFile)
+{
+    LOGI("construct");
+    if (!iniFile.empty()) {
+        if (m_iniParser.Load(iniFile) != RETURN_SUCCESS) {
+            LOGE("ini file open failure.");
+            m_cfgHandlerException = true;
+        }
+    } else {
+        LOGE("ini file path is empty.");
+        m_cfgHandlerException = true;
+    }
+}
+
+bool ConfigHandler::GetCfgExceptionStatus() const
+{
+    return m_cfgHandlerException;
+}
+
+string ConfigHandler::ParseString(const string &field)
+{
+    return m_iniParser.GetValue(field, "");
+}
+
+unordered_map<std::string, std::string> ConfigHandler::GetCacheMap()
+{
+    return m_iniParser.GetCacheMap();
+}
+
+vector<bool> ConfigHandler::StringToBooleanVector(const char *str)
+{
+    if (str == nullptr) {
+        return {};
+    }
+
+    vector<bool> ret;
+    while (*str != '\0') {
+        while ((*str == ',') || (isspace(static_cast<int32_t>(*str)))) {
+            str++;
+        }
+        const char *ptr = str;
+        while ((*ptr != '\0') && (*ptr != ',')) {
+            ptr++;
+        }
+
+        char tmp[32] = {0}; // array length is 32
+
+        if (ptr > str) {
+            errno_t rc = strncpy_s(tmp, sizeof(tmp), str, ptr - str);
+            if (rc != EOK) {
+                LOGE("strncpy_s failed, rc = %d", rc);
+                return ret;
+            }
+            if ((strcasecmp(tmp, "y") == 0) || (strcasecmp(tmp, "yes") == 0) || (strcasecmp(tmp, "true") == 0) ||
+                (strcasecmp(tmp, "1") == 0)) {
+                ret.push_back(true);
+            }
+            if ((strcasecmp(tmp, "n") == 0) || (strcasecmp(tmp, "no") == 0) || (strcasecmp(tmp, "false") == 0) ||
+                (strcasecmp(tmp, "0") == 0)) {
+                ret.push_back(false);
+            }
+        }
+
+        if (*ptr == '\0') {
+            break;
+        }
+        str = ++ptr;
+    }
+
+    return ret;
+}
+
+vector<std::string> ConfigHandler::StringToStringVector(const char *str)
+{
+    if (str == nullptr) {
+        return {};
+    }
+
+    vector<std::string> ret;
+    while (*str != '\0') {
+        while (*str == ',') {
+            str++;
+        }
+        const char *ptr = str;
+        while ((*ptr != '\0') && (*ptr != ',')) {
+            ptr++;
+        }
+
+        char tmp[256] = {0};
+
+        if (ptr > str) {
+            errno_t rc = strncpy_s(tmp, sizeof(tmp), str, (ptr - str));
+            if (rc != EOK) {
+                LOGE("strncpy_s failed,rc = %d",rc);
+                return ret;
+            }
+            ret.emplace_back(tmp);
+        }
+
+        if (*ptr == '\0') {
+            break;
+        }
+        str = ++ptr;
+    }
+
+    return ret;
+}
+
+void ConfigHandler::Trim(std::string &str)
+{
+    if (str.empty()) {
+        return;
+    }
+    str.erase(str.find_last_not_of(';') + 1);
+    str.erase(0,str.find_first_not_of(' '));
+    str.erase(str.find_last_not_of(' ') + 1);
+}
