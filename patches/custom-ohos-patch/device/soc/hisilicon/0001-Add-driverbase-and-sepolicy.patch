+        case DRIVERBASE_AOUT_SRC_CVBS2:
+            subType = static_cast<uapi_ai_port>(ConfigFactory::Get().ParseInt("audioinputmap:MapCVBS2"));
+            break;
+        case DRIVERBASE_AOUT_SRC_CVBS3:
+            subType = static_cast<uapi_ai_port>(ConfigFactory::Get().ParseInt("audioinputmap:MapCVBS3"));
+            break;
+        case DRIVERBASE_AOUT_SRC_HDMI1:
+            subType = static_cast<uapi_ai_port>(ConfigFactory::Get().ParseInt("audioinputmap:MapHDMI1"));
+            break;
+        case DRIVERBASE_AOUT_SRC_HDMI2:
+            subType = static_cast<uapi_ai_port>(ConfigFactory::Get().ParseInt("audioinputmap:MapHDMI2"));
+            break;
+        case DRIVERBASE_AOUT_SRC_HDMI3:
+            subType = static_cast<uapi_ai_port>(ConfigFactory::Get().ParseInt("audioinputmap:MapHDMI3"));
+            break;
+        case DRIVERBASE_AOUT_SRC_HDMI4:
