+    drvSndAttr.port_num = static_cast<td_u32>(outDeviceAttr.portNum);
+    drvSndAttr.sample_rate = static_cast<uapi_audio_sample_rate>(outDeviceAttr.sampleRate);
+    drvSndAttr.master_output_buf_size = outDeviceAttr.masterOutputBufSize;
+    drvSndAttr.slave_output_buf_size = outDeviceAttr.slaveOutputBufSize;
