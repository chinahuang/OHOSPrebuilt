+int32_t PqHal::SetHdrType(HdrType hdrtype)
+{
+    auto it = SVR_HDR_MAP.find(hdrtype);
+    if (it == SVR_HDR_MAP.end()) {
+        LOGE("Unsupported HDR type: %d", static_cast<int>(hdrtype));
+        return RETURN_FAILURE;
+    }
+    uapi_svr_dispmng_hdr_type uapiHdrType = it->second;
+    int32_t ret = uapi_svr_dispmng_set_hdr_type(UAPI_SVR_DISPMNG_DISPLAY_ID_0, uapiHdrType);
+    if (ret != TD_SUCCESS) {
+        LOGE("Set HDR type failed (0x%x), requested type: %d", ret, static_cast<int>(hdrtype));
+        return RETURN_FAILURE;
+    }
+
+    return RETURN_SUCCESS;
+}
