+
+
+
+
+
+#define LOG_NDEBUG 0
+#define LOG_TAG "ConfigProvider"
+
+#include "ConfigProvider.h"
+
+#include "CommonDef.h"
+#include "FileUtils.h"
+
+using namespace std;
+
+mutex ConfigProvider::m_tmpCacheMutex;
+
+namespace {
+    const std::string ATV_INI_CFG_INI_PATH = "/vendor/tvservice/ini/cfg.ini";
+    const std::string ATV_INI_DB_INI_PATH = "/vendor/tvservice/ini/db.ini";
+    const std::string ATV_INI_AQ_INI_PATH = "/vendor/tvservice/ini/aq.ini";
+    const std::string ATV_INI_AV_INI_PATH = "/vendor/tvservice/ini/av.ini";
+    const std::string ATV_INI_PQ_INI_PATH = "/vendor/tvservice/ini/pq.ini";
+}
+
+ConfigProvider::ConfigProvider(bool isLoad)
+{
+    LOGI("ConfigProvider construct");
+    if(isLoad) {
+        LoadIniFile();
+    }
+}
+
+ConfigProvider::~ConfigProvider()
+{
+    LOGI("ConfigProvider deconstruct");
+}
+
+void ConfigProvider::LoadIniFile()
+{
+    //get the path of cfg.ini
+    GetFilePath(ATV_INI_CFG_INI_PATH);
+
+    //get the path of db.ini
+    GetFilePath(ATV_INI_DB_INI_PATH);
+
+    //get the path of aq.ini
+    GetFilePath(ATV_INI_AQ_INI_PATH);
+
+    //get the path of av.ini
+    GetFilePath(ATV_INI_AV_INI_PATH);
+
+    //get the path of pq.ini
+    GetFilePath(ATV_INI_PQ_INI_PATH);
+
+    //load the ini files
+    for (const string &str : m_cfgPathVector){
+        LOGI("the ini path:%s", str.c_str());
+        InitCacheMap(str);
+    }
+
+    LOGI("Update keys finish! all ini configs have been loaded into Cache!");
+}
+
+void ConfigProvider::GetFilePath(std::string atvPath)
+{
+    //string iniPath = FileUtils::GetCustomConfigPath(atvPath);
+    if (atvPath.empty()) {
+        LOGE("iniPath is empty");
+        return;
+    }
+    m_cfgPathVector.emplace_back(atvPath);
+}
+
+void ConfigProvider::InitCacheMap(const string &iniFile)
+{
+    vector<string> fileVector = ConfigHandler::StringToStringVector(iniFile.c_str());
+    string fileName = fileVector[0];
+
+    AddCacheMap(fileName);
+}
+
+void ConfigProvider::AddCacheMap(const string &iniFile)
+{
+    LOGI("start loading keys in ini file to m_Cache,file:%s",iniFile.c_str());
+    ConfigHandler configHandler(iniFile);
+    if (configHandler.GetCfgExceptionStatus()) {
+        LOGE("ini file parser failure. iniFile=%s",iniFile.c_str());
+        return;
+    }
+    m_cfgCache.merge(configHandler.GetCacheMap());
+    LOGI("cache size=%zu",m_cfgCache.size());
+}
+
+void ConfigProvider::AddTmpCacheMap(const string &iniFile)
+{
+    lock_guard<mutex> lock(m_tmpCacheMutex);
+    ConfigHandler configHandler(iniFile);
+    if (configHandler.GetCfgExceptionStatus()) {
+        LOGE("ini file parser failure. iniFile=%s",iniFile.c_str());
+        return;
+    }
+    m_tmpCfgCache.emplace(iniFile, configHandler.GetCacheMap());
+}
