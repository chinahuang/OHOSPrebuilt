+int32_t VideoOutputHal::GetVideoDelayBySource(td_handle windowHandle, SourceType source, uint32_t &delayMs)
+{
+	uapi_win_play_info playInfo{};
+	int32_t ret = uapi_win_get_play_info(windowHandle, &playInfo);
+	if (ret != TD_SUCCESS) {
+		LOGE("uapi_win_get_play_info failed. ret=0x%x", ret);
+		return RETURN_FAILURE;
+	}
+
+	uapi_video_source videoSource = ConvertVideoSource(source);
+	if (videoSource == UAPI_VIDEO_SOURCE_HDMI) {
+		uapi_video_frame_info frameInfo{};
+		ret = uapi_win_get_latest_frame(windowHandle, &frameInfo);
+		if (ret != TD_SUCCESS) {
+			LOGE("uapi_win_get_latest_frame faild. ret=0x%x", ret);
+			return RETURN_FAILURE;
+		}
+
+		int64_t curPts = playInfo.current_disp_frame_pts_us;
+		int64_t latestPts = frameInfo.pts;
+		delayMs = (latestPts > curPts) ? static_cast<uint32_t>(latestPts - curPts) : 0;
+		delayMs = delayMs / 1000;
+		LOGI("delayMs=%u, curPts=%ld, latestPts=%ld", delayMs, curPts, latestPts);
+	} else {
+		delayMs = playInfo.delay_time_ms;
+		LOGI("delayMs=%u", delayMs);
+	}
+
+	return RETURN_SUCCESS;
+}
