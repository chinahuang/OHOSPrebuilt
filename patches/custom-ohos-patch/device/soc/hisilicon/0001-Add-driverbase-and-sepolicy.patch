+WinAspectMode VideoOutputHal::ConvertWinAspectMode(uapi_win_aspect_mode wsMode) const
+{
+	const static std::unordered_map <uapi_win_aspect_mode, WinAspectMode> winAspectMap {
+		{UAPI_WIN_ASPECT_CONVERT_FULL, WIN_ASPECT_FULL},
+		{UAPI_WIN_ASPECT_CONVERT_LETTERBOX, WIN_ASPECT_BLACK},
+		{UAPI_WIN_ASPECT_CONVERT_PAN_SCAN, WIN_ASPECT_SCAN},
+		{UAPI_WIN_ASPECT_CONVERT_COMBINED, WIN_ASPECT_BLACK_AND_SCAN},
+		{UAPI_WIN_ASPECT_CONVERT_P2P, WIN_ASPECT_P2P},
+		{UAPI_WIN_ASPECT_CONVERT_NONLINEAR, WIN_ASPECT_NONLINEAR},
+		{UAPI_WIN_ASPECT_CONVERT_CUSTOM, WIN_ASPECT_CUSTOM}
+	};
+
+	auto item = winAspectMap.find(wsMode);
+	if (item == winAspectMap.end()) {
+		LOGE("not find uapiAspectMode=%d.", wsMode);
+		return WIN_ASPECT_BUTT;
+	}
+
+	return item->second;
+}
