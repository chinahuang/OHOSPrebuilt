+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#ifndef TVSERVICE_THREADHANDLER_H
+#define TVSERVICE_THREADHANDLER_H
+
+#include <pthread.h>
+#include <string>
+#include <unistd.h>
+
+#include "CommonDef.h"
+
+/* 
+ *  ThreadHandler Event callback. Used for monitoring running state.
+ */ 
+class ThreadHandler;
+
+class IThreadHandlerEvt {
+public:
+    virtual void OnThreadHandlerExit(ThreadHandler *threadHandler) = 0;
+    virtual ~IThreadHandlerEvt() = default;
+};
+
+/*  
+ *  Base Thread class. The implementation is system-dependent.
+ */
+class ThreadHandler {
+public:
+    using ThreadHandlerFunc = void(*)(const void *arg);
+    struct ThreadHandlerStat {
+        volatile bool wait; /* enable or disable ThreadHandler */
+        volatile bool once; /* select loop once or always */
+        volatile bool exit; /* exit and recovery resource */
+    };
+    enum Flag : uint32_t {
+        ONCE = 0x1U << 0,   /* just loop once */
+        REPEAT = 0x1U << 1, /* repeat loop */
+        WAIT = 0x1U << 2    /* wait for resume, only valid at first running */
+    };
+
+    explicit ThreadHandler(ThreadHandlerFunc func = nullptr, const void *arg = nullptr,
+        IThreadHandlerEvt *evt = nullptr);
+    virtual ~ThreadHandler();
+
+    void Run(uint32_t flag = ONCE);
+    void Suspend();
+    void Resume();
+    void Exit();
+    void ExitAndJoin();
+    void SetName(std::string threadName);
+
+protected:
+    virtual void Run(const void *arg) = 0;
+
+private:
+    static void *Loop(void *arg);
+    void Task();
+
+    ThreadHandlerFunc m_threadFunc;
+    const void *m_arg;
+    IThreadHandlerEvt *m_curEvt;
+    pthread_t m_curId;
+    ThreadHandlerStat m_stat = {
+        .wait = false,
+        .once = false,
+        .exit = true
+    };
+    pthread_mutex_t m_lock;
+    pthread_cond_t m_cond;
+    std::string m_threadName{"ThreadHandler"};
+};
+
+#endif
