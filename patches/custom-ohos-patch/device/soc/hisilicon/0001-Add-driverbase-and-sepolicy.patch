+
+	int32_t ret = uapi_win_deinit();
+	if (ret != TD_SUCCESS) {
+		LOGE("uapi_win_deinit failed");
+		return RETURN_FAILURE;
+	}
+
+	m_isInited = false;
+	return RETURN_SUCCESS;
+}
+
+int32_t VideoOutputHal::Check()
+{
+	if (m_isInited) {
+		return RETURN_SUCCESS;
+	}
+
+	return Init();
+}
