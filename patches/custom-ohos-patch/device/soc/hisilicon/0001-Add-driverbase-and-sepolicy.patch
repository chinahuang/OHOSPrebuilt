+        break;
+    }
+    int32_t ret = uapi_snd_set_output_mode(UAPI_SND_0, UAPI_SND_OUT_PORT_SPDIF0, mode);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_snd_get_output_mode failed, mode:%d ret:0x%x", spdifMode, ret);
+        return RETURN_FAILURE;
+    }
+    LOGE("uapi_snd_get_output_mode success, mode:%d", spdifMode);
+    return RETURN_SUCCESS;
+}
+int32_t AudioOutDeviceHal::GetSpdifMode(SoundSpdifModeType &spdifMode) 
+{
+    if (Check() != RETURN_SUCCESS) {
+        LOGE("check failed");
+        return RETURN_FAILURE;
+    }
+    uapi_snd_output_mode mode = UAPI_SND_OUTPUT_MODE_AUTO;
+    int32_t ret = uapi_snd_get_output_mode(UAPI_SND_0, UAPI_SND_OUT_PORT_SPDIF0, &mode);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_snd_get_output_mode failed, retL0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    if (mode == UAPI_SND_OUTPUT_MODE_LPCM) {
+        spdifMode = SOUND_SPDIF_MODE_PCM;
+    } else if (mode == UAPI_SND_OUTPUT_MODE_RAW) {
+        spdifMode = SOUND_SPDIF_MODE_RAW;
+    } else if (mode == UAPI_SND_OUTPUT_MODE_AUTO) {
+        spdifMode = SOUND_SPDIF_MODE_AUTO;
+    } else {
+        spdifMode = SOUND_SPDIF_MODE_BUTT;
+    }
+    return RETURN_SUCCESS;
+}
