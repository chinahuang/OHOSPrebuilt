+int32_t VideoInputHal::PrepareVi(GraphicModeType graphicMode,bool isCast)
+{
+    if(Check() != RETURN_SUCCESS)
+    {
+        LOGE("Check failed");
+        return RETURN_FAILURE;
+    }
+    if(m_viHandle != TD_INVALID_HANDLE)
+    {
+        LOGI("Vi already prepared");
+        static_cast<void>(ReleaseVi());
+    }
+    uapi_vi_attr viAttr{};
+    int32_t ret = uapi_vi_get_default_attr(&viAttr);
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("uapi_vi_get_default_attr failed");
+        return RETURN_FAILURE;
+    }
+    SourceType targetSource = isCast ? m_castSource : m_source;
+    if(targetSource == SOURCE_BUTT)
+    {
+        LOGE("targetSource is SOURCE_BUTT");
+        return RETURN_FAILURE;
+    }
+    VideoDecoderHal *videoDecoderHal = GetVideoDecoder(targetSource);
+    if(videoDecoderHal == nullptr)
+    {
+        LOGE("videoDecoderHal is nullptr");
+        return RETURN_FAILURE;
+    }
+    if(videoDecoderHal->AssembleViAttr(viAttr) != RETURN_SUCCESS)
+    {
+        LOGE("GetVideoAttr failed");
+        return RETURN_FAILURE;
+    }
+    AssembleViGraphicModeAttr(graphicMode,viAttr);
+    ret = uapi_vi_create(&viAttr,&m_viHandle);
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("uapi_vi_create failed");
+        return RETURN_FAILURE;
+    }
+    if(graphicMode == GRAPHIC_MODE_GAME || graphicMode == GRAPHIC_MODE_PC)
+    {
+        LOGI("graphicMode is GAME or PC");
+        static_cast<void>(VideoOutputHal::GetInstance().SetQuickOutputEnable(true));
+    } else {
+        static_cast<void>(VideoOutputHal::GetInstance().SetQuickOutputEnable(false));
+    }
+    return RETURN_SUCCESS;
+}
+
+void VideoInputHal::AssembleViGraphicModeAttr(GraphicModeType graphicMode,uapi_vi_attr &viAttr) const 
+{
+    switch(graphicMode)
+    {
+        case GRAPHIC_MODE_PC:
+            viAttr.picture_mode = UAPI_VI_PICTURE_MODE_PC;
+            break;
+        case GRAPHIC_MODE_VIDEO:
+            viAttr.picture_mode = UAPI_VI_PICTURE_MODE_VIDEO;
+            break;
+        case GRAPHIC_MODE_GAME:
+            viAttr.picture_mode = UAPI_VI_PICTURE_MODE_GAME;
+            break;
+        default:
+            LOGE("graphicMode is invalid");
+            viAttr.picture_mode = UAPI_VI_PICTURE_MODE_VIDEO;
+            break;
+    }
+    LOGI("picture_mode is %d",viAttr.picture_mode);
+}
