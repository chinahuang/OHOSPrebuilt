+int32_t AudioDecoderHal::GetStreamInfo(AcodecStreamInfo &streamInfo)
+{
+    if(Check() != RETURN_SUCCESS) {
+        LOGE("check failed");
+        return RETURN_FAILURE;
+    }
+    if(m_handle == TD_INVALID_HANDLE) {
+        LOGE("handle invalid.");
+        return RETURN_FAILURE;
+    }
+    uapi_avplay_stream_info avplayStreamInfo{};
+    int32_t ret = uapi_avplay_get_stream_info(m_handle, &avplayStreamInfo);
+    if(ret != TD_SUCCESS) {
+        LOGE("uapi_avplay_get_stream_info failed, ret:0x%x", ret);
+        return RETURN_FAILURE;
+    } 
+
+    streamInfo.aCodecType = avplayStreamInfo.aud_stream_info.codec_type;
+    streamInfo.sampltRate = avplayStreamInfo.aud_stream_info.sample_rate;
+    streamInfo.bitDepth = static_cast<BitDepth>(avplayStreamInfo.aud_stream_info.bit_depth);
+    streamInfo.channel = avplayStreamInfo.aud_stream_info.channels;
+    streamInfo.audioFormat = static_cast<HaFormat>(avplayStreamInfo.aud_stream_info.format);
+    streamInfo.channelMode = static_cast<HaAudioChannelMode>(avplayStreamInfo.aud_stream_info.channel_mode);
+    streamInfo.lfePresent = avplayStreamInfo.aud_stream_info.lfe_present == TD_TRUE;
+    streamInfo.bitRate = avplayStreamInfo.aud_stream_info.bit_rate;
+    streamInfo.atmosOutput = (avplayStreamInfo.aud_stream_info.atmos == TD_TRUE);
+    return RETURN_SUCCESS;
+}
