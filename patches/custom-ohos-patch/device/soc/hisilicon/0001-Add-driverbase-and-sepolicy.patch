+    if(m_input == nullptr) {
+        LOGE("no audio input resource!");
+        return RETURN_FAILURE;
+    }
+    return m_input->SetEnable(enable);
+}
+
+int32_t AudioControllerHal::GetDelay(uint32_t &delayMs) const
+{
+    uint32_t sinkDelay = 0;
+    int32_t ret = GetSinkDelay(sinkDelay);
+    if(ret != RETURN_SUCCESS) {
+        LOGI("get ai delay failed, ret:0x%x", ret);
+        sinkDelay = 0;
+    }
+
+    uint32_t trackDelay = 0;
+    if(m_track != nullptr) {
+        ret = m_track->GetLatency(trackDelay);
+        if(ret != RETURN_SUCCESS) {
+            LOGI("get ai delay failed, ret:0x%x", ret);
+            trackDelay = 0;
+        }
+    }
+
+    delayMs = sinkDelay + trackDelay;
+    LOGI("sinkDelay:%u, trackDelay:%u, delayMs:%u", sinkDelay, trackDelay, delayMs);
+    return ret;
+}
+
+int32_t AudioControllerHal::SetAiDelay(uint32_t aiDelay) const
+{
+    if(m_input == nullptr) {
+        LOGE("no audio input resource!");
+        return RETURN_FAILURE;
+    }
+    return m_input->SetDelay(aiDelay);
+}
