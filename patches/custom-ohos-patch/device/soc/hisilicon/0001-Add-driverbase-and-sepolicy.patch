+int32_t AudioDecoderHal::Init()
+{
+    LOGI("Init");
+    std::lock_guard<std::mutex> lock(m_lock);
+    if(m_isInited) {
+        return RETURN_SUCCESS;
+    }
+    int32_t ret = uapi_avplay_init();
+    if(ret != TD_SUCCESS) {
+        LOGE("uapi_tvd_init fail, ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    m_isInited = true;
+    return RETURN_SUCCESS;
+}
+int32_t AudioDecoderHal::DeInit()
+{
+    LOGI("DeInit");
+    std::lock_guard<std::mutex> lock(m_lock);
+    if(!m_isInited) {
+        return RETURN_SUCCESS;
+    }
+    m_isInited = false;
+    return RETURN_SUCCESS;
+}
+
+int32_t AudioDecoderHal::Check()
+{
+    if(m_isInited) {
+        return RETURN_SUCCESS;
+    }
+    return Init();
+}
