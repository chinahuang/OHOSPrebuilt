+		{UAPI_PIXEL_BIT_DEPTH_12BIT, PIXEL_BIT_WIDTH_12BIT},
+		{UAPI_PIXEL_BIT_DEPTH_16BIT, PIXEL_BIT_WIDTH_16BIT}
+	};
+
+	auto item = convertMap.find(depth);
+	if (item == convertMap.end()) {
+		return PIXEL_BIT_WIDTH_BUTT;
+	}
+
+	return item->second;
+}
+
+OverSampleType VideoDecoderHal::ConvertOverSample(uapi_oversample oversample) const
