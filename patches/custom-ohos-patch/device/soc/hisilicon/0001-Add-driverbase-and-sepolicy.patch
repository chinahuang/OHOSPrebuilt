+int32_t AudioOutDeviceHal::Init()   
+{
+    LOGI("Init");
+    lock_guard<mutex> lock(m_mutex);
+    if (m_isInited) {
+        return RETURN_SUCCESS;
+    }
+    int32_t ret = uapi_snd_init();
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_snd_init failed, retL0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    uapi_snd_attr stSndAttr{};
+    ret = uapi_snd_get_default_open_attr(UAPI_SND_0, &stSndAttr);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_snd_get_default_open_attr failed, retL0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    ret = uapi_snd_open(UAPI_SND_0, &stSndAttr);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_snd_open failed, ret:0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    m_isInited = true;
+    return RETURN_SUCCESS;
+}
+
+int32_t AudioOutDeviceHal::DeInit()
+{
+    LOGI("Deinit");
+    lock_guard<mutex> lock(m_mutex);
+    if (!m_isInited) {
+        return RETURN_SUCCESS;
+    }
+    int32_t ret = uapi_snd_close(UAPI_SND_0);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_snd_close failed, retL0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    ret = uapi_snd_deinit();
+    if (ret != TD_SUCCESS) {
+        
+        LOGE("uapi_snd_deinit failed, retL0x%x", ret);
+        return RETURN_FAILURE;
+    }
+    m_isInited = false;
+    return RETURN_SUCCESS;
+}
