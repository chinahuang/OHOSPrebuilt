+int32_t PanelHal::SetBacklightLevel(uint32_t level, BacklightType type)
+{
+    LOGI("PanelHal::SetBacklightLevel in");
+    if ((!m_isInit) && (Init() != RETURN_SUCCESS)) {
+        LOGE("Panel has not initialized.");
+        return RETURN_FAILURE;
+    }
+
+    uint32_t pwmLevelMin;
+    uint32_t pwmLevelMax;
+    int32_t ret = GetPanelPwmRangeByType(pwmLevelMin, pwmLevelMax);
+    if (ret != TD_SUCCESS) {
+        LOGE("GetPanelPwmRange failed");
+        return RETURN_FAILURE;
+    }
+    if (type == BACKLIGHT_12BIT) {
+        level = level >> BACKLIGHT_12BIT_TO_8BIT_SCALE;
+    }
+
+    /* calculate backlightlevel for setting driver */
+    uint32_t backLightDrvLevel = (pwmLevelMax - pwmLevelMin) * level / BACKLIGHT_PWM_8BIT_MAX + pwmLevelMin;
+
+    ret = uapi_panel_set_backlight_level(UAPI_PANEL_ID_0, backLightDrvLevel);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_panel_set_backlight_level failed, ret:0x%x.", ret);
+        return RETURN_FAILURE;
+    }
+    return RETURN_SUCCESS;
