+int32_t AudioInputHal::Create(AoutAudioInputType type, const AudioInputAttr &aiAttr)
+{
+    LOGI("Create");
+    if (Check() != RETURN_SUCCESS)
+    {
+        LOGE("check failed");
+        return RETURN_FAILURE;
+    }
+
+    uapi_ai_attr defAttr{};
+    m_inputType = MapSrc2Type(type);
+    int32_t ret = uapi_ai_get_default_attr(m_inputType, &defAttr);
+    if(ret != TD_SUCCESS)
+    {
+        LOGE("uapi_ai_get_default_attr failed, ret:0x%x", ret);
+        return ret;
+    }
+    m_attr = defAttr;
+    UpdateAttr(aiAttr);
+    LOGI("Create sample_rate=0x%x, hdmi_attr.sample_rate=0x%x, hdmi_attr.channels=0x%x, hdmi_attr.data_format=0x%x, hdmi_attr.data_type=0x%x, u32PcmFrameMax=0x%x",
+        m_attr.sample_rate, m_attr.attr.hdmi_attr.sample_rate, m_attr.attr.hdmi_attr.channels, m_attr.attr.hdmi_attr.data_format, m_attr.attr.hdmi_attr.data_type, m_attr.pcm_frame_max_num);
+    ret = uapi_ai_create(m_inputType, &m_attr, &m_handle);
+    if(ret != TD_SUCCESS || m_handle == TD_INVALID_HANDLE)
+    {
+        LOGE("uapi_ai_create failed, ret:0x%x, ai handle is 0x%x", ret, m_handle);
+        return RETURN_FAILURE;
+    }
+
+    LOGI("Create m_handle:0x%x, m_inputType:%d, data_type:%d", m_handle, m_inputType, m_attr.attr.hdmi_attr.data_type);
+    return RETURN_SUCCESS;
+}
