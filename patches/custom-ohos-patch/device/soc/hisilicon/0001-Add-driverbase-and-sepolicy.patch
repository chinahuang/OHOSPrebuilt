+std::string AudioOutDeviceHal::GetTrackModeName(const TrackChannelModeType &trackMode)
+{
+    if( trackMode > DRIVERBASE_TRACK_MODE_BUTT || trackMode < DRIVERBASE_TRACK_MODE_STEREO ){
+        return "No this track mode type";
+    }
+    
+    static const std::string trackModes[DRIVERBASE_TRACK_MODE_BUTT + 1] = {"[0]STEREO",
+        "[1]DOUBLE_MONO",
+        "[2]DOUBLE_LEFT",
+        "[3]DOUBLE_RIGHT",
+        "[4]EXCHANGE",
+        "[5]ONLY_RIGHT",
+        "[6]ONLY_LEFT",
+        "[7]MUTED",
+        "[8]BUTT"    
+    };
+    return trackModes[trackMode];
+}
