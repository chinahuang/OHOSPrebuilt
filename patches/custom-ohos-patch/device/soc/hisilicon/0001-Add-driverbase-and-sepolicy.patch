+        return RETURN_FAILURE;
+    }
+
+    int32_t ret = uapi_snd_get_avc_attr(UAPI_SND_0, &avcAttr);
+    if (ret != TD_SUCCESS) {
+        LOGE("uapi_snd_get_avc_attr fail, ret=%d", ret);
