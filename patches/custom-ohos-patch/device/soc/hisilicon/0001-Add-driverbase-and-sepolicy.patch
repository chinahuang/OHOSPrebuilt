+int32_t HdmiAudioControllerHal::PassThroughCreate(AoutHdmiDataType streamType)
+{
+    LOGI("current audio type is non-pcm");
+    struct sched_param param = {};
+    param.sched_priority = sched_get_priority_max(SCHED_FIFO);
+    if(pthread_setschedparam(pthread_self(), SCHED_FIFO, &param) != 0) {
+        LOGW("pthread_setschedparam failed!");
+    }
+    if((m_decoder == nullptr) || (m_track == nullptr)) {
+        LOGE("audio decoder or track is nullptr!");
+        return RETURN_FAILURE;
+    }
+    int32_t ret = m_decoder->Create();
+    if(ret != RETURN_SUCCESS) {
+        LOGE("audio decoder create failed:%d", ret);
+        return RETURN_FAILURE;
+    }
+    ret = m_decoder->Open();
+    if(ret != RETURN_SUCCESS) {
+        m_decoder->Destroy();
+        LOGE("audio decoder open failed:%d", ret);
+        return RETURN_FAILURE;
+    }
+    ret = m_track->AttachInput(m_decoder->GetHandle());
+    if(ret != RETURN_SUCCESS) {
+        LOGW("decoder bind track failed:%d", ret);
+    }
+    m_isTrackAttachAi = true;
+    int32_t adecType = m_decoder->GetAdecType(streamType);
+    //������ callback
+    // bool onlySupport = false;
+    // static_cast<void>(m_decoder->IsOnlySupportPassthrough(adecType, onlySupport));
+    //NotifyDecoderInfo(adecType);
+    if(adecType == 0) {
+        LOGW("Adec type is 0! Fail to set adecAttr!");
+        return RETURN_SUCCESS;
+    }
+    ret = m_decoder->SetAdecAttrMap(static_cast<uint32_t>(adecType), DEC_MODE_SIMUL);
+    if(ret == RETURN_SUCCESS) {
+        LOGI("Set adec attr successed, ret:%d", ret);
+        ret = m_decoder->Start();
+        m_isStartDecoder = true;
+        if(ret != RETURN_SUCCESS) {
+            LOGE("start decoder fail, ret:%d", ret);
+            return RETURN_FAILURE;
+        }
+        m_decoder->Pause();
+        m_passthroughPutBufCount = 0;
+    } else {
+        LOGE("Set adec attr failed, ret:%d", ret);
+    }
+    return RETURN_SUCCESS;
+}
+
+int32_t HdmiAudioControllerHal::PassThroughPlay()
+{
+    if(m_decoder == nullptr) {
+        LOGE("audio decoder is nullptr!");
+        return RETURN_FAILURE;
+    }
+    AoFrameInfo frame{};
+    int32_t ret = m_input->AcquireFrame(frame);
+    if(ret != RETURN_SUCCESS) {
+        LOGE("audio input acquire frame failed!, ret:0x%x", ret);
+        if(m_normalFlag && (ret == AI_NOT_ENOUGH_DATA || ret == AI_NOT_FIND_SYNC || ret == AI_BIT_INVALID_DATA)) {
+            ret = m_decoder->Reset();
+            if(ret != RETURN_SUCCESS) {
+                LOGW("decoder reset failed! ret = %d", ret);
+            }
+            usleep(10 * KILO_MICROSECOND); // sleep 10 ms
+            LOGE("sleep 10 ms");
+        }
+        return RETURN_FAILURE;
+    } else {
+        m_normalFlag = (!m_normalFlag);
+    }
+    StreamBuffer buff{};
+    ret = m_decoder->GetBuf(buff, frame.bitsBytesPerFrame);
+    if(ret == RETURN_SUCCESS && buff.data != nullptr && frame.pcmBuffer != nullptr) {
+        errno_t rc = memcpy_s(buff.data, frame.bitsBytesPerFrame, frame.pcmBuffer, frame.bitsBytesPerFrame);
+        if(rc != EOK) {
+            LOGE("memcpy_s failed! rc = %d", rc);
+            return RETURN_FAILURE;
+        }
+        if(m_decoder->PutBuf(frame.bitsBytesPerFrame) != RETURN_SUCCESS) {
+            LOGW("call decoder put buf failed!");
+        }
+        ret = AccumulateFlowCheck();
+        if(ret != RETURN_SUCCESS) {
+            LOGW("m_decoder resume fail");
+        }
+    } else {
+        usleep(KILO_MICROSECOND);
+        ret = RETURN_FAILURE;
+    }
+    if(ret != ADEC_IN_BUFF_FULL && ret != ADEC_IN_PTSBUFF_FULL && ret != ADEC_OUT_BUFF_FULL) {
+        if(m_input->ReleaseFrame(frame) != RETURN_SUCCESS){
+            LOGW("Release frame fail:%d", ret);
+        }
+    }
+    return RETURN_SUCCESS;
+}
+
+int32_t HdmiAudioControllerHal::AccumulateFlowCheck() 
+{
+    if(m_passthroughPutBufCount >= 0) {
+        if(m_passthroughPutBufCount >= WAIT_FOR_PUT_BUF_TIMES) {
+            int32_t ret = m_decoder->Resume();
+            if(ret != RETURN_SUCCESS) {
+                return RETURN_FAILURE;
+            }
+            m_passthroughPutBufCount = -1;
+        } else {
+            m_passthroughPutBufCount++;
+        }
+    }
+    return RETURN_SUCCESS;
+}
