+
+void HdmiAudioControllerHal::HdmiPlayLoop()
+{
+    if(m_input == nullptr) {
+        LOGE("audio input is nullptr!");
+        return;
+    }
+    if(m_track == nullptr) {
+        LOGE("audio track is nullptr!");
+        return;
+    }
+    int32_t ret = GetCurStreamType();
+    if(ret != RETURN_SUCCESS) {
+        return;
+    }
+    if(m_curStreamType != m_streamType) {
+        LOGI("m_curStreamType=%d, m_streamType=%d", m_curStreamType, m_streamType);
+        m_streamType = m_curStreamType;
+        if(m_curStreamType == DRIVERBASE_AOUT_HDMI_DATA_PCM) {
+            LOGI("current audio type is pcm");
+            static_cast<void>(m_input->SetEnable(true));
+            ret = m_track->AttachInput(m_input->GetHandle());
+            if(ret != RETURN_SUCCESS) {
+                LOGW("ai bind track ret = 0x%x", ret);
+            }
+            m_isTrackAttachAi = true;
+            static_cast<void>(InitCastForPcm());
+            return;
+        } else {
+            PassThroughDestroy();
+            ret = PassThroughCreate(m_curStreamType);
+            if(ret != RETURN_SUCCESS) {
+                LOGW("passThrough create fail");
+                m_streamType = DRIVERBASE_AOUT_HDMI_DATA_BUTT;
+                return;
+            }
+            static_cast<void>(InitCastForNoPcm());
+        }
+    }
+    if(m_streamType != DRIVERBASE_AOUT_HDMI_DATA_PCM) {
+        ret = PassThroughPlay();
+        if(ret != RETURN_SUCCESS) {
+            LOGW("passThrough play fail");
+            return;
+        }
+    }
+    PassThroughInfo();
+}
+
+int32_t HdmiAudioControllerHal::GetCurStreamType()
+{
+    if(m_curAudioType == DRIVERBASE_AOUT_HDMI_DATA_UNKNOWN || m_curAudioType == DRIVERBASE_AOUT_HDMI_DATA_BUTT) {
+        int32_t ret = m_input->GetStreamType(m_curStreamType);
+        if(ret != RETURN_SUCCESS) {
+            LOGI("get current audio stream type fail!");
+        }
+        if(m_curStreamType == DRIVERBASE_AOUT_HDMI_DATA_UNKNOWN || m_curStreamType == DRIVERBASE_AOUT_HDMI_DATA_BUTT) {
+            usleep(10 * KILO_MICROSECOND); //sleep 10 ms
+            return RETURN_FAILURE;
+        }
+    } else {
+        m_curStreamType= m_curAudioType;
+    }
+    return RETURN_SUCCESS;
+}
+
+void HdmiAudioControllerHal::PassThroughDestroy()
+{
+    LOGI("destory.");
+    //if track attach ai; detach
+    if(m_isTrackAttachAi && m_track != nullptr)  {
+        int32_t ret = m_track->DetachInput();
+        m_isTrackAttachAi = false;
+        if(ret == RETURN_SUCCESS) {
+            LOGD("Track Detach");
+        }
+    }
+    if(m_isStartDecoder && m_decoder != nullptr) {
+        static_cast<void>(m_decoder->Stop());
+        m_isStartDecoder = false;
+    }
+    if(m_decoder != nullptr) {
+        int32_t ret = m_decoder->Close();
+        if(ret != RETURN_SUCCESS) {
+            LOGW("audio decoder close failed!");
+        }
+        ret = m_decoder->Destroy();
+        if(ret != RETURN_SUCCESS) {
+            LOGW("audio decoder destroy failed!");
+        }
+    }
+}
