+// mute type of the audio port 
+enum SoundMuteType {
+    SOUND_MUTE_IRCTRL = 0,          // IR Mute
+    SOUND_MUTE_POLICY = 1,          // Policy Mute
+    SOUND_MUTE_SIGNAL = 2,          // No signal mute
+    SOUND_MUTE_SELSRC = 3,          // change source mute
+    SOUND_MUTE_SELPRG = 4,          // switch channel mute
