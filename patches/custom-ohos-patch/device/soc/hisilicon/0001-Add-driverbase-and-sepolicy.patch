+int32_t AudioDecoderHal::PcmOpenParam(uapi_audio_decode_attr &adecAttr, [[maybe_unused]]DecodeMode mode)
+{
+    ha_codec_wav_format wavFormat{};
+    bool isBigEndian = false;
+    if(wavFormat.cb_ext_word[0] == PCM_EXT_WORD || !isBigEndian) {
+        // if choose normal pcm decoder, set attribute
+        // if choose wifi_dsp_lpcm decoder, need not to set attribute by follows, ignore it
+        // set pcm wav format here base on pcm file
+        wavFormat.channels = 2;             // Channels is 2
+        wavFormat.samples_per_sec = 48000;  // SamplesPerSec is 48000
+        wavFormat.bits_per_sample = 16;     // BitPerSample is 16
+    }
+    ha_codec_pcm_dec_get_default_open_param(&(adecAttr.param), &wavFormat);
+    LOGI("please make sure the attributes of PCM stream is the same as defined "
+         "in function of \"HIADP_AVPlay_SetadecAttr\" ");
+    LOGI("(channels = 1, bits_per_sample = 16, samples_per_sec = 48000, isBigEndian = false)");
+    return RETURN_SUCCESS;
+}
