+static int32_t SubPortTrackOutManagerFreeTrack(int32_t trackId)
+{
+    MEDIA_HAL_LOCK(g_subPortTrackOutMngLock);
+    for (int32_t i = 0; i < AO_DEV_MAX_TRACK_NUM; i++) {
+        if (g_subPortTrackOuts[i].trackId == trackId) {
+            if (!(g_subPortTrackOuts[i].used)) {
+                MEDIA_HAL_UNLOCK(g_subPortTrackOutMngLock);
+                AUDIO_FUNC_LOGE("sub port out track %d not used can't free", trackId);
+                return MEDIA_HAL_ERR;
+            }
+            g_subPortTrackOuts[i].used = false;
+            MEDIA_HAL_UNLOCK(g_subPortTrackOutMngLock);
+            return MEDIA_HAL_OK;
+        }
+    }
+    MEDIA_HAL_UNLOCK(g_subPortTrackOutMngLock);
+    AUDIO_FUNC_LOGE("track id: %d is invalid", trackId);
+    return MEDIA_HAL_ERR;
+}
+
+static void ChangeInputAttrBitWidthFromFormat(SubPortTrackOutContext *portTrackOutCtx)
+{
+    if (portTrackOutCtx == NULL || portTrackOutCtx->inputAttr.bitWidth > 0) {
+        return;
+    }
+
+    struct PortPluginAttr *inputAttr = &(portTrackOutCtx->inputAttr);
+    switch (inputAttr->audioFormat) {
+        case AUDIO_FORMAT_TYPE_PCM_8_BIT:
+            inputAttr->bitWidth = AUDIO_BIT_WIDTH_8_BIT;
+            break;
+        case AUDIO_FORMAT_TYPE_PCM_16_BIT:
+            inputAttr->bitWidth = AUDIO_BIT_WIDTH_16_BIT;
+            break;
+        case AUDIO_FORMAT_TYPE_PCM_24_BIT:
+            inputAttr->bitWidth = AUDIO_BIT_WIDTH_24_BIT;
+            break;
+        case AUDIO_FORMAT_TYPE_PCM_32_BIT:
+            inputAttr->bitWidth = AUDIO_BIT_WIDTH_32_BIT;
+            break;
+        default:
+            break;
+    }
+}
+
+static int32_t SubPortTrackOutInit(SubPortTrackOutContext *portTrackOutCtx, const struct PortPluginAttr *inputAttr)
+{
+    portTrackOutCtx->inputAttr = *inputAttr;
+    if (pthread_mutex_init(&portTrackOutCtx->stateLock, NULL) != 0) {
+        return MEDIA_HAL_ERR;
+    }
+    portTrackOutCtx->isPause = false;
+    portTrackOutCtx->mute = false;
+
+    ChangeInputAttrBitWidthFromFormat(portTrackOutCtx);
+
+    portTrackOutCtx->common.audioPin = PIN_OUT_SPEAKER;
+    portTrackOutCtx->common.GetFrameCount = NULL;
+    portTrackOutCtx->common.GetLatency = AudioUsbSubPortOutGetLatency;
+    portTrackOutCtx->common.EnableTrack = AudioUsbSubPortOutEnableTrack;
+    portTrackOutCtx->common.DisableTrack = AudioUsbSubPortOutDisableTrack;
+    portTrackOutCtx->common.PauseTrack = AudioUsbSubPortOutPauseTrack;
+    portTrackOutCtx->common.ResumeTrack = AudioUsbSubPortOutResumeTrack;
+    portTrackOutCtx->common.FlushTrack = AudioUsbSubPortOutFlush;
+    portTrackOutCtx->common.AcquireFrame = NULL;
+    portTrackOutCtx->common.SendFrame = AudioUsbSubPortOutSendFrame;
+    portTrackOutCtx->common.GetPosition = AudioUsbSubPortOutGetPosition;
+    portTrackOutCtx->common.SetMute = AudioUsbSubPortOutTrackSetMute;
+    portTrackOutCtx->common.GetMute = AudioUsbSubPortOutTrackGetMute;
+    portTrackOutCtx->common.SetVolume = AudioUsbSubPortOutTrackSetVolume;
+    portTrackOutCtx->common.GetVolume = AudioUsbSubPortOutTrackGetVolume;
+    portTrackOutCtx->common.Invoke = AudioUsbSubPortOutInvoke;
+
+#ifdef DUMPFILE
+    portTrackOutCtx->pfd = fopen(g_audioOutPath, "wb+");
+    if (portTrackOutCtx->pfd == NULL) {
+        AUDIO_FUNC_LOGE("Error opening pcm test file!");
+    }
+#endif // DUMPFILE
+
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioUsbSubPortOutGetLatency(AudioHandle trackHandle, uint32_t *latencyMs)
+{
+    SubPortTrackOutContext *portTrackOutCtx = (SubPortTrackOutContext *)trackHandle;
+
+    MEDIA_HAL_UNUSED(portTrackOutCtx);
+    MEDIA_HAL_UNUSED(latencyMs);
+
+    AUDIO_FUNC_LOGI("AudioUsbSubPortOutGetLatency not support");
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioUsbSubPortOutEnableTrack(AudioHandle trackHandle)
+{
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioUsbSubPortOutDisableTrack(AudioHandle trackHandle)
+{
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioUsbSubPortOutPauseTrack(AudioHandle trackHandle)
+{
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioUsbSubPortOutResumeTrack(AudioHandle trackHandle)
+{
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+#ifdef DUMPFILE
+static void WriteDumpFile(const uint8_t *buffer, uint64_t requestBytes, FILE *pfd)
+{
+    size_t writeResult = fwrite((void*)buffer, 1, requestBytes, pfd);
+    (void)fflush(pfd);
+    if (writeResult != requestBytes) {
+        AUDIO_FUNC_LOGE("Failed to write the file.");
+    }
+}
+#endif
+
+/* transform planar to packed */
+static void SwapPcm16PToPcm16(int16_t *in, uint32_t smpNum, int16_t *out)
+{
+    for (uint32_t i = 0; i < smpNum; i++) {
+        out[0x2 * i] = in[i];
+        out[0x2 * i + 1] = in[i + smpNum];
+    }
+}
+
+static int32_t CheckInputParam(AudioHandle trackHandle, const uint8_t *buffer, uint64_t requestBytes,
+    const uint64_t *replyBytes)
+{
+    CHK_NULL_RETURN(trackHandle, MEDIA_HAL_ERR, "trackHandle null");
+    CHK_NULL_RETURN(buffer, MEDIA_HAL_ERR, "buffer null");
+    CHK_NULL_RETURN(replyBytes, MEDIA_HAL_ERR, "replyBytes null");
+    if (requestBytes >= MAX_PERIOD_SIZE * 0x4) {
+        AUDIO_FUNC_LOGE("requestBytes:0x%lld too large", requestBytes);
+        return MEDIA_HAL_ERR;
+    }
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioUsbSubPortOutSendFrame(AudioHandle trackHandle, const uint8_t *buffer,
+    uint64_t requestBytes, uint64_t *replyBytes)
+{
+    SubPortTrackOutContext *portTrackOutCtx = (SubPortTrackOutContext *)trackHandle;
+
+    if (CheckInputParam(portTrackOutCtx, buffer, requestBytes, replyBytes) != MEDIA_HAL_OK) {
+        return MEDIA_HAL_ERR;
+    }
+
+    *replyBytes = 0;
+    uint8_t *data = (uint8_t *)buffer;
+    if (!portTrackOutCtx->inputAttr.interleaved && portTrackOutCtx->inputAttr.channelCount == 0x2) {
+        uint32_t smpNum = (uint32_t)requestBytes / 0x4; /* pcm16 and two channels */
+        SwapPcm16PToPcm16((int16_t *)data, smpNum, (int16_t *)portTrackOutCtx->bufferSwap);
+        data = portTrackOutCtx->bufferSwap;
+    }
+    uint32_t expectSize = pcm_frames_to_bytes(portTrackOutCtx->pcm, pcm_get_buffer_size(portTrackOutCtx->pcm));
+    if (requestBytes > expectSize) {
+        AUDIO_FUNC_LOGE("buffer too large, actual: %llu vs expect: %u", requestBytes, expectSize);
+        return MEDIA_HAL_INVALID_PARAM;
+    }
+
+    int32_t ret = pcm_write(portTrackOutCtx->pcm, data, requestBytes);
+    if (ret != MEDIA_HAL_OK) {
+        AUDIO_FUNC_LOGE("pcm_read failed:0x%x", ret);
+        return MEDIA_HAL_ERR;
+    }
+    *replyBytes = requestBytes;
+
+#ifdef DUMPFILE
+    WriteDumpFile(data, requestBytes, portTrackOutCtx->pfd);
+#endif // DUMPFILE
+
+    portTrackOutCtx->frames += (requestBytes / portTrackOutCtx->inputAttr.channelCount / sizeof(int16_t));
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioUsbSubPortOutGetPosition(AudioHandle trackHandle,
+    uint64_t *frames, struct AudioTimeStamp *time)
+{
+    SubPortTrackOutContext *portTrackOutCtx = (SubPortTrackOutContext *)trackHandle;
+    *frames = portTrackOutCtx->frames;
+    int64_t timeMs = portTrackOutCtx->frames / (portTrackOutCtx->inputAttr.sampleRate / TIME_S_TO_MS);
+    time->tvSec = timeMs / TIME_S_TO_MS;
+    time->tvNSec = (timeMs % TIME_S_TO_MS) * TIME_MS_TO_NS;
+    return MEDIA_HAL_OK;
+}
