+static void ChangeInputAttrBitWidthFromFormat(SubPortTrackOutContext *portTrackOutCtx)
+{
+    if (portTrackOutCtx == NULL || portTrackOutCtx->inputAttr.bitWidth > 0) {
+        return;
+    }
+
+    struct PortPluginAttr *inputAttr = &(portTrackOutCtx->inputAttr);
+    switch (inputAttr->audioFormat) {
+        case AUDIO_FORMAT_TYPE_PCM_8_BIT:
+            inputAttr->bitWidth = AUDIO_BIT_WIDTH_8_BIT;
+            break;
+        case AUDIO_FORMAT_TYPE_PCM_16_BIT:
+            inputAttr->bitWidth = AUDIO_BIT_WIDTH_16_BIT;
+            break;
+        case AUDIO_FORMAT_TYPE_PCM_24_BIT:
+            inputAttr->bitWidth = AUDIO_BIT_WIDTH_24_BIT;
+            break;
+        case AUDIO_FORMAT_TYPE_PCM_32_BIT:
+            inputAttr->bitWidth = AUDIO_BIT_WIDTH_32_BIT;
+            break;
+        default:
+            break;
+    }
+}
