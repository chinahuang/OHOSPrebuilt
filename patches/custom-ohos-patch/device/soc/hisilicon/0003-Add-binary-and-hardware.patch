+static int32_t PrimaryPortSetVolume(AudioHandle portHandle, float volume)
+{
+    CHK_NULL_RETURN(portHandle, MEDIA_HAL_INVALID_PARAM, "Input param portHandle is null");
+    PrimaryPortContext *priPortCtx = (PrimaryPortContext *)portHandle;
+    CHK_FAILED_RETURN(priPortCtx->isOpened, true, MEDIA_HAL_ERR, "port not open");
+    CHK_NULL_RETURN(priPortCtx->portInfo.aoutDev, MEDIA_HAL_ERR, "aoutDev null");
+    CHK_NULL_RETURN(priPortCtx->portInfo.aoutDev->aout_set_mute, MEDIA_HAL_ERR, "not support set_mute");
+    if (volume > 1.0) {
+        AUDIO_FUNC_LOGE("volum[%{public}f] invalid, range[0,1]", volume);
+        return MEDIA_HAL_INVALID_PARAM;
+    }
+
+    double gain = 20 * log10(volume);
+    int32_t intGain = gain;
+    int32_t decGain = (gain - (double)intGain) / 0.125;
+    intGain = (intGain >= AOUT_VOL_DB_MIN) ? intGain : AOUT_VOL_DB_MIN;
+    int32_t ret = priPortCtx->portInfo.aoutDev->aout_set_volume(priPortCtx->portInfo.aoutDev,
+        priPortCtx->portInfo.aoutHdl, AOUT_DEVICE_ALL, intGain, decGain);
+    if (ret != MEDIA_HAL_OK) {
+        AUDIO_FUNC_LOGE("aout_set_volume failed, ret:%d", ret);
+        return MEDIA_HAL_ERR;
+    }
+
+    priPortCtx->volume = volume;
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
