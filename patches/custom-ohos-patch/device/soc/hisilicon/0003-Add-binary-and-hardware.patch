+static int32_t AudioPrimarySubPortCheckSampleAttributes(const struct AudioSampleAttributes *attrs)
+{
+    if (attrs->type > AUDIO_IN_CALL) {
+        AUDIO_FUNC_LOGE("not support type%d", attrs->type);
+        return MEDIA_HAL_ERR;
+    }
+    if (attrs->channelCount != 1 && attrs->channelCount != 0x2) {
+        AUDIO_FUNC_LOGE("channel count:%d error", attrs->channelCount);
+        return MEDIA_HAL_ERR;
+    }
+
+    if (attrs->sampleRate != SAMPLE_RATE_8K && attrs->sampleRate != SAMPLE_RATE_16K &&
+        attrs->sampleRate != SAMPLE_RATE_24K && attrs->sampleRate != SAMPLE_RATE_32K &&
+        attrs->sampleRate != SAMPLE_RATE_48K && attrs->sampleRate != SAMPLE_RATE_44_1K &&
+        attrs->sampleRate != SAMPLE_RATE_64K && attrs->sampleRate != SAMPLE_RATE_96K) {
+        AUDIO_FUNC_LOGE("sampleRate:%d error", attrs->sampleRate);
+        return MEDIA_HAL_ERR;
+    }
+
+    if (attrs->format != AUDIO_FORMAT_TYPE_PCM_16_BIT) {
+        AUDIO_FUNC_LOGE("not support format%d", attrs->format);
+        return MEDIA_HAL_ERR;
+    }
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioPrimarySubPortOutSetSampleAttributes(AudioHandle trackHandle,
+    const struct AudioSampleAttributes *attrs)
+{
+    CHK_NULL_RETURN(trackHandle, MEDIA_HAL_INVALID_PARAM, "trackHandle null");
+    CHK_NULL_RETURN(attrs, MEDIA_HAL_INVALID_PARAM, "attrs null");
+
+    int32_t ret = AudioPrimarySubPortCheckSampleAttributes(attrs);
+    if (ret != MEDIA_HAL_OK) {
+        return HDF_ERR_INVALID_PARAM;
+    }
+    SubPortTrackOutContext *portTrackOutCtx = (SubPortTrackOutContext *)trackHandle;
+    AOUT_TRACK_PARAMS_S params = {};
+    MEDIA_HAL_DOFUNC_TIME(ret = portTrackOutCtx->info.aoutDev->track_get_default_attr(portTrackOutCtx->info.aoutDev, &params));
+    CHK_FAILED_RETURN(ret, MEDIA_HAL_OK, ret, "track_get_default_attr failed");
+    params.enFormat = attrs->format;
+    params.u32SampleRate = attrs->sampleRate;
+    params.u32Channels = attrs->channelCount;
+    params.u32BufferSize = params.u32Channels * 0x2 * params.u32SampleRate * AOUT_TRACK_BUFFER_MS / TIME_S_TO_MS;
+    if (!portTrackOutCtx->isStart) {
+        MEDIA_HAL_DOFUNC_TIME(ret = portTrackOutCtx->info.aoutDev->track_set_params(portTrackOutCtx->info.aoutDev,
+            portTrackOutCtx->trackHandle, &params));
+        CHK_FAILED_RETURN(ret, MEDIA_HAL_OK, ret, "track_set_params failed");
+        portTrackOutCtx->trackParam = *attrs;
+    }
+    return MEDIA_HAL_OK;
