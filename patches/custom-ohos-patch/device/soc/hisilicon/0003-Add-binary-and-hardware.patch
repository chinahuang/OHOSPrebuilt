+    if (!hwCapture->started) {
+        MEDIA_HAL_UNLOCK(hwCapture->mutex);
+        AUDIO_FUNC_LOGE("hwCapture not started");
+        return MEDIA_HAL_ERR;
+    }
+    int32_t ret = hwCapture->trackHandle->GetPosition(hwCapture->trackHandle, frames, time);
+    if (ret != MEDIA_HAL_OK) {
+        MEDIA_HAL_UNLOCK(hwCapture->mutex);
+        AUDIO_FUNC_LOGE("AudioPortTrack GetPosition failed: 0x%x", ret);
+        return ret;
+    }
+    MEDIA_HAL_UNLOCK(hwCapture->mutex);
+    return MEDIA_HAL_OK;
+}
