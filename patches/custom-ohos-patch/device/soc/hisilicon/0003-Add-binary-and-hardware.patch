+++ b/common/hardware/ir_user/key_pars/key_pars.cpp
@@ -0,0 +1,216 @@
+/*
+ * Copyright (c) Huawei Technologies Co., Ltd. 2012-2019. All rights reserved.
+ * Description: parse key for virtualkeypad
+ * Author: hisilicon
+ * Create: 2012-01-01
+ */
+
+#include "key_pars.h"
+#include <linux/input.h>
+#include <securec.h>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <memory>
+#include "hi_log.h"
+#include "linux_key.h"
+#include "libxml/parser.h"
+#include "CustUtils.h"
+
+using namespace std;
+
+#define XLOGD(...) HI_LOG_INFO("ir_user:key_pars", __VA_ARGS__)
+
+#define PARS_LOG(fmt...) printf(fmt)
+
+const string KEY_XML_PATH = "system/etc/key_ir.xml";
+const string KEY_XML_PATH_BACKUP = "system/etc/key_ir.xml";
+
+const int KEY_ARRAY_NUM = 2;
+
+static HiKeycode g_powerKey[WAKEUP_IRKEY_MAXNUM] = {{0, 0}};
+static unsigned int g_powerKeyNum = 0;
+
+int FindLinuxKeyCode(const string str, unsigned int &linuxKeyCode)
+{
+    int j = sizeof(g_linuxKeycodeArray) / sizeof(g_linuxKeycodeArray[0]);
+    if (j > LINUX_KEYCODE_ARY_SIZE) {
+        return 0;
+    }
+    for (int i = 0; i < j; i++) {
+        if (!strcmp(g_linuxKeycodeArray[i].linux_keycode_name, str.c_str())) {
+            linuxKeyCode = g_linuxKeycodeArray[i].linux_keycode;
+            return 1;
+        }
+    }
+    return 0;
+}
+
+xmlDocPtr ReadXml(const char fileName[], xmlNodePtr &nodeptr)
+{
+    xmlDocPtr docEntry = nullptr;
+    xmlNodePtr rootNode = nullptr;
+    // format xml
+    xmlKeepBlanksDefault(0);
+
+    docEntry = xmlReadFile(fileName, nullptr, XML_PARSE_NOBLANKS);
+    if (docEntry == nullptr) {
+        PARS_LOG("Document not parsed successfully. \n");
+        return nullptr;
+    }
+
+    rootNode = xmlDocGetRootElement(docEntry);
+    /* check root node is null */
+    if (rootNode == nullptr) {
+        PARS_LOG("empty document, not root node \n");
+        xmlFreeDoc(docEntry);
+        return nullptr;
+    }
+
+    if (rootNode->name == nullptr) {
+        xmlFreeDoc(docEntry);
+        return nullptr;
+    }
+
+    if (xmlStrcmp(rootNode->name, BAD_CAST "key_xml")) {
+        PARS_LOG("document of the wrong type, root node != key_xml\n");
+        xmlFreeDoc(docEntry);
+        return nullptr;
+    }
+    nodeptr = rootNode;
+
+    return docEntry;
+}
+
+std::string GetProp(const xmlNodePtr &nodePtr, const string &key)
+{
+    xmlChar *prop = xmlGetProp(nodePtr, BAD_CAST(key.c_str()));
+    if (prop == nullptr) {
+        return "";
+    }
+    std::string value = reinterpret_cast<char *>(prop);
+    xmlFree(prop);
+    return value;
+}
+
+void SetKeyArry(xmlNodePtr &xmlChildNodePtr, struct KeyArry keyarry[], int &keynum)
+{
+    if (keyarry == nullptr) {
+        return;
+    }
+    unsigned long long irKeycode = 0;
+    unsigned int linuxKeycode;
+
+    std::string keyValue = GetProp(xmlChildNodePtr, "value");
+    irKeycode = strtoull(keyValue.c_str(), nullptr, 16);  // 16, an integral number of the specified base
+
+    std::string keyName = GetProp(xmlChildNodePtr, "name");
+    if (keyName.empty()) {
+        return;
+    }
+    int ret = FindLinuxKeyCode(keyName.c_str(), linuxKeycode);
+    if (ret != 0) {
+        keyarry->hi_keycode[keynum].ir_keycode = irKeycode;
+        keyarry->hi_keycode[keynum].linux_keycode = linuxKeycode;
+
+        PARS_LOG("   linuxKeycode=0x%04x, irKeycode=0x%.08llx, %s\n", linuxKeycode, irKeycode, keyName.c_str());
+        // save g_powerKey value
+        if (keyarry->hi_keycode[keynum].linux_keycode == KEY_POWER && g_powerKeyNum < WAKEUP_IRKEY_MAXNUM) {
+            errno_t ret = memmove_s(reinterpret_cast<void *>(&g_powerKey[g_powerKeyNum++]),
+                sizeof(HiKeycode),
+                reinterpret_cast<void *>(&keyarry->hi_keycode[keynum]),
+                sizeof(HiKeycode));
+            if (ret != EOK) {
+                PARS_LOG("memmove_s error, %d\n", ret);
+                return;
+            }
+        }
+        keynum = keynum + 1;
+    }
+    XLOGD("key_name: %s key_value:0x%0llx\n", keyName.c_str(), irKeycode);
+}
+
+void ParsKey(xmlNodePtr &nodeptr, struct KeyArry keyarry[])
+{
+    int keynum = 0;
+
+    if (keyarry == nullptr) {
+        return;
+    }
+
+    xmlNodePtr xmlChildNodePtr = nullptr;
+
+    if (nodeptr->name != nullptr) {
+        int nodeNameLen = strnlen((char *)nodeptr->name, KEY_NAME_MAX);
+        if (KEY_NAME_MAX > nodeNameLen) {
+            errno_t err = memcpy_s(keyarry->keyname, KEY_NAME_MAX, (char *)nodeptr->name, nodeNameLen);
+            if (err != EOK) {
+                XLOGD("memcpy_s failed.err = %d\n", err);
+                return;
+            }
+        }
+        keyarry->keyname[nodeNameLen] = '\0';
+        PARS_LOG("remote controler name=%s\n", keyarry->keyname);
+        xmlChildNodePtr = nodeptr->xmlChildrenNode;
+    }
+
+    while (xmlChildNodePtr != nullptr) {
+        if (keynum >= KEYNUMMAX) {
+            PARS_LOG("we only support max num  keys in one Remote controler\n");
+            break;
+        }
+        if (xmlHasProp(xmlChildNodePtr, BAD_CAST "value")) {
+            SetKeyArry(xmlChildNodePtr, keyarry, keynum);
+        }
+        xmlChildNodePtr = xmlChildNodePtr->next;
+    }
+    keyarry->keynum = keynum;
+
+    return;
+}
+
+void GetKeycode(KeyArry keyarry[], int keyArrayNum)
+{
+    xmlNodePtr rootNode = nullptr;
+    xmlNodePtr childNode = nullptr;
+
+    if (keyArrayNum > KEY_ARRAY_NUM) {
+        return;
+    }
+    char tmpPath[MAX_PATH_LEN] = {0};
+    const char *oneFile = cust_get_one_cfg_file(KEY_XML_PATH.c_str(), CUST_TYPE_CONFIG, tmpPath, MAX_PATH_LEN);
+    if (oneFile == nullptr) {
+        oneFile = cust_get_one_cfg_file(KEY_XML_PATH_BACKUP.c_str(), CUST_TYPE_CONFIG, tmpPath, MAX_PATH_LEN);
+        if (oneFile == nullptr) {
+            PARS_LOG("can't find the key.xml\n");
+            return;
+        }
+    }
+    xmlDocPtr docEntry = ReadXml(oneFile, rootNode);
+    if (docEntry == nullptr) {
+        PARS_LOG("Document not parsed successfully. \n");
+        return;
+    }
+
+    childNode = rootNode->xmlChildrenNode;
+
+    for (int i = 0; i < keyArrayNum; i++) {
+        if (childNode != nullptr) {
+            ParsKey(childNode, keyarry);
+            childNode = childNode->next;
+            keyarry = keyarry + 1;
+        }
+    }
+
+    xmlFreeDoc(docEntry);
+}
+
+void GetPowerKeyCode(unsigned long long irPowerKeyCode[], unsigned int &powerKeyNum)
+{
+    if (irPowerKeyCode != nullptr && g_powerKeyNum < WAKEUP_IRKEY_MAXNUM) {
+        powerKeyNum = g_powerKeyNum;
+        for (unsigned int i = 0; i < g_powerKeyNum; i++) {
+            irPowerKeyCode[i] = g_powerKey[i].ir_keycode;
+        }
+    }
+}
