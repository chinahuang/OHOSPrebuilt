+﻿/*
+ * Copyright (c) Hisilicon Technologies Co., Ltd. 2021-2021. All rights reserved.
+ * Description: Usb port plugin
+ * Author: Media Software Group
+ * Create: 2021-09-28
+ */
+
+#include "audio_usb_port_plugin.h"
+
+#include <stdlib.h>
+
+#include "audio_usb_sub_port_in.h"
+#include "audio_usb_sub_port_out.h"
+#include "media_hal_common.h"
+#include "audio_port_plugin_usb.h"
+#include "securec.h"
+#include "audio_uhdf_log.h"
+
+#ifdef __cplusplus
+#if __cplusplus
+extern "C" {
+#endif
+#endif /* __cplusplus */
+
+#define MODULE_NAME "AudioUSBPortPlugin"
+#define SAMPLE_RATE_8K   8000
+#define SAMPLE_RATE_16K   16000
+#define SAMPLE_RATE_24K   24000
+#define SAMPLE_RATE_32K   32000
+#define SAMPLE_RATE_48K   48000
+#define SAMPLE_RATE_44_1K 44100
+
+typedef struct {
+    /* port context */
+    bool isOpened;
+    /* sub port context */
+    AudioHandle subPortInHandle;
+    AudioHandle subPortOutHandle;
+    AudioHandle subPortTrackHandle;
+} UsbPortContext;
+
+static enum AudioFormat g_supportFormats[] = {
+    AUDIO_FORMAT_TYPE_PCM_16_BIT,
+};
+
+static int32_t UsbSubPortCreateTrack(UsbPortContext *portCtx, const struct PortPluginAttr *portAttr, bool isMic)
+{
+    int32_t ret;
+
+    if (portAttr->audioFormat != AUDIO_FORMAT_TYPE_PCM_16_BIT) {
+        AUDIO_FUNC_LOGE("only support AUDIO_FORMAT_TYPE_PCM_16_BIT");
+        return MEDIA_HAL_ERR;
+    }
+    if (portAttr->channelCount != 1 && portAttr->channelCount != 0x2) {
+        AUDIO_FUNC_LOGE("channel count:%d error", portAttr->channelCount);
+        return MEDIA_HAL_ERR;
+    }
+    if (portAttr->sampleRate != SAMPLE_RATE_8K && portAttr->sampleRate != SAMPLE_RATE_16K &&
+        portAttr->sampleRate != SAMPLE_RATE_24K && portAttr->sampleRate != SAMPLE_RATE_32K &&
+        portAttr->sampleRate != SAMPLE_RATE_48K && portAttr->sampleRate != SAMPLE_RATE_44_1K) {
+        AUDIO_FUNC_LOGE("sampleRate:%d error", portAttr->sampleRate);
+        return MEDIA_HAL_ERR;
+    }
+
+    if (isMic) {
+        ret = AudioUsbSubPortInCreateTrack(portCtx->subPortInHandle, portAttr, &portCtx->subPortTrackHandle);
+        CHK_FAILED_RETURN(ret, MEDIA_HAL_OK, ret, "AudioUsbSubPortInCreateTrack failed");
+    } else {
+        ret = AudioUsbSubPortOutCreateTrack(portCtx->subPortOutHandle, portAttr, &portCtx->subPortTrackHandle);
+        CHK_FAILED_RETURN(ret, MEDIA_HAL_OK, ret, "AudioUsbSubPortOutCreateTrack failed");
+    }
+
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+static int32_t UsbSubPortDestroyTrack(const UsbPortContext *portCtx, AudioHandle trackHandle)
+{
+    int32_t ret;
+    AudioPortTrack *portTrack = (AudioPortTrack *)trackHandle;
+    if (portTrack->audioPin == PIN_IN_MIC) {
+        ret = AudioUsbSubPortInDestroyTrack(portCtx->subPortInHandle, trackHandle);
+        CHK_FAILED_RETURN(ret, MEDIA_HAL_OK, ret, "AudioUsbSubPortInDestroyTrack failed");
+    } else {
+        ret = AudioUsbSubPortOutDestroyTrack(portCtx->subPortOutHandle, trackHandle);
+        CHK_FAILED_RETURN(ret, MEDIA_HAL_OK, ret, "AudioUsbSubPortOutDestroyTrack failed");
+    }
+
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+static int32_t InitPortForCapabilitySub(const struct AudioPort *port, struct AudioPortCapability *capability)
+{
+    if (port->dir == PORT_IN) {
+        capability->deviceId = 0;
+        capability->hardwareMode = false;
+        capability->formatNum = 1;
+        capability->formats = g_supportFormats;
+        capability->sampleRateMasks = AUDIO_SAMPLE_RATE_MASK_8000 | AUDIO_SAMPLE_RATE_MASK_16000 |
+            AUDIO_SAMPLE_RATE_MASK_24000 | AUDIO_SAMPLE_RATE_MASK_32000 | AUDIO_SAMPLE_RATE_MASK_44100 |
+            AUDIO_SAMPLE_RATE_MASK_48000;
+        capability->channelMasks = AUDIO_CHANNEL_STEREO;
+        capability->channelCount = 0x2;
+        capability->subPorts = NULL;
+    } else if (port->dir == PORT_IN) {
+        capability->deviceId = 1;
+        capability->hardwareMode = false;
+        capability->formatNum = 1;
+        capability->formats = g_supportFormats;
+        capability->sampleRateMasks = AUDIO_SAMPLE_RATE_MASK_8000 | AUDIO_SAMPLE_RATE_MASK_16000 |
+            AUDIO_SAMPLE_RATE_MASK_32000 | AUDIO_SAMPLE_RATE_MASK_44100 | AUDIO_SAMPLE_RATE_MASK_48000;
+        capability->channelMasks = AUDIO_CHANNEL_STEREO;
+        capability->channelCount = 0x2;
+        capability->subPortsLen = 1;
+        capability->subPorts = (struct AudioSubPortCapability *)OsalMemCalloc(
+            capability->subPortsLen * sizeof(struct AudioSubPortCapability));
+        if (capability->subPorts == NULL) {
+            AUDIO_FUNC_LOGE("The pointer is null!");
+            return MEDIA_HAL_ERR;
+        }
+        capability->subPorts->portId = 1;
+        capability->subPorts->desc = "usb-audio-snd";
+        capability->subPorts->mask = PORT_PASSTHROUGH_LPCM;
+    }
+    return MEDIA_HAL_OK;
+}
+
+static int32_t UsbPortGetPortPluginCapability(const struct AudioPort *port,
+    struct AudioPortCapability *capability)
+{
+    CHK_NULL_RETURN(port, MEDIA_HAL_INVALID_PARAM, "Input param port is null");
+    CHK_NULL_RETURN(capability, MEDIA_HAL_INVALID_PARAM, "Input param capability is null");
+
+    if (port->dir == PORT_IN) {
+        if (GetAudioCaptureCard() == -1) {
+            AUDIO_FUNC_LOGI("no input asound card");
+            return MEDIA_HAL_ERR;
+        }
+    } else if (port->dir == PORT_OUT) {
+        if (GetAudioRenderCard() == -1) {
+            AUDIO_FUNC_LOGI("no output asound card");
+            return MEDIA_HAL_ERR;
+        }
+    } else {
+        AUDIO_FUNC_LOGE("port direction: 0x%x is invalid", port->dir);
+        return MEDIA_HAL_INVALID_PARAM;
+    }
+    InitPortForCapabilitySub(port, capability);
+    AUDIO_FUNC_LOGI("%s get capability success", port->portName);
+    return MEDIA_HAL_OK;
+}
+
+static int32_t UsbPortOpen(AudioHandle *portHandle)
+{
+    AUDIO_FUNC_LOGI("plugin use usb audio card");
+    CHK_NULL_RETURN(portHandle, MEDIA_HAL_INVALID_PARAM, "Input param portHandle is null");
+
+    UsbPortContext *priPortCtx = (UsbPortContext *)malloc(sizeof(UsbPortContext));
+    if (priPortCtx == NULL) {
+        AUDIO_FUNC_LOGI("malloc failed");
+        return MEDIA_HAL_NO_MEM;
+    }
+
+    if (memset_s(priPortCtx, sizeof(UsbPortContext), 0, sizeof(UsbPortContext)) != EOK) {
+        AUDIO_FUNC_LOGE("memset_s failed");
+        free(priPortCtx);
+        return MEDIA_HAL_ERR;
+    }
+
+    if (AudioUsbSubPortInCreate(&priPortCtx->subPortInHandle) != MEDIA_HAL_OK) {
+        AUDIO_FUNC_LOGE("AudioUsbSubPortInCreate failed");
+        free(priPortCtx);
+        return MEDIA_HAL_ERR;
+    }
+    if (AudioUsbSubPortOutCreate(&priPortCtx->subPortOutHandle) != MEDIA_HAL_OK) {
+        AudioUsbSubPortInDestroy(priPortCtx->subPortInHandle);
+        priPortCtx->subPortInHandle = NULL;
+        free(priPortCtx);
+        AUDIO_FUNC_LOGE("AudioUsbSubPortOutCreate failed");
+        return MEDIA_HAL_ERR;
+    }
+
+    priPortCtx->isOpened = true;
+    *portHandle = priPortCtx;
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+static int32_t UsbPortCreateTrack(AudioHandle portHandle, enum AudioPortPin audioPortPin,
+    const struct PortPluginAttr *portAttr, AudioHandle *trackHandle)
+{
+    CHK_NULL_RETURN(portHandle, MEDIA_HAL_INVALID_PARAM, "Input param portHandle is null");
+    CHK_NULL_RETURN(trackHandle, MEDIA_HAL_INVALID_PARAM, "Input param trackHandle is null");
+    CHK_NULL_RETURN(portAttr, MEDIA_HAL_INVALID_PARAM, "Input param portAttr is null");
+
+    UsbPortContext *priPortCtx = (UsbPortContext *)portHandle;
+    CHK_FAILED_RETURN(priPortCtx->isOpened, true, MEDIA_HAL_ERR, "port not open");
+
+    bool isMic = (audioPortPin == PIN_OUT_USB_HEADSET) ? false : true;
+    int32_t ret = UsbSubPortCreateTrack(priPortCtx, portAttr, isMic);
+    CHK_FAILED_RETURN(ret, MEDIA_HAL_OK, ret, "UsbSubPortCreateTrack failed");
+
+    *trackHandle = priPortCtx->subPortTrackHandle;
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+static int32_t UsbPortDestroyTrack(AudioHandle portHandle, AudioHandle trackHandle)
+{
+    CHK_NULL_RETURN(portHandle, MEDIA_HAL_INVALID_PARAM, "Input param portHandle is null");
+    CHK_NULL_RETURN(trackHandle, MEDIA_HAL_INVALID_PARAM, "Input param trackHandle is null");
+
+    UsbPortContext *priPortCtx = (UsbPortContext *)portHandle;
+    CHK_FAILED_RETURN(priPortCtx->isOpened, true, MEDIA_HAL_ERR, "port not open");
+
+    int32_t ret = UsbSubPortDestroyTrack(priPortCtx, trackHandle);
+    CHK_FAILED_NO_RETURN(ret, MEDIA_HAL_OK, "UsbSubPortDestroyTrack failed");
+
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+static int32_t UsbPortClose(AudioHandle portHandle)
+{
+    CHK_NULL_RETURN(portHandle, MEDIA_HAL_INVALID_PARAM, "Input param portHandle is null");
+    UsbPortContext *priPortCtx = (UsbPortContext *)portHandle;
+    CHK_FAILED_RETURN(priPortCtx->isOpened, true, MEDIA_HAL_ERR, "port not open");
+
+    int32_t ret;
+
+    ret = AudioUsbSubPortInDestroy(priPortCtx->subPortInHandle);
+    CHK_FAILED_NO_RETURN(ret, MEDIA_HAL_OK, "AudioUsbSubPortInDestroy failed");
+
+    ret = AudioUsbSubPortOutDestroy(priPortCtx->subPortOutHandle);
+    CHK_FAILED_NO_RETURN(ret, MEDIA_HAL_OK, "AudioUsbSubPortOutDestroy failed");
+
+    priPortCtx->isOpened = false;
+    free(priPortCtx);
+
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+AudioPortPlugin g_usbPortPlugin = {
+    .audioPortDir = PORT_OUT_IN,
+    .audioPortPins = PIN_IN_MIC | PIN_OUT_SPEAKER,
+    .GetPortPluginCapability = UsbPortGetPortPluginCapability,
+    .Open = UsbPortOpen,
+    .CreateTrack = UsbPortCreateTrack,
+    .DestroyTrack = UsbPortDestroyTrack,
+    .Close = UsbPortClose,
+    .SetMute = NULL,
+    .GetMute = NULL,
+    .SetVolume = NULL,
+    .GetVolume = NULL,
+};
+
+const AudioPortPlugin *GetUSBPortPluginFuncs(AudioPluginType pluginType)
+{
+    return &g_usbPortPlugin;
+}
+
+#ifdef __cplusplus
+#if __cplusplus
+}
+#endif
+#endif /* __cplusplus */
