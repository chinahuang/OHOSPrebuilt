diff --git a/common/hardware/virtual_keypad/main.cpp b/common/hardware/virtual_keypad/main.cpp
new file mode 100644
index 0000000..ca81d00
--- /dev/null
+++ b/common/hardware/virtual_keypad/main.cpp
@@ -0,0 +1,500 @@
+/*
+ * Copyright (c) Huawei Technologies Co., Ltd. 2012-2019. All rights reserved.
+ * Description: main file for virtualkeypad
+ * Author: hisilicon
+ * Create: 2012-01-01
+ */
+
+#include <arpa/inet.h>
+#include <cerrno>
+#include <linux/input.h>
+#include <linux/uinput.h>
+#include <netinet/in.h>
+#include <thread>
+#include <cstdio>
+#include <cstdlib>
+#include <errno.h>
+#include <string>
+#include <sys/epoll.h>
+#include <sys/socket.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#include <cassert>
+#include <fcntl.h>
+#include <linux/fb.h>
+#include <securec.h>
+#include <csignal>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <ctime>
+#include <unistd.h>
+#include "key_pars/key_pars.h"
+#include "interface/gpio_inter.h"
+#include "interface/lsadc_inter.h"
+#include "hi_unf_version.h"
+
+using namespace std;
+
+static const int EPOLL_MAX_EVENTS = 16;
+int mEpollFd = -1;
+
+static int g_uinpFd = -1;
+static int g_retIoctl = 1;
+static int g_retWrite = 1;
+static int g_gpioEnable = 0;
+static int g_lsadcEnable = 0;
+
+// define keypad channel number and boundary value.
+const int MAX_KEYPAD_CH = 3;
+const int MIN_KEYPAD_VALUE = 0x00;
+const int MAX_KEYPAD_VALUE = 0xFF;
+const int INVALID_KEY = 0x0;
+
+/*
+ * when loop_count is equal to SLOW_POLLING_BOUNDARY
+ * polling interval will become KEYPAD_INPUT_SLOW_POLLING
+ */
+const int KEY_OFF_TIME = 100; // key off time 100ms
+const int REPEAT_HOLD_TIME = 405;
+const int REPEAT_INTERVAL = 67;
+const int CHECK_COUNT = 5;
+
+// keypad uevent information
+const string KEY_PAD_NAME = "Hi Keypad";
+const int KEYPAD_VENDOR_ID = 0x046d;
+
+// ChannelID max value;generally it wont be more than 2^8-1
+// 4 is the actual value of the max channelID value
+const int CHANNEL_ID_MAX_VALUE = 255;
+
+// gpio keypad information
+static struct KeyArry g_boardKpd[MAX_KEYPAD_CH];
+static int g_gpioFlag = HI_FAILURE;
+static struct GpioKeyArry g_gpioKpd;
+static hi_u32 g_channelMask;
+
+int SetupUinputDevice(const StKeypadDeviceData& pKpdDev)
+{
+    struct uinput_user_dev uinp = {"", {0, 0, 0, 0}, 0, {0}, {0}, {0}, {0}}; // uInput device structure
+
+    // Open the input device
+    g_uinpFd = open("/dev/uinput", O_WRONLY | O_NDELAY);
+    if (g_uinpFd == 0) {
+        VIRTUALKEY_LOG("Unable to open /dev/uinput\n");
+        return -1;
+    }
+    // Intialize the uInput device to NULL
+    if (memset_s(&uinp, sizeof(uinp), 0x00, sizeof(uinp)) != EOK) {
+        VIRTUALKEY_LOG("SetupUinputDevice memset_s failed !");
+    }
+    strncpy_s(uinp.name, sizeof(uinp.name), KEY_PAD_NAME.c_str(), sizeof(uinp.name) - 1);
+
+    uinp.id.vendor = KEYPAD_VENDOR_ID;
+    uinp.id.product = 0x0002;
+    uinp.id.bustype = BUS_VIRTUAL;
+
+    // Keyboard
+    g_retIoctl = ioctl(g_uinpFd, UI_SET_EVBIT, EV_KEY);
+    if (g_retIoctl < 0) {
+        VIRTUALKEY_LOG("ioctl failed");
+    }
+    for (int i = pKpdDev.minKeycode; i < pKpdDev.maxKeycode; i++) {
+        g_retIoctl = ioctl(g_uinpFd, UI_SET_KEYBIT, i);
+        if (g_retIoctl < 0) {
+            break;
+        }
+    }
+
+    // Create input device into input sub-system
+    if (g_uinpFd > 0 && write(g_uinpFd, &uinp, sizeof(uinp)) != sizeof(uinp)) {
+        VIRTUALKEY_LOG("First write returned fail.\n");
+        return -1;
+    }
+
+    if (ioctl(g_uinpFd, UI_DEV_CREATE)) {
+        VIRTUALKEY_LOG("ioctl UI_DEV_CREATE returned fail.\n");
+        return -1;
+    }
+
+    return 1;
+}
+
+void SetEvent(struct input_event& event, hi_u32 type, hi_u32 code, hi_u32 value)
+{
+    struct timeval time;
+    gettimeofday(&time, nullptr);
+    event.__sec = time.tv_sec;
+    event.__usec = time.tv_usec;
+    event.type = type;
+    event.code = code;
+    event.value = value;
+}
+
+void WriteEventToDevice(hi_u32 u32KeyCode, hi_u32 key)
+{
+    struct input_event event = {0, 0, 0, 0, 0}; // Input device structure
+    VIRTUALKEY_LOG("WriteEventToDevice = %d.\n", u32KeyCode);
+    printf("Send_KeyCode = 0x%x\n", u32KeyCode);
+
+    SetEvent(event, EV_KEY, u32KeyCode, key);
+    g_retWrite = write(g_uinpFd, &event, sizeof(event));
+    if (g_retWrite < 0) {
+        VIRTUALKEY_LOG("write failed");
+    }
+
+    SetEvent(event, EV_SYN, SYN_REPORT, 0);
+    if (write(g_uinpFd, &event, sizeof(event)) != sizeof(event)) {
+        VIRTUALKEY_LOG("First write returned fail.\n");
+    }
+}
+
+void SetChannelMask(hi_u32& u32ChannelMask)
+{
+    for (int i = 0; i < MAX_KEYPAD_CH; i++) {
+        if (!g_boardKpd[i].bEnable && g_boardKpd[i].u8ChannelID < CHANNEL_ID_MAX_VALUE) {
+            continue;
+        }
+        g_lsadcEnable = 1;
+        u32ChannelMask |= 0x1 << (hi_u32)g_boardKpd[i].u8ChannelID;
+    }
+    g_channelMask = u32ChannelMask;
+}
+
+hi_u32 MapKeyValue(int keyPadTabIdx, hi_u32 origValue)
+{
+    if (keyPadTabIdx >= MAX_KEYPAD_CH) {
+        return INVALID_KEY;
+    }
+    if (g_boardKpd[keyPadTabIdx].u8KeyLevelNum > KEY_MAX_NUM) {
+        return INVALID_KEY;
+    }
+    for (int i = 0; i < g_boardKpd[keyPadTabIdx].u8KeyLevelNum; i++) {
+        if ((origValue <= g_boardKpd[keyPadTabIdx].u8KeyThreshold[i]) &&
+            (origValue >= (g_boardKpd[keyPadTabIdx].u8KeyThreshold[i] - 0x10ul))) {
+            return g_boardKpd[keyPadTabIdx].u32KeyCode[i];
+        }
+    }
+    return INVALID_KEY; // something wrong, need check
+}
+
+int TimeAfter(const struct timeval& bef, const struct timeval& cur, unsigned int ms)
+{
+    unsigned long long a;
+    unsigned long long b;
+    a = (unsigned long)(cur.tv_sec) * 1000 + (unsigned long)(cur.tv_usec) / 1000; /* 1000: time unit */
+    b = (unsigned long)(bef.tv_sec) * 1000 + (unsigned long)(bef.tv_usec) / 1000; /* 1000: time unit */
+    if ((a > b) && (a - b >= ms)) {
+        return 1;
+    } else {
+        return 0;
+    }
+}
+
+static void ProcessKey(hi_u32 key)
+{
+    static struct timeval time;
+    static struct timeval trep;
+    static struct timeval tlast;
+    static hi_u32 klast = INVALID_KEY;
+    static int hold = 0;
+    gettimeofday(&time, nullptr);
+    if (klast != INVALID_KEY && TimeAfter(tlast, time, KEY_OFF_TIME)) {
+        WriteEventToDevice(klast, 0);
+        klast = INVALID_KEY;
+    }
+    if (key == INVALID_KEY) {
+        return;
+    }
+    tlast = time;
+    if (klast != key) {
+        trep = time;
+        WriteEventToDevice(key, 1);
+        klast = key;
+        hold = 1;
+    } else {
+        if (hold == 1 && TimeAfter(trep, time, REPEAT_HOLD_TIME)) {
+            trep = time;
+            hold = 0;
+        } else if (TimeAfter(trep, time, REPEAT_INTERVAL)) {
+            trep = time;
+        }
+    }
+}
+
+void GpioPowerInit(void)
+{
+    GetGpioKeyPad(g_gpioKpd);
+    g_gpioEnable = g_gpioKpd.bEnable;
+
+    /* close gpio opt */
+    if (g_gpioEnable == 0) {
+        return;
+    }
+
+    if (g_lsadcEnable == 1) {
+        VIRTUALKEY_LOG("Both LSADC and GPIO switches are on, please check the configuration!\n");
+    }
+
+    VIRTUALKEY_LOG("virtualkeypad: ENTER GpioPowerInit");
+    if (g_gpioFlag == HI_FAILURE) {
+        int ret = HiGpioInit();
+        if (ret != HI_SUCCESS) {
+            VIRTUALKEY_LOG("HiGpioInit err, 0x%08x !\n", ret);
+            return;
+        }
+        if (g_gpioKpd.u8KeyLevelNum > GPIO_MAX_NUM) {
+            return;
+        }
+        for (int i = 0; i < g_gpioKpd.u8KeyLevelNum; i++) {
+            ret = HiGpioSetDirection(g_gpioKpd.u8GroupNum[i], g_gpioKpd.u8PinNum[i], HI_TRUE);   /* input modle */
+            if (ret != HI_SUCCESS) {
+                VIRTUALKEY_LOG("HiGpioSetDirection err, 0x%08x !\n", ret);
+                HiGpioDeinit();
+                return;
+            }
+        }
+
+        g_gpioFlag = HI_SUCCESS; /* SUCESS */
+    }
+    return;
+}
+
+void GpioPowerDeinit(void)
+{
+    /* close gpio opt */
+    if (g_gpioEnable == 0) {
+        return;
+    }
+
+    VIRTUALKEY_LOG("virtualkeypad: ENTER GpioPowerDeinit");
+    if (g_gpioFlag == HI_SUCCESS) {
+        HiGpioDeinit();
+        g_gpioFlag = HI_FAILURE;
+    }
+    return;
+}
+
+void DoGpioPowerOpt(void)
+{
+    static hi_bool curHighVolt[GPIO_MAX_NUM] = {HI_TRUE};
+    static hi_bool perHighVolt[GPIO_MAX_NUM] = {HI_TRUE};
+    static hi_u32 killShakeCnt[GPIO_MAX_NUM] = {0};
+    if (g_gpioKpd.u8KeyLevelNum > GPIO_MAX_NUM) {
+        return;
+    }
+    for (int i = 0; i < g_gpioKpd.u8KeyLevelNum; i++) {
+        int ret = HiGpioRead(g_gpioKpd.u8GroupNum[i], g_gpioKpd.u8PinNum[i], (curHighVolt[i]));
+        if (ret != HI_SUCCESS) {
+            VIRTUALKEY_LOG("call HiGpioRead fail , read value error(0x%08x)\n", ret);
+            return;
+        }
+
+        if (perHighVolt[i] == curHighVolt[i]) { /* same opt , do nothing */
+            killShakeCnt[i] = 0;
+            return;
+        }
+
+        if ((killShakeCnt[i]++) >= CHECK_COUNT) {
+            /* press_key */
+            VIRTUALKEY_LOG("press gpio keycod(%x).\n", g_gpioKpd.u32KeyCode[i]);
+            // 1 trigger button, 0 means not trigger
+            WriteEventToDevice(g_gpioKpd.u32KeyCode[i], curHighVolt[i] ? 0 : 1);
+            perHighVolt[i] = curHighVolt[i];
+        }
+    }
+
+    return;
+}
+
+
+/* lint -save -e715 */
+void VirtualkeypadThread()
+{
+    VIRTUALKEY_LOG("VirtualkeypadThread enter!\n");
+    int pollResult = 0;
+    struct epoll_event pendingEventItems[EPOLL_MAX_EVENTS];
+    hi_u32 pre[MAX_KEYPAD_CH] = {
+        INVALID_KEY,
+        INVALID_KEY,
+    };
+    hi_u32 cur[MAX_KEYPAD_CH];
+    hi_u32 value = 0;
+    hi_u32 cnt[MAX_KEYPAD_CH] = {
+        0,
+        0,
+    };
+
+    while (1) {
+        /* do gpio_power opt */
+        if (g_gpioFlag == HI_SUCCESS) {
+            DoGpioPowerOpt();
+            continue;
+        }
+
+        if (pollResult > 0) {
+            for (int i = 0; i < MAX_KEYPAD_CH; i++) {
+                if (!g_boardKpd[i].bEnable) {
+                    continue;
+                }
+                int ret = HiLsadcGetValue(g_boardKpd[i].u8ChannelID, value);
+                if (ret) {
+                    cur[i] = INVALID_KEY;
+                } else {
+                    cur[i] = MapKeyValue(i, value);
+                }
+                if (cur[i] != pre[i]) {
+                    pre[i] = cur[i];
+                    cnt[i] = 0;
+                } else {
+                    cnt[i]++;
+                }
+                if (cur[i] == pre[i] && cnt[i] >= CHECK_COUNT) {
+                    ProcessKey(pre[i]);
+                }
+            }
+        }
+        pollResult = epoll_wait(mEpollFd, pendingEventItems, EPOLL_MAX_EVENTS, -1);
+        if (pollResult == 0) {
+                VIRTUALKEY_LOG("epoll_wait timed out.\n");
+                continue;
+        }
+        if (pollResult < 0) {
+            // Sleep after errors to avoid locking up the system.
+            // Hopefully the error is transient.
+            if (errno != EINTR) {
+                VIRTUALKEY_LOG("poll failed (errno=%d)\n", errno);
+                usleep(100000);
+            }
+        }
+    }
+    return;
+}
+
+void ThreadProcess()
+{
+    thread keyThread(VirtualkeypadThread);
+    keyThread.join();
+    VIRTUALKEY_LOG("VirtualkeypadThread exit! Bye!\n");
+}
+
+void InitLSADCConfig()
+{
+    hi_u32 channelMask;
+    LSADC_Config stLSADCConfig;
+    if (memset_s(&stLSADCConfig, sizeof(LSADC_Config), 0x00, sizeof(LSADC_Config)) != EOK) {
+        VIRTUALKEY_LOG("main memset_s failed !");
+    }
+    HiLsadcGetConfig(stLSADCConfig);
+    GetBoardKeyPad(g_boardKpd, MAX_KEYPAD_CH);
+#if (UNF_VERSION_CODE == UNF_VERSION(3, 5))
+    channelMask = stLSADCConfig.u32ChannelMask;
+#elif (UNF_VERSION_CODE == UNF_VERSION(4, 0))
+    channelMask = stLSADCConfig.channel_mask;
+#endif
+    SetChannelMask(channelMask);
+    lsadcConfig config;
+    config.channel_mask = channelMask;
+    config.active_bit = 0xFC; // active_bit equal 6bit
+    config.data_delta = 0x0;
+    config.deglitch_bypass = 0x1;
+    config.glitch_sample = 0; // glitch_sample:deglitch is bypassed,glitch sample is invalid
+    config.lsadc_reset = 0x0;
+    config.lsadc_zero = 0xff;
+    config.model_sel = 0x1;
+    config.power_down_mod = 0x1;
+    config.time_scan = 600; // time_scan:default 200us every chnanel,600/3M = 0.0002S
+    HiLsadcStructConfig(stLSADCConfig, config);
+    HiLsadcSetConfig(stLSADCConfig);
+}
+
+hi_u32 GetKeyPadPowerValue(hi_u8 powerKeyCode[], hi_u32 length)
+{
+    hi_u32 keycodeNum = 0;
+    if (powerKeyCode == nullptr) {
+        return keycodeNum;
+    }
+    for (int i = 0; i < MAX_KEYPAD_CH; i++) {
+        if (!g_boardKpd[i].bEnable) {
+            continue;
+        }
+        if (g_boardKpd[i].u8KeyLevelNum > KEY_LEVEL_MAX_NUM) {
+            continue;
+        }
+        for (int j = 0; j < g_boardKpd[i].u8KeyLevelNum; j++) {
+            if (keycodeNum > length) {
+                break;
+            }
+            if (g_boardKpd[i].u32KeyCode[j] == KEY_POWER) {
+                powerKeyCode[i] = g_boardKpd[i].u8KeyThreshold[j];
+                keycodeNum++;
+            }
+        }
+    }
+    return keycodeNum;
+}
+
+hi_s32 main()
+{
+    int retCheck;
+    /* Open LSADC */
+    int fd = HiLsadcInit();
+    if (fd < 0) {
+        VIRTUALKEY_LOG("HI_UNF_PMOC_Init err, 0x%08x !\n", fd);
+        return fd;
+    }
+    InitLSADCConfig();
+    unique_ptr<StKeypadDeviceData> pKpdData = make_unique<StKeypadDeviceData>();
+    if (pKpdData != NULL) {
+        pKpdData->minKeycode = MIN_KEYPAD_VALUE;
+        pKpdData->maxKeycode = MAX_KEYPAD_VALUE;
+    } else {
+        VIRTUALKEY_LOG("pKpdData is null\n");
+        return -1;
+    }
+    if (SetupUinputDevice(*pKpdData) < 0) {
+        VIRTUALKEY_LOG("Unable to find uInput device\n");
+        pKpdData.reset();
+        return -1;
+    }
+    hi_u8 powerKeyCode[KEYPAD_POWER_KEY_NUM] = {0};
+    hi_u32 powerNum = GetKeyPadPowerValue(powerKeyCode, KEYPAD_POWER_KEY_NUM);
+    if (powerNum > 0) {
+#if (UNF_VERSION_CODE == UNF_VERSION(3, 5)) && (PLATFORM_SDK_VERSION < 32)
+        HiLsadcPowerKeySet(powerKeyCode, g_channelMask);
+#endif
+    }
+    /* init gpio config */
+    GpioPowerInit();
+
+    mEpollFd = epoll_create1(EPOLL_CLOEXEC);
+    if (mEpollFd < 0) {
+        VIRTUALKEY_LOG("Could not create epoll instance: %s", strerror(errno));
+        return mEpollFd;
+    }
+    struct epoll_event eventItem = {};
+    eventItem.events = EPOLLIN;
+    eventItem.data.fd = fd;
+    int result = epoll_ctl(mEpollFd, EPOLL_CTL_ADD, fd, &eventItem);
+    if (result != 0) {
+        VIRTUALKEY_LOG("Could not add /dev/soc_lsadc to epoll instance.  errno=%d", errno);
+        return -1;
+    }
+
+    ThreadProcess();
+    pKpdData.reset();
+
+    /* deinit gpio config */
+    GpioPowerDeinit();
+
+    // Destroy the device
+    retCheck = ioctl(g_uinpFd, UI_DEV_DESTROY);
+    close(g_uinpFd);
+    g_uinpFd = -1;
+    if (retCheck < 0) {
+        return retCheck;
+    }
+    epoll_ctl(mEpollFd, EPOLL_CTL_DEL, fd, nullptr);
+    HiLsadcDeinit();
+    return HI_SUCCESS;
+}
diff --git a/common/hardware/virtual_keypad/utils/CustUtils.cpp b/common/hardware/virtual_keypad/utils/CustUtils.cpp
new file mode 100644
index 0000000..966751d
--- /dev/null
+++ b/common/hardware/virtual_keypad/utils/CustUtils.cpp
@@ -0,0 +1,46 @@
+/*
+ * Copyright (c) CompanyNameMagicTag 2019-2023. All rights reserved.
+ * Description: cust config file, common interface can not change
+ * Author: AuthorNameMagicTag
+ * Create: 2019-12-12
+ */
+#include <string>
+#include <unistd.h>
+#include <securec.h>
+#include "CustUtils.h"
+
+// cfg file prefix of odm
+const char* g_odmCfgFiles[] = {
+    "/odm",
+    "/vendor",
+    "/",
+};
+
+// cfg file. default
+const unsigned int CUST_TYPE_CONFIG = 0;
+
+static const int ODM_CFG_FILES_COUNT =
+    (sizeof(g_odmCfgFiles) / sizeof(g_odmCfgFiles[0]));
+
+// get the highest priority cfg file
+char *cust_get_one_cfg_file(const char *path_suffix, int, char buf[MAX_PATH_LEN], int path_len)
+{
+    if ((buf == nullptr) || (path_suffix == nullptr)) {
+        return nullptr;
+    }
+    *buf = '\0';
+    for (int i = 0; i < ODM_CFG_FILES_COUNT; i++) {
+        if (snprintf_s(buf, MAX_PATH_LEN, MAX_PATH_LEN - 1, "%s/%s",
+            g_odmCfgFiles[i], path_suffix) == -1) {
+            printf("failed to snprintf_s buf\n");
+            *buf = '\0';
+            continue;
+        }
+
+        if (access(buf, F_OK) == 0) {
+            break; // find it
+        }
+        *buf = '\0'; // not found, destroy the path
+    }
+    return (*buf != '\0') ? buf : nullptr;
+}
