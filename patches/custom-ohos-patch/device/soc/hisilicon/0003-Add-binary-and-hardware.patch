+#endif
+}
+
+hi_s32 HiLsadcDeinit(void)
+{
+#if (UNF_VERSION_CODE == UNF_VERSION(3, 5))
+    return HI_UNF_LSADC_DeInit();
+#elif (UNF_VERSION_CODE == UNF_VERSION(4, 0))
+    return hi_unf_lsadc_deinit();
+#endif
+}
+
+hi_s32 HiLsadcGetValue(hi_u32 channel, hi_u32& value)
+{
+#if (UNF_VERSION_CODE == UNF_VERSION(3, 5))
+    return HI_UNF_LSADC_GetValue(channel, &value);
+#elif (UNF_VERSION_CODE == UNF_VERSION(4, 0))
+    return hi_unf_lsadc_get_value(channel, &value);
+#endif
+}
+
+hi_s32 HiLsadcGetConfig(LSADC_Config& config)
+{
+#if (UNF_VERSION_CODE == UNF_VERSION(3, 5))
+    return HI_UNF_LSADC_GetConfig(&config);
+#elif (UNF_VERSION_CODE == UNF_VERSION(4, 0))
+    return hi_unf_lsadc_get_config(&config);
+#endif
+}
+
+hi_s32 HiLsadcSetConfig(LSADC_Config& config)
+{
+#if (UNF_VERSION_CODE == UNF_VERSION(3, 5))
+    return HI_UNF_LSADC_SetConfig(&config);
+#elif (UNF_VERSION_CODE == UNF_VERSION(4, 0))
+    return hi_unf_lsadc_set_config(&config);
+#endif
+}
+
+void HiLsadcStructConfig(LSADC_Config& config, lsadcConfig& tempConfig)
+{
+#if (UNF_VERSION_CODE == UNF_VERSION(3, 5))
+    config.u32ChannelMask = tempConfig.channel_mask;
+    config.u32ActiveBit = tempConfig.active_bit;
+    config.u32DataDelta = tempConfig.data_delta;
+    config.u32DeglitchBypass = tempConfig.deglitch_bypass;
+    config.u32GlitchSample = tempConfig.glitch_sample;
+    config.u32LsadcReset = tempConfig.lsadc_reset;
+    config.u32LsadcZero = tempConfig.lsadc_zero;
+    config.u32ModelSel = tempConfig.model_sel;
+    config.u32PowerDownMod = tempConfig.power_down_mod;
+    config.u32TimeScan = tempConfig.time_scan;
+#elif (UNF_VERSION_CODE == UNF_VERSION(4, 0))
+    config.channel_mask = tempConfig.channel_mask;
+    config.active_bit = tempConfig.active_bit;
+    config.data_delta = tempConfig.data_delta;
+    config.deglitch_bypass = tempConfig.deglitch_bypass;
+    config.glitch_sample = tempConfig.glitch_sample;
+    config.lsadc_reset = tempConfig.lsadc_reset;
+    config.lsadc_zero = tempConfig.lsadc_zero;
+    config.model_sel = tempConfig.model_sel;
+    config.power_down_mod = tempConfig.power_down_mod;
+    config.time_scan = tempConfig.time_scan;
+#endif
+}
+
+#if (UNF_VERSION_CODE == UNF_VERSION(3, 5)) && (PLATFORM_SDK_VERSION < 32)
+hi_u32 HiLsadcPmocPowerKeySet(const hi_u8 powerKey[], const hi_u32 channelMask)
+{
+    hi_unf_pmoc_suspend_attr attr;
+    hi_u32 keyValHigh = 0;
+    bool changed = false;
+    hi_u32 ret = HI_UNF_PMOC_Init();
+    if (ret != HI_SUCCESS) {
+        HI_LOG_ERR("HI_UNF_PMOC_Init err, 0x%08x !\n", ret);
+        return ret;
+    }
+    ret = hi_unf_pmoc_get_wakeup_condition(HI_UNF_PMOC_WKUP_LSADC, &attr);
+    if (ret != HI_SUCCESS) {
+        HI_LOG_ERR("pmoc_get_wakeup_condition lsadc power key err, 0x%08x !\n", ret);
+        return ret;
+    }
+    const int maxKeypadCh = 4;
+    for (hi_u32 i = 0; i < maxKeypadCh; i++) {
+        keyValHigh = powerKey[i];
+        if (keyValHigh != 0 && (attr.config.lsadc_config.ch_key[i].high != keyValHigh ||
+                attr.config.lsadc_config.keypad_mask != channelMask)) {
+            attr.config.lsadc_config.keypad_mask = channelMask;
+            attr.config.lsadc_config.ch_key[i].high = keyValHigh;
+            attr.config.lsadc_config.ch_key[i].low = keyValHigh < LSADC_MIN_THRESHOLD ?
+                keyValHigh : keyValHigh - LSADC_THRESHOLD_COORDINATE;
+            changed = true;
+        }
+    }
+    if (changed) {
+        HI_LOG_ERR("HiLsadcPmocPowerKeySet, changed !\n");
+        ret = hi_unf_pmoc_set_wakeup_condition(HI_UNF_PMOC_WKUP_LSADC, attr);
+        if (ret != HI_SUCCESS) {
+            HI_LOG_ERR("pmoc_set_wakeup_condition lsadc power key err, 0x%08x !\n", ret);
+        }
+    }
+    return HI_SUCCESS;
+}
+
+hi_u32 HiLsadcPdmPowerKeySet(const hi_u8 powerKey[], const hi_u32 channelMask)
+{
+    hi_u32 keyVal[POWER_KEY_NUM + 1]; // channlmask
+    hi_u32 keyValHigh = 0;
+    bool changed = false;
+    hi_u32 ret = HI_UNF_PDM_GetDevInfo(HI_UNF_PDM_DEVINFO_POWER_KEYVALUE, &keyVal, sizeof(keyVal));
+    if (ret != HI_SUCCESS) {
+        HI_LOG_ERR("pdm_getdevinfo lsadc power key err, 0x%08x !\n", ret);
+    }
+    hi_u32 offset = KEYPAD_POWER_KEY_OFFSET;
+    hi_u32 channelId = keyVal[offset];
+    const int maxKeypadCh = 4;
+    for (hi_u32 i = 0; i < maxKeypadCh; i++) {
+        keyValHigh = powerKey[i] & 0xffffffff;
+        if (keyValHigh != 0 && (keyVal[offset + i * POWER_KEY_SIZE + 1] != keyValHigh || channelId != channelMask)) {
+            keyVal[offset++] = channelMask;
+            keyVal[offset + i * POWER_KEY_SIZE + 1] = keyValHigh;
+            keyVal[offset + i * POWER_KEY_SIZE] = keyValHigh < LSADC_MIN_THRESHOLD ?
+                keyValHigh : keyValHigh - LSADC_THRESHOLD_COORDINATE;
+            changed = true;
+        }
+    }
+    if (changed) {
+        HI_LOG_ERR("updatePdmPowerKey, changed !\n");
+        ret = HI_UNF_PDM_SetDevInfo(HI_UNF_PDM_DEVINFO_POWER_KEYVALUE, &keyVal, sizeof(keyVal));
+        if (ret != HI_SUCCESS) {
+            HI_LOG_ERR("pdm_setdevinfo lsadc power key err, 0x%08x !\n", ret);
+            return ret;
+        }
+    }
+    return HI_SUCCESS;
+}
+
+void HiLsadcPowerKeySet(const hi_u8 powerKey[], const hi_u32 channelMask)
+{
+    hi_u32 ret = HiLsadcPmocPowerKeySet(powerKey, channelMask);
+    HI_LOG_ERR("HiLsadcPmocPowerKeySet ret, %08x !\n", ret);
+    ret = HiLsadcPdmPowerKeySet(powerKey, channelMask);
+    HI_LOG_ERR("HiLsadcPdmPowerKeySet ret, %08x !\n", ret);
+}
+#endif
