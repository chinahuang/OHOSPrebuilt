diff --git a/common/binary/hardware/imagekit/BUILD.gn b/common/binary/hardware/imagekit/BUILD.gn
new file mode 100644
index 0000000..0ae6b27
--- /dev/null
+++ b/common/binary/hardware/imagekit/BUILD.gn
@@ -0,0 +1,24 @@
+# Copyright (C) 2022 Hisilicon (Shanghai) Technologies Co., Ltd. All rights reserved.
+
+import("//build/ohos.gni")
+
+ohos_prebuilt_shared_library("libimagekit") {
+  if (target_cpu == "arm") {
+    source = "libimagekit.z.so"
+  }
+
+  subsystem_name = "hisilicon_common"
+  part_name = "imagekit"
+  install_enable = true
+  install_images = [ chipset_base_dir ]
+  relative_install_dir = "chipsetsdk"
+}
+
+print("build_hisi_private_code = $build_hisi_private_code")
+group("imagekit_group") {
+    if (build_hisi_private_code) {
+        deps = [ "//device/soc/hisilicon/common/hardware/imagekit/source:libimagekit" ]
+    } else {
+        deps = [ ":libimagekit" ]
+    }
+}
