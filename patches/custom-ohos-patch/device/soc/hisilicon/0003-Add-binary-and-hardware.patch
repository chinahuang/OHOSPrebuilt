+
+#ifdef __cplusplus
+#if __cplusplus
+extern "C" {
+#endif
+#endif
+
+#define MODULE_NAME "AudioUsbSubPortIn"
+
+/* need fix: used for external buffer allocation, internal means samples per frame */
+#define AUDIO_HAL_FRAME_COUNT 1024
+#define MAX_PERIOD_SIZE 2048
+
+
+#define DEFAULT_PERIOD_SIZE 640
+#define DEFAULT_PERIOD_COUNT 6
+#define VOLUME_UNIT 10
+#define CONTROL_CAPTURE_SWITCH_INDEX 2
+#define CONTROL_CAPTURE_VOLUME_INDEX 3
+
+#define MIN_CUR(a, b) (((a) <= (b)) ? (a) : (b))
+const unsigned long long TIME_CONVERSION_US_S = 1000000ULL; /* us to s */
+const unsigned long long TIME_CONVERSION_NS_US = 1000ULL; /* ns to us */
+
+static enum AudioFormat g_supportFormats[] = {
+    AUDIO_FORMAT_TYPE_PCM_16_BIT,
+};
+
+typedef struct {
+    /* track impl */
+    AudioPortTrack common;
+    /* ai context */
+    uint64_t frameIndex;
+    struct AudioTimeStamp aiTimeStamp;
+    /* adp context */
+    /* attr context */
+    bool isRaw;
+    bool mute;
+    float volume;
+    uint64_t frames;
+    struct PortPluginAttr inputAttr;
+    /* alsa context */
+    struct pcm *pcm;
+    struct mixer *mixer;
+    int32_t cardId;
+    uint8_t *bufferSwap;
+    uint32_t bufferSize;
+} SubPortTrackInContext;
+
+typedef struct {
+    int32_t aiHandle;
+} SubPortInContext;
+
+
+static int32_t SubPortTrackInInit(SubPortTrackInContext *portTrackInCtx, const struct PortPluginAttr *inputAttr)
+{
+    if (memcpy_s(&(portTrackInCtx->inputAttr), sizeof(struct PortPluginAttr),
+        inputAttr, sizeof(struct PortPluginAttr)) != EOK) {
+        AUDIO_FUNC_LOGE("memcpy_s failed");
+        return MEDIA_HAL_ERR;
+    }
+
+    /* need fix: need audio stream in pass bit depth parameter */
+    portTrackInCtx->inputAttr.bitWidth = AUDIO_BIT_WIDTH_16_BIT;
+    portTrackInCtx->mute = false;
+
+    portTrackInCtx->common.audioPin = PIN_IN_MIC;
+    portTrackInCtx->common.GetFrameCount = AudioUsbSubPortInGetFrameCount;
+    portTrackInCtx->common.GetLatency = NULL;
+    portTrackInCtx->common.EnableTrack = AudioUsbSubPortInEnableTrack;
+    portTrackInCtx->common.PauseTrack = NULL;
+    portTrackInCtx->common.ResumeTrack = NULL;
+    portTrackInCtx->common.FlushTrack = NULL;
+    portTrackInCtx->common.DisableTrack = AudioUsbSubPortInDisableTrack;
+    portTrackInCtx->common.AcquireFrame = AudioUsbSubPortInAcquireFrame;
+    portTrackInCtx->common.SendFrame = NULL;
+    portTrackInCtx->common.GetPosition = AudioUsbSubPortInGetPosition;
+    portTrackInCtx->common.SetMute = AudioUsbSubPortInSetMute;
+    portTrackInCtx->common.GetMute = AudioUsbSubPortInGetMute;
+    portTrackInCtx->common.SetVolume = AudioUsbSubPortInSetVolume;
+    portTrackInCtx->common.GetVolume = AudioUsbSubPortInGetVolume;
+    portTrackInCtx->common.Invoke = AudioUsbSubPortInInvoke;
+
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+
+int32_t AudioUsbSubPortInGetFrameCount(AudioHandle trackHandle, uint64_t *count)
+{
+    *count = AUDIO_HAL_FRAME_COUNT;
+
+    AUDIO_FUNC_LOGI("frame count: %llu", *count);
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioUsbSubPortInEnableTrack(AudioHandle trackHandle)
+{
