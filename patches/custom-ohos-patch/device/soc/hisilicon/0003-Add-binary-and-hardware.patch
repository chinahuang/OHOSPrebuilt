+   AUDIO_FUNC_LOGI("get mute %d success", *mute);
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioPrimarySubPortOutTrackSetVolume(AudioHandle trackHandle, float volume)
+{
+    SubPortTrackOutContext *portTrackOutCtx = (SubPortTrackOutContext *)trackHandle;
+    if (volume < 0.0000f || volume > 1.0000f) {
+       AUDIO_FUNC_LOGI("set volume %f failed", volume);
+        return MEDIA_HAL_ERR;
+    }
+
+    int32_t ret;
+    const int floatToInt = 100;
+    const float roundingValue = 0.5;
+    int32_t tmpVolume = (int)(volume * floatToInt + roundingValue);
+    TRACK_GAIN_ATTR_S gainAttr;
+    gainAttr.bLinearMode = TRUE;
+    gainAttr.s32Gain = tmpVolume;
+
+    MEDIA_HAL_DOFUNC_TIME(ret = portTrackOutCtx->info.aoutDev->track_set_weight(portTrackOutCtx->info.aoutDev,
+        portTrackOutCtx->trackHandle, gainAttr));
+    CHK_FAILED_RETURN(ret, MEDIA_HAL_OK, ret, "track_set_weight failed");
+
+    portTrackOutCtx->volume = volume;
+   AUDIO_FUNC_LOGI("set volume %f success", volume);
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioPrimarySubPortOutTrackGetVolume(AudioHandle trackHandle, float *volume)
+{
+    SubPortTrackOutContext *portTrackOutCtx = (SubPortTrackOutContext *)trackHandle;
+
+    *volume = portTrackOutCtx->volume;
+   AUDIO_FUNC_LOGI("get volume %f success", *volume);
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioPrimarySubPortOutInvoke(AudioHandle trackHandle,
+    enum InvokeID invokeID, struct InvokeAttr *invokeAttr)
+{
+    CHK_NULL_RETURN(trackHandle, MEDIA_HAL_INVALID_PARAM, "trackHandle null");
+    CHK_NULL_RETURN(invokeAttr, MEDIA_HAL_INVALID_PARAM, "invokeAttr null");
+
+    SubPortTrackOutContext *portTrackOutCtx = (SubPortTrackOutContext *)trackHandle;
+    switch (invokeID) {
+        case INVOKE_ID_GET_CHANNEL_ID:
+            *((uint32_t *)invokeAttr->request) = portTrackOutCtx->sndTrackId;
+            invokeAttr->replyBytes = (uint64_t)sizeof(uint32_t);
+           AUDIO_FUNC_LOGI("data channel id: 0x%x success", *((uint32_t *)invokeAttr->request));
+            break;
+        default:
+            AUDIO_FUNC_LOGW("invalid invoke id: %d", invokeID);
+            return MEDIA_HAL_INVALID_PARAM;
+    }
+
+   AUDIO_FUNC_LOGI("invoke %d success", invokeID);
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioPrimarySubPortOutCreate(const AudioPortInfo *info, AudioHandle *portHandle)
+{
+    if (!g_subPortOutMngInited) {
+        SubPortOutManagerInit();
+    }
+
+    if (!g_subPortTrackOutMngInited) {
+        SubPortTrackOutManagerInit();
+    }
+
+    int32_t sndDevId = SubPortOutManagerGetFreeDev();
+    CHK_COND_RETURN(sndDevId == INVALID_ID, MEDIA_HAL_ERR, "no free AO device");
+
+    int32_t ret;
+    SubPortOutContext *portOutCtx = (SubPortOutContext *)OsalMemCalloc(sizeof(SubPortOutContext));
+    if (portOutCtx == NULL) {
+       AUDIO_FUNC_LOGI("malloc failed");
+        ret = MEDIA_HAL_NO_MEM;
+        goto FREE_SND_DEV;
+    }
+
+    if (memset_s(portOutCtx, sizeof(SubPortOutContext), 0, sizeof(SubPortOutContext)) != EOK) {
+        AUDIO_FUNC_LOGE("memset_s failed");
+        ret = MEDIA_HAL_ERR;
+        goto FREE_PORT;
+    }
+
+    portOutCtx->sndDevId = sndDevId;
+    portOutCtx->info = *info;
+    *portHandle = portOutCtx;
+   AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+
+FREE_PORT:
+    OsalMemFree(portOutCtx);
+FREE_SND_DEV:
+    (void)SubPortOutManagerFreeDev(sndDevId);
+    return ret;
+}
+
+int32_t AudioPrimarySubPortOutDestroy(AudioHandle portHandle)
+{
+    SubPortOutContext *portOutCtx = (SubPortOutContext *)portHandle;
+
+    (void)SubPortOutManagerFreeDev(portOutCtx->sndDevId);
+
+    (void)SubPortTrackOutManagerDeInit();
+
+    OsalMemFree(portOutCtx);
+
+   AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioPrimarySubPortOutGetCapability(const struct AudioPort *port, struct AudioPortCapability *capability)
+{
+    capability->formats =  g_supportFormats;
+
+   AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+static int32_t AudioPrimarySubPortOutFlush(AudioHandle trackHandle)
+{
+    SubPortTrackOutContext *portTrackOutCtx = (SubPortTrackOutContext *)trackHandle;
+    portTrackOutCtx->frames = 0;
+    portTrackOutCtx->info.aoutDev->track_flush(portTrackOutCtx->info.aoutDev, portTrackOutCtx->trackHandle);
+    return MEDIA_HAL_OK;
+}
+
+static int32_t CreateTrackProcess(SubPortOutContext *portOutCtx, SubPortTrackOutContext *portTrackOutCtx)
+{
+    int32_t ret = SndCreateTrackFromFormat(portOutCtx, portTrackOutCtx);
+    if (ret != MEDIA_HAL_OK) {
+        AUDIO_FUNC_LOGE("SndCreateTrackFromFormat failed");
+    }
+    return ret;
+}
+
+int32_t AudioPrimarySubPortOutCreateTrack(AudioHandle portHandle, const struct PortPluginAttr *inputAttr,
+    AudioHandle *trackHandle)
+{
+    SubPortOutContext *portOutCtx = (SubPortOutContext *)portHandle;
+
+    int32_t sndTrackId = SubPortTrackOutManagerGetFreeTrack();
+    CHK_COND_RETURN(sndTrackId == INVALID_ID, MEDIA_HAL_INVALID_PARAM, "no free sound track");
+
+    int32_t ret;
+    SubPortTrackOutContext *portTrackOutCtx = (SubPortTrackOutContext *)OsalMemCalloc(sizeof(SubPortTrackOutContext));
+    if (portTrackOutCtx == NULL) {
+       AUDIO_FUNC_LOGI("malloc failed");
+        ret = MEDIA_HAL_NO_MEM;
+        goto FREE_TRACK;
+    }
+
+    if (memset_s(portTrackOutCtx, sizeof(SubPortTrackOutContext), 0, sizeof(SubPortTrackOutContext)) != EOK) {
+        AUDIO_FUNC_LOGE("memset_s failed");
+        ret = MEDIA_HAL_ERR;
+        goto FREE_TRACK_CTX;
+    }
+
+    ret = SubPortTrackOutInit(portTrackOutCtx, inputAttr);
+    if (ret != MEDIA_HAL_OK) {
+        AUDIO_FUNC_LOGE("SubPortTrackOutInit failed");
+        goto FREE_TRACK_CTX;
+    }
+
+    portTrackOutCtx->sndTrackId = sndTrackId;
+    portTrackOutCtx->info = portOutCtx->info;
+    portTrackOutCtx->align = sizeof(int16_t) * portTrackOutCtx->inputAttr.channelCount;
+    if (CreateTrackProcess(portOutCtx, portTrackOutCtx) != MEDIA_HAL_OK) {
+        ret = MEDIA_HAL_ERR;
+        goto FREE_TRACK_CTX;
+    }
+
+    if (!portTrackOutCtx->inputAttr.interleaved) {
+        portTrackOutCtx->bufferSize = MAX_PERIOD_SIZE * 0x4; /* stero and 16bit */
+        portTrackOutCtx->bufferSwap = (uint8_t *)OsalMemCalloc(portTrackOutCtx->bufferSize);
+        portTrackOutCtx->bufferUsed = false;
+        if (portTrackOutCtx->bufferSwap == NULL) {
+            ret = MEDIA_HAL_NO_MEM;
+            goto FREE_TRACK_CTX;
+        }
+    }
+
+    portOutCtx->portTrack[sndTrackId] = portTrackOutCtx;
+    /* Failed to release memory */
+    // *trackHandle = &portTrackOutCtx->common;
+    *trackHandle = portTrackOutCtx;
+
+   AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+
+FREE_TRACK_CTX:
+    OsalMemFree(portTrackOutCtx);
+FREE_TRACK:
+    (void)SubPortTrackOutManagerFreeTrack(sndTrackId);
+    return ret;
+}
+
+static bool PrimaryPortIsValidTrack(SubPortOutContext *portOutCtx, SubPortTrackOutContext *portTrackOutCtx)
+{
+    for (int32_t i = 0; i < AO_DEV_MAX_TRACK_NUM; i++) {
+        if (portOutCtx->portTrack[i] == portTrackOutCtx) {
+            return true;
+        }
+    }
+    return false;
+}
+
+int32_t AudioPrimarySubPortOutDestroyTrack(AudioHandle portHandle, AudioHandle trackHandle)
+{
+    AUDIO_FUNC_LOGI("Enter.");
+
+    SubPortOutContext *portOutCtx = (SubPortOutContext *)portHandle;
+    SubPortTrackOutContext *portTrackOutCtx = (SubPortTrackOutContext *)trackHandle;
+
+    bool isValid = PrimaryPortIsValidTrack(portOutCtx, portTrackOutCtx);
+    CHK_FAILED_RETURN(isValid, true, MEDIA_HAL_INVALID_PARAM, "track is invalid");
+
+    int32_t ret;
+    MEDIA_HAL_DOFUNC_TIME(ret = portOutCtx->info.aoutDev->track_destroy(portOutCtx->info.aoutDev,
+        portTrackOutCtx->trackHandle));
+    CHK_FAILED_NO_RETURN(ret, MEDIA_HAL_OK, "track_destroy failed");
+
+    ret = SubPortTrackOutManagerFreeTrack(portTrackOutCtx->sndTrackId);
+    CHK_FAILED_NO_RETURN(ret, MEDIA_HAL_OK, "SubPortTrackOutManagerFreeTrack failed");
+
+#ifdef DUMPFILE
+    if (portTrackOutCtx->pfd != NULL) {
+        (void)fflush(portTrackOutCtx->pfd);
+        fclose(portTrackOutCtx->pfd);
+        portTrackOutCtx->pfd = NULL;
+    }
+#endif // DUMPFILE
+
+    if (portTrackOutCtx->bufferSwap != NULL) {
+        pthread_mutex_lock(&portTrackOutCtx->stateLock);
+        if (portTrackOutCtx->bufferUsed == true) {
+            pthread_mutex_unlock(&portTrackOutCtx->stateLock);
+            AUDIO_FUNC_LOGE("bufferSwap used");
+        } else {
+            pthread_mutex_unlock(&portTrackOutCtx->stateLock);
+            OsalMemFree(portTrackOutCtx->bufferSwap);
+            portTrackOutCtx->bufferSwap = NULL;
+        }
+    }
+
+    pthread_mutex_destroy(&portTrackOutCtx->stateLock);
+    if (portTrackOutCtx) {
+        OsalMemFree(portTrackOutCtx);
+        portTrackOutCtx = NULL;
+    }
+
+   AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+#ifdef __cplusplus
+#if __cplusplus
+}
+#endif
+#endif
