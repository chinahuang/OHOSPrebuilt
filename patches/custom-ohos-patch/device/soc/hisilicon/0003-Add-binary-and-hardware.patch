+int32_t AudioCaptureCaptureFrame(struct IAudioCapture *capture, int8_t *frame,
+    uint32_t *frameLen, uint64_t *replyBytes)
+{
+    CHK_NULL_RETURN(capture, MEDIA_HAL_INVALID_PARAM, "input param capture null");
+    CHK_NULL_RETURN(frame, MEDIA_HAL_INVALID_PARAM, "input param frame null");
+     CHK_NULL_RETURN(frameLen, MEDIA_HAL_INVALID_PARAM, "input param frame null");
+    CHK_NULL_RETURN(replyBytes, MEDIA_HAL_INVALID_PARAM, "input param replyBytes null");
+
+    struct AudioHwCapture *hwCapture = (struct AudioHwCapture *)capture;
+    MEDIA_HAL_LOCK(hwCapture->mutex);
+    if (!hwCapture->started) {
+        MEDIA_HAL_UNLOCK(hwCapture->mutex);
+        AUDIO_FUNC_LOGE("hwCapture not started");
+        return MEDIA_HAL_ERR;
+    }
+    if (hwCapture->paused) {
+        AUDIO_FUNC_LOGE("hwCapture current paused");
+        MEDIA_HAL_UNLOCK(hwCapture->mutex);
+        return MEDIA_HAL_ERR;
+    }
+    int32_t ret = hwCapture->trackHandle->AcquireFrame(hwCapture->trackHandle, frame, *frameLen, replyBytes);
+    if (ret != MEDIA_HAL_OK) {
+        if (ret != MEDIA_HAL_ERR_AGAIN) {
+            AUDIO_FUNC_LOGE("AudioPortTrack AcquireFrame failed: 0x%x", ret);
+        }
+
+        MEDIA_HAL_UNLOCK(hwCapture->mutex);
+        return ret;
+    }
+    hwCapture->frames++;
+    MEDIA_HAL_UNLOCK(hwCapture->mutex);
+    return MEDIA_HAL_OK;
+}
