+
+static int32_t CheckInputParam(AudioHandle trackHandle, const uint8_t *buffer, uint64_t requestBytes,
+    const uint64_t *replyBytes)
+{
+    CHK_NULL_RETURN(trackHandle, MEDIA_HAL_ERR, "trackHandle null");
+    CHK_NULL_RETURN(buffer, MEDIA_HAL_ERR, "buffer null");
+    CHK_NULL_RETURN(replyBytes, MEDIA_HAL_ERR, "replyBytes null");
+    MEDIA_HAL_UNUSED(requestBytes);
+    return MEDIA_HAL_OK;
+}
+
+/* transform packed to planar */
+static void SwapPcm16ToPcm16P(int16_t *in, uint32_t smpNum, int16_t *out)
+{
+    for (uint32_t i = 0; i < smpNum; i++) {
+        out[i] = in[0x2 * i];
+        out[i + smpNum] = in[0x2 * i + 1];
+    }
+}
+
+
+static int32_t AcquireFrameProcess(SubPortTrackInContext *portTrackInCtx, uint8_t *buffer, uint64_t requestBytes,
+    uint64_t *replyBytes)
+{
+    uint8_t *data = (uint8_t *)buffer;
+    uint64_t maxSize = requestBytes;
+    *replyBytes = 0;
+    if (!portTrackInCtx->inputAttr.interleaved && portTrackInCtx->inputAttr.channelCount == 0x2) {
+        data = portTrackInCtx->bufferSwap;
+        maxSize = MIN_CUR(portTrackInCtx->bufferSize, requestBytes);
+    }
+
+    uint32_t expectSize = pcm_frames_to_bytes(portTrackInCtx->pcm, pcm_get_buffer_size(portTrackInCtx->pcm));
+    maxSize = MIN_CUR(expectSize, maxSize);
+    int32_t ret = pcm_read(portTrackInCtx->pcm, data, maxSize);
+    if (ret != MEDIA_HAL_OK) {
+        AUDIO_FUNC_LOGE("pcm_read failed:0x%x", ret);
+        return MEDIA_HAL_ERR;
+    }
+    if (!portTrackInCtx->inputAttr.interleaved && portTrackInCtx->inputAttr.channelCount == 0x2) {
+        int32_t smpNum = maxSize / 0x4; /* pcm16 and two channels */
+        SwapPcm16ToPcm16P((int16_t *)data, smpNum, (int16_t *)buffer);
+    }
+    *replyBytes = maxSize;
+    return MEDIA_HAL_OK;
+}
+
+
+int32_t AudioUsbSubPortInAcquireFrame(AudioHandle trackHandle, uint8_t *buffer, uint64_t requestBytes,
+    uint64_t *replyBytes)
+{
+    SubPortTrackInContext *portTrackInCtx = (SubPortTrackInContext *)trackHandle;
+    if (CheckInputParam(portTrackInCtx, buffer, requestBytes, replyBytes) != MEDIA_HAL_OK) {
+        return MEDIA_HAL_ERR;
+    }
+    int32_t ret = AcquireFrameProcess(portTrackInCtx, buffer, requestBytes, replyBytes);
+    if (ret != MEDIA_HAL_OK) {
+        return ret;
+    }
+    portTrackInCtx->frames += (requestBytes / portTrackInCtx->inputAttr.channelCount / sizeof(int16_t));
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioUsbSubPortInGetPosition(AudioHandle trackHandle,
+    uint64_t *frames, struct AudioTimeStamp *time)
+{
+    SubPortTrackInContext *portTrackInCtx = (SubPortTrackInContext *)trackHandle;
+    uint32_t avail;
+    struct timespec timestamp = {};
+    int32_t ret = pcm_get_htimestamp(portTrackInCtx->pcm, &avail, &timestamp);
+    *frames = portTrackInCtx->frames;
+    time->tvSec = timestamp.tv_sec;
+    time->tvNSec = timestamp.tv_nsec;
+    CHK_FAILED_RETURN(ret, MEDIA_HAL_OK, ret, "pcm_get_htimestamp failed");
+
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioUsbSubPortInSetMute(AudioHandle trackHandle, bool mute)
+{
+    SubPortTrackInContext *portTrackInCtx = (SubPortTrackInContext *)trackHandle;
+
+    int32_t ret;
+
+    ret = TinyMixSetValue(portTrackInCtx->mixer, CONTROL_CAPTURE_SWITCH_INDEX, !mute);
+    CHK_FAILED_RETURN(ret, MEDIA_HAL_OK, ret, "TinyMixSetValue failed");
+
+    portTrackInCtx->mute = mute;
+    AUDIO_FUNC_LOGI("set mute %d success", mute);
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioUsbSubPortInGetMute(AudioHandle trackHandle, bool *mute)
+{
+    SubPortTrackInContext *portTrackInCtx = (SubPortTrackInContext *)trackHandle;
+
+    *mute = portTrackInCtx->mute;
+    AUDIO_FUNC_LOGI("get mute %d success", *mute);
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioUsbSubPortInSetVolume(AudioHandle trackHandle, float volume)
+{
+    SubPortTrackInContext *portTrackInCtx = (SubPortTrackInContext *)trackHandle;
+
+    if (volume < 0.0000f || volume > 1.0000f) {
+        AUDIO_FUNC_LOGI("set volume %f failed", volume);
+        return MEDIA_HAL_ERR;
+    }
+
+    int32_t ret;
+    ret = TinyMixSetValue(portTrackInCtx->mixer, CONTROL_CAPTURE_VOLUME_INDEX, (int32_t)(volume * VOLUME_UNIT));
+    CHK_FAILED_RETURN(ret, MEDIA_HAL_OK, ret, "TinyMixSetValue failed");
+
+    portTrackInCtx->volume = volume;
+    AUDIO_FUNC_LOGI("set volume %f success", volume);
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioUsbSubPortInGetVolume(AudioHandle trackHandle, float *volume)
+{
+    SubPortTrackInContext *portTrackInCtx = (SubPortTrackInContext *)trackHandle;
+
+    *volume = portTrackInCtx->volume;
+
+    AUDIO_FUNC_LOGI("get volume %f success", *volume);
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioUsbSubPortInInvoke(AudioHandle trackHandle, enum InvokeID invokeID, struct InvokeAttr *invokeAttr)
+{
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioUsbSubPortInCreate(AudioHandle *portHandle)
+{
+    SubPortInContext *portInCtx = (SubPortInContext *)malloc(sizeof(SubPortInContext));
+    if (portInCtx == NULL) {
+        AUDIO_FUNC_LOGI("malloc failed");
+        return MEDIA_HAL_NO_MEM;
+    }
+
+    int32_t ret;
+    if (memset_s(portInCtx, sizeof(SubPortInContext), 0, sizeof(SubPortInContext)) != EOK) {
+        AUDIO_FUNC_LOGE("memset_s failed");
+        ret = MEDIA_HAL_ERR;
+        goto FREE;
+    }
+
+    *portHandle = portInCtx;
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+
+FREE:
+    free(portInCtx);
+    return ret;
+}
+
+int32_t AudioUsbSubPortInDestroy(AudioHandle portHandle)
+{
+    SubPortInContext *portInCtx = (SubPortInContext *)portHandle;
+
+    free(portInCtx);
+
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioUsbSubPortInGetCapability(const struct AudioPort *port, struct AudioPortCapability *capability)
+{
+    capability->formats =  g_supportFormats;
+
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+static int32_t TinyAlsaOpen(SubPortTrackInContext *portTrackInCtx, const struct PortPluginAttr *inputAttr)
+{
+    int32_t ret = 0;
+    int32_t cardId = GetAudioCaptureCard();
+    if (cardId == -1) {
+        AUDIO_FUNC_LOGE("sound card not ready");
+        return MEDIA_HAL_ERR;
+    }
+
+    struct pcm_config config;
+    AudioSndConfigInit(&config, 1, (uint32_t)inputAttr->sampleRate, PCM_FORMAT_S16_LE, true);
+
+    if (portTrackInCtx->pcm == NULL) {
+        ret = PcmOpen(cardId, 0, PCM_IN, &config, &(portTrackInCtx->pcm));
+        CHK_FAILED_RETURN(ret, MEDIA_HAL_OK, MEDIA_HAL_ERR, "pcm open failed");
+    }
+
+    if (portTrackInCtx->mixer == NULL) {
+        ret = MixerOpen(cardId, &(portTrackInCtx->mixer));
+        if (ret != MEDIA_HAL_OK) {
+            PcmClose(portTrackInCtx->pcm);
+            portTrackInCtx->pcm = NULL;
+            AUDIO_FUNC_LOGE("mixer open failed");
+            return MEDIA_HAL_ERR;
+        }
+    }
+
+    portTrackInCtx->cardId = cardId;
+
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+static int32_t CreateTrackProcess(SubPortInContext *portInCtx, SubPortTrackInContext *portTrackInCtx)
+{
+    int32_t ret = TinyAlsaOpen(portTrackInCtx, &portTrackInCtx->inputAttr);
+    if (ret != MEDIA_HAL_OK) {
+        AUDIO_FUNC_LOGE("TinyAlsaOpen failed");
+    }
+    return ret;
+}
+
+int32_t AudioUsbSubPortInCreateTrack(AudioHandle portHandle, const struct PortPluginAttr *inputAttr,
+    AudioHandle *trackHandle)
+{
+    SubPortInContext *portInCtx = (SubPortInContext *)portHandle;
+
+    SubPortTrackInContext *portTrackInCtx = (SubPortTrackInContext *)malloc(sizeof(SubPortTrackInContext));
+    if (portTrackInCtx == NULL) {
+        AUDIO_FUNC_LOGI("malloc failed");
+        return MEDIA_HAL_NO_MEM;
+    }
+
+    int32_t ret;
+    if (memset_s(portTrackInCtx, sizeof(SubPortTrackInContext), 0, sizeof(SubPortTrackInContext)) != EOK) {
+        AUDIO_FUNC_LOGE("memset_s failed");
+        ret = MEDIA_HAL_ERR;
+        goto FREE_TRACK_IN;
+    }
+
+    ret = SubPortTrackInInit(portTrackInCtx, inputAttr);
+    if (ret != MEDIA_HAL_OK) {
+        AUDIO_FUNC_LOGE("SubPortTrackInInit failed");
+        goto FREE_TRACK_IN;
+    }
+
+    if (CreateTrackProcess(portInCtx, portTrackInCtx) != MEDIA_HAL_OK) {
+        ret = MEDIA_HAL_ERR;
+        goto FREE_TRACK_IN;
+    }
+
+    if (!portTrackInCtx->inputAttr.interleaved) {
+        portTrackInCtx->bufferSize = MAX_PERIOD_SIZE * 0x8; /* stero 16bit and two frame */
+        portTrackInCtx->bufferSwap = (uint8_t *)malloc(portTrackInCtx->bufferSize);
+        if (portTrackInCtx->bufferSwap == NULL) {
+            ret = MEDIA_HAL_NO_MEM;
+            goto FREE_TRACK_IN;
+        }
+    }
+    *trackHandle = &portTrackInCtx->common;
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+
+FREE_TRACK_IN:
+    free(portTrackInCtx);
+    return ret;
+}
+
+int32_t AudioUsbSubPortInDestroyTrack(AudioHandle portHandle, AudioHandle trackHandle)
+{
+    SubPortTrackInContext *portTrackInCtx = (SubPortTrackInContext *)trackHandle;
+    PcmClose(portTrackInCtx->pcm);
+    MixerClose(portTrackInCtx->mixer);
+    if (portTrackInCtx->bufferSwap != NULL) {
+        free(portTrackInCtx->bufferSwap);
+        portTrackInCtx->bufferSwap = NULL;
+    }
+    free(portTrackInCtx);
+
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+#ifdef __cplusplus
+#if __cplusplus
+}
+#endif
+#endif
