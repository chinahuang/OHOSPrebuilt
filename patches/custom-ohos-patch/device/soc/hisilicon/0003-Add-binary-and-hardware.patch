+static int32_t AudioAdapterOpenPort(struct AudioHwAdapter *hwAdapter)
+{
+    MEDIA_HAL_LOCK(hwAdapter->mutex);
+    if (hwAdapter->portOpened) {
+         AUDIO_FUNC_LOGE("port has opened");
+        MEDIA_HAL_UNLOCK(hwAdapter->mutex);
+        return MEDIA_HAL_OK;
+    }
+
+    if (hwAdapter->portPlugin == NULL) {
+        AUDIO_FUNC_LOGE("portPlugin is NULL");
+        return HDF_FAILURE;
+    }
+
+    if (hwAdapter->portPlugin->Open == NULL) {
+        AUDIO_FUNC_LOGE("portPlugin->Open is NULL");
+        return HDF_FAILURE;
+    }
+
+    
+    int32_t ret = hwAdapter->portPlugin->Open(&hwAdapter->portHandle);
+    if (ret != MEDIA_HAL_OK || hwAdapter->portHandle == NULL) {
+         AUDIO_FUNC_LOGE("portPlugin Open failed: 0x%x", ret);
+        MEDIA_HAL_UNLOCK(hwAdapter->mutex);
+        return ret;
+    }
+    hwAdapter->portOpened = true;
+    MEDIA_HAL_UNLOCK(hwAdapter->mutex);
+
+     AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioAdapterClosePort(struct AudioHwAdapter *adapter)
+{
+    if (adapter == NULL) {
+        AUDIO_FUNC_LOGE("Input parameter(adapter) is NULL!");
+        return MEDIA_HAL_INVALID_PARAM;
+    }
+
+    struct AudioHwAdapter *hwAdapter = (struct AudioHwAdapter *)adapter;
+    MEDIA_HAL_LOCK(hwAdapter->mutex);
+    if (!hwAdapter->portOpened) {
+        MEDIA_HAL_UNLOCK(hwAdapter->mutex);
+         AUDIO_FUNC_LOGE("port not opened");
+        return MEDIA_HAL_ERR;
+    }
+
+    if (hwAdapter->portPlugin == NULL) {
+        AUDIO_FUNC_LOGE("portPlugin is NULL");
+        return HDF_FAILURE;
+    }
+
+    if (hwAdapter->portPlugin->Close == NULL) {
+        AUDIO_FUNC_LOGE("portPlugin->Open is NULL");
+        return HDF_FAILURE;
+    }
+    
+    int32_t ret = hwAdapter->portPlugin->Close(hwAdapter->portHandle);
+    if (ret != MEDIA_HAL_OK) {
+        MEDIA_HAL_UNLOCK(hwAdapter->mutex);
+         AUDIO_FUNC_LOGE("portPlugin Close failed: 0x%x", ret);
+        return ret;
+    }
+    hwAdapter->portHandle = NULL;
+    hwAdapter->portOpened = false;
+    MEDIA_HAL_UNLOCK(hwAdapter->mutex);
+    return MEDIA_HAL_OK;
+}
+
+int32_t InitForGetPortCapability(struct AudioHwAdapter *hwAdapter, 
+    struct AudioPort portIndex, struct AudioPortCapability *capabilityIndex)
+{
+    int32_t ret;
+
+    if (capabilityIndex == NULL) {
+        AUDIO_FUNC_LOGE("Input parameter(capabilityIndex) is NULL!");
+        return HDF_ERR_INVALID_PARAM;
+    }
+
+    /* get capabilityIndex from driver or default */
+    if (portIndex.dir != PORT_OUT) {
+        capabilityIndex->hardwareMode = true;
+        capabilityIndex->channelMasks = AUDIO_CHANNEL_STEREO;
+        capabilityIndex->channelCount = CONFIG_CHANNEL_COUNT;
+        return HDF_SUCCESS;
+    }
+
+    if (hwAdapter->portPlugin == NULL) {
+        AUDIO_FUNC_LOGE("portPlugin is NULL");
+        return HDF_FAILURE;
+    }
+
+    if (hwAdapter->portPlugin->GetPortPluginCapability == NULL) {
+        AUDIO_FUNC_LOGE("GetPortPluginCapability is NULL");
+        return HDF_FAILURE;
+    }
+        
+    ret = hwAdapter->portPlugin->GetPortPluginCapability(&portIndex, capabilityIndex);
+    if (ret != MEDIA_HAL_OK) {
+        AUDIO_FUNC_LOGE("audio adapter get port capability failed");
+        capabilityIndex->deviceType = -1;
+        capabilityIndex->deviceId = -1;
+        capabilityIndex->formatNum = 0;
+        capabilityIndex->sampleRateMasks = 0;
+        capabilityIndex->channelCount = 0;
+        capabilityIndex->subPortsLen = 0;
+        AUDIO_FUNC_LOGE("PortInitForCapability fail");
+        return HDF_FAILURE;
+    }
+
+    return HDF_SUCCESS;
+}
+
+void AudioAdapterReleaseCapSubPorts(const struct AudioPortAndCapability *portCapabilitys, int32_t num)
+{
+    int32_t i = 0;
+
+    if (portCapabilitys == NULL) {
+        AUDIO_FUNC_LOGE("Input parameter(portCapabilitys) is NULL!");
+        return;
+    }
+
+    while (i < num) {
+        if (&portCapabilitys[i] == NULL) {
+            break;
+        }
+        AudioMemFree((void **)(&portCapabilitys[i].capability.subPorts));
+        i++;
+    }
+}
+
+int32_t AudioAdapterInitAllPorts(struct IAudioAdapter *adapter)
+{
+    int32_t ret;
+
+    if (adapter == NULL) {
+        AUDIO_FUNC_LOGE("Input parameter(adapter) is NULL!");
+        return MEDIA_HAL_INVALID_PARAM;
+    }
+
+    struct AudioHwAdapter *hwAdapter = (struct AudioHwAdapter *)adapter;
+    if (hwAdapter->portOpened) {
+         AUDIO_FUNC_LOGE("port is opended.");
+        return MEDIA_HAL_OK;
+    }
+
+    if (hwAdapter->portCapabilitys != NULL) {
+        AUDIO_FUNC_LOGW("portCapabilitys already Init!");
+        OsalMemFree(hwAdapter->portCapabilitys);
+    }
+
+    uint32_t portsLen = hwAdapter->adapterDescriptor.portsLen;
+    struct AudioPort *ports = hwAdapter->adapterDescriptor.ports;
+    if (ports == NULL) {
+        AUDIO_FUNC_LOGE("ports is NULL!");
+        return AUDIO_ERR_INTERNAL;
+    }
+    if (portsLen == 0) {
+        AUDIO_FUNC_LOGE("portsLen is 0!");
+        return AUDIO_ERR_INTERNAL;
+    }
+
+   struct AudioPortAndCapability *portCapability =
+        (struct AudioPortAndCapability *)OsalMemCalloc((size_t) portsLen * sizeof(struct AudioPortAndCapability));
+    if (portCapability == NULL) {
+        AUDIO_FUNC_LOGE("portCapability is NULL!");
+        return AUDIO_ERR_INTERNAL;
+    }
+    for (uint32_t i = 0; i < portsLen; i++) {
+        portCapability[i].port = ports[i];
+        if (InitForGetPortCapability(hwAdapter, ports[i], &portCapability[i].capability)) {
+            AUDIO_FUNC_LOGE("ports Init Fail!");
+            AudioAdapterReleaseCapSubPorts(portCapability, portsLen);
+            AudioMemFree((void **)&portCapability);
+            return AUDIO_ERR_INTERNAL;
+        }
+    }
+    hwAdapter->portCapabilitys = portCapability;
+    hwAdapter->portCapabilitys->mode = PORT_PASSTHROUGH_LPCM;
+
+    ret = AudioAdapterOpenPort(hwAdapter);
+    if (ret != MEDIA_HAL_OK) {
+         AUDIO_FUNC_LOGE("AudioAdapterOpenPort failed");
+        return MEDIA_HAL_ERR;
+    }
+
+     AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+static uint32_t AudioAdapterGetFreeChn(struct IAudioAdapter *adapter, bool capture)
+{
+    if (adapter == NULL) {
+        AUDIO_FUNC_LOGE("Input parameter(adapter) is NULL!");
+        return MEDIA_HAL_INVALID_PARAM;
+    }
+
+    struct AudioHwAdapter *hwAdapter = (struct AudioHwAdapter *)adapter;
+    MEDIA_HAL_LOCK(hwAdapter->mutex);
+    if (capture) {
+        for (uint32_t i = 0; i < MAX_CAPTURE_INSTANCE_NUM; i++) {
+            if (!hwAdapter->capture[i].used) {
+                hwAdapter->capture[i].used = true;
+                hwAdapter->capture[i].chnId = i;
+                MEDIA_HAL_UNLOCK(hwAdapter->mutex);
+                return hwAdapter->capture[i].chnId;
+            }
+        }
+    } else {
+        for (uint32_t i = 0; i < MAX_RENDER_INSTANCE_NUM; i++) {
+            if (!hwAdapter->render[i].used) {
+                hwAdapter->render[i].used = true;
+                hwAdapter->render[i].chnId = i;
+                MEDIA_HAL_UNLOCK(hwAdapter->mutex);
+                return hwAdapter->render[i].chnId;
+            }
+        }
+    }
+    MEDIA_HAL_UNLOCK(hwAdapter->mutex);
+     AUDIO_FUNC_LOGE("not get %s free channel", capture ? "capture" : "render");
+    return INVALID_AUDIO_CHANNEL;
+}
+
+static int32_t AudioAdapterFreeChn(struct IAudioAdapter *adapter, uint32_t chnId, bool capture)
+{
+    AUDIO_FUNC_LOGI("Enter.");
+
+    if (adapter == NULL) {
+        AUDIO_FUNC_LOGE("Input parameter(adapter) is NULL!");
+        return MEDIA_HAL_INVALID_PARAM;
+    }
+
+    struct AudioHwAdapter *hwAdapter = (struct AudioHwAdapter *)adapter;
+    MEDIA_HAL_LOCK(hwAdapter->mutex);
+    if (capture) {
+        if (chnId >= MAX_CAPTURE_INSTANCE_NUM) {
+             AUDIO_FUNC_LOGE("Can't free %s invaild chnId: %d", capture ? "capture" : "render", chnId);
+            MEDIA_HAL_UNLOCK(hwAdapter->mutex);
+            return MEDIA_HAL_ERR;
+        }
+        hwAdapter->capture[chnId].used = false;
+        hwAdapter->capture[chnId].chnId = 0xFFFFFFFF;
+        MEDIA_HAL_UNLOCK(hwAdapter->mutex);
+        AUDIO_FUNC_LOGI("Exit.");
+        return MEDIA_HAL_OK;
+    } else {
+        if (chnId >= MAX_RENDER_INSTANCE_NUM) {
+             AUDIO_FUNC_LOGE("Can't free %s invaild chnId: %d", capture ? "capture" : "render", chnId);
+            MEDIA_HAL_UNLOCK(hwAdapter->mutex);
+            return MEDIA_HAL_ERR;
+        }
+        hwAdapter->render[chnId].used = false;
+        hwAdapter->render[chnId].chnId = 0xFFFFFFFF;
+        MEDIA_HAL_UNLOCK(hwAdapter->mutex);
+        AUDIO_FUNC_LOGI("Exit.");
+        return MEDIA_HAL_OK;
+    }
+}
