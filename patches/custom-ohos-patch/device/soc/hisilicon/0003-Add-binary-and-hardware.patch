+/* transform planar to packed */
+static void SwapPcm16PToPcm16(int16_t *in, uint32_t smpNum, int16_t *out)
+{
+    for (uint32_t i = 0; i < smpNum; i++) {
+        out[0x2 * i] = in[i];
+        out[0x2 * i + 1] = in[i + smpNum];
+    }
+}
+
+static int32_t CheckInputParam(AudioHandle trackHandle, const uint8_t *buffer, uint64_t requestBytes,
+    const uint64_t *replyBytes)
+{
+    CHK_NULL_RETURN(trackHandle, MEDIA_HAL_ERR, "trackHandle null");
+    CHK_NULL_RETURN(buffer, MEDIA_HAL_ERR, "buffer null");
+    CHK_NULL_RETURN(replyBytes, MEDIA_HAL_ERR, "replyBytes null");
+    SubPortTrackOutContext *ctx = (SubPortTrackOutContext *)trackHandle;
+    if (requestBytes % ctx->align != 0) {
+        AUDIO_FUNC_LOGE("requestBytes:0x%llu is not aligned[%u]", requestBytes, ctx->align);
+        return MEDIA_HAL_ERR;
+    }
+    return MEDIA_HAL_OK;
+}
+
+static int64_t GetCurTimeUs(void)
+{
+    const int32_t  SS2US = 1000000;
+    struct timeval ts;
+    ts.tv_sec = 0;
+    ts.tv_usec = 0;
+    gettimeofday(&ts, NULL);
+    return ((int64_t)ts.tv_sec * SS2US) + (int64_t)ts.tv_usec;
+}
+
+static int64_t GetCurTimeMs(void)
+{
+    const int32_t US2MS = 1000;
+    int64_t curTimeUs = GetCurTimeUs();
+    return (int64_t)(curTimeUs / US2MS);
+}
+
+static int32_t WriteFrameToDevice(SubPortTrackOutContext *trackCtx, const uint8_t *data,
+    uint64_t requestBytes, uint64_t *replyBytes)
+{
+    uint32_t availBytes = 0;
+    uint32_t haveWriten = 0;
+    int64_t startTime = GetCurTimeMs();
+    while (haveWriten < requestBytes) {
+        int32_t ret = trackCtx->info.aoutDev->track_get_buf_avail(NULL, trackCtx->trackHandle, &availBytes);
+        if (ret != MEDIA_HAL_OK) {
+            if (ret == MEDIA_HAL_ERR_NOT_INITED) {
+                AUDIO_FUNC_LOGE("aout not inited");
+                break;
+            }
+            AUDIO_FUNC_LOGE("track_get_buf_avail failed 0x%x\n", ret);
+            usleep(SEND_FRAME_SLEEP_US);
+            continue;
+        }
+        if (availBytes < trackCtx->align * MAX_PERIOD_SIZE && availBytes  < requestBytes - haveWriten) {
+            usleep(SEND_FRAME_SLEEP_US);
+            continue;
+        }
+
+        int32_t bufLen = requestBytes - haveWriten;
+        bufLen = (bufLen > availBytes) ? availBytes : bufLen;
+        bufLen -= bufLen % trackCtx->align;
+        ret = trackCtx->info.aoutDev->track_write(trackCtx->info.aoutDev, trackCtx->trackHandle,
+            data + haveWriten, bufLen);
+        if (ret == MEDIA_HAL_OK) {
+            haveWriten += bufLen;
+        } else {
+            if (GetCurTimeMs() > startTime + SEND_FRAME_TIMEOUT_MS) {
+                *replyBytes = haveWriten;
+                return MEDIA_HAL_OK;
+            }
+            usleep(SEND_FRAME_SLEEP_US);
+        }
+    }
+    *replyBytes = requestBytes;
+
+#ifdef DUMPFILE
+    WriteDumpFile(data, requestBytes, trackCtx->pfd);
+#endif // DUMPFILE
+
+    trackCtx->frames += (requestBytes / trackCtx->align);
+    return MEDIA_HAL_OK;
+}
+
+static int32_t ReallocateSwapBuffer(SubPortTrackOutContext *trackCtx, uint32_t newBufferSize)
+{
+    uint8_t *newBufferSwap = NULL;
+    newBufferSwap = (uint8_t *)OsalMemCalloc(newBufferSize);
+    if (newBufferSwap == NULL) {
+        return MEDIA_HAL_NO_MEM;
+    }
+
+    if (trackCtx->bufferSwap != NULL) {
+        OsalMemFree(trackCtx->bufferSwap);
+    }
+    trackCtx->bufferSwap = newBufferSwap;
+    trackCtx->bufferSize = newBufferSize;
+
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioPrimarySubPortOutSendFrame(AudioHandle trackHandle, const uint8_t *buffer,
+    uint64_t requestBytes, uint64_t *replyBytes)
+{
+    SubPortTrackOutContext *trackCtx = (SubPortTrackOutContext *)trackHandle;
+
+    if (CheckInputParam(trackCtx, buffer, requestBytes, replyBytes) != MEDIA_HAL_OK) {
+        return MEDIA_HAL_ERR;
+    }
+
+    *replyBytes = 0;
+    uint8_t *data = (uint8_t *)buffer;
+    if (!trackCtx->inputAttr.interleaved && trackCtx->inputAttr.channelCount == 0x2) {
+        uint32_t smpNum = (uint32_t)requestBytes / trackCtx->align; /* pcm16 and two channels */
+        /*Actual swap buffer size: smpNum * 2 * sizeof(int16_t) */
+        uint32_t actualSwapBufferSize = smpNum * STEREO_CHANNEL_COUNT * sizeof(int16_t);
+        if (trackCtx->bufferSize < actualSwapBufferSize)
+        {
+            AUDIO_FUNC_LOGD("bufferSize:%{public}d,  actualSwapBufferSize:%{public}d",
+                trackCtx->bufferSize, actualSwapBufferSize);
+            int32_t ret = ReallocateSwapBuffer(trackCtx, actualSwapBufferSize);
+            if (ret != MEDIA_HAL_OK) {
+                AUDIO_FUNC_LOGW("ReallocateSwapBuffer failed.");
+            }else {
+                AUDIO_FUNC_LOGD("ReallocateSwapBuffer Succeed, new buffer size:%{public}d.", trackCtx->bufferSize);
+            }
+        }
+
+        SwapPcm16PToPcm16((int16_t *)data, smpNum, (int16_t *)trackCtx->bufferSwap);
+        data = trackCtx->bufferSwap;
+    }
+    if (!trackCtx->isRaw) {
+        return MEDIA_HAL_ERR;
+    }
+
+    pthread_mutex_lock(&trackCtx->stateLock);
+    if (trackCtx->isPause) {
+        pthread_mutex_unlock(&trackCtx->stateLock);
+        return MEDIA_HAL_ERR_AGAIN;
+    }
+    trackCtx->bufferUsed = true;
+    int32_t ret = WriteFrameToDevice(trackCtx, data, requestBytes, replyBytes);
+    trackCtx->bufferUsed = false;
+    pthread_mutex_unlock(&trackCtx->stateLock);
+    return ret;
+}
+
+int32_t AudioPrimarySubPortOutGetPosition(AudioHandle trackHandle,
+    uint64_t *frames, struct AudioTimeStamp *time)
+{
+    SubPortTrackOutContext *portTrackOutCtx = (SubPortTrackOutContext *)trackHandle;
+    *frames = portTrackOutCtx->frames;
+    int64_t timeMs = portTrackOutCtx->frames / (portTrackOutCtx->inputAttr.sampleRate / TIME_S_TO_MS);
+    time->tvSec = timeMs / TIME_S_TO_MS;
+    time->tvNSec = (timeMs % TIME_S_TO_MS) * TIME_MS_TO_NS;
+
+    return MEDIA_HAL_OK;
+}
