+static int32_t PrimaryPortGetPassthroughMode(AudioHandle portHandle, enum AudioPortPassthroughMode *mode)
+{
+    CHK_NULL_RETURN(portHandle, MEDIA_HAL_INVALID_PARAM, "Input param portHandle is null");
+    PrimaryPortContext *priPortCtx = (PrimaryPortContext *)portHandle;
+    *mode = priPortCtx->passthroughMode;
+    return MEDIA_HAL_OK;
