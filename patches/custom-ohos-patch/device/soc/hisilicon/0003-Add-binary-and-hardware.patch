+static int CheckParams(void)
+{
+    if (g_modeSet > 1 || (g_mode != 0 && g_mode != 1)) {
+        printf("fetch g_mode error!\n");
+        return -1;
+    }
+
+    if (g_keyupEventSet > 1 || (g_keyupEvent != 0 && g_keyupEvent != 1)) {
+        printf("keyup event error!\n");
+        return -1;
+    }
+    if (g_repeatEventSet > 1 || g_repeatIntervalSet > 1) {
+        printf("Only -g [-s -e] option can be set more than once!\n");
+        return -1;
+    }
+    return 0;
+}
