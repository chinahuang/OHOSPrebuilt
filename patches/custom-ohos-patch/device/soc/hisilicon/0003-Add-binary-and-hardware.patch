diff --git a/common/binary/hardware/chinadrm/BUILD.gn b/common/binary/hardware/chinadrm/BUILD.gn
new file mode 100755
index 0000000..29ebe6d
--- /dev/null
+++ b/common/binary/hardware/chinadrm/BUILD.gn
@@ -0,0 +1,65 @@
+# Copyright (C) 2022 Hisilicon (Shanghai) Technologies Co., Ltd. All rights reserved.
+
+import("//build/ohos.gni")
+
+ohos_prebuilt_shared_library("opksw") {
+  if (target_cpu == "arm") {
+    source = "lib32/libchinadrm_opk_sw.z.so"
+  } else if (target_cpu == "arm64") {
+    source = "lib64/libchinadrm_opk_sw.z.so"
+  }
+  subsystem_name = "hisilicon_common"
+  part_name = "drivers_peripheral_wiseplay"
+  install_enable = true
+  install_images = [ chipset_base_dir ]
+}
+
+ohos_prebuilt_shared_library("wiseplay_service") {
+  if (target_cpu == "arm") {
+    source = "lib32/libmedia_key_system_factory_wiseplay_service_1.0.z.so"
+  } else if (target_cpu == "arm64") {
+    source = "lib64/libmedia_key_system_factory_wiseplay_service_1.0.z.so"
+  }
+  subsystem_name = "hisilicon_common"
+  part_name = "drivers_peripheral_wiseplay"
+  install_enable = true
+  install_images = [ chipset_base_dir ]
+}
+
+ohos_prebuilt_shared_library("wiseplay_driver") {
+  if (target_cpu == "arm") {
+      source = "lib32/libwiseplay_driver.z.so"
+  } else if (target_cpu == "arm64") {
+      source = "lib64/libwiseplay_driver.z.so"
+  }
+  subsystem_name = "hisilicon_common"
+  part_name = "drivers_peripheral_wiseplay"
+  install_enable = true
+  install_images = [ chipset_base_dir ]
+}
+
+ohos_prebuilt_executable("wiseplay_tool") {
+  if (target_cpu == "arm") {
+      source = "lib32/drivers_peripheral_wiseplay_provison"
+  } else if (target_cpu == "arm64") {
+      source = "lib64/drivers_peripheral_wiseplay_provison"
+  }
+  subsystem_name = "hisilicon_common"
+  part_name = "drivers_peripheral_wiseplay"
+  install_enable = true
+  install_images = [ chipset_base_dir ]
+}
+
+print("build_hisi_private_code = $build_hisi_private_code")
+group("wiseplay_entry_group") {
+    if (build_hisi_private_code) {
+        deps = [ "//device/soc/hisilicon/common/hardware/chinadrm:wiseplay_entry" ]
+    } else {
+        deps = [
+          ":opksw",
+          ":wiseplay_service",
+          ":wiseplay_driver",
+          ":wiseplay_tool"
+        ]
+    }
+}
