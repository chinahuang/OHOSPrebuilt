+int IR_PmocPowerKeySet(const unsigned long long irPowerKeyCode[], const unsigned int powerKeyNum)
+{
+    if (irPowerKeyCode == nullptr) {
+        return HI_FAILURE;
+    }
+    hi_unf_pmoc_suspend_attr attr;
+    HI_U32 keyValLow = 0;
+    HI_U32 keyValHigh = 0;
+    bool changed = false;
+    int ret = HI_UNF_PMOC_Init();
+    if (ret != HI_SUCCESS) {
+        XLOGD("HI_UNF_PMOC_Init err, 0x%08x !\n", ret);
+        return ret;
+    }
+    ret = hi_unf_pmoc_get_wakeup_condition(HI_UNF_PMOC_WKUP_IR, &attr);
+    if (ret != HI_SUCCESS) {
+        XLOGD("pmoc_get_wakeup_condition ir power key err, 0x%08x !\n", ret);
+        return ret;
+    }
+    int count = powerKeyNum;
+    if (count > IR_POWER_KEY_NUM) {
+        count = IR_POWER_KEY_NUM;
+    }
+    for (int i = 0; i < count; i++) {
+        keyValLow = static_cast<HI_U32>(irPowerKeyCode[i] & 0x00000000ffffffff);
+        keyValHigh = static_cast<HI_U32>((irPowerKeyCode[i] & 0xffffffff00000000) >> 32); // 32 : 32bit
+        if (attr.config.ir_config.keyval_low[i] != keyValLow || attr.config.ir_config.keyval_high[i] != keyValHigh) {
+                attr.config.ir_config.keyval_low[i] = keyValLow;
+                attr.config.ir_config.keyval_high[i] = keyValHigh;
+                changed = true;
+        }
+    }
+    if (changed) {
+        XLOGD("IRPmocPowerKeySet, changed !\n");
+        ret = hi_unf_pmoc_set_wakeup_condition(HI_UNF_PMOC_WKUP_IR, attr);
+        if (ret != HI_SUCCESS) {
+            XLOGD("pmoc_set_wakeup_condition ir power key err, 0x%08x !\n", ret);
+        }
+    }
+    return HI_SUCCESS;
+}
+
+int IR_PdmPowerKeySet(const unsigned long long irPowerKeyCode[], const unsigned int powerKeyNum)
+{
+    if (irPowerKeyCode == nullptr) {
+        return HI_FAILURE;
+    }
+    HI_U32 keyVal[POWER_KEY_NUM] = {0};
+    HI_U32 keyValLow = 0;
+    HI_U32 keyValHigh = 0;
+    bool changed = false;
+    int ret = HI_UNF_PDM_GetDevInfo(HI_UNF_PDM_DEVINFO_POWER_KEYVALUE, &keyVal, sizeof(keyVal));
+    if (ret != HI_SUCCESS) {
+        XLOGD("pdm_getdevinfo ir power key err, 0x%08x !\n", ret);
+    }
+    int count = powerKeyNum;
+    if (count > IR_POWER_KEY_NUM) {
+        count = IR_POWER_KEY_NUM;
+    }
+    for (int i = 0; i < count; i++) {
+        keyValLow = static_cast<HI_U32>(irPowerKeyCode[i] & 0x00000000ffffffff);
+        keyValHigh = static_cast<HI_U32>((irPowerKeyCode[i] & 0xffffffff00000000) >> 32); // 32 : 32bit
+        if (keyVal[i * POWER_KEY_SIZE] != keyValLow || keyVal[i * POWER_KEY_SIZE + 1] != keyValHigh) {
+            keyVal[i * POWER_KEY_SIZE] = keyValLow;
+            keyVal[i * POWER_KEY_SIZE + 1] = keyValHigh;
+            changed = true;
+        }
+    }
+    if (changed) {
+        XLOGD("updatePdmPowerKey, changed !\n");
+        ret = HI_UNF_PDM_SetDevInfo(HI_UNF_PDM_DEVINFO_POWER_KEYVALUE, &keyVal, sizeof(keyVal));
+        if (ret != HI_SUCCESS) {
+            XLOGD("pdm_setdevinfo ir power key err, 0x%08x !\n", ret);
+            return ret;
+        }
+    }
+    return HI_SUCCESS;
+}
+#endif
