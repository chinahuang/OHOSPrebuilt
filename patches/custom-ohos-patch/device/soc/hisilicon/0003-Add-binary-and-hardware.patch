+static int IrGetProtStatus(string prot)
+{
+    HI_BOOL enabled = HI_FALSE;
+
+    if (prot.empty()) {
+        perror("prot is null!\n");
+        return -1;
+    }
+
+    int ret = IR_Init();
+    if (ret) {
+        perror("Fail to open ir device!\n");
+        return -1;
+    }
+
+    ret = IR_GetProtocolEnabled(prot, enabled);
+    if (ret) {
+        IR_DeInit();
+        printf("Fail to get protocol status!\n");
+        return -1;
+    }
+
+    IR_DeInit();
+    return enabled;
+}
+
+static int IrSampleSetProtEnable()
+{
+    if (g_protName.empty()) {
+        perror("g_protName is null!\n");
+        return -1;
+    }
+
+    int ret = IR_Init();
+    if (ret) {
+        perror("Fail to open ir device!\n");
+        return -1;
+    }
+
+    printf("Try set enable status %d to protocol %s.\n", g_protEnable, g_protName.c_str());
+    if (g_protEnable) {
+        ret = IR_EnableProtocol(g_protName);
+    } else {
+        ret = IR_DisableProtocol(g_protName);
+    }
+    if (ret) {
+        printf("Fail to set enable status of %s\n", g_protName.c_str());
+        IR_DeInit();
+        return -1;
+    }
+
+    printf("Check it out if we do have set succussfully!\n");
+    if (g_protEnable == IrGetProtStatus(g_protName)) {
+        printf("Check pass!\n");
+    } else {
+        printf("Check fail!\n");
+    }
+
+    IR_DeInit();
+    return 0;
+}
