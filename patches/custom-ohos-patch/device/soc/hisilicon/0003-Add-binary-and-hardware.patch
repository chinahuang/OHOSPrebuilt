diff --git a/common/hardware/audio/source/BUILD.gn b/common/hardware/audio/source/BUILD.gn
new file mode 100644
index 0000000..6ea5b47
--- /dev/null
+++ b/common/hardware/audio/source/BUILD.gn
@@ -0,0 +1,107 @@
+# Copyright (c) 2022-2023 Huawei Device Co., Ltd.
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+hdf_audio_path = "//drivers/peripheral/audio"
+hdf_hdi_service_path = "//drivers/peripheral/audio/hdi_service"
+import("//build/ohos.gni")
+import("$hdf_audio_path/audio.gni")
+
+group("hdf_audio_group") {
+  if (drivers_peripheral_audio_feature_user_mode) {
+    print("hdf_audio_group: drivers_peripheral_audio_feature_user_mode=$drivers_peripheral_audio_feature_user_mode")
+    deps = [
+      ":audio_primary_huanglong_vendor"
+    ]
+  }
+}
+
+ohos_shared_library("audio_primary_huanglong_vendor") {
+  defines = []
+  sources = [
+      "src/audio_capture.c",
+      "src/audio_adapter.c",
+      "src/audio_manager.c",
+      "src/audio_render.c",
+      "src/audio_adapter_info_common.c",
+      "src/audio_common.c",
+      "src/audio_plugins_manager/src/audio_plugins_manager.c",
+  ]
+  output_name = "audio_primary_impl_vendor"
+  output_extension = "z.so"
+  include_dirs = [
+    "plugins/plugin_include",
+    "src/audio_plugins_manager/include",
+    "common/include",
+    "$hdf_hdi_service_path/pathselect/include",
+    "$hdf_audio_path/supportlibs/adm_adapter/include",
+    "$hdf_audio_path/supportlibs/interfaces/include",
+    "//third_party/bounds_checking_function/include",
+    "$hdf_hdi_service_path/vendor_interface/utils",
+    "//drivers/hdf_core/interfaces/inner_api/utils",
+    "//drivers/peripheral/audio/interfaces/include"
+  ]
+
+  if (enable_audio_hal_hdf_log) {
+    defines += [ "AUDIO_HDF_LOG" ]
+  }
+
+  if(api_version == "11") {
+    if (use_jemalloc && use_jemalloc_dfx_intf) {
+      defines += [ "CONFIG_USE_JEMALLOC_DFX_INTF" ]
+    }
+  }
+  if (is_standard_system) {
+    external_deps = [
+      "c_utils:utils",
+      "drivers_interface_audio:audio_idl_headers",
+      "hdf_core:libhdf_ipc_adapter",
+      "hdf_core:libhdi",
+      "hdf_core:libpub_utils",
+      "hilog:libhilog",
+    ]
+    if(api_version == "11") {
+      external_deps += [ "drivers_interface_audio:libaudio_proxy_2.0" ]
+    } else {
+      external_deps += [ "drivers_interface_audio:libaudio_proxy_4.0" ]
+    }
+  } else {
+    external_deps = [ "hilog:libhilog" ]
+  }
+  cflags = [
+    "-DFFMPEG_DEC",
+    "-Wno-macro-redefined",
+    "-D__LINUX__",
+    "-D__L2_VERSION__",
+  ]
+
+  if(api_version != "11") {
+    cflags += [ "-DNEW_VERSION_HDI_SUPPORT" ]
+  }
+
+  deps = [
+    "common:media_hal_common",
+    "plugins:audio_plugins_group",
+  ]
+  defines += [
+    "ENABLE_DL_AUDIO_PLUGIN",
+  ]
+
+  if (target_cpu == "arm64") {
+    defines += [ "ARM64" ]
+  }
+
+  install_enable = true
+  install_images = [ chipset_base_dir ]
+  subsystem_name = "hisilicon_common"
+  part_name = "hdf_audio_hal"
+}
