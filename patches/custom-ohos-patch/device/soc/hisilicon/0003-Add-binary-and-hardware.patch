@@ -0,0 +1,388 @@
+/*
+* Copyright (c) CompanyNameMagicTag. 2021-2021. All rights reserved.
+* Description: Primary port plugin
+* Author: Media Software Group
+* Create: 2021-09-28
+*/
+
+#include "audio_primary_port_plugin.h"
+#include <math.h>
+#include <stdlib.h>
+#include "audio_primary_sub_port_out.h"
+#include "media_hal_common.h"
+#include "audio_port_plugin_common.h"
+#include "securec.h"
+#include "tvos_hal_aout.h"
+#include "hdf_base.h"
+#include "audio_uhdf_log.h"
+#include "osal_mem.h"
+
+
+#ifdef __cplusplus
+#if __cplusplus
+extern "C" {
+#endif
+#endif /* __cplusplus */
+
+#define MODULE_NAME "AudioPrimaryPortPlugin"
+#define SAMPLE_RATE_8K   8000
+#define SAMPLE_RATE_16K   16000
+#define SAMPLE_RATE_24K   24000
+#define SAMPLE_RATE_32K   32000
+#define SAMPLE_RATE_48K   48000
+#define SAMPLE_RATE_44_1K 44100
+#define SAMPLE_RATE_64K 64000
+#define SAMPLE_RATE_96K 96000
+#define TRACK_VOL_MIN       (0)
+#define TRACK_VOL_MAX       (100)
+#define CONFIG_CHANNEL_COUNT  2 // two channels
+
+typedef struct {
+    /* port context */
+    bool isOpened;
+    /* sub port context */
+    AudioHandle subPortOutHandle;
+    AudioHandle subPortTrackHandle;
+
+    AudioPortInfo portInfo;
+    bool isMute;
+    float volume;
+    enum AudioPortPassthroughMode passthroughMode;
+} PrimaryPortContext;
+
+
+static enum AudioFormat g_formatIdZero = AUDIO_FORMAT_TYPE_PCM_16_BIT;
+
+static int32_t PrimarySubPortCreateTrack(PrimaryPortContext *portCtx, const struct PortPluginAttr *portAttr, bool isMic)
+{
+    int32_t ret;
+
+    if (portAttr->audioFormat != AUDIO_FORMAT_TYPE_PCM_16_BIT) {
+        AUDIO_FUNC_LOGE("only support AUDIO_FORMAT_TYPE_PCM_16_BIT");
+        return MEDIA_HAL_ERR;
+    }
+    if (portAttr->channelCount < 1) {
+        AUDIO_FUNC_LOGE("channel count:%{public}d error", portAttr->channelCount);
+        return MEDIA_HAL_ERR;
+    }
+    if (portAttr->sampleRate != SAMPLE_RATE_8K && portAttr->sampleRate != SAMPLE_RATE_16K &&
+        portAttr->sampleRate != SAMPLE_RATE_24K && portAttr->sampleRate != SAMPLE_RATE_32K &&
+        portAttr->sampleRate != SAMPLE_RATE_48K && portAttr->sampleRate != SAMPLE_RATE_44_1K &&
+        portAttr->sampleRate != SAMPLE_RATE_64K && portAttr->sampleRate != SAMPLE_RATE_96K) {
+        AUDIO_FUNC_LOGE("sampleRate:%d error", portAttr->sampleRate);
+        return MEDIA_HAL_ERR;
+    }
+
+    if (isMic) {
+        AUDIO_FUNC_LOGE("not support create capture track");
+        return MEDIA_HAL_ERR;
+    } else {
+        ret = AudioPrimarySubPortOutCreateTrack(portCtx->subPortOutHandle, portAttr, &portCtx->subPortTrackHandle);
+        CHK_FAILED_RETURN(ret, MEDIA_HAL_OK, ret, "AudioPrimarySubPortOutCreateTrack failed");
+    }
+
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+static int32_t PrimarySubPortDestroyTrack(const PrimaryPortContext *portCtx, AudioHandle trackHandle)
+{
+    AUDIO_FUNC_LOGI("Enter.");
+    int32_t ret;
+    AudioPortTrack *portTrack = (AudioPortTrack *)trackHandle;
+    if (portTrack->audioPin == PIN_IN_MIC) {
+        AUDIO_FUNC_LOGE("not support destroy capture track");
+        return MEDIA_HAL_ERR;
+    } else {
+        ret = AudioPrimarySubPortOutDestroyTrack(portCtx->subPortOutHandle, trackHandle);
+        CHK_FAILED_RETURN(ret, MEDIA_HAL_OK, ret, "AudioPrimarySubPortOutDestroyTrack failed");
+    }
+
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+int32_t InitPortForCapabilitySub(struct AudioPort portIndex, struct AudioPortCapability *capabilityIndex)
+{
+    if (capabilityIndex == NULL) {
+        AUDIO_FUNC_LOGE("capabilityIndex Is NULL");
+        return MEDIA_HAL_ERR;
+    }
+
+    //capabilityIndex->deviceType = 1;
+    capabilityIndex->deviceId = 0;
+    capabilityIndex->hardwareMode = false;
+    capabilityIndex->formatNum = 1;
+    capabilityIndex->formats = &g_formatIdZero;
+    capabilityIndex->channelMasks = AUDIO_CHANNEL_STEREO;
+    capabilityIndex->channelCount = CONFIG_CHANNEL_COUNT;
+    capabilityIndex->deviceType = portIndex.dir;
+    capabilityIndex->sampleRateMasks = AUDIO_SAMPLE_RATE_MASK_8000 | AUDIO_SAMPLE_RATE_MASK_16000 | AUDIO_SAMPLE_RATE_MASK_32000 |
+        AUDIO_SAMPLE_RATE_MASK_44100 | AUDIO_SAMPLE_RATE_MASK_48000;
+
+    capabilityIndex->formatsLen = 1;
+    capabilityIndex->subPortsLen = 1;
+    capabilityIndex->subPorts = (struct AudioSubPortCapability *)OsalMemCalloc(
+        capabilityIndex->subPortsLen * sizeof(struct AudioSubPortCapability));
+    if (capabilityIndex->subPorts == NULL) {
+        AUDIO_FUNC_LOGE("The pointer is null!");
+        return MEDIA_HAL_ERR;
+    }
+    capabilityIndex->subPorts->portId = portIndex.portId;
+    capabilityIndex->subPorts->desc = portIndex.portName;
+    capabilityIndex->subPorts->mask = PORT_PASSTHROUGH_LPCM;
+    
+    return MEDIA_HAL_OK;
+}
+
+
+static int32_t PrimaryPortGetPortPluginCapability(const struct AudioPort *port,
+    struct AudioPortCapability *capability)
+{
+    CHK_NULL_RETURN(port, MEDIA_HAL_INVALID_PARAM, "Input param port is null");
+    CHK_NULL_RETURN(capability, MEDIA_HAL_INVALID_PARAM, "Input param capability is null");
+
+    if (port->dir == PORT_OUT) {
+        if (InitPortForCapabilitySub(*port, capability) != MEDIA_HAL_OK) {
+            AUDIO_FUNC_LOGE("PortInitForCapability fail");
+            return MEDIA_HAL_ERR;
+        }
+    } else {
+        capability->hardwareMode = true;
+        capability->channelMasks = AUDIO_CHANNEL_STEREO;
+        capability->channelCount = CONFIG_CHANNEL_COUNT;
+        AUDIO_FUNC_LOGE("port direction: 0x%x is invalid", port->dir);
+        return MEDIA_HAL_INVALID_PARAM;
+    }
+
+    AUDIO_FUNC_LOGI("%{public}s get capability success", port->portName);
+    return MEDIA_HAL_OK;
+}
