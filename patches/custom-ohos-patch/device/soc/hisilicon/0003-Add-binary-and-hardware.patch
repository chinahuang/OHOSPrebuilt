+        if ((g_audioAdapters[adapterIndex].common) == adapter) {
+            MEDIA_HAL_UNLOCK(g_audioAdapters[adapterIndex].adapterLock);
+            return true;
+        }
+        MEDIA_HAL_UNLOCK(g_audioAdapters[adapterIndex].adapterLock);
+    }
+    AUDIO_FUNC_LOGE("not found valid adapter");
+    return false;
+}
