+#ifdef DUMPFILE
+static void WriteDumpFile(const uint8_t *buffer, uint64_t requestBytes, FILE *pfd)
+{
+    if (pfd == NULL) {
+        return;
+    }
+    size_t writeResult = fwrite((void*)buffer, 1, requestBytes, pfd);
+    (void)fflush(pfd);
+    if (writeResult != requestBytes) {
+        AUDIO_FUNC_LOGE("Failed to write the file.");
+    }
+}
+#endif
