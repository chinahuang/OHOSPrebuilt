+
+static int AudioGetAdapt(SampleAudio *audio, enum AudioPortDirection dirType)
+{
+    audio->audiomanager = AudioManagerLoadVendorLib(audio);
+    if (audio->audiomanager == NULL) {
+        SAMPLE_LOG("GetAudioManagerFuncs failed!");
+        return -1;
+    }
+
+    uint32_t size = AUDIO_ADAPTER_NUM_MAX;
+    audio->descs = (struct AudioAdapterDescriptor *)malloc(size * sizeof(struct AudioAdapterDescriptor));
+    SAMPLE_LOG("descs = <%p> size:%u", audio->descs, size);
+    int ret = audio->audiomanager->GetAllAdapters(audio->audiomanager, audio->descs, &size);
+    SAMPLE_LOG("GetAllAdapters size = <%u>", size);
+    if (ret != 0) {
+        SAMPLE_LOG("GetAllAdapters failed!");
+        return -1;
+    }
+
+    for (uint32_t index = 0; index < size; index++) {
+        struct AudioAdapterDescriptor *desc = &audio->descs[index];
+        for (uint32_t port = 0; (desc != NULL && port < desc->portsLen); port++) {
+            if (desc->ports[port].dir != dirType) {
+                continue;
+            }
+            if (audio->audiomanager->LoadAdapter(audio->audiomanager, desc, &audio->adapter) == 0) {
+                audio->adapterName = desc->adapterName;
+                SAMPLE_LOG("LoadAdapter :%s", audio->adapterName);
+                ret = audio->adapter->InitAllPorts(audio->adapter);
+            } else {
+                SAMPLE_LOG("loadadapt fail");
+                return -1;
+            }
+            break;
+        }
+    }
+
+    if (ret != 0) {
+        audio->audiomanager->UnloadAdapter(audio->audiomanager, audio->adapterName);
+        audio->adapter = NULL;
+        audio->audiomanager = NULL;
+        return -1;
+    }
+
+    if (audio->adapter == NULL) {
+        SAMPLE_LOG("LoadAdapter failed!");
+        return -1;
+    }
+
+    return 0;
+}
+
+static void InitAttrFromMember(SampleMember *member, struct AudioSampleAttributes *attr)
+{
+    if (member == NULL || attr == NULL) {
+        return;
+    }
+
+    switch (member->pcmFormat.bitDepth) {
+        case 8: // 8 bitdepth
+            attr->format = AUDIO_FORMAT_TYPE_PCM_8_BIT;
+            break;
+        case 16: // 16 bitdepth
+            attr->format = AUDIO_FORMAT_TYPE_PCM_16_BIT;
+            break;
+        case 24: // 24 bitdepth
+            attr->format = AUDIO_FORMAT_TYPE_PCM_24_BIT;
+            break;
+        case 32: // 32 bitdepth
+            attr->format = AUDIO_FORMAT_TYPE_PCM_32_BIT;
+            break;
+        default:
+            attr->format = AUDIO_FORMAT_TYPE_PCM_16_BIT;
+            break;
+    }
+
+    attr->type = AUDIO_IN_MEDIA;
+    attr->interleaved = member->pcmFormat.interleaved;
+    attr->sampleRate = member->pcmFormat.sampleRate;
+    attr->channelCount = member->pcmFormat.channelCnt;
+}
+
+static int AudioRenderCreate(SampleMember *member)
+{
+    SampleAudio *audio = &(member->audio);
+    if (memset_s(audio, sizeof(SampleAudio), 0, sizeof(SampleAudio)) != EOK) {
+        SAMPLE_LOG("memset member audio fail");
+    }
+
+    if (AudioGetAdapt(audio, PORT_OUT) != 0) {
+        return -1;
+    }
+
+    struct AudioDeviceDescriptor deviceDesc = { 0 };
+    deviceDesc.pins = PIN_OUT_SPEAKER;
+    struct AudioSampleAttributes attr = { 0 };
+    InitAttrFromMember(member, &attr);
+    int ret = audio->adapter->CreateRender(audio->adapter, &deviceDesc, &attr, &audio->render, &audio->renderId);
+    if (ret != 0) {
+        SAMPLE_LOG("CreateRender failed");
+        return -1;
+    }
+
+    return 0;
+}
+
+static void DestroySampleAudio(SampleAudio *audio)
+{
+    if (audio->frameAddr != NULL) {
+        free(audio->frameAddr);
+        audio->frameAddr = NULL;
+    }
+
+    if (audio->adapter != NULL) {
+        audio->adapter->DestroyRender(audio->adapter, audio->renderId);
+    }
+
+    if (audio->audiomanager != NULL) {
+        audio->audiomanager->UnloadAdapter(audio->audiomanager, audio->adapterName);
+    }
+    if (audio->descs != NULL) {
+        free(audio->descs);
+    }
+}
+
+static int ReadPcmBufFromFile(SampleMember *member, FILE* pfd, bool *fileEos)
+{
+    SampleAudio *audio = &(member->audio);
+    if (audio->frameSize != 0) {
+        return 0;
+    }
+
+    if (*fileEos) {
+        usleep(SLEEP_TIME_10 * TIME_SCALE);
+        if (member->retry) {
+            fseek(pfd, 0, SEEK_SET);
+            member->retry = false;
+            *fileEos = false;
+        }
+        return -1;
+    }
+
+    size_t mallocLen = 1024 * member->pcmFormat.channelCnt * sizeof(int16_t);
+    int ret = fread(audio->frameAddr, 1, mallocLen, pfd);
+    if (ret <= 0) {
+        *fileEos = true;
+        SAMPLE_LOG("read file eos");
+        return -1;
+    }
+    audio->frameSize = ret;
+    return 0;
+}
+
+static void SendPcmFrameToAudio(SampleMember *member, FILE* pfd)
+{
+    SampleAudio *audio = &(member->audio);
+    uint64_t replyBytes = 0;
+    size_t mallocLen = 1024 * member->pcmFormat.channelCnt * sizeof(int16_t);
+    audio->frameSize = 0;
+    audio->frameAddr = (void *)malloc(mallocLen);
+    member->threadRun = 1;
+    pthread_mutex_lock(&member->dataMutex);
+    member->isPlaying = true;
+    pthread_mutex_unlock(&member->dataMutex);
+    bool fileEos = false;
+    while (member->threadRun != 0) {
+        pthread_mutex_lock(&member->dataMutex);
+        if (!member->isPlaying) {
+            pthread_cond_wait(&member->dataCond, &member->dataMutex);
+        }
+        pthread_mutex_unlock(&member->dataMutex);
+
+        if (ReadPcmBufFromFile(member, pfd, &fileEos) != 0) {
+            break;
+        }
+
+        int ret = audio->render->RenderFrame(audio->render, audio->frameAddr, audio->frameSize, &replyBytes);
+        if (ret != 0) {
+            usleep(20000); /* 20000 sleep 20ms */
+            continue;
+        }
+
+        audio->frameSize = 0;
+    }
+    SAMPLE_LOG("audio render thread exit");
+}
+
+static void *AudioRenderThread(void *arg)
+{
+    SAMPLE_LOG("AudioRenderTest start");
+    SampleMember *member = (SampleMember *)arg;
+    FILE *pfd = fopen(member->fileName,"rb");
+    if (pfd == NULL) {
+        SAMPLE_LOG("outfileName open failed!");
+        return NULL;
+    }
+
+    SampleAudio *audio = &(member->audio);
+    int ret = AudioRenderCreate(member);
+    if (ret != 0) {
+        SAMPLE_LOG("Create Render failed ");
+        goto DEINIT;
+    }
+
+    ret = audio->render->Start(audio->render);
+    if (ret != 0) {
+        SAMPLE_LOG("Render Start failed ");
+        goto DEINIT;
+    }
+
+    SendPcmFrameToAudio(member, pfd);
+    audio->render->Stop(audio->render);
+DEINIT:
+    if (pfd != NULL) {
+        (void)fclose(pfd);
+    }
+    DestroySampleAudio(audio);
+    return NULL;
+}
