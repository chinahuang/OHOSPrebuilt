+ * Create: 2020-10-13
+ */
+
+#include "media_hal_common.h"
+
+#include <sys/time.h>
+#include <dlfcn.h>
+#include <limits.h>
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+#include "audio_uhdf_log.h"
+
+#ifdef __cplusplus
+#if __cplusplus
+extern "C" {
+#endif
+#endif /* End of #ifdef __cplusplus */
+#define MODULE_NAME "MediaHalCommon"
+#define S2US  1000000
+#define US2MS  1000
+#define S2MS  1000
+
+static MEDIA_HAL_LOG_LEVEL g_enabledLevel = MEDIA_HAL_LOG_LEVEL_ERR;
+
+static void LogTime()
+{
+    struct timeval tv;
+    gettimeofday(&tv, NULL);
+    struct tm tm;
+    localtime_r(&tv.tv_sec, &tm);
+    printf("[%02d:%02d:%02d:%03lld]", tm.tm_hour, tm.tm_min, tm.tm_sec, tv.tv_usec / US2MS);
+}
+
+int32_t MediaHalLogPrintf(const char *modName, MEDIA_HAL_LOG_LEVEL level, const char *fmt, ...)
+{
+    if (level < g_enabledLevel) {
+        return MEDIA_HAL_OK;
+    }
+    if (modName == NULL || fmt == NULL) {
+        return MEDIA_HAL_ERR;
+    }
+    char *levelStr = NULL;
+    switch (level) {
+        case MEDIA_HAL_LOG_LEVEL_VERBOSE:
+            levelStr = "V";
+            break;
+        case MEDIA_HAL_LOG_LEVEL_DEBUG:
+            levelStr = "D";
+            break;
+        case MEDIA_HAL_LOG_LEVEL_INFO:
+            levelStr = "I";
+            break;
+        case MEDIA_HAL_LOG_LEVEL_WARN:
+            levelStr = "W";
+            break;
+        case MEDIA_HAL_LOG_LEVEL_ERR:
+            levelStr = "E";
+            break;
+        default:
+            levelStr = "E";
+            break;
+    }
+    LogTime();
+    va_list args;
+    printf("[%s:%s]", modName, levelStr);
+    va_start(args, fmt);
+    vprintf(fmt, args);
+    va_end(args);
+    printf("\n");
+    return MEDIA_HAL_OK;
+}
+
+
+void *MediaHalDLOpen(const char *file)
+{
+    void *soModule = NULL;
+    if (file == NULL) {
+        return NULL;
+    }
+    char resolvedPath[PATH_MAX + 1] = { 0 };
+    if (realpath(file, resolvedPath) == NULL) {
+        AUDIO_FUNC_LOGE("realpath file error");
+        return NULL;
+    }
+
+    soModule = dlopen(resolvedPath, RTLD_LAZY);
+    if (soModule == NULL) {
+        AUDIO_FUNC_LOGE("MediaHalDLOpen file:%s error:%s", file, dlerror());
+        return soModule;
+    }
+    AUDIO_FUNC_LOGI("MediaHalDLOpen,file:%s ok", file);
+    return soModule;
+}
+
+void *MediaHalDLSym(VoidPtr module, const char *symbol)
+{
+    void *moduleAddr = NULL;
+    if (module == NULL || symbol == NULL) {
+        return NULL;
+    }
+
+    moduleAddr = dlsym(module, symbol);
+    return moduleAddr;
+}
+
+void MediaHalDLClose(HalHandle handle)
+{
+    if (handle == NULL) {
+        return;
+    }
+
+    dlclose(handle);
+}
+
+int64_t CalDiffTimeBetween(struct timeval timeStart, struct timeval timeEnd,
+    const char *tag, const char *name, bool showLog)
+{
+    int64_t diffSecToUs = (int64_t)(timeEnd.tv_sec - timeStart.tv_sec) * S2US;
+    int64_t diffUsec = (int64_t)(timeEnd.tv_usec - timeStart.tv_usec);
+    int64_t diffTimeUS = diffSecToUs + diffUsec;
+    if (showLog) {
+        MEDIA_HAL_LOGI(tag, "[%s] elapsed time: %lld us", name, diffTimeUS);
+    }
+    return diffTimeUS;
+}
+#ifdef __cplusplus
+#if __cplusplus
+}
+#endif
+#endif /* End of #ifdef __cplusplus */
