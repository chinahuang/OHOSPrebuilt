+    g_irEnable = atoi(optarg);
+    if (g_irEnable != 0 && g_irEnable != 1) {
+        printf("-E parameter not correct, only 0 or 1 allowed!\n");
+        return;
+    }
+    g_irEnableSet = 1;
+    printf("Set ir mode to %s state!\n", g_irEnable ? "enable" : "disable");
+}
+
+static int GetProtStatus()
+{
+    printf("try to get the enable status of %s\n", optarg);
+    g_protStatus = IrGetProtStatus(optarg);
+    if (g_protStatus >= 0) {
+        printf("The status of %s is :%s\n", optarg, g_protStatus == 0 ? "disabled" : "enabled");
+    } else {
+        printf("Fail to get protocol status!\n");
+    }
+    return HI_SUCCESS;
+}
+
+static int GetProtList()
+{
+    printf("Available default protocols list:\n");
+    for (int i = 0; i < (signed int)(sizeof(g_protNames) / sizeof(g_protNames[0])); i++) {
+        printf("%s\n", g_protNames[i].c_str());
+    }
+    return HI_SUCCESS;
+}
+
+static int SetProtEnable()
+{
+    g_protName = optarg;
+    g_protNameSet = 1;
+
+    printf("g_protName :%s.\n", g_protName.c_str());
+
+    if (g_protEnableSet && g_protNameSet) {
+        g_protEnableSet = 0;
+        g_protNameSet = 0;
+        int ret = IrSampleSetProtEnable();
+        if (ret) {
+            perror("Fail to set g_protEnable!\n");
+            return HI_SUCCESS;
+        }
+    }
+    return HI_FAILURE;
+}
+
+static int SetProtE()
+{
+    g_protEnable = atoi(optarg);
+    g_protEnableSet = 1;
+
+    printf("protocol enable status will set to :%d\n", g_protEnable);
+
+    if (g_protEnableSet && g_protNameSet) {
+        g_protEnableSet = 0;
+        g_protNameSet = 0;
+        int ret = IrSampleSetProtEnable();
+        if (ret) {
+            perror("Fail to set g_protEnable!\n");
+            return HI_SUCCESS;
+        }
+    }
+    return HI_FAILURE;
+}
+
+static void SetMode()
+{
+    g_mode = atoi(optarg);
+    g_modeSet++;
+    printf("key fetch g_mode set to :%d\n", g_mode);
+}
+
+static void SetTimeOut()
+{
+    g_keyupTimeout = strtoul(optarg, nullptr, 10); // 10, an integral number of the specified base
+    g_keyupTimeoutSet++;
+    printf("keyup timeout set to %u\n", g_keyupTimeout);
+}
+
+static void SetRepeatEvent()
+{
+    g_repeatEvent = atoi(optarg);
+    g_repeatEventSet++;
+    printf("repeat event set to %d\n", g_repeatEvent);
+}
+
+static void SetRepeatInterval()
+{
+    g_repeatInterval = strtoul(optarg, nullptr, 10); // 10, an integral number of the specified base
+    g_repeatIntervalSet++;
+    printf("repeat interval set to %u\n", g_repeatInterval);
+}
+
+static int ProcessOptions1(int op, char *argv[])
+{
+    switch (op) {
+        case 'g':
+            return GetProtStatus();
+        case 'l':
+            return GetProtList();
+        case 's':
+            return SetProtEnable();
+        case 'e':
+            return SetProtE();
+        case 'h':
+        default:
+            Usage(*argv[0]);
+            return HI_SUCCESS;
+    }
+}
+
+static int ProcessOptions(int argc, char *argv[])
+{
+    int op;
+    opterr = 0;
+    while ((op = getopt(argc, argv, "m:u:U:r:R:T:E:g:ls:e:hD:d")) != -1) {
+        switch (op) {
+            case 'm':
+                SetMode();
+                break;
+            case 'u':
+                g_keyupEvent = atoi(optarg);
+                g_keyupEventSet++;
+                printf("keyup event set to %d\n", g_keyupEvent);
+                break;
+            case 'U':
+                SetTimeOut();
+                break;
+            case 'r':
+                SetRepeatEvent();
+                break;
+            case 'R':
+                SetRepeatInterval();
+                break;
+            case 'T':
+                g_readTimeout = strtoul(optarg, nullptr, 10); // 10, an integral number of the specified base
+                printf("read syscall timeout set to %u\n", g_readTimeout);
+                break;
+            case 'E':
+                SetIrEnable();
+                break;
+            case 'D':
+                g_debugEnable = 1;
+                break;
+            case 'd':
+                g_debugIrEnable = !g_debugIrEnable;
+                printf("ir automated test enable %d\n", g_debugIrEnable);
+                break;
+            default:
+                return ProcessOptions1(op, argv);
+        }
+    }
+    return HI_FAILURE;
+}
+
+void SetBrowserMouseMode(bool& isBrowserMouseMode)
+{
+    char value[PROPERTY_VALUE_MAX] = "false";
+    char browsePidValue[PROPERTY_VALUE_MAX] = "0";
+
+    // When enter browser mdoe , need dectect the browser is alive
+    if (strcmp(value, "true") == 0 && strlen(browsePidValue) && atoi(browsePidValue) > 0) {
+        XLOGD(">>>Enter browser mosue g_mode!!!");
+        const int processInfoLength = 128;
+        char processInfo[processInfoLength] = "";
+        int err = sprintf_s(processInfo, sizeof(processInfo) - 1, "/proc/%s/", browsePidValue);
+        if (err < 0) {
+            XLOGD("sprintf failed.err = %d\n", err);
+            return;
+        }
+        if (access(processInfo, F_OK) != 0) {
+            XLOGD("Set isBrowserMouseMode to false!!");
+            isBrowserMouseMode = false;
+        } else {
+            XLOGD("Set isBrowserMouseMode to true!!");
+            isBrowserMouseMode = true;
+        }
+    }
+}
+
+void SetMoveStep(bool isBrowserMouseMode, HI_UNF_KEY_STATUS_E status)
+{
+    //  Browser mode or not -- checking
+    if (!isBrowserMouseMode) {
+        if (status < HI_UNF_KEY_STATUS_HOLD) {
+            g_mouseMoveStep = MOUSE_MIN_STEP;
+        } else {
+            g_mouseMoveStep = ((g_mouseMoveStep + MOUSE_STEP) > MOUSE_MAX_STEP
+                ? MOUSE_MAX_STEP
+                : (g_mouseMoveStep + MOUSE_STEP));
+        }
+    } else {
+        if (status < HI_UNF_KEY_STATUS_HOLD) {
+            // Normal
+            g_mouseMoveStep = BROWSER_MOUSE_MIN_STEP;
+        } else {
+            // Holding
+            g_mouseMoveStep += BROWSER_MOUSE_STEP;
+        }
+    }
+}
+
+void LinuxKeycodeLogic(unsigned int linuxKeycode, HI_UNF_KEY_STATUS_E status, bool& isMouseEventKey, int& yCoordinate)
+{
+    if (linuxKeycode == KEY_UP && status != HI_UNF_KEY_STATUS_UP) {
+        isMouseEventKey = true;
+        if (yCoordinate <= 0) {
+            XLOGD("In the top of screen");
+            // scroll up
+            ReportMouseScrollState(1);
+            yCoordinate = 0;
+        } else {
+            ReportMouseState(0, 0, -g_mouseMoveStep);
+            yCoordinate = yCoordinate - g_mouseMoveStep;
+        }
+    } else if (linuxKeycode == KEY_DOWN && status != HI_UNF_KEY_STATUS_UP) {
+        isMouseEventKey = true;
+        if (yCoordinate >= g_yCoordinateMax) {
+            XLOGD("In the bottom of screen");
+            // scroll down
+            ReportMouseScrollState(-1);
+            yCoordinate = g_yCoordinateMax;
+        } else {
+            ReportMouseState(0, 0, g_mouseMoveStep);
+            yCoordinate = yCoordinate + g_mouseMoveStep;
+        }
+    } else if (linuxKeycode == KEY_LEFT && status != HI_UNF_KEY_STATUS_UP) {
+        isMouseEventKey = true;
+        ReportMouseState(0, -g_mouseMoveStep, 0);
+    } else if (linuxKeycode == KEY_RIGHT && status != HI_UNF_KEY_STATUS_UP) {
+        isMouseEventKey = true;
+        ReportMouseState(0, g_mouseMoveStep, 0);
+    } else if (linuxKeycode == KEY_ENTER) {
+        isMouseEventKey = true;
+        if (status == HI_UNF_KEY_STATUS_DOWN) {
+            ReportMouseState(0x01, 0, 0);
+        } else if (status == HI_UNF_KEY_STATUS_UP) {
+            ReportMouseState(0x00, 0, 0);
+        }
+    }
+}
+
+void InitCoordinate(int& yCoordinate)
+{
+#if (UNF_VERSION_CODE >= UNF_VERSION(4, 0))
+    yCoordinate = 1080; /* 1080: half of 2160 */
+    g_yCoordinateMax = 2160;
+    XLOGD("Init yCoordinate 1080 cause 4k UI!");
+#else
+    char isFhd[PROPERTY_VALUE_MAX] = "true";
+    if (strcmp(isFhd, "false") == 0) {
+        yCoordinate = 540; /* 540: half of 1080 */
+        XLOGD("isFhd = false");
+    }
+#endif
+}
+
+/**
+ * Adjust the value of the up, down, left, and right keys
+ * of the remote control according to different angles of screen rotation
+ */
+void RotateKey(unsigned int& linuxKeycode)
+{
+    for (int i = 0; i < KEY_LENGTH; i++) {
+        if (linuxKeycode == g_keys[i]) {
+            char rotationProperty[PROPERTY_VALUE_MAX] = "landscape";
+            if (strcmp(rotationProperty, "landscape") == 0) { // Rotate 0 °
+                linuxKeycode = g_keys[(i + 0) % KEY_LENGTH];
+            } else if (strcmp(rotationProperty, "portrait") == 0) { // Rotate 90 °
+                linuxKeycode = g_keys[(i + 1) % KEY_LENGTH];
+            } else if (strcmp(rotationProperty, "seascape") == 0) { // Rotate 180 °
+                linuxKeycode = g_keys[(i + 2) % KEY_LENGTH]; /* 2: index */
+            } else if (strcmp(rotationProperty, "upsideDown") == 0) { // Rotate 270 °
+                linuxKeycode = g_keys[(i + 3) % KEY_LENGTH]; /* 3: index */
+            }
+            return;
+        }
+    }
+}
+
+bool SetLinuxKeycode(unsigned int& linuxKeycode, unsigned long long key)
+{
+    bool isKeyValid = false;
+    linuxKeycode = 0;
+    for (unsigned int i = 0; i < KEY_ARRY_NUM; i++) {
+        char num = g_keyArray[i].keynum;
+        if (num > KEYNUMMAX) {
+            break;
+        }
+        for (unsigned int j = 0; j < num; j++) {
+            if (g_keyArray[i].hi_keycode[j].ir_keycode == key) {
+                isKeyValid = true;
+                linuxKeycode = g_keyArray[i].hi_keycode[j].linux_keycode;
+                return isKeyValid;
+            }
+        }
+    }
+    return isKeyValid;
+}
+
+void IrAutomatedTest(unsigned int& num, unsigned long long &key, HI_UNF_KEY_STATUS_E& status)
+{
+    num++;
+    if (num % 2 == 1) { // 2: Logic judgment of key up and down, the mod is 1 is down
+        status = HI_UNF_KEY_STATUS_DOWN;
+    } else {
+        status = HI_UNF_KEY_STATUS_UP;
+        g_debugIrEnable = false;
+        num = 0;
+    }
+    key = 0x3ec1ff00; // KEY_RIGHT key value
+}
+
+void ReportKey(bool isMouseEventKey, HI_UNF_KEY_STATUS_E status, unsigned int linuxKeycode)
+{
+    if (!isMouseEventKey) {
+        if (status == HI_UNF_KEY_STATUS_DOWN) {
+            ReportKeyEvent(linuxKeycode, KPC_EV_KEY_PRESS);
+        } else if (status == HI_UNF_KEY_STATUS_UP) {
+            ReportKeyEvent(linuxKeycode, KPC_EV_KEY_RELEASE);
+        }
+    }
+}
+
+void IrSampleThread()
+{
+    unsigned long long key = 0LL;
+    unsigned long long lower = 0LL;
+    unsigned long long upper = 0LL;
+    unsigned int linuxKeycode = 0;
+    unsigned int readTimeout = 200; // ms
+    unsigned int num = 0;
+    bool threadStopFlag = false;
+    bool isMouseEventKey = false;
+    char name[64]; // 64 is name array init size
+    HI_UNF_KEY_STATUS_E status = HI_UNF_KEY_STATUS_DOWN;
+
+    static unsigned int u32MouseMode = 0;
+    static int yCoordinate = 360; // half of 720
+    InitCoordinate(yCoordinate);
+
+    while (!threadStopFlag) {
+        int ret = IR_GetValueWithProtocol(status, key, name, sizeof(name), readTimeout);
+        if (ret) {
+            if (!g_debugIrEnable) {
+                printf("IR_GetValueWithProtocol ret = %d ", ret);
+                continue;
+            }
+            IrAutomatedTest(num, key, status);
+        }
+        isMouseEventKey = false;
+        bool isBrowserMouseMode = false;
+        SetBrowserMouseMode(isBrowserMouseMode);
+        if (!SetLinuxKeycode(linuxKeycode, key)) {
+            continue;
+        }
+        // shield PIP(WINDOW) key
+        if (linuxKeycode == WINDOW) {
+            isMouseEventKey = true;
+            XLOGD("you have pressed PIP key\n ,yCoordinate is %d ", yCoordinate);
+            if (status == HI_UNF_KEY_STATUS_UP) {
+                u32MouseMode = !u32MouseMode;
+            }
+        }
+
+        printf("IR got value linux_key:%u; status:%d.;", linuxKeycode, status);
+        if (isBrowserMouseMode || u32MouseMode) {
+            XLOGD("We are entering into MOUSE MODE! \ny_coodinate is %d", yCoordinate);
+            SetMoveStep(isBrowserMouseMode, status);
+            LinuxKeycodeLogic(linuxKeycode, status, isMouseEventKey, yCoordinate);
+        } else {
+            RotateKey(linuxKeycode);
+        }
+        ReportKey(isMouseEventKey, status, linuxKeycode);
+    }
+
+    return;
+}
+
+void ThreadProcess()
+{
+    thread irThread(IrSampleThread);
+    irThread.join();
+    IR_DeInit();
+    printf("Ir sample thread exit! Bye!\n");
+}
+
+void SetPowerKey()
+{
+    // set ir wakeup source value
+    unsigned int powerKeyNum = 0;
+    unsigned long long irPowerKeyCode[WAKEUP_IRKEY_MAXNUM] = {0};
+    GetPowerKeyCode(irPowerKeyCode, powerKeyNum);
+    IR_PowerResumSet(irPowerKeyCode, powerKeyNum);
+}
+
+int main(int argc, char *argv[])
+{
+    if (argv == nullptr || ProcessOptions(argc, argv) == HI_SUCCESS) {
+        exit(-1);
+    }
+    if (HiVinputInit() == -1) {
+        printf("can't open hi_vinput,so we can't use ir ,please check vinput driver\n");
+        exit(-1);
+    }
+
+    GetKeycode(g_keyArray, KEY_ARRY_NUM);
+    SetPowerKey();
+
+    if (CheckParams() < 0) {
+        Usage(*argv[0]);
+        exit(-1);
+    }
+
+    // open
+    printf("IR_Init-ing...");
+    if (IR_Init()) {
+        perror("Fail to open ir dev!");
+        exit(-1);
+    }
+
+    if (!g_mode) {
+        if (g_keyupTimeoutSet) {
+            printf("This version cannot support dynamicly change keyup timeout!\n");
+        }
+        if (g_keyupEventSet && IR_EnableKeyUp(g_keyupEvent > 0 ? HI_TRUE : HI_FALSE)) {
+            perror("Fail to set keyup event!");
+            goto EXIT;
+        } else if (g_repeatEventSet && IR_EnableRepKey(g_repeatEvent > 0 ? HI_TRUE : HI_FALSE)) {
+            perror("Fail to set repeat key event!");
+            goto EXIT;
+        } else if (g_repeatIntervalSet && IR_SetRepKeyTimeoutAttr(g_repeatInterval)) {
+            perror("Fail to set repeat interval!");
+            goto EXIT;
+        }
+    }
+
+    if (IR_SetFetchMode(g_mode)) {
+        perror("Fail to set key fetch g_mode!");
+        goto EXIT;
+    } else if (g_irEnableSet && IR_Enable(g_irEnable > 0 ? HI_TRUE : HI_FALSE)) {
+        perror("Fail to set enable state of ir module!");
+        goto EXIT;
+    }
+    ThreadProcess();
+    return 0;
+EXIT:
+    IR_DeInit();
+    exit(-1);
+}
