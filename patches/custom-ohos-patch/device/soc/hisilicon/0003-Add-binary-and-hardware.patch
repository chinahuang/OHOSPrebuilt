+int32_t AudioAdapterGetPortCapability(
+    struct IAudioAdapter *adapter, const struct AudioPort *port, struct AudioPortCapability *capability)
+{
+    AUDIO_FUNC_LOGI("Enter.");
+    bool Valid = AudioManagerIsValidAdapter(adapter);
+    if (Valid != true) {
+        AUDIO_FUNC_LOGE("adapter is invalid");
+        return AUDIO_ERR_INVALID_PARAM;
+    }
+
+   if (port == NULL) {
+        AUDIO_FUNC_LOGE("Input parameter(port) is NULL!");
+        return MEDIA_HAL_INVALID_PARAM;
+    }
+    if (port->portName == NULL) {
+        AUDIO_FUNC_LOGE("Input parameter(portName) is NULL!");
+        return MEDIA_HAL_INVALID_PARAM;
+    }
+    if (capability == NULL) {
+        AUDIO_FUNC_LOGE("Input parameter(capability) is NULL!");
+        return MEDIA_HAL_INVALID_PARAM;
+    }
+
+    struct AudioHwAdapter *hwAdapter = (struct AudioHwAdapter *)adapter;
+
+    uint32_t portIndex;
+    for (portIndex = 0; portIndex < PORT_NUM_MAX; portIndex++) {
+        if (port->dir == hwAdapter->adapterDescriptor.ports[portIndex].dir &&
+            !strcmp(port->portName, hwAdapter->adapterDescriptor.ports[portIndex].portName)) {
+            if (memcpy_s(capability, sizeof(struct AudioPortCapability), &(hwAdapter->portCapabilitys[portIndex].capability),
+                sizeof(struct AudioPortCapability)) != EOK) {
+                 AUDIO_FUNC_LOGE("memcpy_s failed");
+            }
+            break;
+        }
+    }
+    if (portIndex == PORT_NUM_MAX) {
+         AUDIO_FUNC_LOGE("invalid audio port dir[%d], id[%d], name[%s]", port->dir, port->portId,
+            port->portName);
+        return MEDIA_HAL_INVALID_PARAM;
+    }
+
+     AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
