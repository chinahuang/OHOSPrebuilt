+
+extern "C" {
+const static uint8_t MAX_COLOR_PLANES = 3;
+const static int32_t MAX_BUF_SLOTS = 24;
+
+enum ImageColorspace {
+    IMAGE_COLORSPACE_SRGB,
+    IMAGE_COLORSPACE_BT709,
+    IMAGE_COLORSPACE_BT2020_LINEAR,
+    IMAGE_COLORSPACE_BT2020_PQ,
