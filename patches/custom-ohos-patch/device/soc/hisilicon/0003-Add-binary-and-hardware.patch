+int32_t AudioAdapterDestroyCapture(struct IAudioAdapter *adapter, uint32_t captureId)
+{
+    AUDIO_FUNC_LOGI("Enter.");
+    bool Valid = AudioManagerIsValidAdapter(adapter);
+    if (Valid != true) {
+        AUDIO_FUNC_LOGE("adapter is invalid");
+        return AUDIO_ERR_INVALID_PARAM;
+    }
+    struct AudioHwAdapter *hwAdapter = (struct AudioHwAdapter *)adapter;
+    if (hwAdapter == NULL || captureId >= MAX_AUDIO_STREAM_NUM) {
+        AUDIO_FUNC_LOGE("Parameter error!");
+        return AUDIO_ERR_INVALID_PARAM;
+    }
+
+    struct IAudioCapture *capture = (struct IAudioCapture *)hwAdapter->infos.captureServicePtr[captureId];
+    struct AudioHwCapture *hwCapture = (struct AudioHwCapture *)capture;
+    if (hwCapture == NULL) {
+        AUDIO_FUNC_LOGE("hwCapture is NULL!");
+        return AUDIO_ERR_INTERNAL;
+    }
+
+    int32_t ret = AudioAdapterFreeChn(adapter, hwCapture->chnId, true);
+    if (ret == -1) {
+         AUDIO_FUNC_LOGE("AudioAdapterFreeChn failed");
+        return MEDIA_HAL_INVALID_PARAM;
+    }
+    if (hwCapture->started) {
+        (void)AudioCaptureStop(capture);
+    }
+    ret = hwAdapter->portPlugin->DestroyTrack(hwAdapter->portHandle, hwCapture->trackHandle);
+    if (ret != MEDIA_HAL_OK) {
+         AUDIO_FUNC_LOGE("portPlugin DestroyTrack failed: 0x%x", ret);
+    }
+    hwCapture->trackHandle = NULL;
+    pthread_mutex_destroy(&hwCapture->mutex);
+    OsalMemFree(hwCapture);
+    hwAdapter->infos.captureServicePtr[captureId] = NULL;
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
