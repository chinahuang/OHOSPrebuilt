+/*
+ * Copyright (c) Huawei Technologies Co., Ltd. 2016-2019. All rights reserved.
+ * Description: Application programming interfaces (APIs) of gpio
+ * Author: hisilicon
+ * Create: 2019-11-30
+ */
+
+#include "hi_log.h"
+#include <cstdio>
+#include <cstdlib>
+#include <unistd.h>
+#include "hi_unf_gpio.h"
+#include "hi_unf_version.h"
+#include "gpio_inter.h"
+
+static hi_s32 hiGpioNum(hi_u32 group_number, hi_u32 bit_number)
+{
+    return group_number * 8 + bit_number; /* 8: bit number */
+}
+
+hi_s32 HiGpioInit(hi_void)
+{
+#if (UNF_VERSION_CODE == UNF_VERSION(3, 5))
+    return HI_UNF_GPIO_Init();
+#elif (UNF_VERSION_CODE == UNF_VERSION(4, 0))
+    return hi_unf_gpio_init();
+#endif
+}
+
+
+hi_s32 HiGpioDeinit(hi_void)
+{
+#if (UNF_VERSION_CODE == UNF_VERSION(3, 5))
+    return HI_UNF_GPIO_DeInit();
+#elif (UNF_VERSION_CODE == UNF_VERSION(4, 0))
+    return hi_unf_gpio_deinit();
+#endif
+}
+
+hi_s32 HiGpioSetDirection(hi_u32 group_number, hi_u32 bit_number, hi_bool input)
+{
+#if (UNF_VERSION_CODE == UNF_VERSION(3, 5))
+    return HI_UNF_GPIO_SetDirBit(hiGpioNum(group_number, bit_number), input);
+#elif (UNF_VERSION_CODE == UNF_VERSION(4, 0))
+    return hi_unf_gpio_set_direction(group_number, bit_number, input);
+#endif
+}
+
+hi_s32 HiGpioRead(hi_u32 group_number, hi_u32 bit_number, hi_bool& high_volt)
+{
+#if (UNF_VERSION_CODE == UNF_VERSION(3, 5))
+    return HI_UNF_GPIO_ReadBit(hiGpioNum(group_number, bit_number), &high_volt);
+#elif (UNF_VERSION_CODE == UNF_VERSION(4, 0))
+    return hi_unf_gpio_read(group_number, bit_number, &high_volt);
+#endif
+}
