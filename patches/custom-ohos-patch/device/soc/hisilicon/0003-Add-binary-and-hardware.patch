+++ b/common/hardware/audio/source/plugins/audio_usb_port_plugin/audio_port_plugin_usb.c
@@ -0,0 +1,290 @@
+﻿/*
+ * Copyright (c) Hisilicon Technologies Co., Ltd. 2021-2021. All rights reserved.
+ * Description: AudioOutputPortPlugin
+ * Author: Media Software Group
+ * Create: 2021-05-18
+ */
+
+#include "audio_port_plugin_usb.h"
+
+#include <string.h>
+#include <unistd.h>
+#include "media_hal_common.h"
+#include "audio_usb_port_plugin.h"
+#include "securec.h"
+#include "tinyalsa/asoundlib.h"
+#include "audio_uhdf_log.h"
+
+#ifdef __cplusplus
+#if __cplusplus
+extern "C" {
+#endif
+#endif /* __cplusplus */
+
+#define MODULE_NAME "AudioPortPluginUsb"
+
+#define MAX_AUDIO_SND_CARD_NUM 4
+#define DEFAULT_PERIOD_SIZE_IN 640
+#define DEFAULT_PERIOD_COUNT_IN 6
+#define DEFAULT_PERIOD_SIZE_OUT 1024
+#define DEFAULT_PERIOD_COUNT_OUT 4
+#define AUDIO_SAMPLE_RATE_DEFAULT 48000
+#define USB_AUDIO_CARD_TYPE 0
+#define BUILDIN_AUDIO_CARD_TYPE 1
+
+typedef struct {
+    bool inited;
+    int32_t captureCard;
+    int32_t renderCard;
+} AudioSndCard;
+
+typedef struct {
+    bool capture;
+    bool render;
+} AudioSndCardInfo;
+
+AudioSndCard g_audioSndCard = {false, -1, -1};
+
+void AudioSndConfigInit(struct pcm_config *config, uint32_t channels, uint32_t rate, enum pcm_format format,
+    bool dirInput)
+{
+    (void)memset_s(config, sizeof(struct pcm_config), 0, sizeof(struct pcm_config));
+    config->channels = channels;
+    config->rate = rate;
+    config->period_size = dirInput ? DEFAULT_PERIOD_SIZE_IN : DEFAULT_PERIOD_SIZE_OUT;
+    config->period_count = dirInput ? DEFAULT_PERIOD_COUNT_IN : DEFAULT_PERIOD_COUNT_OUT;
+    config->format = format;
+    config->start_threshold = 0;
+    config->stop_threshold = 0;
+    config->silence_threshold = 0;
+}
+
+static void ChecSndValid(int32_t cardId, AudioSndCardInfo *info)
+{
+    struct pcm_config config;
+    AudioSndConfigInit(&config, 0x1, (uint32_t)AUDIO_SAMPLE_RATE_DEFAULT, PCM_FORMAT_S16_LE, true);
+    info->capture = false;
+    info->render = false;
+    struct pcm *pcm = pcm_open(cardId, 0, PCM_IN, &config); // USB Audio: card 1, device 0
+    if (!pcm || !pcm_is_ready(pcm)) {
+        AUDIO_FUNC_LOGE("Unable to open PCM device %{public}u (%{public}s)\n", cardId, pcm_get_error(pcm));
+        AudioSndConfigInit(&config, 0x2, (uint32_t)AUDIO_SAMPLE_RATE_DEFAULT, PCM_FORMAT_S16_LE, true);
+        pcm = pcm_open(cardId, 0, PCM_IN, &config);
+    }
+    if (pcm != NULL && pcm_is_ready(pcm)) {
+        info->capture = true;
+        pcm_close(pcm);
+    }
+
+    AudioSndConfigInit(&config, 0x2, (uint32_t)AUDIO_SAMPLE_RATE_DEFAULT, PCM_FORMAT_S16_LE, false);
+    pcm = pcm_open(cardId, 0, PCM_OUT, &config); // USB Audio: card 1, device 0
+    if (!pcm || !pcm_is_ready(pcm)) {
+        AUDIO_FUNC_LOGE("Unable to open PCM device %{public}u (%{public}s)\n", cardId, pcm_get_error(pcm));
+    }
+    if (pcm != NULL && pcm_is_ready(pcm)) {
+        info->render = true;
+        pcm_close(pcm);
+    }
+    AUDIO_FUNC_LOGI("Audio usb cardId=%{public}d ChecSndValid success, capture=%{public}d, render=%{public}d",
+        cardId, info->capture, info->render);
+}
+
+static bool GetAudioCardType(int32_t cardId)
+{
+#define BUFFER_SIZE 128
+    bool ret = BUILDIN_AUDIO_CARD_TYPE;
+    FILE *fp;
+    char buffer[BUFFER_SIZE] = { 0 };
+    AUDIO_FUNC_LOGI("Audio card id=%{public}d ", cardId);
+    fp = fopen("/proc/asound/cards", "r");
+    if (!fp) {
+        AUDIO_FUNC_LOGE("Failed to open /proc/asound/cards");
+        return BUILDIN_AUDIO_CARD_TYPE;
+    }
+
+    while (fgets(buffer, BUFFER_SIZE, fp)) {
+        int device_number;
+        char card_name[BUFFER_SIZE];
+        AUDIO_FUNC_LOGI("Audio card str=%{public}s ", buffer);
+        if (sscanf(buffer, "%d [%*[^]]]: %[^-]", &device_number, &card_name) == 2) {
+            if (strstr(card_name, "USB") && device_number == cardId) {
+                AUDIO_FUNC_LOGI("Audio card OK str=%{public}s", buffer);
+                ret = USB_AUDIO_CARD_TYPE;
+                break;
+            }
+        }
+    }
+    fclose(fp);
+    AUDIO_FUNC_LOGI("Audio card type=%{public}d ", ret);
+    return ret;
+}
+
+static void SearchSndCardSupportedInputAndOutput(void)
+{
+#define FOUND_SLEEP_TIME_US 500000
+#define WAIT_TIME_OUT_CNT 40  /* 20s */
+    bool found = false;
+    int32_t count = 0;
+
+    while (!found) {
+        for (int32_t i = 0; i < MAX_AUDIO_SND_CARD_NUM; i++) {
+            AudioSndCardInfo card;
+            ChecSndValid(i, &card);
+            /* first select the double direct audio sound card */
+            if (card.capture && card.render) {
+                found = true;
+                break;
+            }
+        }
+        usleep(FOUND_SLEEP_TIME_US);
+        if (count++ > WAIT_TIME_OUT_CNT) {
+            AUDIO_FUNC_LOGE("no card support input and output");
+            break;
+        }
+    }
+}
+
+static void SelectAudioSndCard(void)
+{
+    if (g_audioSndCard.inited) {
+        return;
+    }
+
+    int32_t firstCaptureCard = -1;
+    int32_t firstRenderCard = -1;
+
+    SearchSndCardSupportedInputAndOutput();
+    for (int32_t i = 0; i < MAX_AUDIO_SND_CARD_NUM; i++) {
+        AudioSndCardInfo card;
+        ChecSndValid(i, &card);
+        /* first select the double direct audio sound card */
+        if (card.capture && card.render) {
+            if ( GetAudioCardType(i) == USB_AUDIO_CARD_TYPE ) {
+                firstCaptureCard = i;
+                firstRenderCard = i;
+                break;
+            }
+            firstCaptureCard = i;
+            firstRenderCard = i;
+        }
+
+        if (card.capture && firstCaptureCard == -1) {
+            firstCaptureCard = i;
+        }
+        if (card.render && firstRenderCard == -1) {
+            firstRenderCard = i;
+        }
+    }
+
+    g_audioSndCard.captureCard = firstCaptureCard;
+    g_audioSndCard.renderCard = firstRenderCard;
+
+    if (firstCaptureCard != -1 || firstRenderCard != -1) {
+        g_audioSndCard.inited = true;
+    }
+    AUDIO_FUNC_LOGI("captureCard:%{public}d, renderCard:%{public}d", g_audioSndCard.captureCard,
+        g_audioSndCard.renderCard);
+}
+
+int32_t GetAudioCaptureCard(void)
+{
+    SelectAudioSndCard();
+    return g_audioSndCard.captureCard;
+}
+
+int32_t GetAudioRenderCard(void)
+{
+    SelectAudioSndCard();
+    return g_audioSndCard.renderCard;
+}
+
+int32_t PcmOpen(int32_t card, int32_t device, int32_t flags, struct pcm_config *config, struct pcm **pcmHdl)
+{
+    AUDIO_FUNC_LOGI("Audio usb PcmOpen card=%{public}d device=%{public}d flags=%{public}d", card, device, flags);
+    struct pcm *pcm = pcm_open(card, device, flags, config); // USB Audio: card 1, device 0
+    if (!pcm || !pcm_is_ready(pcm)) {
+        AUDIO_FUNC_LOGE("card=%{public}d Unable to open PCM device (%{public}s)", card, pcm_get_error(pcm));
+        return MEDIA_HAL_ERR;
+    }
+
+    *pcmHdl = pcm;
+    return MEDIA_HAL_OK;
+}
+
+void PcmClose(struct pcm *pcm)
+{
+    if (pcm != NULL) {
+        pcm_close(pcm);
+        pcm = NULL;
+    }
+}
+
+int32_t MixerOpen(int32_t card, struct mixer **mixerHdl)
+{
+    struct mixer *mixer = mixer_open(card); // USB Audio: card 1
+    if (!mixer) {
+        AUDIO_FUNC_LOGE("Failed to open mixer");
+        return MEDIA_HAL_ERR;
+    }
+
+    *mixerHdl = mixer;
+    return MEDIA_HAL_OK;
+}
+
+void MixerClose(struct mixer *mixer)
+{
+    if (mixer != NULL) {
+        mixer_close(mixer);
+    }
+}
+
+bool IsRawFormat(enum AudioFormat audioFormat)
+{
+    if (audioFormat == AUDIO_FORMAT_TYPE_PCM_8_BIT || audioFormat == AUDIO_FORMAT_TYPE_PCM_16_BIT ||
+        audioFormat == AUDIO_FORMAT_TYPE_PCM_24_BIT || audioFormat == AUDIO_FORMAT_TYPE_PCM_32_BIT) {
+        return true;
+    }
+    return false;
+}
+
+int32_t TinyMixSetValue(struct mixer *mixer, uint32_t control, int32_t value)
+{
+    struct mixer_ctl *ctl;
+    enum mixer_ctl_type type;
+    uint32_t valuesNum;
+
+    ctl = mixer_get_ctl(mixer, control);
+    if (ctl == NULL) {
+        AUDIO_FUNC_LOGE("Invalid mixer control: %d", control);
+        return MEDIA_HAL_INVALID_PARAM;
+    }
+
+    type = mixer_ctl_get_type(ctl);
+    valuesNum = mixer_ctl_get_num_values(ctl);
+
+    for (uint32_t i = 0; i < valuesNum; i++) {
+        if (mixer_ctl_set_value(ctl, i, value)) {
+            AUDIO_FUNC_LOGE("Error: invalid value");
+            return MEDIA_HAL_ERR;
+        }
+    }
+
+    AUDIO_FUNC_LOGI("control %d success", control);
+    return MEDIA_HAL_OK;
+}
+
+const AudioPortPlugin *GetPortPluginFuncs(AudioPluginType pluginType)
+{
+    if (pluginType == AUDIO_PLUGIN_USB) {
+        return GetUSBPortPluginFuncs(pluginType);
+    }
+
+    AUDIO_FUNC_LOGE("invalid plugin type %d", pluginType);
+    return NULL;
+}
+
+#ifdef __cplusplus
+#if __cplusplus
+}
+#endif
+#endif /* __cplusplus */
