diff --git a/common/binary/hardware/keystone/BUILD.gn b/common/binary/hardware/keystone/BUILD.gn
new file mode 100755
index 0000000..c2e3824
--- /dev/null
+++ b/common/binary/hardware/keystone/BUILD.gn
@@ -0,0 +1,24 @@
+# Copyright (C) 2022 Hisilicon (Shanghai) Technologies Co., Ltd. All rights reserved.
+
+import("//build/ohos.gni")
+
+ohos_prebuilt_shared_library("libkeystone") {
+  if (target_cpu == "arm") {
+    source = "libkeystone.z.so"
+  }
+
+  subsystem_name = "hisilicon_common"
+  part_name = "keystone"
+  install_enable = true
+  install_images = [ chipset_base_dir ]
+  relative_install_dir = "chipsetsdk"
+}
+
+print("build_hisi_private_code = $build_hisi_private_code")
+group("keystone_group") {
+    if (build_hisi_private_code) {
+        deps = [ "//device/soc/hisilicon/common/hardware/keystone/source:libkeystone" ]
+    } else {
+        deps = [ ":libkeystone" ]
+    }
+}
