+int32_t AudioGetExtraParams(struct IAudioAdapter *adapter, enum AudioExtParamKey key, const char *condition,
+    char *value, uint32_t valueLen)
+{
+    CHECK_NULL_PTR_RETURN_VALUE(adapter, HDF_ERR_INVALID_PARAM);
+    CHECK_NULL_PTR_RETURN_VALUE(condition, HDF_ERR_INVALID_PARAM);
+    CHECK_NULL_PTR_RETURN_VALUE(value, HDF_ERR_INVALID_PARAM);
+    (void)memset_s(value, valueLen, 0, valueLen);
+
+    if (key == AUDIO_EXT_PARAM_KEY_USB_DEVICE && !strcmp(condition, "need_change_usb_device")) {
+        if (memcpy_s(value, valueLen, "false", strlen("false")) != 0) {
+            AUDIO_FUNC_LOGE("memcpy_s failed");
+            return AUDIO_ERR_INTERNAL;
+        }
+    } else if (key == AUDIO_EXT_PARAM_KEY_USB_DEVICE && !strcmp(condition, "get_usb_info")) {
+        if (memcpy_s(value, valueLen, USB_INFO_STR, strlen(USB_INFO_STR)) != 0) {
+            AUDIO_FUNC_LOGE("memcpy_s failed");
+            return AUDIO_ERR_INTERNAL;
+        }
+    } else {
+        AUDIO_FUNC_LOGE("unsupported param");
+        return AUDIO_ERR_NOT_SUPPORT;
+    }
+    return AUDIO_SUCCESS;
+}
