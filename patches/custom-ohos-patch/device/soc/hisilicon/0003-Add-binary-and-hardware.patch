+signed int IR_PowerResumSet(const unsigned long long irPowerKeyCode[], unsigned int powerKeyNum)
+{
+    if (irPowerKeyCode == nullptr || powerKeyNum > WAKEUP_IRKEY_MAXNUM) {
+        return HI_FAILURE;
+    }
+#if (UNF_VERSION_CODE >= UNF_VERSION(4, 0))
+    hi_unf_pmoc_suspend_param irparam;
+    hi_unf_pmoc_wakeup_type wakeup_type = HI_UNF_PMOC_WAKEUP_TYPE_MAX;
+    char tmp[PROP_VALUE_MAX];
+
+    property_get("persist.sys.suspend.mode", tmp, "shutdown");
+    ALOGD("suspend mode is %s", tmp);
+    if (strcmp(tmp, "str") == 0) {
+        wakeup_type = HI_UNF_PMOC_WAKEUP_TO_DDR;
+    }
+    int ret = hi_unf_pmoc_init();
+    if (ret != HI_SUCCESS) {
+        XLOGD("HI_UNF_PMOC_Init err, 0x%08x !\n", ret);
+        return ret;
+    }
+    if (wakeup_type != HI_UNF_PMOC_WAKEUP_TYPE_MAX) {
+        ret = hi_unf_pmoc_set_wakeup_type(wakeup_type);
+        if (ret != HI_SUCCESS) {
+            XLOGD("hi_unf_pmoc_set_wakeup_type err, 0x%08x !\n", ret);
+            return ret;
+        }
+    }
+
+    irparam.ir_param.ir_type = HI_UNF_IR_CODE_RAW;
+    irparam.ir_param.ir_num = powerKeyNum;
+    for (unsigned int i = 0; i < powerKeyNum; i++) {
+        irparam.ir_param.ir_low_val[i] = (hi_u32)(irPowerKeyCode[i] & 0x00000000ffffffff);
+        irparam.ir_param.ir_high_val[i] = (hi_u32)((irPowerKeyCode[i] & 0xffffffff00000000) >> 32); /* 32 :bits */
+        XLOGD("power %d resume value =0x%x%x \n", i,
+        irparam.ir_param.ir_low_val[i], irparam.ir_param.ir_high_val[i]);
+    }
+
+    ret = hi_unf_pmoc_set_suspend_param(HI_UNF_PMOC_WAKEUP_IR, HI_TRUE, &irparam);
+    if (ret != HI_SUCCESS) {
+        XLOGD("hi_unf_pmoc_set_suspend_param HI_UNF_PMOC_WAKEUP_IR err, 0x%08x !\n", ret);
+        return ret;
+    }
+
+#elif (UNF_VERSION_CODE == UNF_VERSION(3, 5))
+        int ret = IR_PmocPowerKeySet(irPowerKeyCode, powerKeyNum);
+        XLOGD("IR_PmocPowerKeySet ret, %08x !\n", ret);
+        ret = IR_PdmPowerKeySet(irPowerKeyCode, powerKeyNum);
+        XLOGD("IR_PdmPowerKeySet ret, 0x%08x !\n", ret);
+#endif
+    return HI_SUCCESS;
+}
+
