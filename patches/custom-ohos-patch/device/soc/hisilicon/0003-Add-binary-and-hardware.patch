+
+
+#define CONFIG_IN_GAIN_MIN     (-50.0) // unit: db
+#define CONFIG_IN_GAIN_MAX     6.0 // unit: db
+
+// 1 buffer: 8000(8kHz sample rate) * 2(bytes, PCM_16_BIT) * 1(channel)
+// 1 frame: 1024(sample) * 2(bytes, PCM_16_BIT) * 1(channel)
+#define CONFIG_FRAME_SIZE      (1024 * 2 * 1)
+
+int32_t AudioCaptureStart(struct IAudioCapture *handle)
+{
+    CHK_NULL_RETURN(handle, MEDIA_HAL_INVALID_PARAM, "input param handle null");
+
+    struct AudioHwCapture *hwCapture = (struct AudioHwCapture *)handle;
+    MEDIA_HAL_LOCK(hwCapture->mutex);
+    if (hwCapture->started) {
+        MEDIA_HAL_UNLOCK(hwCapture->mutex);
+        AUDIO_FUNC_LOGE("hwCapture have started");
+        return MEDIA_HAL_OK;
+    }
+    int32_t ret = hwCapture->trackHandle->EnableTrack(hwCapture->trackHandle);
+    if (ret != MEDIA_HAL_OK) {
+        MEDIA_HAL_UNLOCK(hwCapture->mutex);
+        AUDIO_FUNC_LOGE("AudioPortTrack EnableTrack failed: 0x%x", ret);
+        return ret;
+    }
+
+    ret = hwCapture->trackHandle->SetVolume(hwCapture->trackHandle, hwCapture->volume);
+    if (ret != MEDIA_HAL_OK) {
+        AUDIO_FUNC_LOGE("AudioPortTrack SetVolume failed: 0x%x", ret);
+    }
+
+    hwCapture->started = true;
+    enum VqeScene vqeScene;
+    if (hwCapture->attrs.type == AUDIO_IN_MEDIA) {
+        vqeScene = VQE_SCENE_AI_RECORD;
+    } else if (hwCapture->attrs.type == AUDIO_IN_COMMUNICATION) {
+        vqeScene = VQE_SCENE_AI_TALK;
+    }
+    struct InvokeAttr invokeAttr = {};
+    invokeAttr.request = &vqeScene;
+    ret = hwCapture->trackHandle->Invoke(hwCapture->trackHandle, INVOKE_ID_CONFIG_VQE, &invokeAttr);
+    if (ret != MEDIA_HAL_OK) {
+        AUDIO_FUNC_LOGE("AudioPortTrack Invoke INVOKE_ID_CONFIG_INPUT_VQE failed: 0x%x", ret);
+    }
+    MEDIA_HAL_UNLOCK(hwCapture->mutex);
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioCaptureStop(struct IAudioCapture *handle)
+{
+    CHK_NULL_RETURN(handle, MEDIA_HAL_INVALID_PARAM, "input param handle null");
+
+    struct AudioHwCapture *hwCapture = (struct AudioHwCapture *)handle;
+    MEDIA_HAL_LOCK(hwCapture->mutex);
+    if (!hwCapture->started) {
+        MEDIA_HAL_UNLOCK(hwCapture->mutex);
+        AUDIO_FUNC_LOGE("hwCapture not started");
+        return MEDIA_HAL_ERR;
+    }
+    int32_t ret = hwCapture->trackHandle->DisableTrack(hwCapture->trackHandle);
+    if (ret != MEDIA_HAL_OK) {
+        AUDIO_FUNC_LOGE("AudioPortTrack DisableTrack failed: 0x%x", ret);
+    }
+    hwCapture->started = false;
+    MEDIA_HAL_UNLOCK(hwCapture->mutex);
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioCapturePause(struct IAudioCapture *handle)
+{
+    CHK_NULL_RETURN(handle, MEDIA_HAL_INVALID_PARAM, "input param handle null");
+
+    struct AudioHwCapture *hwCapture = (struct AudioHwCapture *)handle;
+    MEDIA_HAL_LOCK(hwCapture->mutex);
+    if (!hwCapture->started) {
+        AUDIO_FUNC_LOGE("AudioCapturePause, not started");
+        MEDIA_HAL_UNLOCK(hwCapture->mutex);
+        return MEDIA_HAL_ERR;
+    }
+    if (hwCapture->paused) {
+        AUDIO_FUNC_LOGE("AudioCapturePause, current paused");
+        MEDIA_HAL_UNLOCK(hwCapture->mutex);
+        return MEDIA_HAL_OK;
+    }
+    hwCapture->paused = true;
+    MEDIA_HAL_UNLOCK(hwCapture->mutex);
+
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioCaptureResume(struct IAudioCapture *handle)
+{
+    CHK_NULL_RETURN(handle, MEDIA_HAL_INVALID_PARAM, "input param handle null");
+
+    struct AudioHwCapture *hwCapture = (struct AudioHwCapture *)handle;
+    MEDIA_HAL_LOCK(hwCapture->mutex);
+    if (!hwCapture->started) {
+        AUDIO_FUNC_LOGE("AudioCaptureResume, not started");
+        MEDIA_HAL_UNLOCK(hwCapture->mutex);
+        return MEDIA_HAL_ERR;
+    }
+    if (!hwCapture->paused) {
+        AUDIO_FUNC_LOGE("AudioCaptureResume, not paused");
+        MEDIA_HAL_UNLOCK(hwCapture->mutex);
+        return MEDIA_HAL_OK;
+    }
+    hwCapture->paused = false;
+    MEDIA_HAL_UNLOCK(hwCapture->mutex);
+
+    return MEDIA_HAL_OK;
+}
+
+int32_t AudioCaptureFlush(struct IAudioCapture *handle)
+{
+    CHK_NULL_RETURN(handle, MEDIA_HAL_INVALID_PARAM, "input param handle null");
+
+    MEDIA_HAL_UNUSED(handle);
