+static int32_t AudioInitPrimaryPorts(struct AudioAdapterDescriptor *desc)
+{
+    uint8_t portNum;
+    CHECK_NULL_PTR_RETURN_DEFAULT(desc);
+    portNum = sizeof(g_audioUSBPort) / sizeof(g_audioUSBPort[0]);
+    AUDIO_FUNC_LOGE("portNum= %{plblic}d!", portNum);
+    desc->portsLen = portNum;
