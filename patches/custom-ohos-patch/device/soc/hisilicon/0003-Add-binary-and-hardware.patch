+ * Description: keystone module
+ * Author: GPU group
+ * Create: 2020.06.04
+ */
+
+#ifndef HI_GPU_COMMON_H
+#define HI_GPU_COMMON_H
+
+#include <stdbool.h>
+
+#define MAX_PLANES 3
+
+typedef enum {
+    HI_LAYOUT_LINEAR,
+    HI_LAYOUT_TILE,
+    HI_LAYOUT_AFBC,
+    HI_LAYOUT_HFBC,
+} hi_layout;
+
+typedef struct {
+    int x;
+    int y;
+} hi_point_2d;
+
+typedef struct {
+    int x;
+    int y;
+    int z;
+} hi_point_3d;
+
+typedef struct {
+    int x;
+    int y;
+    unsigned int width;
+    unsigned int height;
+} hi_gpu_rect;
+
+struct attr_afbc {
+    unsigned int header_size;
+    unsigned int header_stride;
+    unsigned int use_yuv_transform;
+    unsigned int use_sparse_alloc;
+    unsigned int disp_width;    /* display width for yuv format */
+    unsigned int disp_height;   /* display height for yuv format */
+}__attribute__((packed));
+
+struct attr_hfbc {
+    unsigned int align_width;
+    unsigned int align_height;
+    unsigned int bit_depth;
+    unsigned int luma_stride;
+
+    unsigned int luma_header_offset;
+    unsigned int luma_data_offset;
+
+    unsigned int chroma_header_offset;
+    unsigned int chroma_data_offset;
+
+    unsigned int luma_data2_offset;    /* for 10bit, luma data address for part2 if exist */
+    unsigned int chroma_data2_offset;  /* for 10bit, chroma data address for part2 if exist */
+}__attribute__((packed));
+
+typedef struct {
+    unsigned int stride;
+    unsigned int size;
+    unsigned int offset;
+} hi_color_plane;
+
+typedef struct {
+    int width;  /* real width */
+    int height; /* real height */
+    int drm_format;
+    int color_space;
+    int color_range;
+    bool protected;
+    hi_layout layout;
+    unsigned long long handle[MAX_PLANES]; /* only 0 valid for ARGB format */
+
+    union {
+        hi_color_plane planes[MAX_PLANES]; /* Linear */
+        struct attr_afbc afbc;   /* afbc */
+        struct attr_hfbc hfbc;   /* hfbc or tile */
+    };
+} hi_color_buffer;
+
+#endif
