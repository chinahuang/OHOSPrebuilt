+static int32_t CreateTrackProcess(SubPortOutContext *portOutCtx, SubPortTrackOutContext *portTrackOutCtx)
+{
+    int32_t ret = TinyAlsaOpen(portTrackOutCtx, &portTrackOutCtx->inputAttr);
+    if (ret != MEDIA_HAL_OK) {
+        AUDIO_FUNC_LOGE("TinyAlsaOpen failed");
+    }
+    return ret;
+}
+
+int32_t AudioUsbSubPortOutCreateTrack(AudioHandle portHandle, const struct PortPluginAttr *inputAttr,
+    AudioHandle *trackHandle)
+{
+    SubPortOutContext *portOutCtx = (SubPortOutContext *)portHandle;
+
+    int32_t sndTrackId = SubPortTrackOutManagerGetFreeTrack();
+    CHK_COND_RETURN(sndTrackId == INVALID_ID, MEDIA_HAL_INVALID_PARAM, "no free sound track");
+
+    int32_t ret;
+    SubPortTrackOutContext *portTrackOutCtx = (SubPortTrackOutContext *)malloc(sizeof(SubPortTrackOutContext));
+    if (portTrackOutCtx == NULL) {
+        AUDIO_FUNC_LOGI("malloc failed");
+        ret = MEDIA_HAL_NO_MEM;
+        goto FREE_TRACK;
+    }
+
+    if (memset_s(portTrackOutCtx, sizeof(SubPortTrackOutContext), 0, sizeof(SubPortTrackOutContext)) != EOK) {
+        AUDIO_FUNC_LOGE("memset_s failed");
+        ret = MEDIA_HAL_ERR;
+        goto FREE_TRACK_CTX;
+    }
+
+    ret = SubPortTrackOutInit(portTrackOutCtx, inputAttr);
+    if (ret != MEDIA_HAL_OK) {
+        AUDIO_FUNC_LOGE("SubPortTrackOutInit failed");
+        goto FREE_TRACK_CTX;
+    }
+
+    if (CreateTrackProcess(portOutCtx, portTrackOutCtx) != MEDIA_HAL_OK) {
+        ret = MEDIA_HAL_ERR;
+        goto FREE_TRACK_CTX;
+    }
+
+    portTrackOutCtx->sndTrackId = sndTrackId;
+    if (!portTrackOutCtx->inputAttr.interleaved) {
+        portTrackOutCtx->bufferSize = MAX_PERIOD_SIZE * 0x4; /* stero and 16bit */
+        portTrackOutCtx->bufferSwap = (uint8_t *)malloc(portTrackOutCtx->bufferSize);
+        if (portTrackOutCtx->bufferSwap == NULL) {
+            ret = MEDIA_HAL_NO_MEM;
+            goto FREE_TRACK_CTX;
+        }
+    }
+
+    portOutCtx->portTrack[sndTrackId] = portTrackOutCtx;
+    *trackHandle = &portTrackOutCtx->common;
+
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+
+FREE_TRACK_CTX:
+    free(portTrackOutCtx);
+FREE_TRACK:
+    (void)SubPortTrackOutManagerFreeTrack(sndTrackId);
+    return ret;
+}
+
+static bool UsbPortIsValidTrack(SubPortOutContext *portOutCtx, SubPortTrackOutContext *portTrackOutCtx)
+{
+    for (int32_t i = 0; i < AO_DEV_MAX_TRACK_NUM; i++) {
+        if (portOutCtx->portTrack[i] == portTrackOutCtx) {
+            return true;
+        }
+    }
+    return false;
+}
+
+int32_t AudioUsbSubPortOutDestroyTrack(AudioHandle portHandle, AudioHandle trackHandle)
+{
+    SubPortOutContext *portOutCtx = (SubPortOutContext *)portHandle;
+    SubPortTrackOutContext *portTrackOutCtx = (SubPortTrackOutContext *)trackHandle;
+
+    bool isValid = UsbPortIsValidTrack(portOutCtx, portTrackOutCtx);
+    CHK_FAILED_RETURN(isValid, true, MEDIA_HAL_INVALID_PARAM, "track is invalid");
+
+    int32_t ret;
+    PcmClose(portTrackOutCtx->pcm);
+    MixerClose(portTrackOutCtx->mixer);
+
+    ret = SubPortTrackOutManagerFreeTrack(portTrackOutCtx->sndTrackId);
+    CHK_FAILED_NO_RETURN(ret, MEDIA_HAL_OK, "SubPortTrackOutManagerFreeTrack failed");
+    pthread_mutex_destroy(&portTrackOutCtx->stateLock);
+#ifdef DUMPFILE
+    if (portTrackOutCtx->pfd != NULL) {
+        (void)fflush(portTrackOutCtx->pfd);
+        fclose(portTrackOutCtx->pfd);
+        portTrackOutCtx->pfd = NULL;
+    }
+#endif // DUMPFILE
+    if (portTrackOutCtx->bufferSwap != NULL) {
+        free(portTrackOutCtx->bufferSwap);
+        portTrackOutCtx->bufferSwap = NULL;
+    }
+
+    free(portTrackOutCtx);
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+#ifdef __cplusplus
+#if __cplusplus
+}
+#endif
+#endif
