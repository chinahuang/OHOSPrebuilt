diff --git a/common/hardware/virtual_keypad/key_pars/key_pars.cpp b/common/hardware/virtual_keypad/key_pars/key_pars.cpp
new file mode 100644
index 0000000..43e4f37
--- /dev/null
+++ b/common/hardware/virtual_keypad/key_pars/key_pars.cpp
@@ -0,0 +1,234 @@
+/*
+ * Copyright (c) Huawei Technologies Co., Ltd. 2012-2019. All rights reserved.
+ * Description: parse key for virtualkeypad
+ * Author: hisilicon
+ * Create: 2012-01-01
+ */
+
+#include "key_pars.h"
+#include <cstdlib>
+#include <string>
+#include <unistd.h>
+#include <securec.h>
+#include <parameters.h>
+#include "libxml/parser.h"
+#include "CustUtils.h"
+
+using namespace std;
+
+const string KEY_XML_PATH = "system/etc/key_pad.xml";
+
+bool IsNodeLegal(const xmlNodePtr nodePtr, const std::string &tagName)
+{
+    return nodePtr != nullptr && nodePtr->type != XML_COMMENT_NODE && nodePtr->name != nullptr &&
+           xmlStrEqual(nodePtr->name, BAD_CAST(tagName.c_str())) != 0;
+}
+
+std::string GetProp(const xmlNodePtr &nodePtr, const std::string &key)
+{
+    xmlChar *prop = xmlGetProp(nodePtr, BAD_CAST(key.c_str()));
+    if (prop == nullptr) {
+        return "";
+    }
+    std::string value = reinterpret_cast<char *>(prop);
+    xmlFree(prop);
+    return value;
+}
+
+xmlNodePtr GetNodeByName(xmlNodePtr nodePtr, const std::string &name)
+{
+    for (; nodePtr != nullptr; nodePtr = nodePtr->next) {
+        if (nodePtr->type == XML_ELEMENT_NODE && nodePtr->name != nullptr) {
+            if (xmlStrEqual(nodePtr->name, BAD_CAST(name.c_str())) != 0) {
+                return nodePtr;
+            }
+        }
+    }
+
+    return nullptr;
+}
+
+xmlDocPtr ReadXml(const char fileName[], xmlNodePtr &nodeptr)
+{
+    xmlDocPtr docEntry = nullptr;
+    xmlNodePtr rootNode = nullptr;
+    // format xml
+    xmlKeepBlanksDefault(0);
+
+    docEntry = xmlReadFile(fileName, nullptr, XML_PARSE_RECOVER);
+    if (docEntry == nullptr) {
+        VIRTUALKEY_LOG("Document xml read failed. \n");
+        return nullptr;
+    }
+
+    rootNode = xmlDocGetRootElement(docEntry);
+    /* check root node is null */
+    if (rootNode == nullptr) {
+        VIRTUALKEY_LOG("empty document, not root node \n");
+        xmlFreeDoc(docEntry);
+        return nullptr;
+    }
+
+    if (rootNode->name == nullptr) {
+        xmlFreeDoc(docEntry);
+        return nullptr;
+    }
+
+    if (xmlStrcmp(rootNode->name, BAD_CAST "key_pad_xml")) {
+        VIRTUALKEY_LOG("document of the wrong type, root node != key_pad_xml\n");
+        xmlFreeDoc(docEntry);
+        return nullptr;
+    }
+    nodeptr = rootNode;
+    return docEntry;
+}
+
+void SetKeyArray(const xmlNodePtr &xmlChildNodePtr, int &keynum, KeyArry &keyarry)
+{
+    if (xmlChildNodePtr->name == nullptr) {
+        return;
+    }
+    const int base = 16;
+    if (IsNodeLegal(xmlChildNodePtr, "enable")) {
+        std::string enable = GetProp(xmlChildNodePtr, "value");
+        keyarry.bEnable = strtoul(enable.c_str() ? enable.c_str() : "0", nullptr, base);
+    } else if (IsNodeLegal(xmlChildNodePtr, "channel_id")) {
+        std::string channelId = GetProp(xmlChildNodePtr, "value");
+        keyarry.u8ChannelID = strtoul(channelId.c_str() ? channelId.c_str() : "0", nullptr, base);
+    } else if (IsNodeLegal(xmlChildNodePtr, "KeyLevelNum")) {
+        std::string keyLevelNum = GetProp(xmlChildNodePtr, "value");
+        keyarry.u8KeyLevelNum = strtoul(keyLevelNum.c_str() ? keyLevelNum.c_str() : "0", nullptr, base);
+    } else if (IsNodeLegal(xmlChildNodePtr, "key_pad")) {
+        std::string keyThreshold = GetProp(xmlChildNodePtr, "KeyThreshold");
+        keyarry.u8KeyThreshold[keynum] = strtoul(keyThreshold.c_str() ? keyThreshold.c_str() : "0", nullptr, base);
+        std::string keyCode = GetProp(xmlChildNodePtr, "KeyCode");
+        keyarry.u32KeyCode[keynum] = (hi_u32)strtoull(keyCode.c_str() ? keyCode.c_str() : "0", nullptr, base);
+
+        keynum++;
+    }
+}
+
+void ParsKey(xmlNodePtr &nodePtr, KeyArry &keyarry)
+{
+    int keynum = 0;
+    xmlNodePtr xmlChildNodePtr = nullptr;
+    xmlChildNodePtr = nodePtr->xmlChildrenNode;
+    while (xmlChildNodePtr != nullptr) {
+        if (xmlChildNodePtr->type != XML_COMMENT_NODE) {
+            SetKeyArray(xmlChildNodePtr, keynum, keyarry);
+        }
+
+        xmlChildNodePtr = xmlChildNodePtr->next;
+    }
+}
+
+void GetKeyCfgPath(char* path)
+{
+    std::string hardware = OHOS::system::GetParameter("ohos.boot.hardware", "");
+    size_t pos = hardware.find('_');
+    if (pos != std::string::npos) {
+        std::string vendorName = hardware.substr(pos + 1);
+        snprintf_s(path, MAX_PATH_LEN,MAX_PATH_LEN - 1, "%s_%s.xml", "system/etc/key_pad", vendorName.c_str());
+    } else {
+        snprintf_s(path, MAX_PATH_LEN,MAX_PATH_LEN - 1, "%s.xml", "system/etc/key_pad");
+    }
+}
+
+void GetBoardKeyPad(KeyArry keyarry[], int keyArryNum)
+{
+    xmlNodePtr xmlRootNodePtr = nullptr;
+    xmlNodePtr nodePtr = nullptr;
+    char path[MAX_PATH_LEN] = {0};
+    char tmpPath[MAX_PATH_LEN] = {0};
+
+    GetKeyCfgPath(path);
+    const char *oneFile = cust_get_one_cfg_file(path, CUST_TYPE_CONFIG, tmpPath, MAX_PATH_LEN);
+    if (oneFile == nullptr) {
+        VIRTUALKEY_LOG("can't find the cfg file\n");
+        return;
+    }
+    xmlDocPtr docEntry = ReadXml(oneFile, xmlRootNodePtr);
+    const int maxKeypadCh = 3;
+    if (docEntry == nullptr || keyArryNum > maxKeypadCh) {
+        VIRTUALKEY_LOG("Document parsed failed. \n");
+        return;
+    }
+    nodePtr = xmlRootNodePtr->xmlChildrenNode;
+    for (int i = 0; i < keyArryNum; i++) {
+        if (nodePtr == nullptr || keyarry == nullptr) {
+            return;
+        }
+        if (IsNodeLegal(nodePtr, "gpio")) {
+            // ignore gpio config
+            nodePtr = nodePtr->next;
+            continue;
+        }
+
+        VIRTUALKEY_LOG("GetBoardKeyPad nodePtr=%s, i = %d\n", nodePtr->name, i);
+        ParsKey(nodePtr, keyarry[i]);
+        VIRTUALKEY_LOG("parsKey i = %d, enable=0x%x, channel=0x%x\n", i, keyarry[i].bEnable, keyarry[i].u8ChannelID);
+
+        nodePtr = nodePtr->next;
+    }
+}
+
+void SetGpio(const xmlNodePtr &xmlChildNodePtr, int &keynum, GpioKeyArry &gpio)
+{
+    if (xmlChildNodePtr->name == nullptr) {
+        return;
+    }
+
+    const int base = 10;
+    const char *pchar = nullptr;
+
+    if (IsNodeLegal(xmlChildNodePtr, "enable")) {
+        std::string enable = GetProp(xmlChildNodePtr, "value");
+        gpio.bEnable = strtoul(enable.c_str() ? enable.c_str() : "0", nullptr, base);
+    } else if (IsNodeLegal(xmlChildNodePtr, "KeyLevelNum")) {
+        std::string keyLevelNum = GetProp(xmlChildNodePtr, "value");
+        gpio.u8KeyLevelNum = strtoul(keyLevelNum.c_str() ? keyLevelNum.c_str() : "0", nullptr, base);
+    } else if (IsNodeLegal(xmlChildNodePtr, "key_pad")) {
+        if ((keynum > GPIO_MAX_NUM - 1) || (keynum > gpio.u8KeyLevelNum - 1)) {
+            return;
+        }
+        std::string groupNum = GetProp(xmlChildNodePtr, "GroupNum");
+        gpio.u8GroupNum[keynum] = strtoul(groupNum.c_str() ? groupNum.c_str() : "0", nullptr, base);
+        std::string pinNum = GetProp(xmlChildNodePtr, "PinNum");
+        gpio.u8PinNum[keynum] = strtoul(pinNum.c_str() ? pinNum.c_str() : "0", nullptr, base);
+        std::string keyCode = GetProp(xmlChildNodePtr, "KeyCode");
+        gpio.u32KeyCode[keynum] = (hi_u32)strtoull(keyCode.c_str() ? keyCode.c_str() : "0", nullptr, base);
+        keynum++;
+    }
+}
+
+void GetGpioKeyPad(GpioKeyArry &gpio)
+{
+    xmlNodePtr rootNode = nullptr;
+    xmlNodePtr childNode = nullptr;
+
+    char tmpPath[MAX_PATH_LEN] = {0};
+    const char *oneFile = cust_get_one_cfg_file(KEY_XML_PATH.c_str(), CUST_TYPE_CONFIG, tmpPath, MAX_PATH_LEN);
+
+    xmlDocPtr docEntry = ReadXml(oneFile, rootNode);
+    if (docEntry == nullptr) {
+        VIRTUALKEY_LOG("Document parsed failed. \n");
+        return;
+    }
+
+    childNode = rootNode->xmlChildrenNode;
+
+    if (childNode != nullptr) {
+        xmlNodePtr nodePtr = GetNodeByName(childNode, "gpio");
+        if (nodePtr != nullptr) {
+            int keynum = 0;
+            xmlNodePtr xmlChildNodePtr = nodePtr->xmlChildrenNode;
+            while (xmlChildNodePtr != nullptr) {
+                SetGpio(xmlChildNodePtr, keynum, gpio);
+                xmlChildNodePtr = xmlChildNodePtr->next;
+            }
+        }
+    }
+
+    xmlFreeDoc(docEntry);
+    return;
+}
