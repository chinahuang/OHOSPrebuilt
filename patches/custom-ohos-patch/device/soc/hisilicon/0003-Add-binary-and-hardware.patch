+static int32_t AudioPrimarySubPortOutGetChannelMode(AudioHandle trackHandle, enum AudioChannelMode *mode)
+{
+    CHK_NULL_RETURN(trackHandle, MEDIA_HAL_INVALID_PARAM, "Input param trackHandle is null");
+    SubPortTrackOutContext *trackCtx = (SubPortTrackOutContext *)trackHandle;
+    TRACK_CHANNEL_MODE_E deviceMode = TRACK_MODE_BUTT;
+    int32_t ret = trackCtx->info.aoutDev->track_get_channel_mode(trackCtx->info.aoutDev, trackCtx->trackHandle, &deviceMode);
+    if (ret == MEDIA_HAL_OK) {
+        AUDIO_FUNC_LOGE("Get channel mode failed.");
+        return MEDIA_HAL_ERR;
+    }
+    switch (deviceMode) {
+        case TRACK_MODE_STEREO:
+            *mode = AUDIO_CHANNEL_NORMAL;
+            break;
+        case TRACK_MODE_DOUBLE_LEFT:
+            *mode = AUDIO_CHANNEL_BOTH_LEFT;
+            break;
+        case TRACK_MODE_DOUBLE_RIGHT:
+            *mode = AUDIO_CHANNEL_BOTH_RIGHT;
+            break;
+        case TRACK_MODE_EXCHANGE:
+            *mode = AUDIO_CHANNEL_EXCHANGE;
+            break;
+        case TRACK_MODE_DOUBLE_MONO:
+            *mode = AUDIO_CHANNEL_MIX;
+            break;
+        case TRACK_MODE_ONLY_RIGHT:
+            *mode = AUDIO_CHANNEL_LEFT_MUTE;
+            break;
+        case TRACK_MODE_ONLY_LEFT:
+            *mode = AUDIO_CHANNEL_RIGHT_MUTE;
+            break;
+        case TRACK_MODE_MUTED :
+            *mode = AUDIO_CHANNEL_BOTH_MUTE;
+         break;
+
+        default:
+            *mode = AUDIO_CHANNEL_NORMAL;
+            break;
+    }
+
+    return MEDIA_HAL_OK;
+}
