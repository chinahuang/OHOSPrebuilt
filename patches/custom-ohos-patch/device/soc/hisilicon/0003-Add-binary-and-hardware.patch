+    CHK_FAILED_RETURN(priPortCtx->isOpened, true, MEDIA_HAL_ERR, "port not open");
+    CHK_NULL_RETURN(volume, MEDIA_HAL_ERR, "volume null");
+
+    *volume = priPortCtx->volume;
+
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
