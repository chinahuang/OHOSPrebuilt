+static void ProcessCmdResume(SampleMember *member, char *cmd)
+{
+    SampleAudio *audio = &(member->audio);
+    if (audio == NULL) {
+        return;
+    }
+
+    pthread_mutex_lock(&member->dataMutex);
+    if (member->isPlaying) {
+        pthread_mutex_unlock(&member->dataMutex);
+        return;
+    }
+    pthread_mutex_unlock(&member->dataMutex);
+
+    int32_t ret = audio->render->Resume(audio->render);
+    if (ret == 0) {
+        pthread_mutex_lock(&member->dataMutex);
+        member->isPlaying = true;
+        pthread_cond_signal(&member->dataCond);
+        pthread_mutex_unlock(&member->dataMutex);
+    }
