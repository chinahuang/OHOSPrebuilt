diff --git a/common/hardware/ir_user/vinput_interface/ohos_vinput_inter.cpp b/common/hardware/ir_user/vinput_interface/ohos_vinput_inter.cpp
new file mode 100644
index 0000000..8ac8ee4
--- /dev/null
+++ b/common/hardware/ir_user/vinput_interface/ohos_vinput_inter.cpp
@@ -0,0 +1,91 @@
+/*
+ * Copyright (c) Huawei Technologies Co., Ltd. 2012-2019. All rights reserved.
+ * Description: parse key for virtualkeypad
+ * Author: hisilicon
+ * Create: 2012-01-01
+ */
+
+#include "ohos_vinput_inter.h"
+#include <fcntl.h>
+#include <malloc.h>
+#include <pthread.h>
+#include <semaphore.h>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+#include "hi_drv_vinput.h"
+
+using namespace std;
+
+#define VINPUT_LOG(fmt...) printf(fmt)
+const int MOUSEDATA_ARRAY_SIZE = 4;
+
+const string VINPUT_FILE = "/dev/vinput";
+static int g_sFdVinput = -1;
+
+int HiVinputInit()
+{
+    g_sFdVinput = open(VINPUT_FILE.c_str(), O_RDONLY);
+    if (g_sFdVinput < 0) {
+        VINPUT_LOG("can't open Vinput,%s\n", VINPUT_FILE.c_str());
+        return -1;
+    }
+
+    return g_sFdVinput;
+}
+
+int ReportKeyEvent(int iKeyValue, int iStatus)
+{
+    int ret;
+    int mousedata[MOUSEDATA_ARRAY_SIZE] = {iKeyValue, iStatus, 0, 0};
+
+    if (g_sFdVinput < 0) {
+        VINPUT_LOG("Vinput not init\n");
+        return -1;
+    }
+
+    ret = ioctl(g_sFdVinput, IOCTK_KBD_STATUS, reinterpret_cast<void *>(mousedata));
+    if (ret < 0) {
+        VINPUT_LOG("ioctl failed");
+    }
+    return 0;
+}
+
+int ReportMouseState(int key, int dx, int dy)
+{
+    int ret;
+    int mousedata[MOUSEDATA_ARRAY_SIZE] = {key, dx, dy, 0};
+
+    if (g_sFdVinput < 0) {
+        VINPUT_LOG("key Vinput not init\n");
+        return -1;
+    }
+
+    ret = ioctl(g_sFdVinput, IOCTL_MOUSE_STATUS, reinterpret_cast<void *>(mousedata));
+    if (ret < 0) {
+        VINPUT_LOG("ioctl failed");
+    }
+    return 0;
+}
+
+int ReportMouseScrollState(int scroll)
+{
+    int ret;
+    int mousedata[MOUSEDATA_ARRAY_SIZE] = {0, 0, 0, scroll};
+
+    if (g_sFdVinput < 0) {
+        VINPUT_LOG("key Vinput not init\n");
+        return -1;
+    }
+
+    ret = ioctl(g_sFdVinput, IOCTL_MOUSE_STATUS, reinterpret_cast<void *>(mousedata));
+    if (ret < 0) {
+        VINPUT_LOG("ioctl failed");
+    }
+    return 0;
+}
+
