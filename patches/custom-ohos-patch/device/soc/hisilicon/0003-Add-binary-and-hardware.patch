+
+static inline bool IsValidChar(char ch)
+{
+    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9');
+}
+
+static char *RemoveCmdSpace(char *cmd)
+{
+    size_t len = strlen(cmd);
+    if (len == 0) {
+        return NULL;
+    }
+
+    char *valid = NULL;
+    for (size_t i = 0; i < len; i++) {
+        if (IsValidChar(cmd[i])) {
+            valid = &(cmd[i]);
+            break;
+        }
+    }
+
+    if (valid == NULL || strlen(valid) == 0) {
+        return NULL;
+    }
+
+    for (int32_t i = strlen(valid) - 1; i >= 0; i--) {
+        if (IsValidChar(valid[i])) {
+            break;
+        } else {
+            valid[i] = '\0';
+        }
+    }
+
+    return strlen(valid) == 0 ? NULL : valid;
+}
+
+static void ProcessCmd(SampleMember *member, char *cmd)
+{
+    if (cmd == NULL || strlen(cmd) == 0 || member->threadRun != 1 || member->audio.render == NULL) {
+        return;
+    }
+
+    size_t cnt = sizeof(g_cmdParam) / sizeof(g_cmdParam[0]);
+    size_t i;
+    for (i = 0; i < cnt; i++) {
+        if (strncasecmp(g_cmdParam[i].keyTag, cmd, strlen(g_cmdParam[i].keyTag)) == 0) {
+            g_cmdParam[i].handle(member, cmd);
+            break;
+        }
+    }
+
+    if (i >= cnt) {
+        SAMPLE_LOG("not support cmd:[%s], enter \"help\" for more.", cmd);
+    }
+}
+
+static void SampleCmd(SampleMember *member)
+{
+    SAMPLE_LOG("\ninput q to quit!");
+    char cmd[CMD_LENGTH] = { 0 };
+    while (1) {
+        if (fgets(cmd, sizeof(cmd) - 1, stdin) == NULL) {
+            SAMPLE_LOG("fgets cmd fail");
+        }
+        if (strncasecmp(cmd, "q", strlen("q")) == 0) {
+            member->threadRun = 0;
+            pthread_mutex_lock(&member->dataMutex);
+            pthread_cond_signal(&member->dataCond);
+            pthread_mutex_unlock(&member->dataMutex);
+            break;
+        }
+
+        char *valid = RemoveCmdSpace(cmd);
+        if (valid != NULL) {
+            ProcessCmd(member, valid);
+        }
+
+        if (memset_s(cmd, sizeof(cmd), 0, sizeof(cmd)) != EOK) {
+            SAMPLE_LOG("memset cmd fail\n");
+        }
+    }
+}
+
+int main(int argc, char *argv[])
+{
+    SAMPLE_LOG("enter sample audio");
+    if (argc < 0x5) {
+        SAMPLE_LOG("useage:%s fileUrl sampleRate bitWidth channelCnt \n", argv[0]);
+        SAMPLE_LOG("    eg:%s /data/media/16kHz_16bit_mono_1024pointNum.pcm 16000 16 1\n", argv[0]);
+        return -1;
+    }
+    SampleMember member = { 0 };
+    member.fileName = strdup(argv[1]);
+    if (member.fileName == NULL) {
+        SAMPLE_LOG("strdup file name fail");
+        return -1;
+    }
+    member.pcmFormat.sampleRate = atoi(argv[ARGV_2]);
+    member.pcmFormat.bitDepth = atoi(argv[ARGV_3]);
+    member.pcmFormat.channelCnt = atoi(argv[ARGV_4]);
+    member.pcmFormat.interleaved = true;
+    pthread_mutex_init(&member.dataMutex, NULL);
+    pthread_cond_init(&member.dataCond, NULL);
+    if (argc > 0x5) {
+        member.pcmFormat.interleaved = (atoi(argv[ARGV_5]) != 0);
+    }
+
+    if (pthread_create(&(member.threadId), NULL, AudioRenderThread, &member) != 0) {
+        member.threadId = 0;
+        SAMPLE_LOG("create thread fail");
+    } else {
+        SampleCmd(&member);
+    }
+
+    if (member.threadId != 0) {
+        pthread_join(member.threadId, NULL);
+    }
+    pthread_mutex_destroy(&member.dataMutex);
+    pthread_cond_destroy(&member.dataCond);
+    free(member.fileName);
+    return 0;
+}
