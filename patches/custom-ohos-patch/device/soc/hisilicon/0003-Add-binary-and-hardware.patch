+﻿/*
+* Copyright (c) CompanyNameMagicTag. 2021-2021. All rights reserved.
+* Description: Audio plugins manager
+* Author: Media Software Group
+* Create: 2021-07-21
+*/
+
+#include <sys/time.h>
+#include <sys/types.h>
+#include <unistd.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <string.h>
+#include "securec.h"
+#include "media_hal_common.h"
+#include "list.h"
+#include "audio_plugins_manager.h"
+#include "osal_mem.h"
+#include "audio_uhdf_log.h"
+
+
+#ifdef __cplusplus
+#if __cplusplus
+extern "C" {
+#endif
+#endif /* End of #ifdef __cplusplus */
+
+#define MODULE_NAME "AudioPluginManager"
+
+#ifdef ENABLE_DL_AUDIO_PLUGIN
+#define AUDIO_PORT_PLUGIN_FUNCS "GetPortPluginFuncs"
+
+#ifdef ARM64
+#define PRIMARY_PORT_PLUGIN_LIB_PATH "/vendor/lib64/libaudio_primary_port.z.so"
+#define USB_PORT_PLUGIN_LIB_PATH "/vendor/lib64/libaudio_usb_port.z.so"
+#define BLUETOOTH_PORT_PLUGIN_LIB_PATH "/vendor/lib64/libaudio_bluetooth_port.z.so"
+#else
+#define PRIMARY_PORT_PLUGIN_LIB_PATH "/vendor/lib/libaudio_primary_port.z.so"
+#define USB_PORT_PLUGIN_LIB_PATH "/vendor/lib/libaudio_usb_port.z.so"
+#define BLUETOOTH_PORT_PLUGIN_LIB_PATH "/vendor/lib/libaudio_bluetooth_port.z.so"
+#endif
+
+#endif
+
+typedef struct {
+    AudioPluginType audioPluginType;
+    uintptr_t pluginHandle;
+#ifdef ENABLE_DL_AUDIO_PLUGIN
+    void *pluginDlHandle;
+#endif
+} AudioPlugin;
+
+typedef struct {
+    bool inited;
+    pthread_mutex_t mutex;
+    List plugins;
+} AudioPluginsManager;
+
+static AudioPluginsManager g_audioPluginsManager = {
+    .inited = false,
+    .mutex = PTHREAD_MUTEX_INITIALIZER,
+};
+
+static int32_t CheckPortPlugin(const AudioPortPlugin *plugin)
+{
+    CHK_NULL_RETURN(plugin->GetPortPluginCapability, MEDIA_HAL_INVALID_PARAM,
+        "port plugin GetPortPluginCapability() is null");
+    CHK_NULL_RETURN(plugin->Open, MEDIA_HAL_INVALID_PARAM, "port plugin Open() is null");
+    CHK_NULL_RETURN(plugin->CreateTrack, MEDIA_HAL_INVALID_PARAM, "port plugin CreateTrack() is null");
+    CHK_NULL_RETURN(plugin->DestroyTrack, MEDIA_HAL_INVALID_PARAM, "port plugin DestroyTrack() is null");
+    CHK_NULL_RETURN(plugin->Close, MEDIA_HAL_INVALID_PARAM, "port plugin Close() is null");
+    return MEDIA_HAL_OK;
+}
+
+static int32_t ScanAndLoadPlugin(AudioPluginsManager *manager, AudioPluginType type)
+{
+    AudioPlugin plugin = {};
+    plugin.audioPluginType = type;
+    const AudioPortPlugin *pluginImpl = NULL;
+    AUDIO_FUNC_LOGI("Enter");
+    if (type >= AUDIO_PLUGIN_NONE || type < AUDIO_PLUGIN_PRIMARY) {
+        AUDIO_FUNC_LOGE("error type:%{public}d", type);
+        return MEDIA_HAL_ERR;
+    }
+#ifdef ENABLE_DL_AUDIO_PLUGIN
+    AUDIO_FUNC_LOGD("ScanAndLoadPlugin By dlopen");
+    const char *pluginPath[AUDIO_PLUGIN_NONE] = {
+        NULL, PRIMARY_PORT_PLUGIN_LIB_PATH, BLUETOOTH_PORT_PLUGIN_LIB_PATH, USB_PORT_PLUGIN_LIB_PATH
+    };
+
+    plugin.pluginDlHandle = MediaHalDLOpen(pluginPath[type]);
+    if (plugin.pluginDlHandle == NULL) {
+        AUDIO_FUNC_LOGE("not port plugin in path: %s", pluginPath[type]);
+        return MEDIA_HAL_ERR;
+    }
+    GetPortPlugin getPluginFuns = (GetPortPlugin)MediaHalDLSym(plugin.pluginDlHandle, AUDIO_PORT_PLUGIN_FUNCS);
+    if (getPluginFuns == NULL) {
+        MediaHalDLClose(plugin.pluginDlHandle);
+        AUDIO_FUNC_LOGE("not found symbol: %s", AUDIO_PORT_PLUGIN_FUNCS);
+        return MEDIA_HAL_ERR;
+    }
+    pluginImpl = getPluginFuns(type);
+    if (pluginImpl == NULL ||
+        CheckPortPlugin(pluginImpl) != MEDIA_HAL_OK) {
+        AUDIO_FUNC_LOGE("not found valid type[%d] port plugin", type);
+        MediaHalDLClose(plugin.pluginDlHandle);
+        return MEDIA_HAL_ERR;
+    }
+#else
+    AUDIO_FUNC_LOGD("ScanAndLoadPlugin By func");
+    pluginImpl = GetPortPluginFuncs(type);
+    if (pluginImpl == NULL ||
+        CheckPortPlugin(pluginImpl) != MEDIA_HAL_OK) {
+        AUDIO_FUNC_LOGE("not found valid type[%d] port plugin", type);
+        return MEDIA_HAL_ERR;
+    }
+#endif
+    plugin.pluginHandle = (uintptr_t)pluginImpl;
+    if (ListPushFront(&manager->plugins, (uintptr_t)&plugin) != LIST_OK) {
+        AUDIO_FUNC_LOGE("type:%d, port plugin cannot be pushed into the list", type);
+        return MEDIA_HAL_ERR;
+    }
+
+    AUDIO_FUNC_LOGI("type:%{public}d, success", type);
+    return MEDIA_HAL_OK;
+}
+
+static uintptr_t DupPlugin(const AudioPlugin *audioPlugin)
+{
+    AudioPortPlugin *plugin = NULL;
+    plugin = (AudioPortPlugin *)OsalMemCalloc(sizeof(AudioPortPlugin));
+    if (plugin == NULL) {
+        AUDIO_FUNC_LOGE("malloc failed");
+        return 0;
+    }
+    *plugin = *(AudioPortPlugin *)audioPlugin->pluginHandle;
+    return (uintptr_t)plugin;
+}
+
+static uintptr_t PluginListDup(uintptr_t ptr)
+{
+    if (ptr == 0) {
+        return 0;
+    }
+    AudioPlugin *audioPluginSrc = (AudioPlugin *)ptr;
+    AudioPlugin *audioPluginDst = (AudioPlugin *)OsalMemCalloc(sizeof(AudioPlugin));
+    if (audioPluginDst == NULL) {
+        AUDIO_FUNC_LOGE("malloc failed");
+        return 0;
+    }
+    if (memcpy_s(audioPluginDst, sizeof(AudioPlugin), audioPluginSrc,
+                 sizeof(AudioPlugin)) != EOK) {
+        AUDIO_FUNC_LOGE("memcpy_s  failed");
+        OsalMemFree(audioPluginDst);
+        return 0;
+    }
+    audioPluginDst->pluginHandle = DupPlugin(audioPluginSrc);
+    if (audioPluginDst->pluginHandle == 0) {
+        OsalMemFree(audioPluginDst);
+        return 0;
+    }
+    return (uintptr_t)audioPluginDst;
+}
+
+static void FreePlugin(AudioPlugin *audioPlugin)
+{
+    AudioPortPlugin *plugin = (AudioPortPlugin *)audioPlugin->pluginHandle;
+    if (plugin != NULL) {
+        OsalMemFree(plugin);
+        audioPlugin->pluginHandle = 0;
+    }
+}
+
+static void PluginListFree(uintptr_t ptr)
+{
+    if (ptr == 0) {
+        return;
+    }
+    AudioPlugin *audioPlugin = (AudioPlugin *)ptr;
+#ifdef ENABLE_DL_AUDIO_PLUGIN
+    if (audioPlugin->pluginDlHandle != NULL) {
+        MediaHalDLClose(audioPlugin->pluginDlHandle);
+    }
+#endif
+    FreePlugin(audioPlugin);
+    OsalMemFree(audioPlugin);
+}
+
+void AudioPluginManagerInit(void)
+{
+    AUDIO_FUNC_LOGD("Enter");
+    AudioPluginsManager *manager = &g_audioPluginsManager;
+    MEDIA_HAL_LOCK(manager->mutex);
+    if (manager->inited) {
+        MEDIA_HAL_UNLOCK(manager->mutex);
+        return;
+    }
+    DupFreeFuncPair dataFunc;
+    dataFunc.dupFunc = PluginListDup;
+    dataFunc.freeFunc = PluginListFree;
+    MediaHalListInit(&manager->plugins, &dataFunc);
+    if (ScanAndLoadPlugin(manager, AUDIO_PLUGIN_PRIMARY) != MEDIA_HAL_OK) {
+        AUDIO_FUNC_LOGI("ScanAndLoad AUDIO_PLUGIN_PRIMARY failed");
+        goto LOAD_FAILED;
+    }
+    if (ScanAndLoadPlugin(manager, AUDIO_PLUGIN_USB) != MEDIA_HAL_OK) {
+        AUDIO_FUNC_LOGI("ScanAndLoadU AUDIO_PLUGIN_USB failed");
+        goto LOAD_FAILED;
+    }
+#if 0
+    if (ScanAndLoadPlugin(manager, AUDIO_PLUGIN_BLUETOOTH) != MEDIA_HAL_OK) {
+        AUDIO_FUNC_LOGI("ScanAndLoadBluetoothPortPlugin failed");
+    }
+#endif    
+    manager->inited = true;
+    MEDIA_HAL_UNLOCK(manager->mutex);
+    AUDIO_FUNC_LOGD("Exit");
+    return;
+LOAD_FAILED:
+    MediaHalListDeinit(&manager->plugins);
+    MEDIA_HAL_UNLOCK(manager->mutex);
+    return;
+}
+
+const void *AudioPluginManagerGetPlugin(AudioPluginType pluginType)
+{
+    AUDIO_FUNC_LOGD("Enter");
+    AudioPluginsManager *manager = &g_audioPluginsManager;
+    MEDIA_HAL_LOCK(manager->mutex);
+    if (!manager->inited) {
+        MEDIA_HAL_UNLOCK(manager->mutex);
+        return NULL;
+    }
+    List *pluginListHead = &manager->plugins;
+    AUDIO_FUNC_LOGI("get audio plugin type: %d", pluginType);
+    for (ListIterator it = ListIterBegin(pluginListHead); it != ListIterEnd(pluginListHead);
+        it = ListIterNext(pluginListHead, it)) {
+        AudioPlugin *audioPlugin = (AudioPlugin *)ListIterData(it);
+        if (audioPlugin != NULL && audioPlugin->audioPluginType == pluginType) {
+            MEDIA_HAL_UNLOCK(manager->mutex);
+            return (const void *)audioPlugin->pluginHandle;
+        }
+    }
+    AUDIO_FUNC_LOGI("get audio plugin failed: %d", pluginType);
+    MEDIA_HAL_UNLOCK(manager->mutex);
+    return NULL;
+}
+
+void AudioPluginManagerDeInit(void)
+{
+    AudioPluginsManager *manager = &g_audioPluginsManager;
+    MEDIA_HAL_LOCK(manager->mutex);
+    if (!manager->inited) {
+        MEDIA_HAL_UNLOCK(manager->mutex);
+        return;
+    }
+    MediaHalListDeinit(&manager->plugins);
+    manager->inited = false;
+    MEDIA_HAL_UNLOCK(manager->mutex);
+    pthread_mutex_destroy(&manager->mutex);
+    return;
+}
+
+#ifdef __cplusplus
+#if __cplusplus
+}
+#endif
+#endif /* End of #ifdef __cplusplus */
