+typedef struct IAudioManager* (*AudioManagerCreateIfInstanceVendor)(void);
+
+static struct IAudioManager *AudioManagerLoadVendorLib(SampleAudio *audio)
+{
+    char *error = NULL;
+    const char *hdiAudioVendorLibPath = "/vendor/lib/libaudio_primary_impl_vendor.z.so";
+    SAMPLE_LOG("thy audio load path:%s", hdiAudioVendorLibPath);
+
+    audio->handle = dlopen(hdiAudioVendorLibPath, RTLD_LAZY);
+    if (audio->handle == NULL) {
+        error = dlerror();
+        SAMPLE_LOG("audio vdiManager load path%s, dlopen err=%s", hdiAudioVendorLibPath, error);
+        return NULL;
+    }
+
+    (void)dlerror(); // clear existing error
+
+    AudioManagerCreateIfInstanceVendor audioManagerCreateIfInstanceVendor =
+        dlsym(audio->handle, "AudioManagerCreateIfInstance");
+    if (audioManagerCreateIfInstanceVendor == NULL) {
+        error = dlerror();
+        SAMPLE_LOG("dlsym AudioManagerCreateIfInstance err=%", error);
+        dlclose(audio->handle);
+        audio->handle = NULL;
+        return NULL;
+    }
+
+    SAMPLE_LOG("audio AudioManagerCreateIfInstance success");
+    return audioManagerCreateIfInstanceVendor();
+}
