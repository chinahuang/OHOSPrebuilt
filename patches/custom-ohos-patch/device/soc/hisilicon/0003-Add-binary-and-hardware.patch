+#include "securec.h"
+
+#ifdef __cplusplus
+#if __cplusplus
+extern "C" {
+#endif
+#endif /* __cplusplus */
+
+#define MODULE_NAME "AudioPrimaryPort"
+#define AOUT_INVALID_HANDLE     (-1)
+typedef struct {
+    pthread_mutex_t mutex;
+    int32_t count;
+    bool isOpen;
+    AOUT_DEVICE_S *aoutDev;
+    HANDLE aoutHdl;
+} AudioPortManager;
+
+static AudioPortManager g_audioPrimaryPortManager = {
+    .mutex = PTHREAD_MUTEX_INITIALIZER,
+    .count = 0,
+    .isOpen = false,
+    .aoutDev = NULL,
+    .aoutHdl = AOUT_INVALID_HANDLE
+};
+
+int32_t OpenAudioPort(void)
+{
+    int32_t ret;
+    AudioPortManager *manager = &g_audioPrimaryPortManager;
+
+    MEDIA_HAL_LOCK(manager->mutex);
+    if (manager->isOpen) {
+        manager->count++;
+        AUDIO_FUNC_LOGI("audio port manager count:%{public}d", manager->count);
+        MEDIA_HAL_UNLOCK(manager->mutex);
+        return MEDIA_HAL_OK;
+    }
+
+    manager->aoutDev = getAOutDevice();
+    if (manager->aoutDev == NULL) {
+        AUDIO_FUNC_LOGE("getAOutDevice failed");
+        MEDIA_HAL_UNLOCK(manager->mutex);
+        return MEDIA_HAL_ERR;
+    }
+
+    MEDIA_HAL_DOFUNC_TIME(ret = manager->aoutDev->aout_init(NULL, NULL));
+    if (ret != MEDIA_HAL_OK) {
+        AUDIO_FUNC_LOGE("aout_init failed ret  0x%x", ret);
+        MEDIA_HAL_UNLOCK(manager->mutex);
+        return MEDIA_HAL_ERR;
+    }
+
+    AOUT_OPEN_PARAMS_S openParams;
+    openParams.enId = AOUT_ID_0;
+    openParams.stSettings.enOutputDevice = AOUT_DEVICE_ALL;
+    openParams.stSettings.u32Dummy = 0;
+    ret = manager->aoutDev->aout_open(NULL, &manager->aoutHdl, &openParams);
+    if (ret != MEDIA_HAL_OK) {
+        AUDIO_FUNC_LOGE("aout_open failed");
+        (void)manager->aoutDev->aout_term(NULL, NULL);
+        MEDIA_HAL_UNLOCK(manager->mutex);
+        return MEDIA_HAL_ERR;
+    }
+
+    manager->isOpen = true;
+    manager->count++;
+    AUDIO_FUNC_LOGI("audio port manager count:%{public}d", manager->count);
+    MEDIA_HAL_UNLOCK(manager->mutex);
+    return MEDIA_HAL_OK;
+}
+
+static void ResetAudioPortManager(void)
+{
+    AUDIO_FUNC_LOGI("reset Manager");
+    AudioPortManager *manager = &g_audioPrimaryPortManager;
+    manager->isOpen = false;
+    manager->count = 0;
+    manager->aoutDev = NULL;
+    manager->aoutHdl = AOUT_INVALID_HANDLE;
+}
+
+int32_t CloseAudioPort(void)
+{
+    int32_t ret;
+    AudioPortManager *manager = &g_audioPrimaryPortManager;
+
+    MEDIA_HAL_LOCK(manager->mutex);
+    if (!manager->isOpen) {
+        manager->count = 0;
+        MEDIA_HAL_UNLOCK(manager->mutex);
+        return MEDIA_HAL_OK;
+    }
+
+    if (manager->aoutDev == NULL) {
+        AUDIO_FUNC_LOGE("aoutdev null");
+        goto END;
+    }
+
+    if (manager->aoutHdl == AOUT_INVALID_HANDLE) {
+        AUDIO_FUNC_LOGE("aoutdev null");
+        goto END;
+    }
+
+    manager->count--;
+    AUDIO_FUNC_LOGI("audio port manager count:%{public}d", manager->count);
+    if (manager->count > 0) {
+        MEDIA_HAL_UNLOCK(manager->mutex);
+        return MEDIA_HAL_OK;
+    }
+
+    ret = manager->aoutDev->aout_close(NULL, manager->aoutHdl, NULL);
+    if (ret != MEDIA_HAL_OK) {
+        AUDIO_FUNC_LOGE("aout_close failed");
+        (void)manager->aoutDev->aout_term(NULL, NULL);
+        MEDIA_HAL_UNLOCK(manager->mutex);
+        return MEDIA_HAL_ERR;
+    }
+
+    (void)manager->aoutDev->aout_term(NULL, NULL);
+
+END:
+    ResetAudioPortManager();
+    MEDIA_HAL_UNLOCK(manager->mutex);
+    return MEDIA_HAL_OK;
+}
+
+AOUT_DEVICE_S* GetAudioPortDev(void)
+{
+    return g_audioPrimaryPortManager.aoutDev;
+}
+
+HANDLE GetAudioPortHdl(void)
+{
+    return g_audioPrimaryPortManager.aoutHdl;
+}
+
+bool IsRawFormat(enum AudioFormat audioFormat)
+{
+    if (audioFormat == AUDIO_FORMAT_TYPE_PCM_8_BIT || audioFormat == AUDIO_FORMAT_TYPE_PCM_16_BIT ||
+        audioFormat == AUDIO_FORMAT_TYPE_PCM_24_BIT || audioFormat == AUDIO_FORMAT_TYPE_PCM_32_BIT) {
+        return true;
+    }
+    return false;
+}
+
+bool AudioPluginIsValidPin(enum AudioPortPin pin, const char *pluginName)
+{
+    if (strcmp("primary", pluginName) == 0) {
+        if (pin == PIN_OUT_SPEAKER) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
+const AudioPortPlugin *GetPortPluginFuncs(AudioPluginType pluginType)
+{
+    if (pluginType == AUDIO_PLUGIN_PRIMARY) {
+        return GetPrimaryPortPluginFuncs(pluginType);
+    }
+
+    if (pluginType == AUDIO_PLUGIN_USB) {
+        return GetUSBPortPluginFuncs(pluginType);
+    }
+
+    AUDIO_FUNC_LOGE("invalid plugin type %d", pluginType);
+    return NULL;
+}
+
+#ifdef __cplusplus
+#if __cplusplus
+}
+#endif
+#endif /* __cplusplus */
