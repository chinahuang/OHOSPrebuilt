+static uint32_t CheckParam(struct pcm_params *params, uint32_t param, uint32_t value,
+    char *paramName, char *paramUnit)
+{
+    uint32_t min;
+    uint32_t max;
+    uint32_t isWithinBounds = 1;
+
+    min = pcm_params_get_min(params, param);
+    if (value < min) {
+        AUDIO_FUNC_LOGE("%s is %u%s, device only supports >= %u%s", paramName, value,
+            paramUnit, min, paramUnit);
+        isWithinBounds = 0;
+    }
+
+    max = pcm_params_get_max(params, param);
+    if (value > max) {
+        AUDIO_FUNC_LOGE("%s is %u%s, device only supports <= %u%s", paramName, value,
+            paramUnit, max, paramUnit);
+        isWithinBounds = 0;
+    }
+
+    return isWithinBounds;
+}
+
+static int32_t IsPlayable(uint32_t card, uint32_t device, uint32_t channels, uint32_t rate, uint32_t bits,
+    uint32_t period_size, uint32_t period_count)
+{
+    struct pcm_params *params;
+    uint32_t canPlay;
+
+    params = pcm_params_get(card, device, PCM_OUT);
+    if (params == NULL) {
+        AUDIO_FUNC_LOGE("Unable to open PCM device %u.", device);
+        return 0;
+    }
+
+    canPlay = CheckParam(params, PCM_PARAM_RATE, rate, "Sample rate", "Hz");
+    canPlay &= CheckParam(params, PCM_PARAM_CHANNELS, channels, "Sample", " channels");
+    canPlay &= CheckParam(params, PCM_PARAM_SAMPLE_BITS, bits, "Bitrate", " bits");
+    canPlay &= CheckParam(params, PCM_PARAM_PERIOD_SIZE, period_size, "Period size", " frames");
+    canPlay &= CheckParam(params, PCM_PARAM_PERIODS, period_count, "Period count", " periods");
+
+    pcm_params_free(params);
+
+    return (int32_t)canPlay;
+}
+
+static int32_t TinyAlsaOpen(SubPortTrackOutContext *portTrackOutCtx, const struct PortPluginAttr *inputAttr)
+{
+    int32_t cardId = GetAudioRenderCard();
+    if (cardId == -1) {
+        AUDIO_FUNC_LOGE("sound card not ready");
+        return MEDIA_HAL_ERR;
+    }
+
+    struct pcm_config config;
+    enum pcm_format format = PCM_FORMAT_S16_LE;
+    if (inputAttr->bitWidth == PCM_FORMAT_S32_LE_BITWHITCH) {
+        format = PCM_FORMAT_S32_LE;
+    } else if (inputAttr->bitWidth == PCM_FORMAT_S24_3LE_BITWHITCH) {
+        format = PCM_FORMAT_S24_3LE;
+    } else if (inputAttr->bitWidth == PCM_FORMAT_S16_LE_BITWHITCH) {
+        format = PCM_FORMAT_S16_LE;
+    }
+    AudioSndConfigInit(&config, inputAttr->channelCount, (uint32_t)inputAttr->sampleRate, format, false);
+
+    if (!IsPlayable(cardId, 0, config.channels, config.rate, inputAttr->bitWidth,
+        config.period_size, config.period_count)) {
+        AUDIO_FUNC_LOGE("cannot play because the pcm parameter is invalid.");
+        return MEDIA_HAL_INVALID_PARAM;
+    }
+
+    int32_t ret = PcmOpen(cardId, 0, PCM_OUT, &config, &(portTrackOutCtx->pcm));
+    CHK_FAILED_RETURN(ret, MEDIA_HAL_OK, MEDIA_HAL_ERR, "pcm open failed");
+
+    ret = MixerOpen(cardId, &(portTrackOutCtx->mixer));
+    if (ret != MEDIA_HAL_OK) {
+        PcmClose(portTrackOutCtx->pcm);
+        AUDIO_FUNC_LOGE("mixer open failed");
+        return MEDIA_HAL_ERR;
+    }
+
+    portTrackOutCtx->cardId = cardId;
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+}
+
+
+static int32_t AudioUsbSubPortOutFlush(AudioHandle trackHandle)
+{
+    SubPortTrackOutContext *portTrackOutCtx = (SubPortTrackOutContext *)trackHandle;
+    portTrackOutCtx->frames = 0;
+    return MEDIA_HAL_OK;
+}
