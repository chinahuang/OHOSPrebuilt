+int32_t AudioAdapterCreateCapture(struct IAudioAdapter *adapter, const struct AudioDeviceDescriptor *desc,
+    const struct AudioSampleAttributes *attrs, struct IAudioCapture **capture, uint32_t *captureId)
+{
+    int32_t ret;
+
+    AUDIO_FUNC_LOGI("Enter.");
+    bool Valid = AudioManagerIsValidAdapter(adapter);
+    if (Valid != true) {
+        AUDIO_FUNC_LOGE("adapter is invalid");
+        return AUDIO_ERR_INVALID_PARAM;
+    }
+    
+    if (adapter == NULL || desc == NULL || attrs == NULL || capture == NULL || captureId == NULL) {
+        AUDIO_FUNC_LOGE("Input parameters is NULL!");
+        return AUDIO_ERR_INVALID_PARAM;
+    }
+
+    struct AudioHwAdapter *hwAdapter = (struct AudioHwAdapter *)adapter;
+
+    CHK_FAILED_RETURN(AudioAdapterInitAllPorts(adapter), MEDIA_HAL_OK, MEDIA_HAL_ERR, "init failed");
+    uint32_t channelId = AudioAdapterGetFreeChn(adapter, true);
+    if (channelId == INVALID_AUDIO_CHANNEL) {
+         AUDIO_FUNC_LOGE("AudioAdapterGetFreeChn failed");
+        return MEDIA_HAL_NO_MEM;
+    }
+    struct AudioHwCapture *hwCapture = (struct AudioHwCapture *)malloc(sizeof(*hwCapture));
+    if (hwCapture == NULL) {
+         AUDIO_FUNC_LOGE("malloc AudioHwCapture failed");
+        ret = MEDIA_HAL_NO_MEM;
+        goto FREE_CHN;
+    }
+    if (memset_s(hwCapture, sizeof(struct AudioHwCapture), 0, sizeof(struct AudioHwCapture)) != 0) {
+         AUDIO_FUNC_LOGE("memset_s failed");
+    }
+    if (memcpy_s(&hwCapture->deviceDesc, sizeof(struct AudioDeviceDescriptor),
+        desc, sizeof(struct AudioDeviceDescriptor)) != EOK) {
+         AUDIO_FUNC_LOGE("memcpy_s failed");
+    }
+    if (memcpy_s(&hwCapture->attrs, sizeof(struct AudioSampleAttributes),
+        attrs, sizeof(struct AudioSampleAttributes)) != EOK) {
+         AUDIO_FUNC_LOGE("memcpy_s failed");
+    }
+    ret = HwCaptureInit(hwAdapter, channelId, hwCapture);
+    if (ret != MEDIA_HAL_OK || hwCapture->trackHandle == NULL) {
+         AUDIO_FUNC_LOGE("InitHwCapture failed");
+        goto FREE_HWCAPTURE;
+    }
+    *captureId = GetAvailableCaptureID(hwAdapter);
+    if (*captureId == MAX_AUDIO_STREAM_NUM) {
+        AUDIO_FUNC_LOGE("there is no available captureId");
+        goto FREE_HWCAPTURE;
+    }
+    hwAdapter->infos.captureServicePtr[*captureId] = hwCapture;
+
+    *capture = &hwCapture->common;
+    AUDIO_FUNC_LOGI("success");
+    return MEDIA_HAL_OK;
+FREE_HWCAPTURE:
+    OsalMemFree(hwCapture);
+FREE_CHN:
+    (void)AudioAdapterFreeChn(adapter, channelId, true);
+    return ret;
+}
