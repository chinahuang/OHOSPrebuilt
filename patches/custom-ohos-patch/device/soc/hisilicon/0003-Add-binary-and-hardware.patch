+static int32_t AudioPrimarySubPortOutSetChannelMode(AudioHandle trackHandle, enum AudioChannelMode mode)
+{
+    CHK_NULL_RETURN(trackHandle, MEDIA_HAL_INVALID_PARAM, "Input param trackHandle is null");
+    SubPortTrackOutContext *trackCtx = (SubPortTrackOutContext *)trackHandle;
+    TRACK_CHANNEL_MODE_E deviceMode = TRACK_MODE_BUTT;
+    switch (mode) {
+        case AUDIO_CHANNEL_NORMAL:
+            deviceMode = TRACK_MODE_STEREO;
+            break;
+        case AUDIO_CHANNEL_BOTH_LEFT:
+            deviceMode = TRACK_MODE_DOUBLE_LEFT;
+            break;
+        case AUDIO_CHANNEL_BOTH_RIGHT:
+            deviceMode = TRACK_MODE_DOUBLE_RIGHT;
+            break;
+        case AUDIO_CHANNEL_EXCHANGE:
+            deviceMode = TRACK_MODE_EXCHANGE;
+            break;
+        case AUDIO_CHANNEL_MIX:
+            deviceMode = TRACK_MODE_DOUBLE_MONO;
+            break;
+        case AUDIO_CHANNEL_LEFT_MUTE:
+            deviceMode = TRACK_MODE_ONLY_RIGHT;
+            break;
+        case AUDIO_CHANNEL_RIGHT_MUTE:
+            deviceMode = TRACK_MODE_ONLY_LEFT;
+            break;
+        case AUDIO_CHANNEL_BOTH_MUTE:
+            deviceMode = TRACK_MODE_MUTED;
+         break;
+
+        default:
+            deviceMode = TRACK_MODE_BUTT;
+            break;
+    }
+
+    int32_t ret = trackCtx->info.aoutDev->track_set_channel_mode(trackCtx->info.aoutDev, trackCtx->trackHandle, deviceMode);
+    if (ret == MEDIA_HAL_OK) {
+        AUDIO_FUNC_LOGE("set channel mode failed.");
+        return MEDIA_HAL_ERR;
+    }
+
+    return MEDIA_HAL_OK;
+}
