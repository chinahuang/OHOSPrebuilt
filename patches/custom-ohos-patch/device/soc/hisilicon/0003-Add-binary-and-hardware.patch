diff --git a/common/hardware/audio/source/sample/audio_capture_sample.c b/common/hardware/audio/source/sample/audio_capture_sample.c
new file mode 100644
index 0000000..f39a56e
--- /dev/null
+++ b/common/hardware/audio/source/sample/audio_capture_sample.c
@@ -0,0 +1,394 @@
+﻿#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <strings.h>
+#include <string.h>
+#include <pthread.h>
+#include "audio_manager.h"
+#include "securec.h"
+
+#define MAX_ARGC 4
+
+typedef struct {
+    void *frameAddr;
+    uint64_t frameSize;
+    struct AudioManager *audioManager;
+    struct AudioAdapter *audioAdapter;
+    struct AudioCapture *audioCapture;
+    struct AudioRender  *audioRender;
+} CaptureContext;
+
+typedef struct {
+    uint32_t sampleRate;
+    uint32_t bitWidth;
+    uint32_t channelCnt;
+    bool interleaved;
+} PcmFormat;
+
+typedef struct {
+    FILE *pfd;
+    bool isMute;
+    CaptureContext capCtx;
+    PcmFormat pcmFmt;
+    pthread_t threadId;
+    bool threadRunning;
+} SampleContext;
+
+static int LoadAudioAdapter(CaptureContext *capCtx)
+{
+    capCtx->audioManager = GetAudioManagerFuncs();
+    if (capCtx->audioManager == NULL) {
+        printf("%s:%d get audio manager failed\n", __func__, __LINE__);
+        return -1;
+    }
+
+    int size = -1;
+    struct AudioAdapterDescriptor *descs = NULL;
+    int ret = capCtx->audioManager->GetAllAdapters(capCtx->audioManager, &descs, &size);
+    if (ret != 0) {
+        printf("%s:%d get all adapters failed\n", __func__, __LINE__);
+        return -1;
+    }
+    printf("%s:%d have %d adapters\n", __func__, __LINE__, size);
+
+    for (int index = 0; index < size; index++) {
+        struct AudioAdapterDescriptor *desc = &descs[index];
+        for (int port = 0; (desc != NULL && port < (int)desc->portNum); port++) {
+            if (desc->ports[port].dir != PORT_IN) {
+                continue;
+            }
+            if (capCtx->audioManager->LoadAdapter(capCtx->audioManager, desc, &capCtx->audioAdapter) == 0) {
+                ret = capCtx->audioAdapter->InitAllPorts(capCtx->audioAdapter);
+            } else {
+                printf("%s:%d load adapter failed\n", __func__, __LINE__);
+                return -1;
+            }
+            break;
+        }
+    }
+
+    if (ret != 0) {
+        capCtx->audioManager->UnloadAdapter(capCtx->audioManager, capCtx->audioAdapter);
+        capCtx->audioAdapter = NULL;
+        capCtx->audioManager = NULL;
+        return -1;
+    }
+
+    if (capCtx->audioAdapter == NULL) {
+        printf("%s:%d adapter is null\n", __func__, __LINE__);
+        return -1;
+    }
+
+    return 0;
+}
+
+static int UnloadAudioAdapter(CaptureContext capCtx)
+{
+    if (capCtx.audioManager != NULL) {
+        capCtx.audioManager->UnloadAdapter(capCtx.audioManager, capCtx.audioAdapter);
+        capCtx.audioManager = NULL;
+        capCtx.audioAdapter = NULL;
+    }
+
+    return 0;
+}
+
+static int CreateAudioCapture(SampleContext *sapCtx)
+{
+    CaptureContext *capCtx = &(sapCtx->capCtx);
+
+    struct AudioDeviceDescriptor desc = { };
+    desc.pins = PIN_IN_MIC;
+
+    struct AudioSampleAttributes attrs = { };
+    attrs.type = AUDIO_IN_MEDIA;
+    attrs.format = AUDIO_FORMAT_PCM_16_BIT;
+    attrs.sampleRate = sapCtx->pcmFmt.sampleRate;
+    attrs.channelCount = sapCtx->pcmFmt.channelCnt;
+    attrs.interleaved = sapCtx->pcmFmt.interleaved;
+
+    int32_t ret = capCtx->audioAdapter->CreateCapture(capCtx->audioAdapter, &desc, &attrs, &capCtx->audioCapture);
+    if (ret != 0 || capCtx->audioCapture == NULL) {
+        printf("%s:%d create audio capture failed\n", __func__, __LINE__);
+        return -1;
+    }
+
+    return 0;
+}
+
+static int DestroyAudioCapture(CaptureContext capCtx)
+{
+    int ret = capCtx.audioAdapter->DestroyCapture(capCtx.audioAdapter, capCtx.audioCapture);
+    if (ret != 0) {
+        printf("%s:%d destroy audio capture failed\n", __func__, __LINE__);
+        return -1;
+    }
+    return 0;
+}
+
+static void Help(SampleContext *ctx, char *cmd);
+static void Pause(SampleContext *ctx, char *cmd);
+static void Resume(SampleContext *ctx, char *cmd);
+static void SetVolume(SampleContext *ctx, char *cmd);
+static void SetMute(SampleContext *ctx, char *cmd);
+static void GetCapability(SampleContext *ctx, char *cmd);
+
+typedef struct {
+    char *name;
+    char *desc;
+    void (*func)(SampleContext *ctx, char *cmd);
+} CmdParam;
+
+CmdParam g_cmdParam[] = {
+    {"help",        "printf usage help",    Help },
+    {"setvol",      "set volume [0-100]",   SetVolume },
+    {"setmute",     "set mute",             SetMute },
+    {"pause",       "pause capture",        Pause },
+    {"resume",      "resume capture",       Resume },
+    {"capability",  "get capability",       GetCapability },
+};
+
+static void Help(SampleContext *ctx, char *cmd)
+{
+    size_t cnt = sizeof(g_cmdParam) / sizeof(g_cmdParam[0]);
+    printf("cmd usage:\n");
+    for (size_t i = 0; i < cnt; i++) {
+        printf("\t%s:\t\t%s\n", g_cmdParam[i].name, g_cmdParam[i].desc);
+    }
+}
+
+static void Pause(SampleContext *ctx, char *cmd)
+{
+    int32_t ret = ctx->capCtx.audioCapture->control.Pause(ctx->capCtx.audioCapture);
+    if (ret != 0) {
+        printf("%s:%d,, pause failed\n", __FUNCTION__, __LINE__);
+    }
+}
+
+static void Resume(SampleContext *ctx, char *cmd)
+{
+    int32_t ret = ctx->capCtx.audioCapture->control.Resume(ctx->capCtx.audioCapture);
+    if (ret != 0) {
+        printf("%s:%d,, Resume failed\n", __FUNCTION__, __LINE__);
+    }
+}
+
+static void SetVolume(SampleContext *ctx, char *cmd)
+{
+    char *value = cmd + strlen("setvol");
+    int volInt = atoi(value);
+
+    const int32_t VOL_MAX = 100;
+    float volume = (float)volInt / (float)VOL_MAX;
+    int32_t ret = ctx->capCtx.audioCapture->volume.SetVolume(ctx->capCtx.audioCapture, volume);
+    if (ret != 0) {
+        printf("%s:%d, SetVolume %f failed\n", __FUNCTION__, __LINE__, volume);
+    }
+}
+
+static void SetMute(SampleContext *ctx, char *cmd)
+{
+    bool setValue = ctx->isMute ? false : true;
+    int32_t ret = ctx->capCtx.audioCapture->volume.SetMute(ctx->capCtx.audioCapture, setValue);
+    if (ret == 0) {
+        ctx->isMute = setValue;
+    }
+}
+
+static void GetCapability(SampleContext *ctx, char *cmd)
+{
+    CaptureContext *audio = &ctx->capCtx;
+
+    struct AudioPort port;
+    port.dir = PORT_IN;
+    port.portId = 0;
+    port.portName = "PrimaryPortIn";
+    struct AudioPortCapability capability;
+    int32_t ret = audio->audioAdapter->GetPortCapability(audio->audioAdapter, &port, &capability);
+    if (ret == 0) {
+        printf("show PortCapability:\n");
+        printf("deviceType:%u, deviceId:%u, hardwareMode:%d, sampleRateMasks:0x%x, channelCount:%d\n",
+            capability.deviceType, capability.deviceId, capability.hardwareMode, capability.sampleRateMasks,
+            capability.channelCount);
+        printf("Capability formatNum:%d\n", capability.formatNum);
+        for (int i = 0; i < capability.formatNum; i++) {
+            printf("formats[%d]:0x%x\n", i, capability.formats[i]);
+        }
+        printf("Capability subPortsNum:%d\n", capability.subPortsNum);
+        for (int j = 0; j < capability.subPortsNum; j++) {
+            printf("subPorts[%d]:\n portId:%u, mask:%d, desc:%p\n", j, capability.subPorts[j].portId,
+                capability.subPorts[j].mask, capability.subPorts[j].desc);
+        }
+    } else {
+        printf("[%s:%d] GetPortCapability failed:%d\n", __FUNCTION__, __LINE__, ret);
+    }
+}
+
+static void CmdProcess(SampleContext *ctx, char *cmd)
+{
+    size_t cnt = sizeof(g_cmdParam) / sizeof(g_cmdParam[0]);
+    size_t i;
+    for (i = 0; i < cnt; i++) {
+        if (strncasecmp(g_cmdParam[i].name, cmd, strlen(g_cmdParam[i].name)) == 0) {
+            g_cmdParam[i].func(ctx, cmd);
+            break;
+        }
+    }
+
+    if (i >= cnt) {
+        printf("not support cmd:[%s], enter \"help\" for more.\n", cmd);
+    }
+}
+
+static void CmdParser(SampleContext *ctx)
+{
+    printf("%s:%d, \ninput q to quit!\n", __func__, __LINE__);
+
+    char cmd[1024] = { 0 };
+    while (true) {
+        if (fgets(cmd, sizeof(cmd) - 1, stdin) == NULL) {
+            printf("%s:%d, fgets fail\n", __func__, __LINE__);
+        }
+        if (strncasecmp(cmd, "q", strlen("q")) == 0) {
+            ctx->threadRunning = false;
+            break;
+        }
+
+        CmdProcess(ctx, cmd);
+
+        if (memset_s(cmd, sizeof(cmd), 0, sizeof(cmd)) != EOK) {
+            printf("%s:%d, memset fail\n", __func__, __LINE__);
+        }
+    }
+}
+
+static void *AudioCaptureThread(void *arg)
+{
+    SampleContext *ctx = (SampleContext *)arg;
+
+    int readCnt = 0;
+    uint64_t readLen;
+    ctx->threadRunning = true;
+    while (ctx->threadRunning) {
+        int32_t ret = ctx->capCtx.audioCapture->CaptureFrame((AudioHandle)ctx->capCtx.audioCapture,
+            ctx->capCtx.frameAddr, ctx->capCtx.frameSize, &readLen);
+        if (ret == -1) {
+            printf("%s:%d, audio capture acquire frame failed\n", __func__, __LINE__);
+            continue;
+        }
+        if (ret == -7) { // -7 MEDIA_HAL_ERR_AGAIN
+            continue;
+        }
+
+        int writeLen = fwrite(ctx->capCtx.frameAddr, 1, readLen, (ctx->pfd));
+        if (writeLen != readLen) {
+            printf("%s:%d, fwrite failed\n", __func__, __LINE__);
+            break;
+        }
+
+        printf("%s:%d, audio capture read count = %d, size = %llu\n", __func__, __LINE__, readCnt++, readLen);
+    }
+    printf("%s:%d, audio capture thread exit\n", __func__, __LINE__);
+    return NULL;
+}
+
+static int PrepareAudioAdapter(SampleContext *ctx)
+{
+    if (ctx == NULL) {
+        return -1;
+    }
+    int ret = LoadAudioAdapter(&(ctx->capCtx));
+    if (ret != 0) {
+        printf("%s:%d load audio adapter failed\n", __func__, __LINE__);
+        return -1;
+    }
+
+    ret = CreateAudioCapture(ctx);
+    if (ret != 0) {
+        printf("%s:%d create audio capture failed\n", __func__, __LINE__);
+        return -1;
+    }
+    uint64_t frameCount = 0;
+    ret = ctx->capCtx.audioCapture->attr.GetFrameCount((AudioHandle)ctx->capCtx.audioCapture, &frameCount);
+    if (ret != 0) {
+        printf("%s:%d audio capture get frame count failed\n", __func__, __LINE__);
+        return -1;
+    }
+
+    ctx->capCtx.frameSize = frameCount * 1024; // 1024 = 1Mb size
+    ctx->capCtx.frameAddr = malloc(ctx->capCtx.frameSize);
+    if (ctx->capCtx.frameAddr == NULL) {
+        printf("%s:%d malloc failed\n", __func__, __LINE__);
+        return -1;
+    }
+    return 0;
+}
+
+int main(int argc, char *argv[])
+{
+    printf("%s:%d audio capture sample enter\n", __func__, __LINE__);
+
+    if (argc < MAX_ARGC) {
+        printf("useage:%s sampleRate bitWidth channelCnt\n", argv[0]);
+        printf("    eg:%s 16000 16 2\n", argv[0]);
+        return -1;
+    }
+
+    FILE *pfd = fopen("/data/media/audio_cap.pcm", "w+");
+    if (pfd == NULL) {
+        printf("%s:%d open file failed\n", __func__, __LINE__);
+        return -1;
+    }
+
+    SampleContext ctx = { };
+    ctx.pcmFmt.sampleRate = atoi(argv[0x1]);
+    ctx.pcmFmt.bitWidth = atoi(argv[0x2]);
+    ctx.pcmFmt.channelCnt = atoi(argv[0x3]);
+    ctx.pcmFmt.interleaved = true;
+    if (argc > MAX_ARGC) {
+        ctx.pcmFmt.interleaved = (atoi(argv[0x4]) != 0);
+    }
+
+    ctx.pfd = pfd;
+
+    int ret = PrepareAudioAdapter(&ctx);
+    if (ret != 0) {
+        return -1;
+    }
+
+    ret = ctx.capCtx.audioCapture->control.Start((AudioHandle)ctx.capCtx.audioCapture);
+    if (ret != 0) {
+        printf("%s:%d audio capture start failed\n", __func__, __LINE__);
+        free(ctx.capCtx.frameAddr);
+        return -1;
+    }
+
+    if (pthread_create(&(ctx.threadId), NULL, AudioCaptureThread, &ctx) != 0) {
+        ctx.threadId = 0;
+        printf("create thread fail");
+    } else {
+        CmdParser(&ctx);
+    }
+
+    if (ctx.threadId != 0) {
+        pthread_join(ctx.threadId, NULL);
+    }
+
+    (void)ctx.capCtx.audioCapture->control.Stop((AudioHandle)ctx.capCtx.audioCapture);
+
+    (void)DestroyAudioCapture(ctx.capCtx);
+
+    (void)UnloadAudioAdapter(ctx.capCtx);
+
+    if (fclose(pfd) != 0) {
+        printf("%s:%d fclose fail\n", __func__, __LINE__);
+    }
+
+    free(ctx.capCtx.frameAddr);
+
+    printf("%s:%d audio capture sample exit\n", __func__, __LINE__);
+
+    return 0;
+}
+
