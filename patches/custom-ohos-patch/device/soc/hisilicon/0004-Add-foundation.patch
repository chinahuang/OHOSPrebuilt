+std::vector<std::string> TvMWServiceAdapterImpl::SplitStandard(const std::string &str, const std::string &delim)
+{
+    std::vector<std::string> elems;
+    size_t strLen = str.length();
+    int findPos = str.find(delim);
+    if (findPos < 0) {
+        elems.push_back(str);
+        elems.push_back("UNKNOWN");
+    } else {
+        elems.push_back(str.substr(0, findPos));
+        findPos += 1;
+        elems.push_back(str.substr(findPos, strLen - findPos));
+    }
+    return elems;
+}
