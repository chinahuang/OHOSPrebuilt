+int32_t TvMWServiceAdapterImpl::GetOutputStandard(std::vector<std::string> &standard)
+{
+    TVMW_DEBUG_LOG("start");
+    S32 s32Ret = FAILURE;
+    VOUT_ALL_FORMATS_PARAMS_S params;
+    errno_t ret = memset_s(&params, sizeof(VOUT_ALL_FORMATS_PARAMS_S), 0, sizeof(VOUT_ALL_FORMATS_PARAMS_S));
+    if (ret != EOK) {
+        TVMW_ERR_LOG("memset failed, ret(%d)", ret);
+        return s32Ret;
+    }
+
+    s32Ret =  getVoutDevice()->vout_get_hdmi_allfmts(NULL, hVout, &params);
+    if (s32Ret != SUCCESS) {
+        TVMW_ERR_LOG("hal failed, ret(%x)", s32Ret);
+        return static_cast<int32_t>(s32Ret);
+    }
+
+    standard.clear();
+    for (size_t i = 0; i < static_cast<size_t>(params.u32FormatsNumber); ++i) {
+        std::string std = GetFmt(params.astDispFormats[i].enDispFmt);
+        std::string rate = GetRate(params.astDispFormats[i].enFrameRate);
+        standard.push_back(std + " " + rate);
+    }
+
+    TVMW_DEBUG_LOG("end");
+    return static_cast<int32_t>(s32Ret);
+}
