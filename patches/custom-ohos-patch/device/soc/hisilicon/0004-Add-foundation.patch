+int32_t DisplaySetting::ParcelOneParam(napi_env env, napi_callback_info info,
+                                       std::shared_ptr<ReturnValue> returnValue)
+{
+    if (returnValue == nullptr) {
+        TVMW_ERR_LOG("returnValue is null!");
+        return FAIL;
+    }
+
+    size_t argc = ARGC_FIVE;
+    napi_value argv[ARGC_FIVE] = {nullptr};
+    napi_get_cb_info(env, info, &argc, argv, nullptr, nullptr);
+    if (argc == ARGC_ZERO) {
+        TVMW_ERR_LOG("Invalid number of params.");
+        returnValue->errCode = FAIL;
+        return FAIL;
+    }
+
+    TVMW_DEBUG_LOG("argc = %{public}d", static_cast<int32_t>(argc));
+    napi_value targetNumber = argv[ARGC_ZERO];
+    if (targetNumber == nullptr) {
+        TVMW_ERR_LOG("The targetNumber number is null.");
+        returnValue->errCode = FAIL;
+        return FAIL;
+    }
+
+    int32_t temp = MIN_VALUE;
+    if (!ConvertFromJsValue(env, argv[ARGC_ZERO], temp)) {
+        TVMW_ERR_LOG("[NAPI]Failed to convert parameter to this value.");
+        returnValue->errCode = FAIL;
+        return FAIL;
+    } else {
+        TVMW_DEBUG_LOG("The value is %{public}d", temp);
+        if (temp < MIN_VALUE || temp > MAX_VALUE) {
+            TVMW_ERR_LOG("Wrong! The value is %{public}d,it should be between 0 and 100.", temp);
+            returnValue->errCode = FAIL;
+            return FAIL;
+        }
+    }
+    return temp;
+}
