+void OrderSerialPort::ParseStartHdcp(const std::vector<uint8_t> &data)
+{
+    if (data.size() != START_HDCP_LEN || data[BIT2] != START_HDCP_LEN || !CheckCode(data)) {
+        MSG_LOGE("%{public}s: NACK_PARAM_ERR", __func__);
+        WriteData(MakeAckData(data, NACK_PARAM_ERR));
+        return;
+    }
+
+    //handle
+    std::stringstream ss;
+    ss << std::hex << std::setfill('0');
+    ss << std::setw(2) << static_cast<int>(data[BIT5]);
+    ss << std::setw(2) << static_cast<int>(data[BIT6]);
+    ss << std::setw(2) << static_cast<int>(data[BIT7]);
+    ss << std::setw(2) << static_cast<int>(data[BIT8]);
+    uint32_t fileId = 0;
+    ss >> std::hex >> fileId;
+    MSG_LOGI("%{public}s, fileId:%{public}d", __func__, fileId);
+
+    //interface:是否烧录可以烧录
+    hdcpFileId_ = fileId;
+    uint32_t len = 16;
+    
+    WriteData(MakeRetStartHdcp(ALREADY_EXIST, len));
+}
