+void OrderSerialPort::ParseSendHdcpData(const std::vector<uint8_t> &data)
+{
+    if (!CheckCode(data)) {
+        MSG_LOGE("%{public}s: NACK_PARAM_ERR", __func__);
+        WriteData(MakeAckData(data, NACK_PARAM_ERR));
+        return;
+    }
+
+    //handle
+    uint32_t pocket_index = 0;
+    if (data.size() > 9) {
+        std::stringstream index_ss;
+        index_ss << std::hex << std::setfill('0');
+        index_ss << std::setw(2) << static_cast<int>(data[BIT5]);
+        index_ss << std::setw(2) << static_cast<int>(data[BIT6]);
+        index_ss << std::setw(2) << static_cast<int>(data[BIT7]);
+        index_ss << std::setw(2) << static_cast<int>(data[BIT8]);
+        index_ss >> std::hex >> pocket_index;
+        MSG_LOGI("%{public}s, pocket_index:%{public}d", __func__, pocket_index);
+    }
+    
+    uint32_t pocket_count = 0;
+    if (data.size() > BIT13) {
+        std::stringstream count_ss;
+        count_ss << std::hex << std::setfill('0');
+        count_ss << std::setw(2) << static_cast<int>(data[BIT9]);
+        count_ss << std::setw(2) << static_cast<int>(data[BIT10]);
+        count_ss << std::setw(2) << static_cast<int>(data[BIT11]);
+        count_ss << std::setw(2) << static_cast<int>(data[BIT12]);
+        count_ss >> std::hex >> pocket_count;
+        MSG_LOGI("%{public}s, pocket_count:%{public}d", __func__, pocket_count);
+    }
+
+    std::string pocket_data = "";
+    if (data.size() > BIT14) {
+        std::vector<uint8_t> subvec(data.begin() + BIT13, data.begin() + data.size() - 1);
+        pocket_data = ByteArrayToHexString(subvec);
+        MSG_LOGI("%{public}s, pocket_data:%{public}s", __func__, pocket_data.c_str());
+        pocketDataVec_.insert(pocketDataVec_.end(), subvec.begin(), subvec.end());
+    }
+
+    //interface:传输数据
+    WriteData(MakeSendHdcpDataAck(data, ACK));
+}
