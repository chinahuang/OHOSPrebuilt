+void TvMWSystemAbility::Init()
+{
+    g_tvmwSystemAbility = this;
+    RegisterBootCompletedCallback();
+
+    if (!eventRunner_) {
+        eventRunner_ = AppExecFwk::EventRunner::Create(TVMW_SERVICE_NAME);
+        if (eventRunner_ == nullptr) {
+            TVMW_ERR_LOG( "Init failed due to create EventRunner");
+            return;
+        }
+    }
+
+    if (!handler_) {
+        handler_ = std::make_shared<TvMWEventHandler>(eventRunner_, g_tvmwSystemAbility);
+        std::string handlerName("TvMWEventHandler");
+        HiviewDFX::Watchdog::GetInstance().AddThread(handlerName, handler_);
+    }
+
+    if(!handler_) {
+        TVMW_ERR_LOG("Create handler failed due to Init");
+        return;
+    }
+
+    TvMWEventHandler::EventCallback setSettingSaturationCallback =
+        [&](int64_t saturation) { SetSettingSaturation(static_cast<uint32_t>(saturation)); };
+    handler_->EmplaceCallBack(TvMWEventHandler::Event::EVENT_SET_SETTING_SATURATION, setSettingSaturationCallback);
+
+    TvMWEventHandler::EventCallback setSettingConstrastCallback =
+        [&](int64_t constrast) { SetSettingContrast(static_cast<uint32_t>(constrast)); };
+    handler_->EmplaceCallBack(TvMWEventHandler::Event::EVENT_SET_SETTING_CONSTRAST, setSettingConstrastCallback);
+
+    TvMWEventHandler::EventCallback setSettingDisplayHueCallback =
+        [&](int64_t hue) { SetSettingDisplayHue(static_cast<uint32_t>(hue)); };
+    handler_->EmplaceCallBack(TvMWEventHandler::Event::EVENT_SET_SETTING_HUE, setSettingDisplayHueCallback);
+}
