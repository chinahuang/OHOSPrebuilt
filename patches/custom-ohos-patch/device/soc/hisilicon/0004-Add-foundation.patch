+napi_value DisplaySetting::SetNLAPoint(napi_env env, napi_callback_info info)
+{
+    NFuncArg funcArg(env, info);
+    if (!funcArg.InitArgs(NARG_CNT::TWO, NARG_CNT::THREE)) {
+        NError(ERR_PARAM_NUMBER).ThrowErr(env, "Number of arguments unmatched, number must be 2 or 3 !");
+        return nullptr;
+    }
+
+    auto [ret, nlaItem] = NVal(env, funcArg[NARG_POS::FIRST]).ToInt32();
+    if (!ret || nlaItem < NLAItem::NLA_BRIGHTNESS || nlaItem > NLAItem::NLA_BACKLIGHT) {
+        std::string errorMsg = "nlaItem argument is invalid, value must between "
+                + std::to_string(NLAItem::NLA_BRIGHTNESS) + " and " + std::to_string(NLAItem::NLA_BACKLIGHT) + ".";
+        NError(ERR_INVALID_PARAM).ThrowErr(env, errorMsg);
+        return nullptr;
+    }
+
+    auto n_nlaPoint = funcArg[NARG_POS::SECOND];
+    napi_value n_x0;
+    napi_value n_x25;
+    napi_value n_x50;
+    napi_value n_x75;
+    napi_value n_x100;
+    int32_t retStatus = napi_ok;
+    retStatus += napi_get_named_property(env, n_nlaPoint, "x0", &n_x0);
+    retStatus += napi_get_named_property(env, n_nlaPoint, "x25", &n_x25);
+    retStatus += napi_get_named_property(env, n_nlaPoint, "x50", &n_x50);
+    retStatus += napi_get_named_property(env, n_nlaPoint, "x75", &n_x75);
+    retStatus += napi_get_named_property(env, n_nlaPoint, "x100", &n_x100);
+    RETURN_IF_WITH_RET_WITH_LOG(retStatus != napi_ok, nullptr, "get js obj data fail!");
+
+    auto [retX0, x0Temp] = NVal(env, n_x0).ToInt32();
+    auto [retX25, x25Temp] = NVal(env, n_x25).ToInt32();
+    auto [retX50, x50Temp] = NVal(env, n_x50).ToInt32();
+    auto [retX75, x75Temp] = NVal(env, n_x75).ToInt32();
+    auto [retX100, x100Temp] = NVal(env, n_x100).ToInt32();
+    if (!retX0 || !retX25 || !retX50 || !retX75 || !retX100) {
+        NError(ERR_INVALID_PARAM).ThrowErr(env, "get param fail!");
+        return nullptr;
+    }
+    NLAPoint nlaPoint;
+    nlaPoint.x0 = x0Temp;
+    nlaPoint.x25 = x25Temp;
+    nlaPoint.x50 = x50Temp;
+    nlaPoint.x75 = x75Temp;
+    nlaPoint.x100 = x100Temp;
+
+    auto result = std::make_shared<bool>();
+    auto cbExec = [result, nlaItem = nlaItem, nlaPoint = nlaPoint]() -> NError {
+        auto *tvMWClient = &TvMWClientManager::GetInstance();
+        if (tvMWClient == nullptr) {
+            return NError(ERR_NULL_POINTER);
+        }
+
+        *result = (tvMWClient->SetNLAPoint(nlaItem, nlaPoint) == SUS);
+        return NError(SUS);
+    };
+    auto cbComplete = [result](napi_env env, NError err) -> NVal {
+        if (err) {
+            return { env, err.GetNapiErr(env) };
+        }
+
+        return NVal::CreateBool(env, *result);
+    };
+
+    const std::string name = "SetNLAPoint";
+    NVal thisVar(env, funcArg.GetThisVar());
+    if (funcArg.GetArgc() == NARG_CNT::TWO) {
+        return NAsyncWorkPromise(env, thisVar).Schedule(name, cbExec, cbComplete).val_;
+    }
+
+    NVal cb(env, funcArg[NARG_POS::THIRD]);
+    if (!cb.TypeIs(napi_function)) {
+        NError(ERR_INVALID_PARAM).ThrowErr(env, "The third argument must be a function");
+        return nullptr;
+    }
+
+    return NAsyncWorkCallback(env, thisVar, cb).Schedule(name, cbExec, cbComplete).val_;
+}
