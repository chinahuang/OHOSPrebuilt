+uint32_t TvMWSystemAbility::GetSettingSaturation(const std::string& key) const
+{
+    SettingProvider& provider = SettingProvider::GetInstance(TVMW_SERVICE_ID);
+    int32_t value;
+    ErrCode ret = provider.GetIntValue(key, value);
+    if (ret != ERR_OK) {
+        TVMW_INFO_LOG("get setting saturation failed, return cachedSaturation_=%{public}u,"\
+                       " key=%{public}s, ret=%{public}d", cachedSettingSaturation_, key.c_str(), ret);
+        return cachedSettingSaturation_;
+    }
+    TVMW_INFO_LOG("GetSettingSaturation:%{public}d", value);
+    return static_cast<uint32_t>(value);
+}
