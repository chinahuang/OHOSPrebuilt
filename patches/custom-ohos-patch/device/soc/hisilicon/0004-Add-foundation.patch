+napi_value DisplaySetting::OnSetOutputSaturation(napi_env env, napi_callback_info info)
+{
+    TVMW_DEBUG_LOG("OnSetOutputSaturation in");
+    auto returnValue = std::make_shared<ReturnValue>();
+    int32_t saturation = ParcelOneParam(env, info, returnValue);
+    NapiAsyncTask::ExecuteCallback execute =
+        [this, saturation, returnValue]() mutable {
+            int32_t temp = tvMWClientManager_->SetOutputSaturation(saturation);
+            returnValue->ret = temp == SUS;
+        };
+    NapiAsyncTask::CompleteCallback complete =
+        [this, returnValue](napi_env env, NapiAsyncTask& task, int32_t status) mutable {
+            Complete(env, task, returnValue);
+        };
+
+    size_t argc = ARGC_FIVE;
+    napi_value argv[ARGC_FIVE] = {nullptr};
+    napi_get_cb_info(env, info, &argc, argv, nullptr, nullptr);
+
+    napi_value result = nullptr;
+    napi_value callback = (argc < ARGC_TWO) ? nullptr :
+        (GetType(env, argv[ARGC_ZERO]) == napi_function ? argv[ARGC_ZERO] : nullptr);
+    NapiAsyncTask::Schedule("DisplaySetting::OnSetOutputSaturation",
+        env, CreateAsyncTaskWithLastParam(env, callback, std::move(execute), std::move(complete), &result));
+        TVMW_DEBUG_LOG("OnSetOutputSaturation out");
+    return result;
+}
