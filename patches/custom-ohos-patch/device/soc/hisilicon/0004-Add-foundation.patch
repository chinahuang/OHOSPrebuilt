+namespace OHOS {
+namespace Produce {
+std::mutex OrderSerialPort::mutex_;
+OrderSerialPort* OrderSerialPort::instance_ = nullptr;
+
+OrderSerialPort::OrderSerialPort(): fd_(-1), stopReading_(false), stopWriting_(false), hdcpFileId_(0)
+{
+    MSG_LOGI("%{public}s constructed.", __func__);
+}
+
+OrderSerialPort::~OrderSerialPort()
+{
+    CleanUp();
+    MSG_LOGI("%{public}s destructed.", __func__);
+}
+
+OrderSerialPort* OrderSerialPort::GetInstance()
+{
+    if (instance_ == nullptr) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (instance_ == nullptr) {
+            instance_ = new OrderSerialPort();
+        }
+    }
+    return instance_;
+}
+
+void OrderSerialPort::CleanUp()
+{
+    stopReading_ = true;
+    stopWriting_ = true;
+
+    if (fd_) {
+        close(fd_);
+    }
+}
+
+int32_t OrderSerialPort::OpenPort(const std::string &portName, speed_t baudrate)
+{
+    int fd = open(portName.c_str(), O_RDWR | O_NOCTTY | O_NDELAY);
+    if (fd < 0)
+    {
+        MSG_LOGE("%{public}s open error, portname: %{public}s, %{public}s",
+                 __func__, portName.c_str(), strerror(errno));
+        return -1;
+    }
+
+    struct termios opt;
+    memset(&opt, 0x00, sizeof(opt));
+    if (tcgetattr(fd, &opt) != 0)
+    {
+        close(fd);
+        MSG_LOGE("%{public}s can't read serial settings", __func__);
+        return -1;
+    }
+
+    cfsetispeed(&opt, baudrate);
+    cfsetospeed(&opt, baudrate);
+
+    opt.c_cflag = (opt.c_cflag & ~CSIZE) | CS8;     // 8-bit chars
+    opt.c_iflag &= ~IGNBRK;         // disable break processing
+    opt.c_lflag = 0;                // no signaling chars, no echo,
+                                    // no canonical processing
+    opt.c_oflag = 0;                // no remapping, no delays
+    opt.c_cc[VMIN]  = 0;            // read doesn't block
+    opt.c_cc[VTIME] = VTIME_TIMEOUT;            // 0.5 seconds read timeout
+
+    opt.c_iflag &= ~(IXON | IXOFF | IXANY); // shut off xon/xoff ctrl
+
+    opt.c_cflag |= (CLOCAL | CREAD);// ignore modem controls,
+                                    // enable reading
+    opt.c_cflag &= ~(PARENB | PARODD);      // shut off parity
+    opt.c_cflag |= 0;
+    opt.c_cflag &= ~CSTOPB;
+    opt.c_cflag &= ~CRTSCTS;
+    if (tcsetattr(fd, TCSANOW, &opt) != 0)
+    {
+        close(fd);
+        MSG_LOGE("%{public}s serial set failed", __func__);
+        return -1;
+    }
+
+    return fd;
+}
+
+void OrderSerialPort::Receiver()
+{
+    pollfd pfd;
+    pfd.fd = fd_;
+    pfd.events = POLLIN;
+    pfd.revents = 0;
+    std::vector<pollfd> pollfds;
+    pollfds.emplace_back(pfd);
+
+    while (!stopReading_) {
+        int32_t res = poll(pollfds.data(), pollfds.size(), PORT_READ_TIMEOUT_MS);
+        if (res == -1) {
+            MSG_LOGE("%{public}s serial port poll error: %{public}s", __func__, strerror(errno));
+        } else if (res == 0) {
+            MSG_LOGI("%{public}s serial port poll timeout", __func__);
+            continue;
+        } else {
+            ReadSerialPort(pollfds);
+        }
+    }
+}
+
+void OrderSerialPort::Sender()
+{
+    while (true) {
+        std::unique_lock<std::mutex> lock(writeMutex_);
+        writeCv_.wait(lock, [this] { return stopWriting_ || !writeQueue_.empty(); });
+        if (stopWriting_ && writeQueue_.empty()) {
+            MSG_LOGI("%{public}s write_queue_ empty and stop", __func__);
+            break;  
+        }
+
+        std::vector<uint8_t> byteArray = writeQueue_.front();
+        writeQueue_.pop();
+        lock.unlock();
+
+        MSG_LOGI("%{public}s, %{public}s", __func__, ByteArrayToHexString(byteArray).c_str());
+        int32_t res = 0;
+        res = write(fd_, byteArray.data(), byteArray.size());
+        if (res < 0) {
+            MSG_LOGE("%{public}s Error writing to serial port: %{public}s", __func__, strerror(errno));
+        }
+    }
+}
+
+
+void OrderSerialPort::WriteData(const std::vector<uint8_t>& data)
+{
+    std::lock_guard<std::mutex> lock(writeMutex_);
+    writeQueue_.push(data);
+    writeCv_.notify_one();
+}
+
+void OrderSerialPort::ReadSerialPort(const std::vector<pollfd> &pollfds)
+{
+    for (const auto &pfd : pollfds) {
+        if (pfd.revents & POLLIN) {
+            std::vector<uint8_t> buffer(BUFF_SIZE);
+            int32_t bytes_read = read(pfd.fd, buffer.data(), BUFF_SIZE);
+            if (bytes_read == -1) {
+                MSG_LOGE("%{public}s ReadSerialPort read error: %{public}s", __func__, strerror(errno));
+            } else if (bytes_read == 0) {
+                MSG_LOGI("%{public}s:File descriptor closed. fd:%{public}d", __func__, pfd.fd);
+            } else {
+                std::vector<uint8_t> receivedData(buffer.begin(), buffer.begin() + bytes_read);
+                MSG_LOGD("%{public}s Received: %{public}s", __func__, receivedData.data());
+                ParseData(receivedData);
+            }
+        }
+    }
+}
+
+void OrderSerialPort::ParseData(const std::vector<uint8_t> &data)
+{
+    MSG_LOGI("%{public}s: start, %{public}s", __func__, ByteArrayToHexString(data).c_str());
+    if (data.size() < DATA_MIN_LEN || data[BIT0] != SYNC_WORD || data[BIT1] != START_WORD ||
+        data[BIT3] != AUTO_TEST_PROTOCOL) {
+        MSG_LOGE("%{public}s: NACK_PARAM_ERR", __func__);
+        WriteData(MakeAckData(data, NACK_PARAM_ERR));
+        return;
+    }
+
+    //parse data
+    switch(data[BIT4]) {
+        case START_HDCP:
+            ParseStartHdcp(data);
+            break;
+        case SEND_HDCP_DATA:
+            ParseSendHdcpData(data);
+            break;
+        case SEND_HDCP_CRC:
+            ParseSendHdcpCrc(data);
+            break;
+        case SET_MAC_ADDR:
+            ParseSetMacAddr(data);
+            break;
+        case GET_MAC_ADDR:
+            ParseGetMacAddr(data);
+            break;
+        case GET_HDCP_ID:
+            ParseGetHdcpId(data);
+            break;
+        case GET_MAX_LEN:
+            ParseGetMaxLen(data);
+            break;
+        case GET_CHECKSUM:
+            ParseGetChecksum(data);
+            break;
+        case GET_SOURCE:
+            ParseGetSource(data);
+            break;
+        case SET_SOURCE:
+            ParseSetSource(data);
+            break;
+        case SET_VOLUME:
+            ParseSetVolume(data);
+            break;
+        case SET_CHANNEL:
+            ParseSetChannel(data);
+            break;
+        case CHANGE_PRO_NUM:
+            ParseChangeProNum(data);
+            break;
+        case CTRL_IO:
+            ParseCtrlIo(data);
+            break;
+        case SET_BARCODE:
+            ParseSetBarcode(data);
+            break;
+        case GET_BARCODE:
+            ParseGetBarcode(data);
+            break;
+        case GET_HDCP_KSV:
+            ParseGetHdcpKsv(data);
+            break;
+        case GET_IP_INFO:
+            ParseGetIpInfo(data);
+            break;
+        case GET_WIFI_STATUS:
+            ParseGetWifiStatus(data);
+            break;
+        case GET_USB_COUNT:
+            ParseGetUsbCount(data);
+            break;
+        case SEND_CVTE_FAC_IR:
+            ParseSendCvteFacIr(data);
+            break;
+        case CHECK_BLUETOOTH:
+            ParseCheckBluetooth(data);
+            break;
+        case PRODUCE_VERSION_ROLLBACK:
+            ParseProduceVersionRollback(data);
+            break;
+        default:
+            MSG_LOGE("%{public}s: can not parse type %{public}d", __func__, data[1]);
+            WriteData(MakeAckData(data, NACK_UNKNOWN_COMMAND));
+            break;
+    }
+}
+
+std::vector<uint8_t> OrderSerialPort::MakeAckData(const std::vector<uint8_t> &srcData, uint8_t resData)
+{
+    std::vector<uint8_t> byteArray;
+    if (srcData.size() < DATA_MIN_LEN) {
+        MSG_LOGE("%{public}s, size:%{public}d, len:%{public}d, %{public}s", __func__, srcData.size(), DATA_MIN_LEN,
+            ByteArrayToHexString(srcData).c_str());
+        byteArray = srcData;
+    } else {
+        byteArray.emplace_back(SYNC_WORD);
+        byteArray.emplace_back(START_WORD);
+        byteArray.emplace_back(ACK_DATA_LEN);
+        byteArray.emplace_back(AUTO_TEST_PROTOCOL);
+        byteArray.emplace_back(ACK_CMD_ID);
+        byteArray.emplace_back(resData);
+        byteArray.emplace_back(srcData[BIT4]);
+        byteArray.emplace_back(0x00);
+        byteArray.emplace_back(0x00);
+        byteArray.emplace_back(0x00);
+        byteArray.emplace_back(0x00);
+        MakeCheckCode(byteArray);
+    }
+    MSG_LOGI("%{public}s: end, %{public}s", __func__, ByteArrayToHexString(byteArray).c_str());
+    return byteArray;
+}
+
+std::vector<uint8_t> OrderSerialPort::HexStringToByteArray(const std::string &hexStr)
+{
+    size_t len = hexStr.size();
+    if (len % 2 != 0) {
+        MSG_LOGE("%{public}s Hex string length must be even, hexStr:%{public}s", __func__, hexStr.c_str());
+        return std::vector<uint8_t>();
+    }
+
+    std::vector<uint8_t> byteArray(len / 2);
+    for (size_t i = 0; i < len; i += 2) {
+        char byteStr[BIT3] = { hexStr[i], hexStr[i + 1], '\0' };
+        byteArray[i / 2] = static_cast<uint8_t>(strtol(byteStr, nullptr, 16));
+    }
+    return byteArray;
+}
+
+std::string OrderSerialPort::ByteArrayToHexString(const std::vector<uint8_t> &byteArray)
+{
+    std::stringstream ss;
+    ss << std::hex << std::setfill('0');
+    for (uint8_t byte : byteArray) {
+        ss << std::setw(2) << static_cast<int>(byte);
+    }
+    return ss.str();
+}
+
+std::string OrderSerialPort::UintToPaddedHexString(uint32_t value, int32_t width)
+{
+    std::stringstream ss;
+    ss << std::hex << std::uppercase << std::setw(width) << std::setfill('0') << value;
+    return ss.str();
+}
+
+bool OrderSerialPort::CheckCode(const std::vector<uint8_t> &data)
+{
+    int32_t sum = 0;
+    for (uint32_t i = BIT2; i < data.size(); ++i) {
+        sum += data[i];
+    }
+
+    if (sum != CHECK_CODE_SUM) {
+        MSG_LOGE("%{public}s: NACK_PARAM_ERR, sum:%{public}d", __func__, sum);
+        return false;
+    }
+
+    return true;
+}
+
+void OrderSerialPort::MakeCheckCode(std::vector<uint8_t> &byteArray)
+{
+    int32_t sum = 0;
+    for (uint32_t i = BIT2; i < byteArray.size(); ++i) {
+        sum += byteArray[i];
+    }
+    byteArray.emplace_back(CHECK_CODE_SUM - sum);
+}
+
+void OrderSerialPort::ParseSetSource(const std::vector<uint8_t> &data)
+{
+    if (data.size() != SET_SOURCE_LEN || data[BIT2] != SET_SOURCE_LEN || !CheckCode(data)) {
+        MSG_LOGE("%{public}s: NACK_PARAM_ERR", __func__);
+        WriteData(MakeAckData(data, NACK_PARAM_ERR));
+        return;
+    }
+
+    switch(data[BIT5]) {
+        case EN_AT_DTV:
+        case EN_AT_HDMI1:
+        case EN_AT_HDMI2:
+        case EN_AT_AV1:
+        case EN_AT_USB1:
+        case EN_AT_USB2: {
+            //interface
+            uint8_t ret = g_CVTEFuns.CVTE_SetTVSource(static_cast<en_CVTE_AT_SOURCE>(data[BIT5]));
+            if (ret != 0) {
+                MSG_LOGE("%{public}s: CVTE_SetTVSource error", __func__);
+            }
+            WriteData(MakeAckData(data, ACK));
+            break;
+        }
+        default:
+            MSG_LOGE("%{public}s: NACK_PARAM_ERR", __func__);
+            WriteData(MakeAckData(data, NACK_PARAM_ERR));
+            break;
+    }
+
+}
+
+std::vector<uint8_t> OrderSerialPort::MakeRetStartHdcp(uint8_t resData, uint32_t len)
+{
+    std::vector<uint8_t> byteArray;
+    byteArray.emplace_back(SYNC_WORD);
+    byteArray.emplace_back(START_WORD);
+    byteArray.emplace_back(RET_START_HDCP_LEN);
+    byteArray.emplace_back(AUTO_TEST_PROTOCOL);
+    byteArray.emplace_back(RET_START_HDCP);
+    byteArray.emplace_back(resData);
+
+    std::vector<uint8_t> lenArray = HexStringToByteArray(UintToPaddedHexString(len, 4));
+    byteArray.insert(byteArray.end(), lenArray.begin(), lenArray.end());
+
+    MakeCheckCode(byteArray);
+    MSG_LOGI("%{public}s: end, %{public}s", __func__, ByteArrayToHexString(byteArray).c_str());
+    return byteArray;
+}
