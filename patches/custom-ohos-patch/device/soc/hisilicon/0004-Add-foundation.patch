+napi_value DisplaySetting::Init(napi_env env, napi_value exportObj)
+{
+    TVMW_DEBUG_LOG("Init");
+    if (env == nullptr || exportObj == nullptr) {
+        TVMW_ERR_LOG("Engine or exportObj is null!");
+        return nullptr;
+    }
+    auto displaySetting = std::make_unique<DisplaySetting>();
+    napi_wrap(env, exportObj, displaySetting.release(), DisplaySetting::Finalizer, nullptr, nullptr);
+
+    const char* moduleName = "display";
+    BindNativeFunction(env, exportObj, "setOutputSaturation", moduleName, DisplaySetting::SetOutputSaturation);
+    BindNativeFunction(env, exportObj, "getOutputSaturation", moduleName, DisplaySetting::GetOutputSaturation);
+    BindNativeFunction(env, exportObj, "setOutputContrast", moduleName, DisplaySetting::SetOutputContrast);
+    BindNativeFunction(env, exportObj, "getOutputContrast", moduleName, DisplaySetting::GetOutputContrast);
+    BindNativeFunction(env, exportObj, "setDisplayHue", moduleName, DisplaySetting::SetDisplayHue);
+    BindNativeFunction(env, exportObj, "getDisplayHue", moduleName, DisplaySetting::GetDisplayHue);
+    BindNativeFunction(env, exportObj, "setHDRType", moduleName, DisplaySetting::SetHDRType);
+    BindNativeFunction(env, exportObj, "getHDRType", moduleName, DisplaySetting::GetHDRType);
+    BindNativeFunction(env, exportObj, "setOutputStandard", moduleName, DisplaySetting::SetOutputStandard);
+    BindNativeFunction(env, exportObj, "getOutputStandard", moduleName, DisplaySetting::GetOutputStandard);
