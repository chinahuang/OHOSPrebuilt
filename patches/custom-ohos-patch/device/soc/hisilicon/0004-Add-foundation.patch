+    "usb_manager:usbsrv_client",
+    "bluetooth:btframework",
+    "init:libbegetutil"
+  ]
+
+  defines = [
+    "LOG_DOMAIN = 0xD0015BB",
+  ]
+
+  if (production_construct_order_enable) {
+    defines += ["PRODUCTION_ORDER_ENABLE"]
+  }
+  if (production_construct_age_enable) {
+    defines += ["PRODUCTION_AGE_ENABLE"]
+  }
+
+  if (product_name == "hispark_hi3751v352") {
+    defines += ["HISPARK_HI3751V352"]
+  } else if (product_name == "mp_ohos") {
+    defines += ["MP_OHOS"]
+  }
+
+  install_enable = true
+  part_name = "production_construct"
+  subsystem_name = "hisilicon_common"
+}
+
+ohos_prebuilt_etc("produce_init") {
+  source = "produce_start.cfg"
+  relative_install_dir = "init"
+  part_name = "production_construct"
+}
+
+ohos_prebuilt_etc("produce_back") {
+  source = "produce_back.cfg"
+  relative_install_dir = "init"
+  part_name = "production_construct"
+}
+
+ohos_prebuilt_etc("produce_back_exec") {
+  source = "produce_back.sh"
+  module_install_dir = "etc/produce_back"
+  part_name = "production_construct"
+}
+
+group("produce_target") {
+  deps = []
+  if (production_construct_order_enable || production_construct_age_enable) {
+      deps = [
+        ":produce_server",
+        ":produce_init",
+        ":produce_back",
+        ":produce_back_exec",
+      ]
+  }
+}
