+void DisplaySetting::ParcelDisplayAreaParams(napi_env env, napi_callback_info info,
+                                             std::shared_ptr<ReturnValue> returnValue, int32_t &left,
+                                             int32_t &top, int32_t &right, int32_t &bottom)
+{
+    if (returnValue == nullptr) {
+        TVMW_ERR_LOG("returnValue is null!");
+        return ;
+    }
+
+    size_t argc = ARGC_FIVE;
+    napi_value argv[ARGC_FIVE] = {nullptr};
+    napi_get_cb_info(env, info, &argc, argv, nullptr, nullptr);
+
+    if (!(argc == ARGC_FOUR || argc == ARGC_FIVE)) {
+        TVMW_ERR_LOG("Number of arguments unmatched, number must be 4 or 5 !");
+        returnValue->errCode = FAIL;
+        return ;
+    }
+    TVMW_DEBUG_LOG("argc = %{public}d", static_cast<int32_t>(argc));
+    if (!ConvertFromJsValue(env, argv[ARGC_ZERO], left)) {
+        TVMW_ERR_LOG("Failed to convert parameter to value of video display area.The value is %{public}d", left);
+        returnValue->errCode = FAIL;
+        return ;
+    }
+    if (!ConvertFromJsValue(env, argv[ARGC_ONE], top)) {
+        TVMW_ERR_LOG("Failed to convert parameter to value of video display area.The value is %{public}d", top);
+        returnValue->errCode = FAIL;
+        return ;
+    }
+    if (!ConvertFromJsValue(env, argv[ARGC_TWO], right)) {
+        TVMW_ERR_LOG("Failed to convert parameter to value of video display area.The value is %{public}d", right);
+        returnValue->errCode = FAIL;
+        return ;
+    }
+    if (!ConvertFromJsValue(env, argv[ARGC_THREE], bottom)) {
+        TVMW_ERR_LOG("Failed to convert parameter to value of video display area.The value is %{public}d", bottom);
+        returnValue->errCode = FAIL;
+        return ;
+    }
+    if (left < MIN_VALUE || top < MIN_VALUE || right < MIN_VALUE || bottom < MIN_VALUE) {
+        TVMW_ERR_LOG("Invalid params.Check your input.");
+        returnValue->errCode = FAIL;
+        return ;
+    }
+    TVMW_DEBUG_LOG("The left ,top ,right ,height is %{public}d,%{public}d,%{public}d,%{public}d",
+                   left, top, right, bottom);
+}
+
+void DisplaySetting::Complete(napi_env env, NapiAsyncTask& task,
+                              std::shared_ptr<ReturnValue> returnValue)
+{
+    if (returnValue == nullptr) {
+        TVMW_ERR_LOG("returnValue is null!");
+        task.Reject(env, CreateJsError(env, returnValue->errCode,
+                                          "Can not get instance."));
+        return ;
+    }
+    if (returnValue->errCode != SUS) {
+        TVMW_ERR_LOG("errcode = FAIL.");
+        task.Reject(env, CreateJsError(env, returnValue->errCode,
+                                          "Invalid params.Check the number or type of params."));
+        return;
+    }
+    if (returnValue->ret != true) {
+        returnValue->errCode = FAIL;
+        TVMW_ERR_LOG("Failed to execute this function.");
+        task.Reject(env, CreateJsError(env, returnValue->errCode, "Fail to start SA."));
+        return ;
+    }
+    TVMW_DEBUG_LOG("Ready to create NativeValue.");
+    task.Resolve(env, CreateJsValue(env, returnValue->ret));
+}
