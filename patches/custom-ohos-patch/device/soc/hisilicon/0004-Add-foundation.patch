+void OrderSerialPort::ParseSetMacAddr(const std::vector<uint8_t> &data)
+{
+    if (data.size() != SET_MAC_ADDR_LEN || data[BIT2] != SET_MAC_ADDR_LEN || !CheckCode(data)) {
+        MSG_LOGE("%{public}s: NACK_PARAM_ERR", __func__);
+        WriteData(MakeAckData(data, NACK_PARAM_ERR));
+        return;
+    }
+
+    //handle
+    std::stringstream ss;
+    ss << std::hex << std::setfill('0');
+    for (uint32_t i = 5; i < data.size() - 2; ++i) {
+        ss << std::setw(2) << static_cast<int>(data[i]);
+        ss << ":";
+    }
+    ss << std::setw(2) << static_cast<int>(data[data.size()-2]);
+    std::string macAddr = ss.str();
+    MSG_LOGI("%{public}s, MacAddr:%{public}s", __func__, macAddr.c_str());
+
+    //interface:设置MAC地址
+    uint8_t ret = 
+        g_CVTEFuns.CVTE_SaveMACAddrToTV(const_cast<uint8_t*>(reinterpret_cast<const uint8_t*>(macAddr.c_str())),
+                                        macAddr.size());
+    if (ret != 0) {
+        MSG_LOGE("%{public}s: CVTE_SaveMACAddrToTV error", __func__);
+    }
+    WriteData(MakeAckData(data, ACK));
+}
+
+std::vector<uint8_t> OrderSerialPort::MakeRetMacAddr(const std::vector<uint8_t> &srcData, const std::string &macAddr)
+{
+    std::vector<uint8_t> byteArray;
+    byteArray.emplace_back(SYNC_WORD);
+    byteArray.emplace_back(START_WORD);
+    byteArray.emplace_back(RET_MAC_ADDR_LEN);
+    byteArray.emplace_back(AUTO_TEST_PROTOCOL);
+    byteArray.emplace_back(RET_MAC_ADDR);
+    
+    std::regex re("([^:]+):?");
+    std::sregex_iterator next(macAddr.begin(), macAddr.end(), re);
+    std::sregex_iterator end;
+    std::string macStr = "";
+    for(int32_t count = 0; next != end && count < 6; ++count) {
+        std::smatch match = *next;
+        macStr += match[1].str();
+        ++next;
+    }
+    std::vector<uint8_t> macVec = HexStringToByteArray(macStr);
+
+    byteArray.insert(byteArray.end(), macVec.begin(), macVec.end());
+    MakeCheckCode(byteArray);
+    MSG_LOGI("%{public}s: end, %{public}s", __func__, ByteArrayToHexString(byteArray).c_str());
+    return byteArray;
+}
