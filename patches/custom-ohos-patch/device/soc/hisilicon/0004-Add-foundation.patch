+
+namespace OHOS {
+namespace TvMWStandard {
+using namespace FileManagement::LibN;
+
+static void ExportEnumAudioHDMIMode(napi_env env, napi_value exports)
+{
+    const std::string propertyName = "AudioHDMIMode";
+    std::vector<napi_property_descriptor> desc = {
+        DECLARE_NAPI_STATIC_PROPERTY("HDMI_MODE_LPCM", NVal::CreateInt32(env, HDMI_MODE_LPCM).val_),
+        DECLARE_NAPI_STATIC_PROPERTY("HDMI_MODE_RAW", NVal::CreateInt32(env, HDMI_MODE_RAW).val_),
+        DECLARE_NAPI_STATIC_PROPERTY("HDMI_MODE_AUTO", NVal::CreateInt32(env, HDMI_MODE_AUTO).val_),
+    };
+
+    NVal enumObj = NVal::CreateObject(env);
+    if (!enumObj.AddProp(std::move(desc))) {
+        TVMW_INFO_LOG("Create enum AudioHDMIMode fail");
+        return;
+    }
+
+    NVal nVal(env, exports);
+    if (!nVal.AddProp(propertyName, enumObj.val_)) {
+        TVMW_INFO_LOG("Add enum AudioHDMIMode fail");
+        return;
+    }
+}
+
+static void ExportEnumAudioSPDIFMode(napi_env env, napi_value exports)
+{
+    const std::string propertyName = "AudioSPDIFMode";
+    std::vector<napi_property_descriptor> desc = {
+        DECLARE_NAPI_STATIC_PROPERTY("SPDIF_MODE_LPCM", NVal::CreateInt32(env, SPDIF_MODE_LPCM).val_),
+        DECLARE_NAPI_STATIC_PROPERTY("SPDIF_MODE_RAW", NVal::CreateInt32(env, SPDIF_MODE_RAW).val_),
+    };
+
+    NVal enumObj = NVal::CreateObject(env);
+    if (!enumObj.AddProp(std::move(desc))) {
+        TVMW_INFO_LOG("Create enum AudioSPDIFMode fail");
+        return;
+    }
+
+    NVal nVal(env, exports);
+    if (!nVal.AddProp(propertyName, enumObj.val_)) {
+        TVMW_INFO_LOG("Add enum AudioSPDIFMode fail");
+        return;
+    }
+}
+
+static void ExportEnumAudioNgenerationMode(napi_env env, napi_value exports)
+{
+    const std::string propertyName = "AudioNgenerationMode";
+    std::vector<napi_property_descriptor> desc = {
+        DECLARE_NAPI_STATIC_PROPERTY("NGENERATION_MODE_RAW", NVal::CreateInt32(env, NGENERATION_MODE_RAW).val_),
+        DECLARE_NAPI_STATIC_PROPERTY("NGENERATION_MODE_AUTO", NVal::CreateInt32(env, NGENERATION_MODE_AUTO).val_),
+        DECLARE_NAPI_STATIC_PROPERTY("NGENERATION_MODE_HBR2LBR", NVal::CreateInt32(env, NGENERATION_MODE_HBR2LBR).val_),
+    };
+
+    NVal enumObj = NVal::CreateObject(env);
+    if (!enumObj.AddProp(std::move(desc))) {
+        TVMW_INFO_LOG("Create enum AudioNgenerationMode fail");
+        return;
+    }
+
+    NVal nVal(env, exports);
+    if (!nVal.AddProp(propertyName, enumObj.val_)) {
+        TVMW_INFO_LOG("Add enum AudioNgenerationMode fail");
+        return;
+    }
+}
+
+static napi_value ModuleInit(napi_env env, napi_value exports)
+{
+    ExportEnumAudioHDMIMode(env, exports);
+    ExportEnumAudioSPDIFMode(env, exports);
+    ExportEnumAudioNgenerationMode(env, exports);
+
+    std::vector<std::unique_ptr<NExporter>> products;
+    products.emplace_back(std::make_unique<TvMWAudioNapi>(env, exports));
+    for (const auto &product : products) {
+        if (!product->Export()) {
+            TVMW_INFO_LOG("INNER BUG. Failed to export class %{public}s for module dk_napi",
+                product->GetClassName().c_str());
+            return nullptr;
+        } else {
+            TVMW_INFO_LOG("Class %{public}s for module dk_napi has been exported",
+                product->GetClassName().c_str());
+        }
+    }
+    return exports;
+}
+
+static napi_module g_module = {
+    .nm_version = 1,
+    .nm_flags = 0,
+    .nm_filename = nullptr,
+    .nm_register_func = ModuleInit,
+    .nm_modname = "tvmw.audio",
+    .nm_priv = ((void *)0),
+    .reserved = {0}
+};
+
+extern "C" __attribute__((constructor)) void RegisterModule(void)
+{
+    napi_module_register(&g_module);
+}
