+{
+    TVMW_DEBUG_LOG("TvMWAdapterManager::Init");
+    return ConnectServiceAdapter();
+}
+
+bool TvMWAdapterManager::ConnectServiceAdapter()
+{
+    TVMW_DEBUG_LOG("TvMWAdapterManager::ConnectServiceAdapter");
+    mTvMWServiceAdapter = TvMWServiceAdapter::CreateTvMWServiceAdapter();
+    if (!mTvMWServiceAdapter) {
+        TVMW_ERR_LOG("[TvMWAdapterManager] Error in tvmw adapter initialization");
+        return false;
+    }
+
+    bool result = mTvMWServiceAdapter->Connect();
+    if (!result) {
+        TVMW_ERR_LOG("[TvMWAdapterManager] Error in connecting tvmw adapter");
+        return false;
+    }
+    return true;
+}
