+    // Component labels, you can add if needed
+    COMP_APP = 0,
+    COMP_FWK = 1,
+    COMP_SVC = 2,
+    COMP_HDI = 3,
+    COMP_DRV = 4,
+    COMP_UTILS = 5,
+    // Test label
+    LABEL_TEST,
+    // The end of labels, max to the domain id range length 32
+    LABEL_END,
+};
+
+enum StandbyLogDomain {
+    DOMAIN_APP = STANDBY_DOMAIN_ID_START + COMP_APP,
+    DOMAIN_FRAMEWORK,
+    DOMAIN_SERVICE,
+    DOMAIN_HDI,
+    DOMAIN_DRIVER,
+    DOMAIN_UTILS,
+    DOMAIN_TEST = TEST_DOMAIN_ID,
+    DOMAIN_END = STANDBY_DOMAIN_ID_END,
+};
