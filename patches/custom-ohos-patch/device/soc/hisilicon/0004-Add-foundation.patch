+int32_t TvMWAbilityProxy::SetOutputSaturation(const int32_t &saturation)
+{
+    MessageParcel data;
+    MessageParcel reply;
+    MessageOption option;
+
+    TVMW_DEBUG_LOG("TvMWAbilityProxy::SetOutputSaturation start");
+    if (!data.WriteInterfaceToken(GetDescriptor())) {
+        TVMW_ERR_LOG("SetOutputSaturation: WriteInterfaceToken failed");
+        return ERR_IPC;
+    }
+
+    data.WriteInt32(saturation);
+    int32_t error = Remote() ->SendRequest(SET_OUTPUT_SATURATION, data, reply, option);
+    if (error != ERR_NONE) {
+        TVMW_ERR_LOG("SetOutputSaturation register playback event failed , error: %d", error);
+        return ERR_IPC;
+    }
+
+    return reply.ReadInt32();
+}
+
