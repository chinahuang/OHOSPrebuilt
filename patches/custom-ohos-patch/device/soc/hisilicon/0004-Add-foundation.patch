+
+#ifndef OHOS_TTVMW_LOG_H
+#define OHOS_TTVMW_LOG_H
+
+#undef LOG_DOMAIN
+#define LOG_DOMAIN 0xD002B71
+#ifndef MLOG_TAG
+#define MLOG_TAG "TvMW"
+#endif
+#undef LOG_TAG
+#define LOG_TAG "TvMW"
+
+#include "hilog/log.h"
+
+static inline OHOS::HiviewDFX::HiLogLabel LogLable()
+{
+    return { LOG_CORE, LOG_DOMAIN, LOG_TAG };
+}
+
+#define __FILE_NAME__ (__builtin_strrchr(__FILE__, '/') ? __builtin_strrchr(__FILE__, '/') + 1 : __FILE__)
+
+#define TVMW_HILOG(op, fmt, args...) \
+    do {                                  \
+        op(LogLable(), MLOG_TAG "[{%{public}s:%{public}s:%{public}d] " fmt, __FILE_NAME__, __FUNCTION__, __LINE__, ##args);  \
+    } while (0)
+
+#define TVMW_DEBUG_LOG(fmt, ...) TVMW_HILOG(OHOS::HiviewDFX::HiLog::Debug, fmt, ##__VA_ARGS__)
+#define TVMW_ERR_LOG(fmt, ...) TVMW_HILOG(OHOS::HiviewDFX::HiLog::Error, fmt, ##__VA_ARGS__)
+#define TVMW_WARN_LOG(fmt, ...) TVMW_HILOG(OHOS::HiviewDFX::HiLog::Warn, fmt, ##__VA_ARGS__)
+#define TVMW_INFO_LOG(fmt, ...) TVMW_HILOG(OHOS::HiviewDFX::HiLog::Info, fmt, ##__VA_ARGS__)
+#define TVMW_FATAL_LOG(fmt, ...) TVMW_HILOG(OHOS::HiviewDFX::HiLog::Fatal, fmt, ##__VA_ARGS__)
+
+#define CHECK_AND_RETURN_RET_LOG(cond, ret, fmt, ...)  \
+    do {                                               \
+        if (!(cond)) {                                 \
+            TVMW_ERR_LOG(fmt, ##__VA_ARGS__);            \
+            return ret;                                \
+        }                                              \
+    } while (0)
+
+#define CHECK_AND_RETURN_LOG(cond, fmt, ...)           \
+    do {                                               \
+        if (!(cond)) {                                 \
+            TVMW_ERR_LOG(fmt, ##__VA_ARGS__);            \
+            return;                                    \
+        }                                              \
+    } while (0)
+
+#define CHECK_AND_BREAK_LOG(cond, fmt, ...)            \
+    do {                                               \
+        if (!(cond)) {                                 \
+            TVMW_ERR_LOG(fmt, ##__VA_ARGS__);            \
+            break;                                     \
+        }                                              \
+    } while (0)
+
+#define RETURN_IF_WITH_RET(cond, retval) if (cond) {return (retval);}
+
+#define RETURN_IF_WITH_RET_WITH_LOG(cond, retval, fmt, ...)      \
+    do {                                                \
+        if (cond) {                                     \
+            TVMW_ERR_LOG(fmt, ##__VA_ARGS__);              \
+            return (retval);                            \
+        }                                               \
+    } while (0)
+
+#define RETURN_IF(cond) if (cond) {return;}
+
+#define RETURN_IF_WITH_LOG(cond, fmt, ...)              \
+    do {                                                \
+        if (cond) {                                     \
+            TVMW_ERR_LOG(fmt, ##__VA_ARGS__);               \
+            return;                                     \
+        }                                               \
+    } while (0)
+
+#endif // OHOS_TVMW_LOG_H
