+napi_value DisplaySetting::OnGetVideoDisplayArea(napi_env env, napi_callback_info info)
+{
+    TVMW_DEBUG_LOG("OnGetVideoDisplayArea in");
+    size_t argc = ARGC_FIVE;
+    napi_value argv[ARGC_FIVE] = {nullptr};
+    napi_get_cb_info(env, info, &argc, argv, nullptr, nullptr);
+
+    if (argc != 0) {
+        TVMW_ERR_LOG("Number of arguments unmatched, number must be zero !");
+        napi_throw(env, CreateJsError(env, FAIL, "Number of arguments unmatched, number must be zero !"));
+        return NapiGetUndefined(env);
+    }
+
+    int32_t left = MIN_VALUE;
+    int32_t top = MIN_VALUE;
+    int32_t right = MIN_VALUE;
+    int32_t bottom = MIN_VALUE;
+    int32_t ret = tvMWClientManager_->GetVideoDisplayArea(left, top, right, bottom);
+    if (ret != SUS) {
+        TVMW_ERR_LOG("Fail to call current standard client function.");
+        napi_throw(env, CreateJsError(env, FAIL, "Fail to call current standard client function."));
+        return NapiGetUndefined(env);
+    }
+
+    napi_value retValue = nullptr;
+    napi_create_object(env, &retValue);
+    if (retValue == nullptr) {
+        TVMW_ERR_LOG("Create Native object fail.");
+        napi_throw(env, CreateJsError(env, FAIL, "Create Native object fail."));
+        return NapiGetUndefined(env);
+    }
+
+    napi_value nativeLeft = CreateJsValue(env, left);
+    napi_value nativeTop = CreateJsValue(env, top);
+    napi_value nativeRight = CreateJsValue(env, right);
+    napi_value nativeBottom = CreateJsValue(env, bottom);
+    if (nativeLeft == nullptr || nativeTop == nullptr || nativeRight == nullptr || nativeBottom == nullptr) {
+        TVMW_ERR_LOG("Create native number fail.");
+        napi_throw(env, CreateJsError(env, FAIL, "Create native number fail."));
+        return NapiGetUndefined(env);
+    }
+
+    bool retBool = false;
+    retBool = napi_set_named_property(env, retValue, "left", nativeLeft);
+    retBool = napi_set_named_property(env, retValue, "top", nativeTop);
+    retBool = napi_set_named_property(env, retValue, "right", nativeRight);
+    retBool = napi_set_named_property(env, retValue, "bottom", nativeBottom);
+
+    if (!retBool) {
+        TVMW_ERR_LOG("Set property fail.");
+        napi_throw(env, CreateJsError(env, FAIL, "Set property fail."));
+        return NapiGetUndefined(env);
+    }
+    TVMW_DEBUG_LOG("OnGetVideoDisplayArea out");
+    return retValue;
+}
