+#include <string>
+#include <fcntl.h>
+#include <unistd.h>
+#include "instruction_adapter.h"
+#include "wifi_device.h"
+#include "usb_srv_client.h"
+#include "bluetooth_host.h"
+#include "ethernet_client.h"
+#include "message_log.h"
+static u8 g_cmdProcessEnable = true;
+u32 g_hdcpFileId = HDCP_FILE_TD_TEST;
+en_CVTE_AT_SOURCE g_tvSource = EN_AT_ATV;
+
+using namespace OHOS;
+using namespace OHOS::Wifi;
+using namespace OHOS::USB;
+using namespace OHOS::NetManagerStandard;
+using namespace OHOS::Produce;
+using namespace OHOS::Bluetooth;
+std::shared_ptr<WifiDevice> wifiDevicePtr = WifiDevice::GetInstance(WIFI_DEVICE_ABILITY_ID);
+s32 GetUsbDeviceInfo(const UsbDevice &device, u8* usb_count);
+
+u8 MappGetTvChecksum(u8* checksum)
+{
+    if (checksum == nullptr) {
+        MSG_LOGE("checksum nullptr");
+        return 0;
+    }
+    std::string cmd = "md5sum -b /system/app/com.ohos.settings/TVSettings.hap";
+    FILE *fp;
+    char path[1024] = {};
+
+    fp = popen(cmd.c_str(), "r");
+    if (fp == NULL) {
+        MSG_LOGE("Failed to run command");
+        return 0;
+    }
+
+    std::string result = "";
+    while (fgets(path, sizeof(path), fp) != NULL) {
+        result += path;
+    }
+
+    pclose(fp);
+    u32 len = result.size() - 1;
+    if (len > MAX_CHECK_SUM_LEN) {
+        len = MAX_CHECK_SUM_LEN;
+    }
+    if (memcpy_s(checksum, len, result.c_str(), len) != 0) {
+        MSG_LOGE("memcpy_s error:%{public}s", strerror(errno));
+        return 0;
+    }
+    MSG_LOGI("checksum:%{public}s,len:%{public}d", checksum, len);
+
+    return len;
+}
+
+u8 MappSetTvSource(en_CVTE_AT_SOURCE source)
+{
+    g_tvSource = source;
+    return 0;
+}
+
+u8 MappGetTvSource(en_CVTE_AT_SOURCE *source)
+{
+    if (source == nullptr) {
+        MSG_LOGE("source nullptr");
+        return 1;
+    }
+    *source = g_tvSource;
+
+    return 0;
+}
+
+u8 MappSetVolume(u8 volume)
+{
+    return 0;
+}
+
+u8 MappChangeTvNum(u16 num)
+{
+    return 0;
+}
+
+u8 MappUsartSendData(u8* datas, u16 len)
+{
+    return 0;
+}
+
+u8 MappGetTvMacAddr(u8* macAddr)
+{
+    if (macAddr == nullptr) {
+        MSG_LOGE("macAddr nullptr");
+        return 1;
+    }
+
+    std::vector<MacAddressInfo> macAddrList;
+    u32 result = DelayedSingleton<EthernetClient>::GetInstance()->GetMacAddress(macAddrList);
+    if (result != 0 || macAddrList.size() == 0) {
+        MSG_LOGE("GetMacAddress error, errorCode: %{public}d", result);
+        return 1;
+    }
+
+    for (int32_t i = 0; i < macAddrList.size(); ++i) {
+        if (macAddrList[i].iface_.compare("eth0") == 0) {
+            std::string macAddress = macAddrList[i].macAddress_;
+            if (memcpy_s(macAddr, macAddress.size(),macAddress.c_str(), macAddress.size()) != 0) {
+                MSG_LOGE("memcpy_s error");
+                return 1;
+            }
+            MSG_LOGI("MacAddress: %{public}s", macAddr);
+            return 0;
+        }
+    }
+
+    return 1;
+}
+
+u8 MappGetTvHdcpId(u32* hdcpId)
+{
+    if (hdcpId != nullptr) {
+        *hdcpId = g_hdcpFileId;
+        return 0;
+    } else {
+        MSG_LOGE("hdcpId nullptr");
+        return 1;
+    }
+}
+
+u8 MappGetTvciPlusId(u32* ciplusId)
+{
+    return 0;
+}
+
+u8 MappSaveHdcpKeyToTv(u8* key, u32 len, u32 fileId)
+{
+    char path[PATH_LEN] = {};
+    int fd = 0;
+    size_t bytesWritten = 0;
+
+    g_hdcpFileId = fileId;
+
+    if (key == nullptr) {
+        MSG_LOGE("key nullptr");
+        return 2;
+    }
+
+    snprintf(path, sizeof(path), "/data/produce/hdcpkey/%u", fileId);
+
+    fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, S_IRUSR | S_IWUSR | S_IRGRP | S_IROTH);
+    if (fd < 0) {
+        MSG_LOGE("Failed to open node: %{public}s", path);
+        return 2;
+    }
+
+    bytesWritten = write(fd, key, len);
+    if (bytesWritten != len) {
+        MSG_LOGE("Failed to write key to node: %{public}s", path);
+        close(fd);
+        return 2;
+    }
+
