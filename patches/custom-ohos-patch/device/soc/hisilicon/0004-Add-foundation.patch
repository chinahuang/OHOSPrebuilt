+ * limitations under the License.
+ */
+
+#include "standby_service.h"
+#include "common_event_data.h"
+#include "common_event_manager.h"
+#include "common_event_subscribe_info.h"
+#include "common_event_support.h"
+#include <common_event_publish_info.h>
+#include "sysparam.h"
+#include "input_manager.h"
+#include "power_mgr_client.h"
+#include "display_power_mgr_client.h"
+#include "iremote_object.h"
+#include "system_ability_definition.h"
+#include "standby_subscriber.h"
+#include "standby_log.h"
+#include "sleep_callback_helper.h"
+#include <ability_manager_client.h>
+#include "audio_system_manager.h"
+
+namespace OHOS {
+namespace PowerMgr {
+namespace {
+auto g_standbyService = DelayedSpSingleton<StandbyService>::GetInstance();
+const bool G_REGISTER_RESULT = SystemAbility::MakeAndRegisterAbility(g_standbyService.GetRefPtr());
+SysParam::BootCompletedCallback g_bootCompletedCallback;
+static constexpr int32_t SHORT_PRESS_DELAY_MS = 20;
+static constexpr int32_t LONG_PRESS_DELAY_MS = 2000;
+}
+
+using namespace MMI;
+using namespace DisplayPowerMgr;
+using namespace OHOS::AAFwk;
+using namespace OHOS::EventFwk;
+std::atomic_bool StandbyService::isBootCompleted_ = false;
+static sptr<hisiPowerStateListener> powerStateListener_ = nullptr;
+
+StandbyService::StandbyService() : SystemAbility(POWER_MANAGER_STANDBY_SERVICE_ID, true) {}
+
+StandbyService::~StandbyService() {}
+
+void StandbyService::OnStart()
+{
+    STANDBY_HILOGD(COMP_SVC, "standby manager startup");
+    if (ready_) {
+        STANDBY_HILOGI(COMP_SVC, "OnStart is ready, nothing to do");
+        return;
+    }
+    if (!Publish(this)) {
+        STANDBY_HILOGE(COMP_SVC, "Register to system ability manager failed");
+        return;
+    }
+    AddSystemAbilityListener(COMMON_EVENT_SERVICE_ID);
+    ready_ = true;
+    STANDBY_HILOGI(COMP_SVC, "Add system ability success");
+}
+
+bool StandbyService::Init()
+{
+    STANDBY_HILOGI(COMP_SVC, "Init start");
+#ifdef HISI_SUBSCRIBE_POWERKEY_EVENT
+    bool result = SubscribeShortPressPowerKeyDownEvent();
+    if (result == false) {
+        STANDBY_HILOGE(COMP_SVC, "Call ProcessShortPressPowerKeyDown failed");
+        return false;
+    }
+    result = SubscribeLongPressPowerKeyDownEvent();
+    if (result == false) {
+        STANDBY_HILOGE(COMP_SVC, "Call ProcessLongPressPowerKeyDown failed");
+        return false;
+    }
+#endif
+    powerStateListener_ = new (std::nothrow) hisiPowerStateListener();
+    PowerMgrClient::GetInstance().RegisterSyncSleepCallback(powerStateListener_, SleepPriority::HIGH);
+
+    STANDBY_HILOGI(COMP_SVC, "Init success");
+    return true;
+}
+
+bool StandbyService::SubscribeShortPressPowerKeyDownEvent()
+{
+    STANDBY_HILOGI(COMP_SVC, "SubscribeShortPressPowerKeyDownEvent start");
+    if (powerkeyShortPressId_ >= 0) {
+        STANDBY_HILOGI(COMP_SVC, "has been called init");
+        return true;
+    }
+
+    std::shared_ptr<KeyOption> keyOption = std::make_shared<KeyOption>();
+    std::set<int32_t> preKeys;
+
+    keyOption->SetPreKeys(preKeys);
+    keyOption->SetFinalKey(KeyEvent::KEYCODE_POWER);
+    keyOption->SetFinalKeyDown(true);
+    keyOption->SetFinalKeyDownDuration(SHORT_PRESS_DELAY_MS);
+    powerkeyShortPressId_ = InputManager::GetInstance()->SubscribeKeyEvent(
+        keyOption, [this](std::shared_ptr<KeyEvent> keyEvent) {
+            STANDBY_HILOGI(COMP_SVC, "receive short press powerkey down");
+            ShortPressPowerKeyDownStandby();
+        });
+
+    STANDBY_HILOGI(COMP_SVC, "powerkey register powerkeyShortPressId_=%{public}d", powerkeyShortPressId_);
+    return powerkeyShortPressId_ >= 0 ? true : false;
+}
+
+bool StandbyService::SubscribeLongPressPowerKeyDownEvent()
+{
+    STANDBY_HILOGI(COMP_SVC, "SubscribeLongPressPowerKeyDownEvent start");
+    if (powerkeyLongPressId_ >= 0) {
+        STANDBY_HILOGI(COMP_SVC, "has been called init");
+        return true;
+    }
+
+    std::shared_ptr<KeyOption> keyOption = std::make_shared<KeyOption>();
+    std::set<int32_t> preKeys;
+
+    keyOption->SetPreKeys(preKeys);
+    keyOption->SetFinalKey(KeyEvent::KEYCODE_POWER);
+    keyOption->SetFinalKeyDown(true);
+    keyOption->SetFinalKeyDownDuration(LONG_PRESS_DELAY_MS);
+    powerkeyLongPressId_ = InputManager::GetInstance()->SubscribeKeyEvent(
+        keyOption, [=](std::shared_ptr<KeyEvent> keyEvent) {
+            STANDBY_HILOGI(COMP_SVC, "receive long press powerkey down");
+            PowerMgrClient::GetInstance().ShutDownDevice(StandbyService::SHUTDOWN_REASON);
+        });
+
+    STANDBY_HILOGI(COMP_SVC, "powerkey register powerkeyLongPressId_=%{public}d", powerkeyLongPressId_);
+    return powerkeyLongPressId_ >= 0 ? true : false;
+}
+
+void StandbyService::ShortPressPowerKeyDownStandby()
+{
+    STANDBY_HILOGI(COMP_SVC, "Short press powerKey event received");
+    int32_t mode = SysParam::GetIntValue(KEY_STANDBY_MODE, DEF_STANDBY_MODE);
+
+    if (isBootCompleted_ == false) {
+        STANDBY_HILOGI(COMP_SVC, "system is not bootcompleted, do not need receive event in standby service");
+        return;
+    }
+
+    STANDBY_HILOGI(COMP_SVC, "standbymode:%{public}d", mode);
+    if (mode ==  STANDBY_MODE_SHUTDOWN) {
+        STANDBY_HILOGD(COMP_SVC, "standbymode:shutdown");
+        PowerMgrClient::GetInstance().ShutDownDevice(SHUTDOWN_REASON);
+    }
+    if (mode ==  STANDBY_MODE_STR) {
+        STANDBY_HILOGD(COMP_SVC, "StandbyMode: STR, force suspend to DeepSleep");
+        EnterDeepSleepPre();
+        PowerMgrClient::GetInstance().ForceSuspendDevice();
+    }
+    if (mode ==  STANDBY_MODE_LIGHTSLEEP) {
+        if (lightSleeping == false) {
+            EnterLightSleep();
+        } else {
+            ExitLightSleep();
+        }
+    }
+}
+
+void StandbyService::OnStop()
+{
+    STANDBY_HILOGW(COMP_SVC, "stop service");
+    if (!ready_) {
+        STANDBY_HILOGI(COMP_SVC, "OnStop is not ready, nothing to do");
+        return;
+    }
+    ready_ = false;
+    isBootCompleted_ = false;
+    RemoveSystemAbilityListener(COMMON_EVENT_SERVICE_ID);
+    if (!OHOS::EventFwk::CommonEventManager::UnSubscribeCommonEvent(subscriberPtr_)) {
+        STANDBY_HILOGE(COMP_SVC, "OnStart unregister to commonevent manager failed");
+    }
+}
+
+void StandbyService::OnAddSystemAbility(int32_t systemAbilityId, const std::string& deviceId)
+{
+    STANDBY_HILOGI(COMP_SVC, "systemAbilityId=%{public}d, deviceId=%{private}s", systemAbilityId, deviceId.c_str());
+    if (systemAbilityId == COMMON_EVENT_SERVICE_ID) {
+        //RegisterBootCompletedCallback();
+        SubscribeCommonEvent();
+    }
+}
+
+void StandbyService::RegisterBootCompletedCallback()
+{
+    g_bootCompletedCallback = []() {
+        STANDBY_HILOGI(COMP_SVC, "BootCompletedCallback triggered");
+        auto standby = DelayedSpSingleton<StandbyService>::GetInstance();
+        if (!standby->Init()) {
+        STANDBY_HILOGI(COMP_SVC, "Call init fail");
+        return;
+    }
+        isBootCompleted_ = true;
+    };
+    SysParam::RegisterBootCompletedCallback(g_bootCompletedCallback);
+}
+
+bool StandbyService::SubscribeCommonEvent()
+{
+    using namespace OHOS::EventFwk;
+    bool result = false;
+    MatchingSkills matchingSkills;
+    matchingSkills.AddEvent(CommonEventSupport::COMMON_EVENT_ENTER_FORCE_SLEEP);
+    matchingSkills.AddEvent(CommonEventSupport::COMMON_EVENT_EXIT_FORCE_SLEEP);
+    matchingSkills.AddEvent(CommonEventSupport::COMMON_EVENT_SCREEN_OFF);
+    matchingSkills.AddEvent(CommonEventSupport::COMMON_EVENT_SCREEN_ON);
+    CommonEventSubscribeInfo subscribeInfo(matchingSkills);
+    subscribeInfo.SetThreadMode(CommonEventSubscribeInfo::ThreadMode::COMMON);
+    if (!subscriberPtr_) {
+        subscriberPtr_ = std::make_shared<StandbySubscriber>(subscribeInfo);
+    }
+    result = CommonEventManager::SubscribeCommonEvent(subscriberPtr_);
+    if (!result) {
+        STANDBY_HILOGE(COMP_SVC, "Subscribe CommonEvent failed");
+    }
+    return result;
+}
+
+void StandbyService::PublishScreenOffEvent()
+{
+    STANDBY_HILOGI(COMP_SVC, "Start of publishing screenoff event");
+    CommonEventPublishInfo publishInfo;
+    publishInfo.SetOrdered(false);
+    IntentWant screenWant;
+    screenWant.SetAction(CommonEventSupport::COMMON_EVENT_SCREEN_OFF);
+    CommonEventData event(screenWant);
+    if (!CommonEventManager::PublishCommonEvent(event, publishInfo, nullptr)) {
+        STANDBY_HILOGE(COMP_SVC, "Publish the screenoff event fail");
+        return;
+    }
+    STANDBY_HILOGD(COMP_SVC, "End of publishing screenoff event");
+}
+
+void StandbyService::PublishScreenOnEvent()
+{
+    STANDBY_HILOGI(COMP_SVC, "Start of publishing screenon event");
+    CommonEventPublishInfo publishInfo;
+    publishInfo.SetOrdered(false);
+    IntentWant screenWant;
+    screenWant.SetAction(CommonEventSupport::COMMON_EVENT_SCREEN_ON);
+    CommonEventData event(screenWant);
+    if (!CommonEventManager::PublishCommonEvent(event, publishInfo, nullptr)) {
+        STANDBY_HILOGE(COMP_SVC, "Publish the screenon event fail");
+        return;
+    }
+    STANDBY_HILOGD(COMP_SVC, "End of publishing screenon event");
+}
+
+void StandbyService::EnterDeepSleepPre()
+{
+    STANDBY_HILOGD(COMP_SVC, "Enter DeepSleepPre");
+    DisplayPowerMgrClient::GetInstance().SetDisplayState(DisplayPowerMgr::DisplayState::DISPLAY_OFF,
+        StateChangeReason::STATE_CHANGE_REASON_HARD_KEY);
+    RestartLauncher();
+}
+
+void StandbyService::EnterLightSleep()
+{
+    STANDBY_HILOGD(COMP_SVC, "Enter LightSleep");
+    DisplayPowerMgrClient::GetInstance().SetDisplayState(DisplayPowerMgr::DisplayState::DISPLAY_OFF,
+        StateChangeReason::STATE_CHANGE_REASON_HARD_KEY);
+    PublishScreenOffEvent();
+    SetAudioMute(true);
+    lightSleeping = true;
+}
+
+void StandbyService::ExitLightSleep()
+{
+    STANDBY_HILOGD(COMP_SVC, "Exit LightSleep");
+    DisplayPowerMgrClient::GetInstance().SetDisplayState(DisplayPowerMgr::DisplayState::DISPLAY_ON,
+        StateChangeReason::STATE_CHANGE_REASON_HARD_KEY);
+    PublishScreenOnEvent();
+    SetAudioMute(false);
+    lightSleeping = false;
+}
+
+void StandbyService::RestartLauncher()
+{
+    auto ams = AbilityManagerClient::GetInstance();
+    if (ams == nullptr) {
+        STANDBY_HILOGW(COMP_SVC, "AbilityManagerClient is nullptr");
+        return;
+    }
+
+    Want want;
+    want.SetElementName("com.ohos.launcher", "com.ohos.launcher.MainAbility");
+    auto result = ams->StartAbility(want);
+    if (result != OHOS::ERR_OK) {
+        STANDBY_HILOGW(COMP_SVC, "start launcher failed");
+        return;
+    }
+    STANDBY_HILOGI(COMP_SVC, "Restart Launcher Success");
+}
+
+void StandbyService::SetAudioMute(bool mute)
+{
+    AudioStandard::AudioSystemManager *audioSystemManager = AudioStandard::AudioSystemManager::GetInstance();
+    AudioStandard::AudioVolumeType volumeType = AudioStandard::AudioVolumeType::STREAM_ALL;
+    if (mute) {
+        STANDBY_HILOGD(COMP_SVC, "set audio mute");
+        audioSystemManager->SetMute(volumeType, true);
+    } else {
+        STANDBY_HILOGD(COMP_SVC, "set audio Unmute");
+        audioSystemManager->SetMute(volumeType, false);
+    }
+}
+} // namespace PowerMgr
+} // namespace OHOS
