+TvMWServiceAdapter::~TvMWServiceAdapter() = default;
+TvMWServiceAdapterImpl::~TvMWServiceAdapterImpl() = default;
+
+unique_ptr<TvMWServiceAdapter> TvMWServiceAdapter::CreateTvMWServiceAdapter()
+{
+    return make_unique<TvMWServiceAdapterImpl>();
+}
+
+TvMWServiceAdapterImpl::TvMWServiceAdapterImpl() = default;
+
+bool TvMWServiceAdapterImpl::Connect()
+{
+    TVMW_DEBUG_LOG("start");
+    hAout = HAL_INVALID_HANDLE;
+    hVout = HAL_INVALID_HANDLE;
