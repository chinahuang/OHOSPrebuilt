+napi_value DisplaySetting::GetNLAPoint(napi_env env, napi_callback_info info)
+{
+    NFuncArg funcArg(env, info);
+    if (!funcArg.InitArgs(NARG_CNT::ONE, NARG_CNT::TWO)) {
+        NError(ERR_PARAM_NUMBER).ThrowErr(env, "Number of arguments unmatched, number must be 1 or 2 !");
+        return nullptr;
+    }
+
+    auto [ret, nlaItem] = NVal(env, funcArg[NARG_POS::FIRST]).ToInt32();
+    if (!ret || nlaItem < NLAItem::NLA_BRIGHTNESS || nlaItem > NLAItem::NLA_BACKLIGHT) {
+        std::string errorMsg = "nlaItem argument is invalid, value must between "
+                + std::to_string(NLAItem::NLA_BRIGHTNESS) + " and " + std::to_string(NLAItem::NLA_BACKLIGHT) + ".";
+        NError(ERR_INVALID_PARAM).ThrowErr(env, errorMsg);
+        return nullptr;
+    }
+
+    auto result = std::make_shared<NLAPoint>();
+    auto cbExec = [result, nlaItem = nlaItem]() -> NError {
+        auto *tvMWClient = &TvMWClientManager::GetInstance();
+        if (tvMWClient == nullptr) {
+            return NError(ERR_NULL_POINTER);
+        }
+
+        auto ret = tvMWClient->GetNLAPoint(nlaItem, *result);
+        return NError(ret);
+    };
+    auto cbComplete = [result](napi_env env, NError err) -> NVal {
+        if (err) {
+            return { env, err.GetNapiErr(env) };
+        }
+
+        napi_value retValue = nullptr;
+        napi_create_object(env, &retValue);
+        if (retValue == nullptr) {
+            TVMW_ERR_LOG("Create Native object fail.");
+            return { env, err.GetNapiErr(env) };
+        }
+
+        napi_value n_x0 = CreateJsValue(env, (*result).x0);
+        napi_value n_x25 = CreateJsValue(env, (*result).x25);
+        napi_value n_x50 = CreateJsValue(env, (*result).x50);
+        napi_value n_x75 = CreateJsValue(env, (*result).x75);
+        napi_value n_x100 = CreateJsValue(env, (*result).x100);
+        if (n_x0 == nullptr || n_x25 == nullptr || n_x50 == nullptr || n_x75 == nullptr || n_x100 == nullptr) {
+            TVMW_ERR_LOG("Create native number fail.");
+            return { env, err.GetNapiErr(env) };
+        }
+        int32_t retStatus = napi_ok;
+        retStatus += napi_set_named_property(env, retValue, "x0", n_x0);
+        retStatus += napi_set_named_property(env, retValue, "x25", n_x25);
+        retStatus += napi_set_named_property(env, retValue, "x50", n_x50);
+        retStatus += napi_set_named_property(env, retValue, "x75", n_x75);
+        retStatus += napi_set_named_property(env, retValue, "x100", n_x100);
+        if (retStatus != napi_ok) {
+            TVMW_ERR_LOG("napi_set_named_property fail.");
+            return { env, err.GetNapiErr(env) };
+        }
+
+        return {env, retValue};
+    };
+
+    const std::string name = "GetNLAPoint";
+    NVal thisVar(env, funcArg.GetThisVar());
+    if (funcArg.GetArgc() == NARG_CNT::ONE) {
+        return NAsyncWorkPromise(env, thisVar).Schedule(name, cbExec, cbComplete).val_;
+    }
+
+    NVal cb(env, funcArg[NARG_POS::SECOND]);
+    if (!cb.TypeIs(napi_function)) {
+        NError(ERR_INVALID_PARAM).ThrowErr(env, "The second argument must be a function");
+        return nullptr;
+    }
+
+    return NAsyncWorkCallback(env, thisVar, cb).Schedule(name, cbExec, cbComplete).val_;
+}
