+void TvMWSystemAbility::SetSettingSaturation(uint32_t value)
+{
+    uint32_t settingSaturation = GetSettingSaturation();
+    if (value == static_cast<uint32_t>(settingSaturation)) {
+        TVMW_INFO_LOG("no need to set setting Saturation");
+        return;
+    }
+    SettingProvider& provider = SettingProvider::GetInstance(TVMW_SERVICE_ID);
+    ErrCode ret = provider.PutIntValue(SETTING_SATURATION_KEY, static_cast<int32_t>(value));
+    if (ret != ERR_OK) {
+        TVMW_INFO_LOG("set setting Saturation failed, ret=%{public}d", ret);
+        return;
+    }
+
+    TVMW_INFO_LOG("SetSettingSaturation: %{public}d", value);
+    cachedSettingSaturation_ = value;
+}
