+std::vector<uint8_t> OrderSerialPort::MakeRetIpInfo(const std::vector<uint8_t> &srcData, const std::string &ipAddr)
+{
+    std::vector<uint8_t> byteArray;
+    byteArray.emplace_back(SYNC_WORD);
+    byteArray.emplace_back(START_WORD);
+    
+    std::vector<uint8_t> ipVec;
+    SplitIpInfo(ipAddr, ipVec);
+    byteArray.emplace_back(ipVec.size() + NORMAL_DATA_SIZE);
+    byteArray.emplace_back(AUTO_TEST_PROTOCOL);
+    byteArray.emplace_back(RET_IP_INFO);
+    byteArray.insert(byteArray.end(), ipVec.begin(), ipVec.end());
+
+    MakeCheckCode(byteArray);
+    MSG_LOGI("%{public}s: end, %{public}s", __func__, ByteArrayToHexString(byteArray).c_str());
+    return byteArray;
+}
+
+void OrderSerialPort::ParseGetIpInfo(const std::vector<uint8_t> &data)
+{
+    if (data.size() != GET_IP_INFO_LEN || data[BIT2] != GET_IP_INFO_LEN || !CheckCode(data)) {
+        MSG_LOGE("%{public}s: NACK_PARAM_ERR", __func__);
+        WriteData(MakeAckData(data, NACK_PARAM_ERR));
+        return;
+    }
+
+    //interface:检查IP地址
+    uint8_t ip[IP_MAX_LEN] = {};
+    std::string ipAddr = "";
+    uint8_t ret = g_CVTEFuns.CVTE_GetIPAddr(ip);
+    if (ret == 0) {
+        MSG_LOGE("%{public}s: CVTE_GetIPAddr error", __func__);
+    } else {
+        ipAddr = std::string(reinterpret_cast<const char*>(ip), ret);
+    }
+    WriteData(MakeRetIpInfo(data, ipAddr));
+}
+
+
+std::vector<uint8_t> OrderSerialPort::MakeRetWifiStatus(const std::vector<uint8_t> &srcData, uint8_t status)
+{
+    std::vector<uint8_t> byteArray;
+    byteArray.emplace_back(SYNC_WORD);
+    byteArray.emplace_back(START_WORD);
+    byteArray.emplace_back(RET_WIFI_STATUS_LEN);
+    byteArray.emplace_back(AUTO_TEST_PROTOCOL);
+    byteArray.emplace_back(RET_WIFI_STATUS);
+    byteArray.emplace_back(status);
+
+    MakeCheckCode(byteArray);
+    MSG_LOGI("%{public}s: end, %{public}s", __func__, ByteArrayToHexString(byteArray).c_str());
+    return byteArray;
+}
+
+void OrderSerialPort::ParseGetWifiStatus(const std::vector<uint8_t> &data)
+{
+    if (data.size() != GET_WIFI_STATUS_LEN || data[BIT2] != GET_WIFI_STATUS_LEN || !CheckCode(data)) {
+        MSG_LOGE("%{public}s: NACK_PARAM_ERR", __func__);
+        WriteData(MakeAckData(data, NACK_PARAM_ERR));
+        return;
+    }
+
+    //interface:检查WIFI
+    uint8_t status = CHECK_FAIL;
+    uint8_t ret = g_CVTEFuns.CVTE_GetWifiTestResult(&status);
+    if (ret != 0) {
+        MSG_LOGE("%{public}s: CVTE_GetWifiTestResult error", __func__);
+    }
+    MSG_LOGI("status:%{public}d", status);
+    WriteData(MakeRetWifiStatus(data, status));
+}
+
+
+std::vector<uint8_t> OrderSerialPort::MakeRetUsbCount(const std::vector<uint8_t> &srcData, uint8_t count)
+{
+    std::vector<uint8_t> byteArray;
+    byteArray.emplace_back(SYNC_WORD);
+    byteArray.emplace_back(START_WORD);
+    byteArray.emplace_back(RET_USB_COUNT_LEN);
+    byteArray.emplace_back(AUTO_TEST_PROTOCOL);
+    byteArray.emplace_back(RET_USB_COUNT);
+    byteArray.emplace_back(count);
+
+    MakeCheckCode(byteArray);
+    MSG_LOGI("%{public}s: end, %{public}s", __func__, ByteArrayToHexString(byteArray).c_str());
+    return byteArray;
+}
+
+void OrderSerialPort::ParseGetUsbCount(const std::vector<uint8_t> &data)
+{
+    if (data.size() != GET_USB_COUNT_LEN || data[BIT2] != GET_USB_COUNT_LEN || !CheckCode(data)) {
+        MSG_LOGE("%{public}s: NACK_PARAM_ERR", __func__);
+        WriteData(MakeAckData(data, NACK_PARAM_ERR));
+        return;
+    }
+
+    //interface:检查USB
+    uint8_t count = 0;
+    uint8_t ret = g_CVTEFuns.CVTE_GetUSBConnectCount(&count);
+    if (ret != 0) {
+        MSG_LOGE("%{public}s: CVTE_GetUSBConnectCount error", __func__);
+    }
+    WriteData(MakeRetUsbCount(data, count));
+}
+
+
+void OrderSerialPort::ParseSendCvteFacIr(const std::vector<uint8_t> &data)
+{
+    if (data.size() != SEND_CVTE_FAC_IR_LEN || data[BIT2] != SEND_CVTE_FAC_IR_LEN || !CheckCode(data)) {
+        MSG_LOGE("%{public}s: NACK_PARAM_ERR", __func__);
+        WriteData(MakeAckData(data, NACK_PARAM_ERR));
+        return;
+    }
+
+    //interface:发送遥控指令
+    uint8_t id = data[BIT5];
+    MSG_LOGI("%{public}s, id:%{public}d", __func__, id);
+
+    uint8_t ret = g_CVTEFuns.CVTE_FAC_IR_Ctrl(id);
+    if (ret != 0) {
+        MSG_LOGE("%{public}s: CVTE_FAC_IR_Ctrl error", __func__);
+    }
+    WriteData(MakeAckData(data, ACK));
+}
+
+std::vector<uint8_t> OrderSerialPort::MakeRetBluetoothStatus(const std::vector<uint8_t> &srcData, uint8_t status)
+{
+    std::vector<uint8_t> byteArray;
+    byteArray.emplace_back(SYNC_WORD);
+    byteArray.emplace_back(START_WORD);
+    byteArray.emplace_back(RET_BLUETOOTH_STATUS_LEN);
+    byteArray.emplace_back(AUTO_TEST_PROTOCOL);
+    byteArray.emplace_back(RET_BLUETOOTH_STATUS);
+    byteArray.emplace_back(status);
+
+    MakeCheckCode(byteArray);
+    MSG_LOGI("%{public}s: end, %{public}s", __func__, ByteArrayToHexString(byteArray).c_str());
+    return byteArray;
+}
+
+void OrderSerialPort::ParseCheckBluetooth(const std::vector<uint8_t> &data)
+{
+    if (data.size() != CHECK_BLUETOOTH_LEN || data[BIT2] != CHECK_BLUETOOTH_LEN || !CheckCode(data)) {
+        MSG_LOGE("%{public}s: NACK_PARAM_ERR", __func__);
+        WriteData(MakeAckData(data, NACK_PARAM_ERR));
+        return;
+    }
+
+    //interface:检查BLUETOOTH
+    uint8_t status = CHECK_FAIL;
+    uint8_t ret = g_CVTEFuns.CVTE_CheckBluetoochStatus(&status);
+    if (ret != 0) {
+        MSG_LOGE("%{public}s: CVTE_CheckBluetoochStatus error", __func__);
+    }
+    WriteData(MakeRetBluetoothStatus(data, status));
+}
+
+void OrderSerialPort::ParseProduceVersionRollback(const std::vector<uint8_t> &data)
+{
+    if (data.size() != PRODUCE_VERSION_ROLLBACK_LEN || data[BIT2] != PRODUCE_VERSION_ROLLBACK_LEN || !CheckCode(data)) {
+        MSG_LOGE("%{public}s: NACK_PARAM_ERR", __func__);
+        WriteData(MakeAckData(data, NACK_PARAM_ERR));
+        return;
+    }
+
+    if (!OHOS::system::SetParameter("persist.produce.back", "true")) {
+        MSG_LOGE("SetParameter persist.produce.back error");
+    }
+
+    WriteData(MakeAckData(data, ACK));
+}
+
+int32_t OrderSerialPort::EnableSerialPort()
+{
+    fd_ = OpenPort(PORT_NAME, B115200);
+    if (fd_ <= 0) {
+        fd_ = OpenPort(PORT_NAME_BACKUP, B115200);
+        if (fd_ <= 0) {
+            MSG_LOGE("%{public}s OpenPort error", __func__);
+            return -1;
+        }
+    }
+
+    stopWriting_ = false;
+    stopReading_ = false;
+
+    std::thread recvThread(&OrderSerialPort::Receiver, this);
+    std::thread sendThread(&OrderSerialPort::Sender, this);
+
+    recvThread.detach();
+    sendThread.detach();
+
+    return 0;
+}
+
+} // namespace Produce
+} // namespace OHOS
