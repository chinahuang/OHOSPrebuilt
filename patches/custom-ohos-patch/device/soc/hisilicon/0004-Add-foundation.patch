+static S32 DispServerInit()
+{
+    S32 s32Ret = FAILURE;
+    VOUT_INIT_PARAMS_S stVOutInit;
+    VOUT_OPEN_PARAMS_S stVOutOpen;
+
+    errno_t ret = memset_s(&stVOutInit, sizeof(VOUT_INIT_PARAMS_S), 0, sizeof(VOUT_INIT_PARAMS_S));
+    if (ret != EOK) {
+        TVMW_ERR_LOG("memset failed, ret(%d)", ret);
+        return s32Ret;
+    }
+
+    s32Ret = getVoutDevice()->vout_init(NULL, &stVOutInit);
+    if (s32Ret != SUCCESS) {
+        TVMW_ERR_LOG("@vout init or open failed, ret(%x)", s32Ret);
+        return s32Ret;
+    }
+
+    s32Ret = getVoutDevice()->vout_open_channel(NULL, &hVout, &stVOutOpen);
+    if (s32Ret != SUCCESS) {
+        TVMW_ERR_LOG("vout init or open failed, ret(%x)", s32Ret);
+        return s32Ret;
+    }
+
+    s32Ret = getVoutDevice()->vout_window_create(NULL, hVout, &hWinHandle, NULL);
+    if (s32Ret != SUCCESS) {
+        TVMW_ERR_LOG("vout init or window create failed, ret(%x)", s32Ret);
+        return s32Ret;
+    }
+
+    return SUCCESS;
+}
+
+static S32 DispServerDeinit()
+{
+    S32 s32Ret = FAILURE;
+    VOUT_TERM_PARAM_S stTerm;
+    VOUT_CLOSE_PARAMS_S stVoutClose;
+
+    errno_t ret = memset_s(&stTerm, sizeof(VOUT_TERM_PARAM_S), 0, sizeof(VOUT_TERM_PARAM_S));
+    if (ret != EOK) {
+        TVMW_ERR_LOG("memset failed, ret(%d)", ret);
+        return s32Ret;
+    }
+
+    ret = memset_s(&stVoutClose, sizeof(VOUT_CLOSE_PARAMS_S), 0, sizeof(VOUT_CLOSE_PARAMS_S));
+    if (ret != EOK) {
+        TVMW_ERR_LOG("memset failed, ret(%d)", ret);
+        return s32Ret;
+    }
+
+    if (hWinHandle != HAL_INVALID_HANDLE) {
+        s32Ret = getVoutDevice()->vout_window_destroy(NULL, hWinHandle, hWinHandle, NULL);
+        hWinHandle = HAL_INVALID_HANDLE;
+        TVMW_ERR_LOG("Destory window, result code(%x)", s32Ret);
+        return s32Ret;
+    }
+
+    s32Ret = getVoutDevice()->vout_close_channel(NULL, hVout, &stVoutClose);
+    if (s32Ret != SUCCESS) {
+        TVMW_DEBUG_LOG("vout_close failed, ret(%x)", s32Ret);
+        return s32Ret;
+    }
+
+    s32Ret = getVoutDevice()->vout_term(NULL, &stTerm);
+    if (s32Ret != SUCCESS) {
+        TVMW_DEBUG_LOG("vout_term failed, ret(%x)", s32Ret);
+        return s32Ret;
+    }
+
+    hVout = HAL_INVALID_HANDLE;
+    TVMW_DEBUG_LOG("DispServerDeinit success!\n");
+    return s32Ret;
+}
+
+static S32 initAudioDevice()
+{
+    S32 s32Ret = FAILURE;
+    AOUT_INIT_PARAMS_S stAoutInit;
+    AOUT_OPEN_PARAMS_S stAoutOpen;
+
+    errno_t ret = memset_s(&stAoutInit, sizeof(AOUT_INIT_PARAMS_S), 0, sizeof(AOUT_INIT_PARAMS_S));
+    if (ret != EOK) {
+        TVMW_ERR_LOG("memset failed, ret(%d)", ret);
+        return s32Ret;
+    }
+
+    ret = memset_s(&stAoutOpen, sizeof(AOUT_OPEN_PARAMS_S), 0, sizeof(AOUT_OPEN_PARAMS_S));
+    if (ret != EOK) {
+        TVMW_ERR_LOG("memset failed, ret(%d)", ret);
+        return s32Ret;
+    }
+
+    s32Ret = getAOutDevice()->aout_init(NULL, &stAoutInit);
+    if (s32Ret != SUCCESS) {
+        TVMW_ERR_LOG("@aout init or open failed, ret(%x)", s32Ret);
+        return s32Ret;
+    }
+
+    stAoutOpen.enId = AOUT_ID_0;
+    stAoutOpen.stSettings.enOutputDevice = AOUT_DEVICE_ALL;
+    s32Ret = getAOutDevice()->aout_open(NULL, &hAout, &stAoutOpen);
+    if (s32Ret != SUCCESS) {
+        TVMW_ERR_LOG("@aout init or open failed, ret(%x)", s32Ret);
+        return s32Ret;
+    }
+
+    return s32Ret;
+}
+
+static S32 deinitAudioDevice()
+{
+    S32 s32Ret = FAILURE;
+    AOUT_TERM_PARAMS_S stTerm;
+    AOUT_CLOSE_PARAMS_S stClose;
+
+    errno_t ret = memset_s(&stTerm, sizeof(AOUT_TERM_PARAMS_S), 0, sizeof(AOUT_TERM_PARAMS_S));
+    if (ret != EOK) {
+        TVMW_ERR_LOG("memset failed, ret(%d)", ret);
+        return s32Ret;
+    }
+
+    ret = memset_s(&stClose, sizeof(AOUT_CLOSE_PARAMS_S), 0, sizeof(AOUT_CLOSE_PARAMS_S));
+    if (ret != EOK) {
+        TVMW_ERR_LOG("memset failed, ret(%d)", ret);
+        return s32Ret;
+    }
+
+    s32Ret = getAOutDevice()->aout_close(NULL, hAout, &stClose);
+    if (s32Ret != SUCCESS) {
+        TVMW_ERR_LOG("@aout deinit failed, ret(%x)", s32Ret);
+        return s32Ret;
+    }
+
+    s32Ret = getAOutDevice()->aout_term(NULL, &stTerm);
+    if (s32Ret != SUCCESS) {
+        TVMW_ERR_LOG("@aout close failed, ret(%x)", s32Ret);
+        return s32Ret;
+    }
+
+    hAout = HAL_INVALID_HANDLE;
+    return s32Ret;
+}
