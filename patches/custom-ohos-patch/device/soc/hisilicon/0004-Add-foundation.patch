+static constexpr OHOS::HiviewDFX::HiLogLabel STANDBY_LABEL[LABEL_END] = {
+    {LOG_CORE, DOMAIN_APP,       "StandbyApp"},
+    {LOG_CORE, DOMAIN_FRAMEWORK, "StandbyFwk"},
