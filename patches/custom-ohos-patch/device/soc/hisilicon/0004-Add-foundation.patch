+napi_value DisplaySetting::GetColorTempParam(napi_env env, napi_callback_info info)
+{
+    NFuncArg funcArg(env, info);
+    if (!funcArg.InitArgs(NARG_CNT::ONE, NARG_CNT::TWO)) {
+        NError(ERR_PARAM_NUMBER).ThrowErr(env, "Number of arguments unmatched, number must be 1 or 2 !");
+        return nullptr;
+    }
+
+    auto [ret, colorTemp] = NVal(env, funcArg[NARG_POS::FIRST]).ToInt32();
+    if (!ret || colorTemp < ColorTempType::CLRTMP_STANDARD || colorTemp > ColorTempType::CLRTMP_TOWARM) {
+        std::string errorMsg = "colorTemp argument is invalid, value must between "
+                + std::to_string(ColorTempType::CLRTMP_STANDARD) + " and "
+                + std::to_string(ColorTempType::CLRTMP_TOWARM) + ".";
+        NError(ERR_INVALID_PARAM).ThrowErr(env, errorMsg);
+        return nullptr;
+    }
+
+    auto result = std::make_shared<ColorTempParam>();
+    auto cbExec = [result, colorTemp = colorTemp]() -> NError {
+        auto *tvMWClient = &TvMWClientManager::GetInstance();
+        if (tvMWClient == nullptr) {
+            return NError(ERR_NULL_POINTER);
+        }
+
+        auto ret = tvMWClient->GetColorTempParam(colorTemp, *result);
+        return NError(ret);
+    };
+    auto cbComplete = [result](napi_env env, NError err) -> NVal {
+        if (err) {
+            return { env, err.GetNapiErr(env) };
+        }
+
+        napi_value retValue = nullptr;
+        napi_create_object(env, &retValue);
+        if (retValue == nullptr) {
+            TVMW_ERR_LOG("Create Native object fail.");
+            return { env, err.GetNapiErr(env) };
+        }
+
+        napi_value n_redGain = CreateJsValue(env, (*result).redGain);
+        napi_value n_greenGain = CreateJsValue(env, (*result).greenGain);
+        napi_value n_blueGain = CreateJsValue(env, (*result).blueGain);
+        napi_value n_redOffset = CreateJsValue(env, (*result).redOffset);
+        napi_value n_greenOffset = CreateJsValue(env, (*result).greenOffset);
+        napi_value n_blueOffset = CreateJsValue(env, (*result).blueOffset);
+        if (n_redGain == nullptr || n_greenGain == nullptr || n_blueGain == nullptr ||
+            n_redOffset == nullptr || n_greenOffset == nullptr || n_blueOffset == nullptr) {
+            TVMW_ERR_LOG("Create native number fail.");
+            return { env, err.GetNapiErr(env) };
+        }
+        int32_t retStatus = napi_ok;
+        retStatus += napi_set_named_property(env, retValue, "redGain", n_redGain);
+        retStatus += napi_set_named_property(env, retValue, "greenGain", n_greenGain);
+        retStatus += napi_set_named_property(env, retValue, "blueGain", n_blueGain);
+        retStatus += napi_set_named_property(env, retValue, "redOffset", n_redOffset);
+        retStatus += napi_set_named_property(env, retValue, "greenOffset", n_greenOffset);
+        retStatus += napi_set_named_property(env, retValue, "blueOffset", n_blueOffset);
+        if (retStatus != napi_ok) {
+            TVMW_ERR_LOG("napi_set_named_property fail.");
+            return { env, err.GetNapiErr(env) };
+        }
+
+        return {env, retValue};
+    };
+
+    const std::string name = "GetColorTempParam";
+    NVal thisVar(env, funcArg.GetThisVar());
+    if (funcArg.GetArgc() == NARG_CNT::ONE) {
+        return NAsyncWorkPromise(env, thisVar).Schedule(name, cbExec, cbComplete).val_;
+    }
+
+    NVal cb(env, funcArg[NARG_POS::SECOND]);
+    if (!cb.TypeIs(napi_function)) {
+        NError(ERR_INVALID_PARAM).ThrowErr(env, "The second argument must be a function");
+        return nullptr;
+    }
+
+    return NAsyncWorkCallback(env, thisVar, cb).Schedule(name, cbExec, cbComplete).val_;
+}
