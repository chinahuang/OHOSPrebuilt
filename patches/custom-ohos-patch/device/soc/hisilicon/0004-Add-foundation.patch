+int32_t TvMWServiceAdapterImpl::SetOutputStandard(const std::string &standard)
+{
+    TVMW_DEBUG_LOG("start");
+    VOUT_DISPSETTING_S stVoutDispSetting;
+
+    S32 s32Ret = FAILURE;
+    errno_t ret = memset_s(&stVoutDispSetting, sizeof(VOUT_DISPSETTING_S), 0, sizeof(VOUT_DISPSETTING_S));
+    if (ret != EOK) {
+        TVMW_ERR_LOG("memset failed, ret(%d)", ret);
+        return s32Ret;
+    }
+
+    s32Ret =  getVoutDevice()->vout_display_get(NULL, hVout, &stVoutDispSetting);
+    if (s32Ret != SUCCESS) {
+        TVMW_ERR_LOG("hal failed, ret(%x)", s32Ret);
+        return static_cast<int32_t>(s32Ret);
+    }
+
+    std::vector<std::string> strVec = SplitStandard(standard);
+    stVoutDispSetting.enDispFmt = GetFmtByString(strVec[0]);
+    stVoutDispSetting.enFrameRate = GetRateByString(strVec[1]);
+    s32Ret = getVoutDevice()->vout_display_set(NULL, hVout, &stVoutDispSetting);
+    if (s32Ret != SUCCESS) {
+        TVMW_ERR_LOG("hal failed, ret(%x)", s32Ret);
+        return static_cast<int32_t>(s32Ret);
+    }
+
+    TVMW_DEBUG_LOG("end");
+    return static_cast<int32_t>(s32Ret);
+}
