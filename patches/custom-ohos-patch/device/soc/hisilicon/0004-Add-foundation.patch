+
+namespace OHOS {
+namespace TvMWStandard {
+bool TvMWAudioNapi::Export()
+{
+    return exports_.AddProp({
+        NVal::DeclareNapiFunction("setOutputHDMIMode", SetOutputHDMIMode),
+        NVal::DeclareNapiFunction("getOutputHDMIMode", GetOutputHDMIMode),
+        NVal::DeclareNapiFunction("setOutputSPDIFMode", SetOutputSPDIFMode),
+        NVal::DeclareNapiFunction("getOutputSPDIFMode", GetOutputSPDIFMode),
+        NVal::DeclareNapiFunction("setOutNgenerationMode", SetOutNgenerationMode),
+        NVal::DeclareNapiFunction("getOutNgenerationMode", GetOutNgenerationMode),
+    });
+}
+
+napi_value TvMWAudioNapi::SetOutputHDMIMode(napi_env env, napi_callback_info info)
+{
+    TVMW_INFO_LOG("SetOutputHDMIMode in");
+    NFuncArg funcArg(env, info);
+    if (!funcArg.InitArgs(NARG_CNT::ONE, NARG_CNT::TWO)) {
+        NError(ERR_PARAM_NUMBER).ThrowErr(env, "Number of arguments unmatched, number must be 1 or 2 !");
+        return nullptr;
+    }
+
+    auto [ret, mode] = NVal(env, funcArg[NARG_POS::FIRST]).ToInt32();
+    if (!ret || mode < AudioHDMIMode::HDMI_MODE_LPCM || mode > AudioHDMIMode::HDMI_MODE_AUTO) {
+        NError(ERR_INVALID_PARAM).ThrowErr(env,
+            "Mode argument is invalid, value must between HDMI_MODE_LPCM and HDMI_MODE_AUTO");
+        return nullptr;
+    }
+    TVMW_INFO_LOG("SetOutputHDMIMode mode:%{public}d", mode);
+    auto result = std::make_shared<bool>();
+    auto cbExec = [result, mode = mode]() -> NError {
+        auto *tvMWClient = &TvMWClientManager::GetInstance();
+        if (tvMWClient == nullptr) {
+            return NError(ERR_NULL_POINTER);
+        }
+
+        *result = (tvMWClient->SetOutputHDMIMode(mode) == SUS);
+        return NError(SUS);
+    };
+    auto cbComplete = [result](napi_env env, NError err) -> NVal {
+        if (err) {
+            return { env, err.GetNapiErr(env) };
+        }
+
+        TVMW_INFO_LOG("SetOutputHDMIMode result:%{public}d", *result);
+        return NVal::CreateBool(env, *result);
+    };
+
+    const std::string name = "SetOutputHDMIMode";
+    NVal thisVar(env, funcArg.GetThisVar());
+    if (funcArg.GetArgc() == NARG_CNT::ONE) {
