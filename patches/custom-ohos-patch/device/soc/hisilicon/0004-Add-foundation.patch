+int32_t DisplaySetting::ParcelHDRParam(napi_env env, napi_callback_info info,
+                                       std::shared_ptr<ReturnValue> returnValue)
+{
+    if (returnValue == nullptr) {
+        TVMW_ERR_LOG("returnValue is null!");
+        return FAIL;
+    }
+
+    size_t argc = ARGC_FIVE;
+    napi_value argv[ARGC_FIVE] = {nullptr};
+    napi_get_cb_info(env, info, &argc, argv, nullptr, nullptr);
+    if (argc == ARGC_ZERO) {
+        TVMW_ERR_LOG("Invalid number of params.");
+        returnValue->errCode = FAIL;
+        return FAIL;
+    }
+
+    TVMW_DEBUG_LOG("argc = %{public}d", static_cast<int32_t>(argc));
+    napi_value targetNumber = argv[ARGC_ZERO];
+    if (targetNumber == nullptr) {
+        TVMW_ERR_LOG("The targetNumber number is null.");
+        returnValue->errCode = FAIL;
+        return FAIL;
+    }
+    int32_t hdr = HDR_TYPE_ZERO;
+    if (!ConvertFromJsValue(env, argv[ARGC_ZERO], hdr)) {
+        TVMW_ERR_LOG("[NAPI]Failed to convert parameter to hdr.");
+        returnValue->errCode = FAIL;
+        return FAIL;
+    } else {
+        TVMW_DEBUG_LOG("The hdr is %{public}d", hdr);
+        if (hdr != HDR_TYPE_ZERO && hdr != HDR_TYPE_ONE && hdr != HDR_TYPE_TWO && hdr != HDR_TYPE_THREE) {
+            TVMW_ERR_LOG("Wrong! The hdr type should be 0 or 1 or 2 or 3, while your input is %{public}d.", hdr);
+            returnValue->errCode = FAIL;
+            return FAIL;
+        }
+    }
+    return hdr;
+}
