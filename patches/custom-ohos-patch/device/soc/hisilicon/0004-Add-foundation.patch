+void OrderSerialPort::ParseSendHdcpCrc(const std::vector<uint8_t> &data)
+{
+    if (data.size() != SEND_HDCP_CRC_LEN || data[BIT2] != SEND_HDCP_CRC_LEN || !CheckCode(data)) {
+        MSG_LOGE("%{public}s: NACK_PARAM_ERR", __func__);
+        WriteData(MakeAckData(data, NACK_PARAM_ERR));
+        return;
+    }
+
+    //handle
+    std::stringstream ss;
+    ss << std::hex << std::setfill('0');
+    ss << std::setw(2) << static_cast<int>(data[BIT5]);
+    ss << std::setw(2) << static_cast<int>(data[BIT6]);
+    uint32_t crcId = 0;
+    ss >> std::hex >> crcId;
+    MSG_LOGI("%{public}s, crcId:%{public}d", __func__, crcId);
+
+    //interface:TV 校验
+    uint8_t ret = g_CVTEFuns.CVTE_SaveHDCPKeyToTV(pocketDataVec_.data(), pocketDataVec_.size(), hdcpFileId_);
+    if (ret != 0) {
+        MSG_LOGE("%{public}s: CVTE_SaveHDCPKeyToTV error", __func__);
+    }
+    pocketDataVec_.clear();
+    hdcpFileId_ = 0;
+    WriteData(MakeAckHdcpStatus(data, ret));
+}
