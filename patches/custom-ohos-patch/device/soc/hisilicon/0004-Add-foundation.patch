+int TvMWAbilityStub::OnRemoteRequest(
+    uint32_t code, MessageParcel &data, MessageParcel &reply, MessageOption &option)
+{
+    if (data.ReadInterfaceToken() != GetDescriptor()) {
+        TVMW_ERR_LOG("ReadInterfaceToken failed");
+        return FAIL;
+    }
+
+    const auto &itFunc = stubFuncMap_.find(code);
+    if (itFunc != stubFuncMap_.end()) {
+        TVMW_DEBUG_LOG("st ubFuncMap_ call code= %{public}d", code);
+        (this->*(itFunc->second))(data, reply);
+        return SUS;
+    }
+    TVMW_ERR_LOG("default case, need check TvMWAbilityStub");
+    return IPCObjectStub::OnRemoteRequest(code, data, reply, option);
+}
