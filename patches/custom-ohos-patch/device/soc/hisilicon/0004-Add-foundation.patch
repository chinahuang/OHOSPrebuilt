+    TvMWServiceAdapterImpl::SetOutputSharpness(sharpness);
+    TvMWServiceAdapterImpl::SetDisplayHue(hue);
+    TvMWServiceAdapterImpl::SetOutputBacklight(backlightLevel);
+
+    TVMW_DEBUG_LOG("end");
+    return static_cast<int32_t>(SUCCESS);
