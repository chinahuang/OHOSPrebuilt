+std::string DisplaySetting::ParcelStandardParam(napi_env env, napi_callback_info info,
+                                                std::shared_ptr<ReturnValue> returnValue)
+{
+    if (returnValue == nullptr) {
+        TVMW_ERR_LOG("returnValue is null!");
+        return nullptr;
+    }
+
+    size_t argc = ARGC_FIVE;
+    napi_value argv[ARGC_FIVE] = {nullptr};
+    napi_get_cb_info(env, info, &argc, argv, nullptr, nullptr);
+    if (argc == ARGC_ZERO) {
+        TVMW_ERR_LOG("Invalid number of params.");
+        returnValue->errCode = FAIL;
+        return nullptr;;
+    }
+
+    TVMW_DEBUG_LOG("argc = %{public}d", static_cast<int32_t>(argc));
+    napi_value targetString = argv[ARGC_ZERO];
+    if (targetString == nullptr) {
+        TVMW_ERR_LOG("The targetString string is null.");
+        returnValue->errCode = FAIL;
+        return nullptr;
+    }
+
+    std::string standard = "";
+    if (!ConvertFromJsValue(env, argv[ARGC_ZERO], standard)) {
+        TVMW_ERR_LOG("[NAPI]Failed to convert parameter to standard.");
+        returnValue->errCode = FAIL;
+        return nullptr;
+    }
+    if (standard.empty()) {
+        TVMW_ERR_LOG("Fail to get the standard what you input.Your input is %{public}s", standard.c_str());
+        returnValue->errCode = FAIL;
+        return nullptr;
+    }
+    TVMW_DEBUG_LOG("The params standard is %{public}s", standard.c_str());
+    return standard;
+}
