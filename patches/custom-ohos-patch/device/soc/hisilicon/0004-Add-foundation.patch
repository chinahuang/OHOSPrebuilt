+namespace OHOS {
+namespace PowerMgr {
+
+static constexpr const char* KEY_STRBOOT_TYPE {"persist.powermgr.standby.strboottype"};
+static constexpr const char* KEY_STRBOOT_TYPE_DEF {"null"};
+#define STR_BOOT_TYPE_LEN (16)
+
+hisiPowerStateListener::hisiPowerStateListener() {}
+
+void hisiPowerStateListener::OnSyncSleep(bool onForceSleep)
+{
+    STANDBY_HILOGI(COMP_SVC, "Enter OnSyncSleep");
+    if (!onForceSleep) {
+        STANDBY_HILOGI(COMP_SVC, "OnSyncSleep not force sleep");
+        return;
+    }
+
+    DealPowerEnterSleepEvent();
+}
+
+void hisiPowerStateListener::OnSyncWakeup(bool onForceSleep)
+{
+    STANDBY_HILOGI(COMP_SVC, "Enter OnSyncWakeup");
+    if (!onForceSleep) {
+        STANDBY_HILOGI(COMP_SVC, "OnSyncWakeup not force sleep");
+        return;
+    }
+    DealPowerExitSleepEvent();
+}
+
+void hisiPowerStateListener::DealPowerEnterSleepEvent()
+{
+}
+
+void hisiPowerStateListener::DealPowerExitSleepEvent()
+{
+    StartBootanimation();
+}
+
+void hisiPowerStateListener::StartBootanimation()
+{
+    STANDBY_HILOGI(COMP_SVC, "Restart Bootanimation Enter");
+    char strboottype[STR_BOOT_TYPE_LEN];
+    const char target_null[] = "null";
+    const char target_animation[] = "bootanimation";
+    GetParameter(KEY_STRBOOT_TYPE, KEY_STRBOOT_TYPE_DEF, strboottype, STR_BOOT_TYPE_LEN);
+    if (!strncmp(strboottype, target_null, strlen(target_null))) {
+        return;
+    }
+    if (!strncmp(strboottype, target_animation, strlen(target_animation))) {
+        SetParameter("ohos.ctl.start", "bootanimation");
+        STANDBY_HILOGI(COMP_SVC, "Restart Bootanimation Success");
+    }
+    return;
+}
+
+} // namespace PowerMgr
+} // namespace OHOS
