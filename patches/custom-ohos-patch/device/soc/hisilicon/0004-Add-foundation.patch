+}
+
+int32_t TvMWServiceAdapterImpl::GetNLAPoint(const int32_t &nlaItem, NLAPoint &nlaPoint)
+{
+    TVMW_DEBUG_LOG("start");
+
+    auto it = NlaPointDefault.find(nlaItem);
+    if (it == NlaPointDefault.end())
+    {
+        TVMW_ERR_LOG("get NLAItem failed");
+        static_cast<int32_t>(FAILURE);
+    }
+    nlaPoint.x0 = static_cast<int32_t>(NlaPointDefault[nlaItem].x0);
+    nlaPoint.x25 = static_cast<int32_t>(NlaPointDefault[nlaItem].x25);
+    nlaPoint.x50 = static_cast<int32_t>(NlaPointDefault[nlaItem].x50);
+    nlaPoint.x75 = static_cast<int32_t>(NlaPointDefault[nlaItem].x75);
+    nlaPoint.x100 = static_cast<int32_t>(NlaPointDefault[nlaItem].x100);
+
+    TVMW_DEBUG_LOG("x0=%{public}d, x25=%{public}d, x50=%{public}d, x75=%{public}d, x100=%{public}d",
+        nlaPoint.x0, nlaPoint.x50, nlaPoint.x50, nlaPoint.x75, nlaPoint.x100);
+
+    TVMW_DEBUG_LOG("end");
+    return static_cast<int32_t>(SUCCESS);
+}
+
+int32_t TvMWServiceAdapterImpl::GetOutputDefinition(std::string &definition)
+{
+    TVMW_DEBUG_LOG("start");
+    definition = "Standard";
+    TVMW_DEBUG_LOG("end");
+    return static_cast<int32_t>(SUCCESS);
+}
+
+int32_t TvMWServiceAdapterImpl::GetFrequencyOffset(int32_t &offset)
+{
+    TVMW_DEBUG_LOG("start");
+    offset = 0;
+    TVMW_DEBUG_LOG("end");
+    return static_cast<int32_t>(SUCCESS);
+}
+
+int32_t TvMWServiceAdapterImpl::GetPanelBinVersionInfo(std::string &version)
+{
+    TVMW_DEBUG_LOG("start");
+    S32 s32Ret = FAILURE;
+    char ver[256] = {0};
+    s32Ret = getVoutDevice()->vout_panelbinversionInfo_get(NULL, ver, sizeof(ver));
+    if (s32Ret != SUCCESS) {
+        version = "version error";
+        TVMW_ERR_LOG("hal failed, ret(%x)", s32Ret);
+        return static_cast<int32_t>(s32Ret);
+    }
+    version = ver;
+    TVMW_DEBUG_LOG("end");
+    return static_cast<int32_t>(SUCCESS);
+}
+
+} // namespace TvMWStandard
+} // namespace OHOS
