+void TvMWSystemAbility::SetSettingContrast(uint32_t value)
+{
+    uint32_t settingContrast = GetSettingContrast();
+    if (value == static_cast<uint32_t>(settingContrast)) {
+        TVMW_INFO_LOG("no need to set setting Contrast");
+        return;
+    }
+    SettingProvider& provider = SettingProvider::GetInstance(TVMW_SERVICE_ID);
+    ErrCode ret = provider.PutIntValue(SETTING_CONTRAST_KEY, static_cast<int32_t>(value));
+    if (ret != ERR_OK) {
+        TVMW_INFO_LOG("set setting Contrast failed, ret=%{public}d", ret);
+        return;
+    }
+    cachedSettingContrast_ = value;
+}
+
+void TvMWSystemAbility::SetSettingDisplayHue(uint32_t value)
+{
+    uint32_t settingDisplayHue = GetSettingDisplayHue();
+    if (value == static_cast<uint32_t>(settingDisplayHue)) {
+        TVMW_INFO_LOG("no need to set setting DisplayHue");
+        return;
+    }
+    SettingProvider& provider = SettingProvider::GetInstance(TVMW_SERVICE_ID);
+    ErrCode ret = provider.PutIntValue(SETTING_DISPLAYHUE_KEY, static_cast<int32_t>(value));
+    if (ret != ERR_OK) {
+        TVMW_INFO_LOG("set setting DisplayHue failed, ret=%{public}d", ret);
+        return;
+    }
+    cachedSettingDisplayHue_ = value;
+}
