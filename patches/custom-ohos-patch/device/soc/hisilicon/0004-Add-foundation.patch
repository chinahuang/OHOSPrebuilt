+    if (config.GetInterfaceCount() > 0) {
+        UsbInterface interface;
+        config.GetInterface(0, interface);
+        if (interface.GetClass() == USB_CLASS) {
+            (*usb_count)++;
+            MSG_LOGD("%{public}s name: %{public}s, productName: %{public}s", \
+                     __func__, device.GetName().c_str(), device.GetProductName().c_str());
