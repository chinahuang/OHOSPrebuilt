+TvMWClientManager::TvMWClientManager() {}
+
+TvMWClientManager::~TvMWClientManager()
+{
+    if (g_sProxy != nullptr) {
+        auto remoteObject = g_sProxy->AsObject();
+        if (remoteObject != nullptr) {
+            remoteObject->RemoveDeathRecipient(deathRecipient_);
+        }
+    }
+}
+
+int32_t TvMWClientManager::Connect()
+{
+    if (g_sProxy != nullptr) {
+        return SUS;
+    }
+
+    TVMW_DEBUG_LOG("Connect");
+
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto samgr = SystemAbilityManagerClient::GetInstance().GetSystemAbilityManager();
+    RETURN_IF_WITH_RET_WITH_LOG(samgr == nullptr, FAIL, "get system ability manager failed");
+
+    sptr<IRemoteObject> object = samgr->GetSystemAbility(TVMW_SERVICE_ID);
+    RETURN_IF_WITH_RET_WITH_LOG(object == nullptr, FAIL, "get tvmw service failed");
+
+    deathRecipient_ = sptr<IRemoteObject::DeathRecipient>(new TvMWMgrDeathRecipient());
+    if ((object->IsProxyObject()) && (!object->AddDeathRecipient(deathRecipient_))) {
+        TVMW_INFO_LOG("add death recipient to tvmw service failed");
+        return FAIL;
+    }
+
+    g_sProxy = iface_cast<ITvMWAbility>(object);
+    RETURN_IF_WITH_RET_WITH_LOG(g_sProxy == nullptr, FAIL, "Convert Proxy is Failed");
+
+    TVMW_DEBUG_LOG("Connect Success");
+    return SUS;
+}
+
+void TvMWClientManager::ResetProxy(const wptr<IRemoteObject>& remote)
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    RETURN_IF(g_sProxy == nullptr);
+    auto serviceRemote = g_sProxy->AsObject();
+    if ((serviceRemote != nullptr) && (serviceRemote == remote.promote())) {
+        serviceRemote->RemoveDeathRecipient(deathRecipient_);
+        g_sProxy = nullptr;
+    }
+}
+
+void TvMWClientManager::TvMWMgrDeathRecipient::OnRemoteDied(const wptr<IRemoteObject>& remote)
+{
+    if (remote == nullptr) {
+        return;
+    }
+    TvMWClientManager::GetInstance().ResetProxy(remote);
+}
