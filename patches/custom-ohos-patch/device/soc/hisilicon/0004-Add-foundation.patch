+#include "standby_subscriber.h"
+
+#include "common_event_data.h"
+#include "common_event_manager.h"
+#include "common_event_subscriber.h"
+#include "common_event_subscribe_info.h"
+#include "common_event_support.h"
+#include "sysparam.h"
+#include "power_mgr_client.h"
+#include "standby_service.h"
+#include "standby_log.h"
+
+
+namespace OHOS {
+namespace PowerMgr {
+namespace {
+
+}
+void StandbySubscriber::OnReceiveEvent(const OHOS::EventFwk::CommonEventData &data)
+{
+    auto sms = DelayedSpSingleton<StandbyService>::GetInstance();
+    bool isBootComleted = sms->isBootCompleted_;
+
+    int32_t mode = SysParam::GetIntValue(KEY_POWERMGR_STANDBY_MODE, DEF_POWERMGR_STANDBY_MODE);
+
+    std::string action = data.GetWant().GetAction();
+    if (action == OHOS::EventFwk::CommonEventSupport::COMMON_EVENT_SCREEN_OFF) {
+        if (isBootComleted == false) {
+            STANDBY_HILOGI(COMP_SVC, "system is not bootcompleted, do not need receive event in standby service");
+            return;
+        }
+        PowerMgrClient& pmc = PowerMgrClient::GetInstance();
+        if (pmc.IsScreenOn()) {
+            STANDBY_HILOGI(COMP_SVC, "no action suspend, screen on");
+            return;
+        }
+        if (sms->powerkeyDown == false) {
+            STANDBY_HILOGI(COMP_SVC, "no action suspend");
+            return;
+        }
+
+        STANDBY_HILOGI(COMP_SVC, "Received COMMON_EVENT_SCREEN_OFF event, standbymode:%{public}d", mode);
+        if (mode ==  STANDBY_MODE_SHUTDOWN) {
+            STANDBY_HILOGD(COMP_SVC, "Received COMMON_EVENT_SCREEN_OFF, and standbymode:shutdown");
+            PowerMgrClient::GetInstance().ShutDownDevice(SHUTDOWN_REASON);
+        }
+        if (mode ==  STANDBY_MODE_STR) {
+            STANDBY_HILOGD(COMP_SVC, "Received COMMON_EVENT_SCREEN_OFF, and standbymode:str");
+            PowerMgrClient::GetInstance().ForceSuspendDevice();
+        }
+    }
+
+    if (action == OHOS::EventFwk::CommonEventSupport::COMMON_EVENT_SHUTDOWN) {
+        STANDBY_HILOGI(COMP_SVC, "Received COMMON_EVENT_SHUTDOWN event");
+    }
+
+    return;
+}
+} // namespace PowerMgr
+} // namespace OHOS
