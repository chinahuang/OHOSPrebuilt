+        return ERR_IPC;
+    }
+
+    int32_t error = Remote() ->SendRequest(GET_OUTPUT_SATURATION, data, reply, option);
+    if (error != ERR_NONE) {
+        TVMW_ERR_LOG("GetOutputSaturation register playback event failed , error: %d", error);
+        return ERR_IPC;
+    }
+
+    int32_t ret = reply.ReadInt32();
+    saturation = reply.ReadInt32();
+    return ret;
+}
