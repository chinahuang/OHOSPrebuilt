+    int32_t res = usbClient.GetDevices(devi);
+    if (res != 0) {
+        MSG_LOGE("GetDevices error: %{public}d", res);
+        return 1;
+    }
+    for (const auto& device : devi) {
+        if (device.GetConfigCount() > 0) {
+            if (GetUsbDeviceInfo(device, usb_count) != 0) {
+                MSG_LOGI("GetUsbDeviceInfo error, continue");
+                continue;
+            }
+        }
+    }
+
+    return 0;
